      const carouselModal = document.querySelector('[data-carousel-modal]');
      const carouselFileInput = document.querySelector('[data-carousel-file]');
      const carouselDrop = document.querySelector('[data-carousel-drop]');
      const carouselList = document.querySelector('[data-carousel-list]');
      const carouselEmpty = document.querySelector('[data-carousel-empty]');
      const autosave = document.querySelector('[data-autosave-status]');
      const autosaveDetail = document.querySelector('[data-autosave-detail]');
      const mediaList = document.querySelector('[data-media-list]');
      const sourcesOutput = document.querySelector('[data-sources-output]');
      const sourceList = document.querySelector('[data-source-list]');
      const tagList = document.querySelector('[data-tag-list]');
      const googleTitle = document.querySelector('[data-google-title]');
      const googleDescription = document.querySelector('[data-google-description]');
      const seoBar = document.querySelector('[data-seo-bar]');
      const previewModal = document.querySelector('[data-preview-modal]');
      const previewContent = document.querySelector('[data-preview-content]');
      const previewTitle = document.querySelector('[data-preview-title]');
      const previewSummary = document.querySelector('[data-preview-summary]');
      const previewCategory = document.querySelector('[data-preview-category]');
      const previewCover = document.querySelector('[data-preview-cover]');
      const previewCoverWrap = document.querySelector('[data-preview-cover-wrap]');
      const previewSources = document.querySelector('[data-preview-sources]');
      const previewReading = document.querySelector('[data-preview-reading]');
      const categoryInput = document.querySelector('[data-category-input]');
      const seoDescriptionInput = document.querySelector('[data-seo-description]');
      const keywordsInput = document.querySelector('[data-keywords-input]');
      const seoAutofillNote = document.querySelector('[data-seo-autofill-note]');
      const aiOutput = document.querySelector('[data-ai-output]');
      const publishFeedback = document.querySelector('[data-publish-feedback]');

      let savedRange = null;
      let slashRange = null;
      let selectedMedia = null;
      let autosaveTimer = null;
      let pendingInlineAction = 'image';
      let seoTouched = false;
      let keywordsTouched = false;
      let currentArticleId = '';
      const mediaItems = [];
      const carouselDraft = [];
      const sources = [];
      const tags = [];
      const categoryKeywordMap = {
        Política: ['política brasileira', 'governo', 'congresso', 'poder público', 'Portal Novo Alvo'],
        Economia: ['economia', 'mercado', 'negócios', 'finanças', 'Portal Novo Alvo'],
        Brasil: ['Brasil', 'notícias do Brasil', 'sociedade', 'atualidade', 'Portal Novo Alvo'],
        Mundo: ['mundo', 'internacional', 'geopolítica', 'notícias internacionais', 'Portal Novo Alvo'],
        Saúde: ['saúde', 'bem-estar', 'hospitais', 'medicina', 'Portal Novo Alvo'],
        Tecnologia: ['tecnologia', 'inovação', 'inteligência artificial', 'internet', 'Portal Novo Alvo'],
        Esportes: ['esportes', 'futebol', 'clubes', 'competição', 'Portal Novo Alvo'],
        Famosos: ['famosos', 'celebridades', 'entretenimento', 'cultura pop', 'Portal Novo Alvo'],
        Entretenimento: ['entretenimento', 'cultura', 'streaming', 'agenda cultural', 'Portal Novo Alvo'],
        Ciência: ['ciência', 'pesquisa', 'descobertas', 'inovação científica', 'Portal Novo Alvo'],
        Educação: ['educação', 'ensino', 'estudantes', 'aprendizagem', 'Portal Novo Alvo'],
        Cultura: ['cultura', 'arte', 'comportamento', 'produção cultural', 'Portal Novo Alvo'],
        Lifestyle: ['lifestyle', 'comportamento', 'tendências', 'vida cotidiana', 'Portal Novo Alvo'],
        Games: ['games', 'jogos', 'eSports', 'tecnologia gamer', 'Portal Novo Alvo'],
        Moda: ['moda', 'estilo', 'tendências', 'comportamento', 'Portal Novo Alvo'],
        Música: ['música', 'artistas', 'shows', 'indústria musical', 'Portal Novo Alvo'],
        Futebol: ['futebol', 'clubes brasileiros', 'campeonatos', 'esporte nacional', 'Portal Novo Alvo'],
      };
      const stopWords = new Set([
        'para', 'como', 'com', 'uma', 'umas', 'uns', 'dos', 'das', 'que', 'por', 'sobre', 'entre', 'mais', 'menos',
        'esta', 'este', 'essa', 'esse', 'isso', 'ainda', 'também', 'pela', 'pelo', 'nas', 'nos', 'aos', 'aqui',
        'portal', 'novo', 'alvo', 'notícia', 'noticias', 'matéria', 'materia', 'ser', 'foi', 'são', 'sao', 'tem',
      ]);

      const escapeHtml = (value) =>
        String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');

      const showPublishFeedback = (html = '') => {
        if (!publishFeedback) return;
        publishFeedback.innerHTML = html;
        publishFeedback.classList.toggle('hidden', !html);
      };

      const slugify = (value) =>
        String(value || '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '')
          .slice(0, 90);

      const statusLabels = {
        draft: 'Rascunho',
        scheduled: 'Agendada',
        published: 'Publicada',
        saving: 'Salvando...',
        publishing: 'Publicando...',
        scheduling: 'Agendando...',
        saved: 'Salvo no D1',
        tokenRequired: 'Token necessário',
        tokenInvalid: 'Token inválido',
        cmsError: 'Erro no CMS',
      };

      const setStatus = (value, detail = '') => {
        const text = String(value || '');
        const isLongRuntimeMessage = text.length > 28 || text.includes('ADMIN_TOKEN') || text.includes('EDITORIAL_DB');
        const label = isLongRuntimeMessage ? statusLabels.cmsError : statusLabels[value] || value;
        const message = detail || (isLongRuntimeMessage ? text : '');
        if (status) status.textContent = label;
        if (autosave && message) autosave.textContent = message;
        if (autosaveDetail && message) autosaveDetail.textContent = message;
      };

      const saveSelection = () => {
        const selection = window.getSelection();
        if (!selection || selection.rangeCount === 0) return;
        const range = selection.getRangeAt(0);
        if (editor.contains(range.commonAncestorContainer)) savedRange = range.cloneRange();
      };

      const restoreSelection = () => {
        editor.focus();
        if (!savedRange) return;
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(savedRange);
      };

      const runCommand = (command, value = null) => {
        const commandRunner = Reflect.get(document, 'execCommand')?.bind(document);
        if (!commandRunner) return false;
        return commandRunner(command, false, value);
      };

      const insertHtml = (html) => {
        restoreSelection();
        runCommand('insertHTML', html);
        updateEditorState();
      };

      const insertHtmlAtSlash = (html) => {
        if (slashRange) savedRange = slashRange.cloneRange();
        restoreSelection();
        runCommand('insertHTML', html);
        slashRange = null;
        slashPalette?.classList.add('hidden');
        updateEditorState();
      };

      const syncOutput = () => {
        if (output) output.value = editor.innerHTML.trim();
        if (sourcesOutput) sourcesOutput.value = JSON.stringify(sources);
      };

      const scoreSeo = (words) => {
        let score = 20;
        if ((titleInput?.value || '').length >= 35) score += 20;
        if ((summaryInput?.value || '').length >= 80) score += 15;
        if (words >= 450) score += 20;
        if (tags.length >= 3) score += 10;
        if (sources.length >= 1) score += 10;
        if (mediaItems.length >= 1) score += 5;
        return Math.min(100, score);
      };

      const normalizeText = (value) =>
        String(value || '')
          .replace(/\s+/g, ' ')
          .trim();

      const clampSentence = (value, max = 158) => {
        const clean = normalizeText(value);
        if (clean.length <= max) return clean;
        const cut = clean.slice(0, max - 1);
        const lastSpace = cut.lastIndexOf(' ');
        return `${cut.slice(0, lastSpace > 90 ? lastSpace : max - 1).replace(/[,.!?;:]$/, '')}…`;
      };

      const getPlainText = () => normalizeText(editor.innerText.replace(/\s*\/\s*$/, ''));

      const extractTopTerms = () => {
        const text = `${titleInput?.value || ''} ${summaryInput?.value || ''} ${getPlainText()}`;
        const counts = new Map();
        text
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9\s-]/g, ' ')
          .split(/\s+/)
          .filter((word) => word.length > 3 && !stopWords.has(word))
          .forEach((word) => counts.set(word, (counts.get(word) || 0) + 1));
        return [...counts.entries()]
          .sort((a, b) => b[1] - a[1])
          .slice(0, 8)
          .map(([word]) => word);
      };

      const buildSeoDescription = () => {
        const category = categoryInput?.value || '';
        const title = normalizeText(titleInput?.value);
        const summary = normalizeText(summaryInput?.value);
        const body = getPlainText();
        const firstSentence = body.split(/(?<=[.!?])\s+/).find((sentence) => sentence.length > 45) || body;
        const base = summary || firstSentence || title;
        if (!base) return '';
        const categoryPrefix = category ? `${category}: ` : '';
        const description = `${categoryPrefix}${base}`;
        return clampSentence(description, 158);
      };

      const buildKeywords = () => {
        const category = categoryInput?.value || '';
        const titleWords = normalizeText(titleInput?.value)
          .split(/\s+/)
          .filter((word) => word.length > 3)
          .slice(0, 4)
          .join(' ');
        return [
          category,
          titleWords,
          ...(categoryKeywordMap[category] || []),
          ...extractTopTerms(),
          ...tags,
        ]
          .map((keyword) => normalizeText(keyword))
          .filter(Boolean)
          .filter((keyword, index, list) => list.findIndex((item) => item.toLowerCase() === keyword.toLowerCase()) === index)
          .slice(0, 12)
          .join(', ');
      };

      const autofillSeo = () => {
        if (!seoTouched && seoDescriptionInput) {
          const description = buildSeoDescription();
          if (description) seoDescriptionInput.value = description;
        }
        if (!keywordsTouched && keywordsInput) {
          const keywords = buildKeywords();
          if (keywords) keywordsInput.value = keywords;
        }
        if (seoAutofillNote) {
          seoAutofillNote.textContent = seoTouched || keywordsTouched
            ? 'Sugestões automáticas pausadas nos campos editados manualmente.'
            : 'Sugestões automáticas ativas com base no título, categoria e texto.';
        }
      };

      const updateEditorState = () => {
        const words = editor.innerText.trim().split(/\s+/).filter(Boolean).length;
        const reading = Math.max(0, Math.ceil(words / 220));
        const seo = scoreSeo(words);
        const seoText = seo >= 75 ? 'SEO bom' : seo >= 50 ? 'SEO em ajuste' : 'SEO inicial';
        if (stats) stats.textContent = `${words.toLocaleString('pt-BR')} palavras • leitura de ${reading} min • ${seoText}`;
        if (seoBar) {
          seoBar.style.width = `${seo}%`;
          seoBar.className = `h-full rounded-full transition-all ${seo >= 75 ? 'bg-emerald-500' : seo >= 50 ? 'bg-amber-400' : 'bg-red-500'}`;
        }
        autofillSeo();
        if (googleTitle) googleTitle.textContent = titleInput?.value ? `Portal Novo Alvo - ${titleInput.value}` : 'Portal Novo Alvo - título da matéria';
        if (googleDescription) googleDescription.textContent = seoDescriptionInput?.value || summaryInput?.value || 'Prévia Google será montada com título e descrição.';
        syncOutput();
        scheduleAutosave();
      };

      const getReadingTime = () => {
        const words = editor.innerText.trim().split(/\s+/).filter(Boolean).length;
        return Math.max(0, Math.ceil(words / 220));
      };

      const redirectToLogin = () => {
        const next = `${window.location.pathname}${window.location.search}${window.location.hash}`;
        window.location.href = `/redacao/?next=${encodeURIComponent(next)}`;
      };

      const getAdminToken = () => {
        try {
          const token = localStorage.getItem('admin-token') || '';
          if (token) return token;
        } catch {}
        redirectToLogin();
        return '';
      };

      const collectArticlePayload = (statusValue, scheduledAt = '') => {
        updateEditorState();
        const title = titleInput?.value.trim() || 'Matéria sem título';
        const slug = slugInput?.value.trim() || slugify(title);
        const coverUrl = document.querySelector('[data-cover-url]')?.value.trim() || '';
        const coverAlt = document.querySelector('[data-cover-alt]')?.value.trim() || title;
        return {
          id: currentArticleId || (slug ? `article:${slug}` : undefined),
          slug,
          title,
          summary: summaryInput?.value.trim() || '',
          bodyHtml: editor.innerHTML.trim(),
          category: categoryInput?.value || 'Política',
          author: 'Redação Novo Alvo',
          status: statusValue,
          coverUrl,
          coverAlt,
          seoDescription: seoDescriptionInput?.value.trim() || '',
          keywords: keywordsInput?.value.trim() || '',
          tags,
          sources,
          media: mediaItems,
          readingMinutes: getReadingTime(),
          scheduledAt,
          publishedAt: statusValue === 'published' ? new Date().toISOString() : '',
        };
      };

      const saveArticle = async (statusValue, scheduledAt = '') => {
        const token = getAdminToken();
        if (!token) {
          setStatus('Token obrigatório');
          return;
        }

        const payload = collectArticlePayload(statusValue, scheduledAt);
        showPublishFeedback('');
        setStatus(statusValue === 'published' ? 'Publicando...' : statusValue === 'scheduled' ? 'Agendando...' : 'Salvando...');

        try {
          const response = await fetch('/api/admin/articles', {
            method: 'POST',
            headers: {
              'content-type': 'application/json',
              authorization: `Bearer ${token}`,
            },
            body: JSON.stringify(payload),
          });
          const result = await response.json().catch(() => ({}));

          if (response.status === 401) {
            try {
              localStorage.removeItem('admin-token');
            } catch {}
            setStatus('Token inválido');
            redirectToLogin();
            return;
          }

          if (!response.ok) {
            setStatus(result.error || 'Erro ao salvar');
            return;
          }

          currentArticleId = result.article?.id || currentArticleId || payload.id || '';
          const staticPublish = result.staticPublish;
          const staticPublishOk = staticPublish?.ok;
          setStatus(statusValue === 'published' ? (staticPublishOk ? 'Publicada no template Astro' : 'Salva no banco') : statusValue === 'scheduled' ? 'Agendada no banco' : 'Rascunho salvo no banco');
          if (slugInput) slugInput.value = result.article?.slug || payload.slug;
          const savedSlug = result.article?.slug || payload.slug;
          const publicUrl = savedSlug ? `/noticia/${encodeURIComponent(savedSlug)}/` : '';

          if (statusValue === 'published' && publicUrl) {
            const publishNote = staticPublishOk
              ? 'Arquivo editorial enviado ao GitHub. O Cloudflare vai recriar a página usando o modelo oficial Astro.'
              : (staticPublish?.reason || 'Sem GITHUB_TOKEN: a matéria ficou salva no banco, mas ainda não foi transformada em página Astro estática.');
            showPublishFeedback(`
              <span class="block text-[9px] font-black uppercase tracking-widest ${staticPublishOk ? 'text-emerald-300 dark:text-emerald-600' : 'text-amber-300 dark:text-amber-600'}">${staticPublishOk ? 'Publicação enviada ao Astro' : 'Publicação aguardando GitHub'}</span>
              <span class="mt-1 block">${publishNote}</span>
              <span class="mt-1 block break-all">${publicUrl}</span>
              <a href="${publicUrl}" class="mt-3 inline-flex rounded-xl bg-white px-3 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-950 transition hover:bg-red-600 hover:text-white dark:bg-zinc-950 dark:text-white" target="_blank" rel="noopener noreferrer">Abrir notícia</a>
              <a href="/admin/noticias/?status=publicada" class="mt-3 ml-2 inline-flex rounded-xl border border-white/15 px-3 py-2 text-[9px] font-black uppercase tracking-widest transition hover:border-white/50 dark:border-zinc-300">Ver publicadas</a>
            `);
          }

          if (statusValue === 'scheduled') {
            const dateLabel = scheduledAt ? new Intl.DateTimeFormat('pt-BR', { dateStyle: 'short', timeStyle: 'short' }).format(new Date(scheduledAt)) : 'data definida';
            showPublishFeedback(`
              <span class="block text-[9px] font-black uppercase tracking-widest text-sky-300 dark:text-sky-600">Agendada</span>
              <span class="mt-1 block">Esta matéria entra na aba Agendadas e será pública em ${dateLabel}.</span>
              <a href="/admin/noticias/?status=agendada" class="mt-3 inline-flex rounded-xl bg-white px-3 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-950 transition hover:bg-red-600 hover:text-white dark:bg-zinc-950 dark:text-white">Ver agendadas</a>
            `);
            window.setTimeout(() => {
              window.location.href = '/admin/noticias/?status=agendada';
            }, 1200);
          }

          if (statusValue === 'draft') {
            showPublishFeedback(`
              <span class="block text-[9px] font-black uppercase tracking-widest text-zinc-300 dark:text-zinc-500">Rascunho salvo</span>
              <a href="/admin/noticias/?status=rascunho" class="mt-3 inline-flex rounded-xl bg-white px-3 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-950 transition hover:bg-red-600 hover:text-white dark:bg-zinc-950 dark:text-white">Ver rascunhos</a>
            `);
          }
        } catch {
          setStatus('Falha de conexão com CMS');
        }
      };

      const openPreview = () => {
        const clone = editor.cloneNode(true);
        clone.querySelectorAll('.is-selected').forEach((node) => node.classList.remove('is-selected'));
        clone.querySelectorAll('[contenteditable]').forEach((node) => node.removeAttribute('contenteditable'));

        if (previewTitle) previewTitle.textContent = titleInput?.value || 'Título da matéria';
        if (previewSummary) previewSummary.textContent = summaryInput?.value || 'Resumo editorial da matéria.';
        if (previewCategory) previewCategory.textContent = categoryInput?.value || 'Categoria';
        if (previewReading) previewReading.textContent = `${getReadingTime()} min de leitura`;
        if (previewContent) previewContent.innerHTML = clone.innerHTML || '<p>O conteúdo da matéria aparecerá aqui.</p>';

        const coverUrl = document.querySelector('[data-cover-url]')?.value.trim();
        const coverAlt = document.querySelector('[data-cover-alt]')?.value.trim() || titleInput?.value || 'Imagem de capa';
        if (previewCover && previewCoverWrap) {
          previewCover.src = coverUrl || '';
          previewCover.alt = coverAlt;
          previewCoverWrap.classList.toggle('hidden', !coverUrl);
        }

        if (previewSources) {
          previewSources.innerHTML = sources.length
            ? `<span class="mr-2 text-[9px] font-black uppercase tracking-widest text-zinc-300">Fontes:</span>${sources
                .map((source) => `<span class="rounded-md border border-zinc-100 bg-zinc-50 px-2 py-1 text-[9px] font-bold uppercase tracking-widest text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900">${escapeHtml(source.name)}</span>`)
                .join('')}`
            : '';
        }

        previewModal?.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      };

      const closePreview = () => {
        previewModal?.classList.add('hidden');
        document.body.style.overflow = '';
      };

      const scheduleAutosave = () => {
        if (autosave) autosave.textContent = 'salvando...';
        window.clearTimeout(autosaveTimer);
        autosaveTimer = window.setTimeout(() => {
          if (autosave) autosave.textContent = 'salvo agora';
          if (autosaveDetail) autosaveDetail.textContent = 'Autosave local há poucos segundos';
        }, 700);
      };

      const positionMediaToolbar = () => {
        if (!mediaToolbar) return;
        if (!selectedMedia) {
          mediaToolbar.classList.add('hidden');
          mediaToolbar.classList.remove('flex');
          return;
        }
        const rect = selectedMedia.getBoundingClientRect();
        mediaToolbar.style.left = `${rect.left + rect.width / 2}px`;
        mediaToolbar.style.top = `${Math.max(12, rect.top - 54)}px`;
        mediaToolbar.classList.remove('hidden');
        mediaToolbar.classList.add('flex');
      };

      const setSelectedMedia = (media) => {
        selectedMedia?.classList.remove('is-selected');
        selectedMedia = media;
        selectedMedia?.classList.add('is-selected');
        positionMediaToolbar();
      };

      const hideSlashPalette = () => {
        slashPalette?.classList.add('hidden');
        slashRange = null;
      };

      const getSlashRangeAtCursor = () => {
        const selection = window.getSelection();
        if (!selection || selection.rangeCount === 0 || !selection.isCollapsed) return null;
        const range = selection.getRangeAt(0);
        if (!editor.contains(range.commonAncestorContainer)) return null;

        if (range.startContainer.nodeType === Node.TEXT_NODE) {
          const text = range.startContainer.textContent || '';
          if (text.slice(0, range.startOffset).endsWith('/')) {
            const slash = range.cloneRange();
            slash.setStart(range.startContainer, range.startOffset - 1);
            slash.setEnd(range.startContainer, range.startOffset);
            return slash;
          }
          return null;
        }

        const before = range.startContainer.childNodes[range.startOffset - 1];
        if (before?.nodeType === Node.TEXT_NODE && before.textContent?.endsWith('/')) {
          const slash = document.createRange();
          slash.setStart(before, before.textContent.length - 1);
          slash.setEnd(before, before.textContent.length);
          return slash;
        }
        return null;
      };

      const positionSlashPalette = () => {
        if (!slashPalette || !slashRange) return;
        const rect = slashRange.getBoundingClientRect();
        const editorRect = editor.getBoundingClientRect();
        slashPalette.style.left = `${Math.max(20, rect.left - editorRect.left + 24)}px`;
        slashPalette.style.top = `${Math.max(24, rect.bottom - editorRect.top + 20)}px`;
        slashPalette.classList.remove('hidden');
      };

      const updateSlashPalette = () => {
        slashRange = getSlashRangeAtCursor();
        if (!slashRange) {
          slashPalette?.classList.add('hidden');
          return;
        }
        positionSlashPalette();
      };

      const hideBlockMenu = () => {
        blockMenu?.classList.add('hidden');
      };

      const getCurrentTextBlock = () => {
        const selection = window.getSelection();
        if (!selection || selection.rangeCount === 0 || !editor.contains(selection.anchorNode)) return null;
        let node = selection.anchorNode.nodeType === Node.ELEMENT_NODE ? selection.anchorNode : selection.anchorNode.parentElement;
        while (node && node !== editor && !/^(P|DIV|H2|H3|BLOCKQUOTE)$/.test(node.nodeName)) node = node.parentElement;
        return node === editor ? null : node;
      };

      const positionBlockInserter = () => {
        if (!blockInserter) return;
        const selection = window.getSelection();
        if (!selection || selection.rangeCount === 0 || !selection.isCollapsed || !editor.contains(selection.anchorNode)) {
          blockInserter.classList.add('hidden');
          hideBlockMenu();
          return;
        }
        const range = selection.getRangeAt(0);
        const rect = range.getBoundingClientRect();
        const sectionRect = editor.closest('section').getBoundingClientRect();
        const currentBlock = getCurrentTextBlock();
        const directTextAtCursor = range.startContainer.nodeType === Node.TEXT_NODE && range.startContainer.parentElement === editor
          ? range.startContainer.textContent?.trim()
          : '';
        const isEmptyBlock = currentBlock ? !currentBlock.textContent?.trim() : !directTextAtCursor && !editor.textContent?.trim();
        const top = rect.top ? rect.top - sectionRect.top - 6 : editor.offsetTop + 20;
        blockInserter.style.left = `${Math.max(8, editor.offsetLeft - 50)}px`;
        blockInserter.style.top = `${Math.max(22, top)}px`;
        blockInserter.classList.toggle('hidden', !isEmptyBlock);
        blockInserter.classList.toggle('flex', isEmptyBlock);
      };

      const positionBlockMenu = (forceOpen = false) => {
        if (!blockMenu || !blockInserter) return;
        blockMenu.style.left = `${Math.max(56, editor.offsetLeft + 18)}px`;
        blockMenu.style.top = blockInserter.style.top || '18rem';
        if (forceOpen) blockMenu.classList.remove('hidden');
        else blockMenu.classList.toggle('hidden');
      };

      const openBlockMenuFromCursor = () => {
        positionBlockInserter();
        blockInserter?.classList.remove('hidden');
        blockInserter?.classList.add('flex');
        positionBlockMenu(true);
      };

      const moveSelectionToPoint = (x, y) => {
        const range = document.caretRangeFromPoint?.(x, y);
        if (!range || !editor.contains(range.commonAncestorContainer)) return;
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        saveSelection();
      };

      const createMediaControls = () => `
        <div class="media-controls">
          <button type="button" data-media-action="caption">Legenda</button>
          <button type="button" data-media-action="credit">Crédito</button>
          <button type="button" data-media-action="left">Esq.</button>
          <button type="button" data-media-action="center">Centro</button>
          <button type="button" data-media-action="right">Dir.</button>
          <button type="button" data-media-action="small">P</button>
          <button type="button" data-media-action="medium">M</button>
          <button type="button" data-media-action="large">Full</button>
          <button type="button" data-media-action="remove">Remover</button>
        </div>
      `;

      const createImageBlock = (url, alt, credit = '') =>
        `<figure data-editor-media="image" data-align="center" data-media-size="large" data-credit="${escapeHtml(credit)}" contenteditable="false">${createMediaControls()}<img src="${escapeHtml(url)}" alt="${escapeHtml(alt)}" /><figcaption><span data-caption>${escapeHtml(alt || 'Legenda da imagem')}</span><span class="media-credit" data-credit-label>${escapeHtml(credit)}</span></figcaption></figure><p><br></p>`;

      const createImportedImageBlock = (url, alt, credit = '', align = 'center', size = 'large') =>
        createImageBlock(url, alt, credit)
          .replace('data-align="center"', `data-align="${escapeHtml(align)}"`)
          .replace('data-media-size="large"', `data-media-size="${escapeHtml(size)}"`);

      const replaceNodeWithHtml = (node, html) => {
        const template = document.createElement('template');
        template.innerHTML = html;
        node.replaceWith(...Array.from(template.content.childNodes));
      };

      const normalizeImportedEditorHtml = (html) => {
        const template = document.createElement('template');
        template.innerHTML = html || '<p><br></p>';

        template.content.querySelectorAll('figure:not([data-editor-media])').forEach((figure) => {
          const image = figure.querySelector('img');
          if (!image?.src) return;
          const caption = figure.querySelector('figcaption')?.textContent?.trim() || image.alt || 'Legenda da imagem';
          const classes = figure.className || '';
          const align = /--left/.test(classes) ? 'left' : /--right/.test(classes) ? 'right' : 'center';
          const size = /--left|--right/.test(classes) ? 'medium' : 'large';
          replaceNodeWithHtml(figure, createImportedImageBlock(image.src, caption, '', align, size));
        });

        template.content.querySelectorAll('img').forEach((image) => {
          if (image.closest('[data-editor-media]')) return;
          const caption = image.alt || image.getAttribute('title') || 'Legenda da imagem';
          replaceNodeWithHtml(image, createImportedImageBlock(image.src, caption));
        });

        return template.innerHTML || '<p><br></p>';
      };

      const createCarouselSlide = (item, index) => `
        <figure class="carousel-slide" data-carousel-slide="${index}" data-main="${item.main ? 'true' : 'false'}">
          <div class="carousel-item-controls">
            <button type="button" data-carousel-slide-action="main">Capa</button>
            <button type="button" data-carousel-slide-action="caption">Legenda</button>
            <button type="button" data-carousel-slide-action="credit">Crédito</button>
            <button type="button" data-carousel-slide-action="alt">Alt</button>
            <button type="button" data-carousel-slide-action="prev">←</button>
            <button type="button" data-carousel-slide-action="next">→</button>
            <button type="button" data-carousel-slide-action="remove">Remover</button>
          </div>
          <img src="${escapeHtml(item.url)}" alt="${escapeHtml(item.alt || item.caption || 'Imagem do carrossel')}" loading="lazy" />
          <figcaption><span data-caption>${escapeHtml(item.caption || item.alt || 'Legenda da imagem')}</span><span class="media-credit" data-credit-label>${escapeHtml(item.credit || '')}</span></figcaption>
        </figure>`;

      const createCarouselBlockFromItems = (items, layout = 'horizontal') => {
        const normalized = items.filter(Boolean).slice(0, 12);
        if (normalized.length < 2) return '';
        return `<section data-editor-media="carousel" data-carousel-layout="${escapeHtml(layout)}" data-align="center" data-media-size="large" contenteditable="false">${createMediaControls()}<div class="carousel-shell"><button type="button" class="carousel-nav" data-carousel-action="prev" aria-label="Imagem anterior">‹</button><div class="carousel-track">${normalized
          .map((item, index) => createCarouselSlide(item, index))
          .join('')}</div><button type="button" class="carousel-nav" data-carousel-action="next" aria-label="Próxima imagem">›</button></div></section><p><br></p>`;
      };

      const createCarouselBlock = () => {
        const items = mediaItems.slice(0, 8);
        if (items.length < 2) return '';
        return createCarouselBlockFromItems(items, 'horizontal');
      };

      const getYoutubeEmbed = (url) => {
        const match = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/shorts\/)([A-Za-z0-9_-]+)/);
        return match ? `https://www.youtube.com/embed/${match[1]}` : '';
      };

      const createEmbedBlock = (rawUrl, label = 'Embed editorial') => {
        const value = rawUrl.trim();
        const youtube = getYoutubeEmbed(value);
        if (youtube) {
          return `<div data-editor-media="embed" data-align="center" data-media-size="large" contenteditable="false">${createMediaControls()}<iframe src="${youtube}" title="${escapeHtml(label)}" loading="lazy" allowfullscreen class="aspect-video w-full rounded-2xl"></iframe></div><p><br></p>`;
        }
        if (value.startsWith('<iframe')) {
          return `<div data-editor-media="embed" data-align="center" data-media-size="large" contenteditable="false">${createMediaControls()}${value}</div><p><br></p>`;
        }
        return `<div data-editor-media="embed" data-align="center" data-media-size="large" contenteditable="false">${createMediaControls()}<a href="${escapeHtml(value)}" target="_blank" rel="noopener noreferrer" class="embed-card">${escapeHtml(label)} • abrir publicação</a></div><p><br></p>`;
      };

      const renderMediaList = () => {
        if (!mediaList) return;
        mediaList.innerHTML = mediaItems
          .map(
            (item, index) => `
              <article class="group overflow-hidden rounded-3xl bg-zinc-50 p-2 dark:bg-zinc-950">
                <img src="${escapeHtml(item.url)}" alt="${escapeHtml(item.alt)}" class="aspect-video w-full rounded-2xl object-cover" />
                <div class="mt-2 flex gap-2">
                  <button type="button" data-insert-media="${index}" class="flex-1 rounded-full bg-white px-3 py-2 text-[8px] font-black uppercase tracking-widest text-zinc-600 shadow-sm dark:bg-zinc-900">Inserir</button>
                  <button type="button" data-cover-media="${index}" class="flex-1 rounded-full bg-red-600 px-3 py-2 text-[8px] font-black uppercase tracking-widest text-white">Capa</button>
                </div>
              </article>
            `
          )
          .join('');
      };

      const addMedia = (url, alt) => {
        const item = { url, alt: alt || 'Imagem editorial' };
        mediaItems.push(item);
        renderMediaList();
        updateEditorState();
        return item;
      };

      const compressImage = async (file, options = {}) => {
        const image = await createImageBitmap(file);
        const maxWidth = 1800;
        const ratio = Math.min(1, maxWidth / image.width);
        const width = Math.round(image.width * ratio);
        const height = Math.round(image.height * ratio);
        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        canvas.getContext('2d')?.drawImage(image, 0, 0, width, height);
        const blob = await new Promise((resolve) => canvas.toBlob((result) => resolve(result), 'image/webp', 0.86));
        const url = await new Promise((resolve) => {
          const reader = new FileReader();
          reader.addEventListener('load', () => resolve(String(reader.result || '')));
          reader.readAsDataURL(blob || file);
        });
        const item = addMedia(url, file.name.replace(/\.[^.]+$/, ''));
        if (options.insert) insertHtml(createImageBlock(item.url, item.alt));
        setStatus('Imagem otimizada em WebP');
        return item;
      };

      const getCarouselLayout = () => document.querySelector('input[name="carousel-layout"]:checked')?.value || 'horizontal';

      const renderCarouselDraft = () => {
        if (!carouselList || !carouselEmpty) return;
        carouselEmpty.classList.toggle('hidden', carouselDraft.length > 0);
        carouselList.innerHTML = carouselDraft
          .map((item, index) => `
            <article class="group grid gap-3 rounded-[1.6rem] bg-zinc-50 p-3 shadow-sm dark:bg-zinc-900 sm:grid-cols-[150px_minmax(0,1fr)]" draggable="true" data-carousel-draft-item="${index}">
              <img src="${escapeHtml(item.url)}" alt="${escapeHtml(item.alt)}" class="aspect-video w-full rounded-[1.2rem] object-cover transition group-hover:scale-[1.01]" />
              <div class="grid gap-2">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="rounded-full ${item.main ? 'bg-red-600 text-white' : 'bg-white text-zinc-400 dark:bg-zinc-950'} px-3 py-1 text-[8px] font-black uppercase tracking-widest">${item.main ? 'Principal' : `Imagem ${index + 1}`}</span>
                  <button type="button" data-carousel-draft-action="main" class="rounded-full bg-white px-3 py-1 text-[8px] font-black uppercase tracking-widest text-zinc-500 dark:bg-zinc-950">Definir principal</button>
                  <button type="button" data-carousel-draft-action="up" class="rounded-full bg-white px-3 py-1 text-[8px] font-black uppercase tracking-widest text-zinc-500 dark:bg-zinc-950">Subir</button>
                  <button type="button" data-carousel-draft-action="down" class="rounded-full bg-white px-3 py-1 text-[8px] font-black uppercase tracking-widest text-zinc-500 dark:bg-zinc-950">Descer</button>
                  <button type="button" data-carousel-draft-action="remove" class="rounded-full bg-red-50 px-3 py-1 text-[8px] font-black uppercase tracking-widest text-red-600 dark:bg-red-950/30">Remover</button>
                </div>
                <input data-carousel-caption="${index}" value="${escapeHtml(item.caption || '')}" placeholder="Legenda editorial" class="rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-sm font-medium outline-none focus:border-red-600 dark:border-zinc-800 dark:bg-zinc-950" />
                <div class="grid gap-2 sm:grid-cols-2">
                  <input data-carousel-credit="${index}" value="${escapeHtml(item.credit || '')}" placeholder="Crédito" class="rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-xs font-bold outline-none focus:border-red-600 dark:border-zinc-800 dark:bg-zinc-950" />
                  <input data-carousel-alt="${index}" value="${escapeHtml(item.alt || '')}" placeholder="Texto alternativo" class="rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-xs font-bold outline-none focus:border-red-600 dark:border-zinc-800 dark:bg-zinc-950" />
                </div>
              </div>
            </article>
          `)
          .join('');
      };

      const openCarouselComposer = () => {
        carouselDraft.length = 0;
        renderCarouselDraft();
        carouselModal?.classList.remove('hidden');
        carouselModal?.classList.add('flex');
      };

      const closeCarouselComposer = () => {
        carouselModal?.classList.add('hidden');
        carouselModal?.classList.remove('flex');
      };

      const addCarouselFiles = async (files) => {
        for (const file of files.filter((item) => item.type.startsWith('image/'))) {
          const item = await compressImage(file);
          carouselDraft.push({
            ...item,
            caption: item.alt,
            credit: '',
            main: carouselDraft.length === 0,
          });
        }
        renderCarouselDraft();
      };

      const syncCarouselDraftInputs = () => {
        carouselDraft.forEach((item, index) => {
          item.caption = document.querySelector(`[data-carousel-caption="${index}"]`)?.value || item.caption || '';
          item.credit = document.querySelector(`[data-carousel-credit="${index}"]`)?.value || item.credit || '';
          item.alt = document.querySelector(`[data-carousel-alt="${index}"]`)?.value || item.alt || item.caption || '';
        });
      };

      const moveCarouselDraftItem = (from, to) => {
        if (to < 0 || to >= carouselDraft.length) return;
        const [item] = carouselDraft.splice(from, 1);
        carouselDraft.splice(to, 0, item);
        renderCarouselDraft();
      };

      const insertCarouselDraft = () => {
        syncCarouselDraftInputs();
        if (carouselDraft.length < 2) {
          setStatus('Adicione pelo menos 2 imagens');
          return;
        }
        const html = createCarouselBlockFromItems(carouselDraft, getCarouselLayout());
        insertHtml(html);
        closeCarouselComposer();
        setStatus('Carrossel editorial inserido');
      };

      const applyFormat = (action) => {
        restoreSelection();
        if (action === 'bold') runCommand('bold');
        if (action === 'italic') runCommand('italic');
        if (action === 'link') {
          const url = window.prompt('URL do link');
          if (url) runCommand('createLink', url);
        }
        if (action === 'quote') runCommand('formatBlock', 'blockquote');
        if (action === 'highlight') runCommand('backColor', '#fef08a');
        if (action === 'comment') insertHtml('<span class="editor-note">Comentário editorial</span>');
        updateEditorState();
      };

      const runSlashAction = (action) => {
        slashPalette?.classList.add('hidden');
        if (action === 'h2') insertHtmlAtSlash('<h2>Novo subtítulo</h2>');
        if (action === 'h3') insertHtmlAtSlash('<h3>Novo intertítulo</h3>');
        if (action === 'quote') insertHtmlAtSlash('<blockquote>Citação ou dado relevante</blockquote>');
        if (action === 'image') {
          pendingInlineAction = 'image';
          if (slashRange) savedRange = slashRange.cloneRange();
          inlineImageInput?.click();
        }
        if (action === 'youtube' || action === 'tweet' || action === 'embed') {
          const url = window.prompt('Cole a URL');
          if (url) insertHtmlAtSlash(createEmbedBlock(url, action === 'youtube' ? 'YouTube' : action === 'tweet' ? 'Post no X' : 'Embed editorial'));
        }
        if (action === 'carousel') {
          if (slashRange) savedRange = slashRange.cloneRange();
          openCarouselComposer();
        }
      };

      const runBlockAction = (action) => {
        hideBlockMenu();
        if (action === 'image') {
          pendingInlineAction = 'image';
          inlineImageInput?.click();
        }
        if (action === 'carousel') {
          openCarouselComposer();
        }
        if (action === 'embed' || action === 'video') {
          const url = window.prompt(action === 'video' ? 'Cole a URL do vídeo' : 'Cole a URL ou iframe');
          if (url) insertHtml(createEmbedBlock(url, action === 'video' ? 'Vídeo' : 'Embed editorial'));
        }
        if (action === 'quote') insertHtml('<blockquote>Citação ou dado relevante</blockquote>');
        if (action === 'separator') insertHtml('<div class="narrative-separator" contenteditable="false"><span>continua</span></div><p><br></p>');
      };

      document.querySelectorAll('[data-format]').forEach((button) => {
        button.addEventListener('click', () => applyFormat(button.dataset.format));
      });

      document.querySelectorAll('[data-slash-action]').forEach((button) => {
        button.addEventListener('click', () => runSlashAction(button.dataset.slashAction));
      });

      blockInserter?.addEventListener('click', () => {
        saveSelection();
        positionBlockMenu(true);
      });

      blockMenu?.addEventListener('click', (event) => {
        const button = event.target.closest('[data-block-action]');
        if (!button) return;
        runBlockAction(button.dataset.blockAction);
      });

      document.querySelector('[data-close-carousel]')?.addEventListener('click', closeCarouselComposer);
      document.querySelector('[data-insert-carousel-draft]')?.addEventListener('click', insertCarouselDraft);
      carouselModal?.addEventListener('click', (event) => {
        if (event.target === carouselModal) closeCarouselComposer();
      });
      carouselFileInput?.addEventListener('change', async (event) => {
        await addCarouselFiles(Array.from(event.target.files || []));
        event.target.value = '';
      });
      carouselDrop?.addEventListener('dragover', (event) => {
        event.preventDefault();
        carouselDrop.classList.add('border-red-600');
      });
      carouselDrop?.addEventListener('dragleave', () => carouselDrop.classList.remove('border-red-600'));
      carouselDrop?.addEventListener('drop', async (event) => {
        event.preventDefault();
        carouselDrop.classList.remove('border-red-600');
        await addCarouselFiles(Array.from(event.dataTransfer?.files || []));
      });
      carouselList?.addEventListener('input', syncCarouselDraftInputs);
      carouselList?.addEventListener('dragstart', (event) => {
        const item = event.target.closest('[data-carousel-draft-item]');
        if (item) event.dataTransfer?.setData('text/plain', item.dataset.carouselDraftItem);
      });
      carouselList?.addEventListener('dragover', (event) => event.preventDefault());
      carouselList?.addEventListener('drop', (event) => {
        event.preventDefault();
        const target = event.target.closest('[data-carousel-draft-item]');
        const from = Number(event.dataTransfer?.getData('text/plain'));
        const to = Number(target?.dataset.carouselDraftItem);
        if (Number.isInteger(from) && Number.isInteger(to) && from !== to) moveCarouselDraftItem(from, to);
      });
      carouselList?.addEventListener('click', (event) => {
        const button = event.target.closest('[data-carousel-draft-action]');
        const item = event.target.closest('[data-carousel-draft-item]');
        if (!button || !item) return;
        syncCarouselDraftInputs();
        const index = Number(item.dataset.carouselDraftItem);
        const action = button.dataset.carouselDraftAction;
        if (action === 'main') carouselDraft.forEach((draft, draftIndex) => (draft.main = draftIndex === index));
        if (action === 'up') moveCarouselDraftItem(index, index - 1);
        if (action === 'down') moveCarouselDraftItem(index, index + 1);
        if (action === 'remove') carouselDraft.splice(index, 1);
        if (action === 'main' || action === 'remove') renderCarouselDraft();
      });

      inlineImageInput?.addEventListener('change', async (event) => {
        const files = Array.from(event.target.files || []).filter((file) => file.type.startsWith('image/'));
        if (!files.length) return;
        const inserted = [];
        for (const file of files) inserted.push(await compressImage(file, { insert: pendingInlineAction === 'image' }));
        if (pendingInlineAction === 'carousel') {
          const carouselItems = inserted.filter(Boolean);
          if (carouselItems.length >= 2) {
            insertHtml(createCarouselBlockFromItems(carouselItems, 'horizontal'));
          } else if (carouselItems[0]) {
            insertHtml(createImageBlock(carouselItems[0].url, carouselItems[0].alt));
          }
        }
        event.target.value = '';
        pendingInlineAction = 'image';
      });

      document.querySelectorAll('[data-media-align]').forEach((button) => {
        button.addEventListener('click', () => {
          if (!selectedMedia) return;
          selectedMedia.dataset.align = button.dataset.mediaAlign;
          setStatus(`Mídia alinhada: ${button.dataset.mediaAlign}`);
          updateEditorState();
          positionMediaToolbar();
        });
      });

      document.querySelectorAll('[data-media-size]').forEach((button) => {
        button.addEventListener('click', () => {
          if (!selectedMedia) return;
          selectedMedia.dataset.mediaSize = button.dataset.mediaSize;
          selectedMedia.style.width = '';
          setStatus(`Tamanho da mídia: ${button.dataset.mediaSize}`);
          updateEditorState();
          positionMediaToolbar();
        });
      });

      editor.addEventListener('input', () => {
        updateSlashPalette();
        positionBlockInserter();
        if (getCurrentTextBlock()?.textContent?.trim()) hideBlockMenu();
        updateEditorState();
      });
      editor.addEventListener('keydown', (event) => {
        const isPlusShortcut = event.key === '+' || (event.key === '=' && event.shiftKey);
        if (!isPlusShortcut) return;
        const currentBlock = getCurrentTextBlock();
        const selection = window.getSelection();
        const range = selection?.rangeCount ? selection.getRangeAt(0) : null;
        const directTextAtCursor = range?.startContainer.nodeType === Node.TEXT_NODE && range.startContainer.parentElement === editor
          ? range.startContainer.textContent?.trim()
          : '';
        const isEmptyBlock = currentBlock ? !currentBlock.textContent?.trim() : !directTextAtCursor && !editor.textContent?.trim();
        if (!isEmptyBlock) return;
        event.preventDefault();
        saveSelection();
        openBlockMenuFromCursor();
      });
      editor.addEventListener('keyup', (event) => {
        saveSelection();
        if (event.key === 'Escape') hideSlashPalette();
        if (event.key === '/') updateSlashPalette();
        if (event.key === 'Enter' || event.key === 'ArrowUp' || event.key === 'ArrowDown') window.setTimeout(positionBlockInserter, 0);
      });
      editor.addEventListener('mouseup', () => {
        saveSelection();
        updateSlashPalette();
      });
      editor.addEventListener('focus', () => {
        saveSelection();
        positionBlockInserter();
      });
      editor.addEventListener('click', (event) => {
        const carouselNav = event.target.closest('[data-carousel-action]');
        if (carouselNav) {
          const carousel = carouselNav.closest('[data-editor-media="carousel"]');
          const track = carousel?.querySelector('.carousel-track');
          if (track) {
            event.preventDefault();
            const direction = carouselNav.dataset.carouselAction === 'next' ? 1 : -1;
            track.scrollBy({ left: direction * track.clientWidth * 0.82, behavior: 'smooth' });
          }
          return;
        }

        const slideActionButton = event.target.closest('[data-carousel-slide-action]');
        if (slideActionButton) {
          event.preventDefault();
          const carousel = slideActionButton.closest('[data-editor-media="carousel"]');
          const slide = slideActionButton.closest('[data-carousel-slide]');
          const action = slideActionButton.dataset.carouselSlideAction;
          if (!carousel || !slide) return;
          if (action === 'caption') {
            const captionNode = slide.querySelector('[data-caption]');
            const caption = window.prompt('Legenda da imagem', captionNode?.textContent?.trim() || '');
            if (caption !== null) {
              if (captionNode) captionNode.textContent = caption;
              const image = slide.querySelector('img');
              if (image) image.alt = caption;
            }
          }
          if (action === 'credit') {
            const creditNode = slide.querySelector('[data-credit-label]');
            const credit = window.prompt('Crédito da imagem', creditNode?.textContent?.trim() || '');
            if (credit !== null && creditNode) creditNode.textContent = credit;
          }
          if (action === 'alt') {
            const image = slide.querySelector('img');
            const alt = window.prompt('Texto alternativo', image?.alt || '');
            if (alt !== null && image) image.alt = alt;
          }
          if (action === 'main') {
            carousel.querySelectorAll('[data-carousel-slide]').forEach((item) => (item.dataset.main = 'false'));
            slide.dataset.main = 'true';
            const track = carousel.querySelector('.carousel-track');
            if (track && track.firstElementChild !== slide) track.prepend(slide);
          }
          if (action === 'prev' || action === 'next') {
            const sibling = action === 'prev' ? slide.previousElementSibling : slide.nextElementSibling;
            if (sibling?.matches('[data-carousel-slide]')) {
              if (action === 'prev') sibling.before(slide);
              else sibling.after(slide);
            }
          }
          if (action === 'remove') slide.remove();
          updateEditorState();
          return;
        }

        const actionButton = event.target.closest('[data-media-action]');
        if (actionButton) {
          const mediaBlock = actionButton.closest('[data-editor-media]');
          const action = actionButton.dataset.mediaAction;
          if (!mediaBlock) return;
          event.preventDefault();
          if (['left', 'center', 'right'].includes(action)) mediaBlock.dataset.align = action;
          if (['small', 'medium', 'large'].includes(action)) {
            mediaBlock.dataset.mediaSize = action;
            mediaBlock.style.width = '';
          }
          if (action === 'caption') {
            const caption = window.prompt('Legenda da imagem', mediaBlock.querySelector('[data-caption]')?.textContent?.trim() || '');
            if (caption !== null) {
              const captionNode = mediaBlock.querySelector('[data-caption]');
              if (captionNode) captionNode.textContent = caption;
              const image = mediaBlock.querySelector('img');
              if (image) image.alt = caption;
            }
          }
          if (action === 'credit') {
            const credit = window.prompt('Crédito da imagem', mediaBlock.dataset.credit || '');
            if (credit !== null) {
              mediaBlock.dataset.credit = credit;
              const creditNode = mediaBlock.querySelector('[data-credit-label]');
              if (creditNode) creditNode.textContent = credit;
            }
          }
          if (action === 'remove') {
            mediaBlock.remove();
            setSelectedMedia(null);
          }
          updateEditorState();
          positionMediaToolbar();
          return;
        }
        const media = event.target.closest('[data-editor-media]');
        setSelectedMedia(media && editor.contains(media) ? media : null);
        updateSlashPalette();
        positionBlockInserter();
      });
      editor.addEventListener('pointerup', () => {
        if (!selectedMedia) return;
        selectedMedia.dataset.mediaSize = 'custom';
        window.setTimeout(() => {
          updateEditorState();
          positionMediaToolbar();
        }, 0);
      });
      editor.addEventListener('paste', (event) => {
        const text = event.clipboardData?.getData('text/plain') || '';
        if (/https?:\/\/\S+/.test(text) && /(youtube|youtu\.be|twitter|x\.com|instagram|tiktok)/i.test(text)) {
          event.preventDefault();
          insertHtml(createEmbedBlock(text, 'Embed social'));
        } else {
          window.setTimeout(updateEditorState, 0);
        }
      });
      editor.addEventListener('dragover', (event) => {
        if (Array.from(event.dataTransfer?.items || []).some((item) => item.type.startsWith('image/'))) {
          event.preventDefault();
          editor.classList.add('is-dragging-media');
        }
      });
      editor.addEventListener('dragleave', () => editor.classList.remove('is-dragging-media'));
      editor.addEventListener('drop', async (event) => {
        const files = Array.from(event.dataTransfer?.files || []).filter((file) => file.type.startsWith('image/'));
        if (!files.length) return;
        event.preventDefault();
        editor.classList.remove('is-dragging-media');
        moveSelectionToPoint(event.clientX, event.clientY);
        for (const file of files) await compressImage(file, { insert: true });
      });

      document.addEventListener('selectionchange', () => {
        const selection = window.getSelection();
        if (!selection || selection.isCollapsed || !editor.contains(selection.anchorNode)) {
          floatingToolbar?.classList.add('hidden');
          return;
        }
        const rect = selection.getRangeAt(0).getBoundingClientRect();
        if (!rect.width) return;
        floatingToolbar.style.left = `${rect.left + rect.width / 2}px`;
        floatingToolbar.style.top = `${Math.max(12, rect.top - 54)}px`;
        floatingToolbar?.classList.remove('hidden');
        saveSelection();
      });
      window.addEventListener('scroll', positionMediaToolbar, { passive: true });
      window.addEventListener('resize', () => {
        positionMediaToolbar();
        positionSlashPalette();
      });

      titleInput?.addEventListener('input', () => {
        titleInput.style.height = 'auto';
        titleInput.style.height = `${titleInput.scrollHeight}px`;
        if (slugInput && !slugInput.dataset.edited) slugInput.value = slugify(titleInput.value);
        updateEditorState();
      });
      slugInput?.addEventListener('input', () => {
        slugInput.dataset.edited = 'true';
      });
      summaryInput?.addEventListener('input', updateEditorState);
      categoryInput?.addEventListener('change', updateEditorState);
      seoDescriptionInput?.addEventListener('input', () => {
        seoTouched = true;
        updateEditorState();
      });
      keywordsInput?.addEventListener('input', () => {
        keywordsTouched = true;
        updateEditorState();
      });

      document.querySelector('[data-local-image]')?.addEventListener('change', async (event) => {
        const files = Array.from(event.target.files || []);
        for (const file of files) await compressImage(file);
      });
      document.querySelector('[data-cover-file]')?.addEventListener('change', async (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        const item = await compressImage(file);
        const url = item.url;
        const preview = document.querySelector('[data-cover-preview]');
        const empty = document.querySelector('[data-cover-empty]');
        const coverUrl = document.querySelector('[data-cover-url]');
        const coverAlt = document.querySelector('[data-cover-alt]');
        if (preview) {
          preview.src = url;
          preview.classList.remove('hidden');
        }
        empty?.classList.add('hidden');
        if (coverUrl) coverUrl.value = url;
        if (coverAlt && !coverAlt.value) coverAlt.value = item.alt || file.name.replace(/\.[^.]+$/, '');
      });

      document.querySelectorAll('[data-drop-zone], [data-cover-drop]').forEach((zone) => {
        zone.addEventListener('dragover', (event) => {
          event.preventDefault();
          zone.classList.add('border-red-600');
        });
        zone.addEventListener('dragleave', () => zone.classList.remove('border-red-600'));
        zone.addEventListener('drop', async (event) => {
          event.preventDefault();
          zone.classList.remove('border-red-600');
          const files = Array.from(event.dataTransfer?.files || []).filter((file) => file.type.startsWith('image/'));
          for (const file of files) await compressImage(file);
        });
      });

      mediaList?.addEventListener('click', (event) => {
        const insertButton = event.target.closest('[data-insert-media]');
        const coverButton = event.target.closest('[data-cover-media]');
        if (insertButton) {
          const item = mediaItems[Number(insertButton.dataset.insertMedia)];
          if (item) insertHtml(createImageBlock(item.url, item.alt));
        }
        if (coverButton) {
          const item = mediaItems[Number(coverButton.dataset.coverMedia)];
          const coverUrl = document.querySelector('[data-cover-url]');
          const coverAlt = document.querySelector('[data-cover-alt]');
          const preview = document.querySelector('[data-cover-preview]');
          const empty = document.querySelector('[data-cover-empty]');
          if (item && coverUrl) coverUrl.value = item.url;
          if (item && coverAlt) coverAlt.value = item.alt;
          if (item && preview) {
            preview.src = item.url;
            preview.classList.remove('hidden');
          }
          empty?.classList.add('hidden');
        }
      });

      document.querySelector('[data-insert-carousel]')?.addEventListener('click', () => {
        const carousel = createCarouselBlock();
        if (!carousel) {
          setStatus('Adicione pelo menos 2 imagens');
          return;
        }
        insertHtml(carousel);
        setStatus('Carrossel inserido');
      });

      document.querySelector('[data-focus-mode]')?.addEventListener('click', () => {
        document.documentElement.classList.toggle('admin-focus-mode');
      });
      document.querySelector('[data-open-preview]')?.addEventListener('click', openPreview);
      document.querySelector('[data-close-preview]')?.addEventListener('click', closePreview);
      previewModal?.addEventListener('click', (event) => {
        if (event.target === previewModal) closePreview();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !previewModal?.classList.contains('hidden')) closePreview();
      });

      document.querySelector('[data-save-draft]')?.addEventListener('click', () => saveArticle('draft'));
      document.querySelector('[data-publish-now]')?.addEventListener('click', () => saveArticle('published'));
      document.querySelector('[data-schedule-post]')?.addEventListener('click', () => {
        const scheduledAt = document.querySelector('[data-schedule-at]')?.value;
        if (!scheduledAt) {
          setStatus('Informe data e hora');
          return;
        }
        saveArticle('scheduled', new Date(scheduledAt).toISOString());
      });

      document.querySelector('[data-add-tag]')?.addEventListener('click', () => {
        const input = document.querySelector('[data-tag-input]');
        const value = input?.value.trim();
        if (!value) return;
        tags.push(value);
        input.value = '';
        renderTags();
        updateEditorState();
      });

      const renderSources = () => {
        sourceList.innerHTML = sources
          .map(
            (source, index) => `
              <div class="rounded-2xl bg-white p-3 text-xs shadow-sm dark:bg-zinc-950">
                <div class="flex items-center justify-between gap-3">
                  <strong class="truncate">${escapeHtml(source.name)}</strong>
                  <button type="button" data-remove-source="${index}" class="text-[8px] font-black uppercase tracking-widest text-red-600">Remover</button>
                </div>
                ${source.url ? `<span class="mt-1 block truncate text-zinc-400">${escapeHtml(source.url)}</span>` : ''}
                ${source.note ? `<p class="mt-2 leading-5 text-zinc-500">${escapeHtml(source.note)}</p>` : ''}
              </div>
            `
          )
          .join('');
        updateEditorState();
      };

      const renderTags = () => {
        if (!tagList) return;
        tagList.innerHTML = tags
          .map((tag) => `<span class="rounded-full bg-zinc-950 px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-white dark:bg-white dark:text-zinc-950">${escapeHtml(tag)}</span>`)
          .join('');
      };

      const parseStoredJson = (value) => {
        if (!value) return [];
        if (Array.isArray(value)) return value;
        try {
          const parsed = JSON.parse(value);
          return Array.isArray(parsed) ? parsed : [];
        } catch {
          return [];
        }
      };

      const loadArticleFromUrl = async () => {
        const articleId = new URLSearchParams(window.location.search).get('id');
        if (!articleId) return;

        const token = getAdminToken();
        if (!token) {
          setStatus('Token obrigatório');
          return;
        }

        setStatus('Carregando...');
        try {
          const response = await fetch(`/api/admin/articles?id=${encodeURIComponent(articleId)}`, {
            headers: { authorization: `Bearer ${token}` },
          });
          const data = await response.json().catch(() => ({}));
          if (response.status === 401) {
            try {
              localStorage.removeItem('admin-token');
            } catch {}
            setStatus('Token inválido');
            redirectToLogin();
            return;
          }
          if (!response.ok || !data.article) throw new Error(data.error || 'Rascunho não encontrado.');

          const article = data.article;
          currentArticleId = article.id || articleId;
          if (titleInput) {
            titleInput.value = article.title || '';
            titleInput.dispatchEvent(new Event('input', { bubbles: true }));
          }
          if (slugInput) slugInput.value = article.slug || '';
          if (summaryInput) summaryInput.value = article.summary || '';
          if (categoryInput && article.category) categoryInput.value = article.category;
          if (editor) editor.innerHTML = normalizeImportedEditorHtml(article.body_html || '');
          if (seoDescriptionInput) seoDescriptionInput.value = article.seo_description || '';
          if (keywordsInput) keywordsInput.value = article.keywords || '';

          const coverUrl = document.querySelector('[data-cover-url]');
          const coverAlt = document.querySelector('[data-cover-alt]');
          const coverPreview = document.querySelector('[data-cover-preview]');
          const coverEmpty = document.querySelector('[data-cover-empty]');
          if (coverUrl) coverUrl.value = article.cover_url || '';
          if (coverAlt) coverAlt.value = article.cover_alt || article.title || '';
          if (coverPreview && article.cover_url) {
            coverPreview.src = article.cover_url;
            coverPreview.classList.remove('hidden');
            coverEmpty?.classList.add('hidden');
          }

          tags.splice(0, tags.length, ...parseStoredJson(article.tags).map(String));
          sources.splice(0, sources.length, ...parseStoredJson(article.sources));
          mediaItems.splice(0, mediaItems.length, ...parseStoredJson(article.media));
          renderTags();
          renderSources();
          renderMediaList();
          setStatus(article.status === 'published' ? 'Publicada' : article.status === 'scheduled' ? 'Agendada' : 'Rascunho');
          updateEditorState();
        } catch (error) {
          setStatus(error.message || 'Erro ao carregar');
        }
      };

      document.querySelector('[data-add-source]')?.addEventListener('click', () => {
        const nameInput = document.querySelector('[data-source-name]');
        const urlInput = document.querySelector('[data-source-url]');
        const noteInput = document.querySelector('[data-source-note]');
        const name = nameInput?.value.trim();
        if (!name) return;
        sources.push({ name, url: urlInput?.value.trim() || '', note: noteInput?.value.trim() || '' });
        nameInput.value = '';
        urlInput.value = '';
        noteInput.value = '';
        renderSources();
      });
      sourceList?.addEventListener('click', (event) => {
        const button = event.target.closest('[data-remove-source]');
        if (!button) return;
        sources.splice(Number(button.dataset.removeSource), 1);
        renderSources();
      });

      const normalizeAction = (value) =>
        String(value || '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase();

      const getSelectedEditorText = () => {
        const selection = window.getSelection();
        if (!selection || selection.rangeCount === 0 || selection.isCollapsed) return '';
        const range = selection.getRangeAt(0);
        return editor.contains(range.commonAncestorContainer) ? selection.toString().trim() : '';
      };

      const getSavedEditorText = () => {
        if (!savedRange || !editor.contains(savedRange.commonAncestorContainer)) return '';
        return savedRange.toString().trim();
      };

      const getAiText = (result) => {
        if (!result) return '';
        if (typeof result === 'string') return result;
        return result.text || result.subtitle || result.push || result.instagram || '';
      };

      const replaceSelectionOrInsert = (text) => {
        const clean = String(text || '').trim();
        if (!clean) return;
        restoreSelection();
        const selection = window.getSelection();
        if (selection && selection.rangeCount > 0 && !selection.isCollapsed && editor.contains(selection.getRangeAt(0).commonAncestorContainer)) {
          runCommand('insertText', clean);
        } else {
          insertHtml(`<p>${escapeHtml(clean).replace(/\n{2,}/g, '</p><p>').replace(/\n/g, '<br>')}</p>`);
        }
        updateEditorState();
      };

      const renderAiOutput = (action, result) => {
        if (!aiOutput) return;
        const titleOptions = Array.isArray(result?.titleOptions) ? result.titleOptions.filter(Boolean).slice(0, 4) : [];
        const keywords = Array.isArray(result?.keywords) ? result.keywords.filter(Boolean).join(', ') : result?.keywords || '';
        const text = getAiText(result);

        aiOutput.classList.remove('hidden');
        aiOutput.innerHTML = `
          <div class="mb-3 flex items-center justify-between gap-3">
            <strong class="text-[10px] font-black uppercase tracking-[0.24em] text-red-600">${escapeHtml(action)}</strong>
            <span class="text-[9px] font-black uppercase tracking-widest text-zinc-300">Workers AI</span>
          </div>
          ${titleOptions.length ? `
            <div class="mb-3 grid gap-2">
              ${titleOptions.map((title) => `<button type="button" data-ai-title="${escapeHtml(title)}" class="rounded-2xl bg-zinc-50 px-3 py-2 text-left text-xs font-bold text-zinc-700 transition hover:bg-red-600 hover:text-white dark:bg-zinc-900 dark:text-zinc-200">${escapeHtml(title)}</button>`).join('')}
            </div>
          ` : ''}
          ${text ? `<p class="whitespace-pre-line">${escapeHtml(text)}</p>` : ''}
          ${result?.seoDescription ? `<p class="mt-3 rounded-2xl bg-emerald-50 p-3 text-xs font-bold text-emerald-700 dark:bg-emerald-950/20 dark:text-emerald-300">${escapeHtml(result.seoDescription)}</p>` : ''}
          ${keywords ? `<p class="mt-2 text-xs font-bold text-zinc-400">${escapeHtml(keywords)}</p>` : ''}
        `;
      };

      const applyAiResult = (action, result) => {
        const actionKey = normalizeAction(action);
        const text = getAiText(result);
        if (actionKey.includes('seo')) {
          if (result?.seoDescription && seoDescriptionInput) {
            seoDescriptionInput.value = String(result.seoDescription).slice(0, 158);
            seoTouched = true;
          }
          if (result?.keywords && keywordsInput) {
            keywordsInput.value = Array.isArray(result.keywords) ? result.keywords.join(', ') : String(result.keywords);
            keywordsTouched = true;
          }
        }
        if (actionKey.includes('criar resumo') && text && summaryInput) {
          summaryInput.value = text.slice(0, 320);
          summaryInput.dispatchEvent(new Event('input', { bubbles: true }));
        }
        if (actionKey.includes('resumir') && text) {
          replaceSelectionOrInsert(text);
        }
        if (actionKey.includes('melhorar escrita') && text) {
          replaceSelectionOrInsert(text);
        }
        if (actionKey.includes('subtitulo') && result?.subtitle) {
          insertHtml(`<h2>${escapeHtml(result.subtitle)}</h2>`);
        }
        renderAiOutput(action, result);
        updateEditorState();
      };

      document.querySelectorAll('[data-ai-action]').forEach((button) => {
        button.addEventListener('click', async () => {
          const action = button.dataset.aiAction;
          setStatus(`${action}: gerando...`);
          button.disabled = true;
          button.classList.add('opacity-60');
          try {
            const token = getAdminToken();
            if (!token) return;
            const selectedText = getSelectedEditorText() || getSavedEditorText();
            const response = await fetch('/api/editorial-ai', {
              method: 'POST',
              headers: {
                'content-type': 'application/json',
                authorization: `Bearer ${token}`,
              },
              body: JSON.stringify({
                action,
                title: titleInput?.value || '',
                summary: summaryInput?.value || '',
                category: categoryInput?.value || '',
                body: getPlainText(),
                selection: selectedText,
                seoDescription: seoDescriptionInput?.value || '',
                keywords: keywordsInput?.value || '',
              }),
            });
            const contentType = response.headers.get('content-type') || '';
            const data = contentType.includes('application/json') ? await response.json() : {};
            if (!contentType.includes('application/json')) {
              throw new Error('A rota de IA respondeu HTML em vez de JSON. Reimplante o Pages Functions ou confira /api/editorial-ai.');
            }
            if (!response.ok) throw new Error(data.error || 'Falha ao gerar sugestao.');
            applyAiResult(action, data.result || {});
            setStatus(`${action}: pronto`);
          } catch (error) {
            if (aiOutput) {
              aiOutput.classList.remove('hidden');
              aiOutput.innerHTML = `<strong class="text-red-600">IA indisponivel</strong><p class="mt-2">${escapeHtml(error.message || 'Confira o binding AI no Cloudflare Pages.')}</p>`;
            }
            setStatus('IA indisponivel');
          } finally {
            button.disabled = false;
            button.classList.remove('opacity-60');
          }
        });
      });

      aiOutput?.addEventListener('click', (event) => {
        const button = event.target.closest('[data-ai-title]');
        if (!button || !titleInput) return;
        titleInput.value = button.dataset.aiTitle || '';
        titleInput.dispatchEvent(new Event('input', { bubbles: true }));
        setStatus('Titulo aplicado');
      });

      document.querySelector('[data-current-date]').textContent = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short' }).format(new Date());
      updateEditorState();
      loadArticleFromUrl();
    })();
  </script>
</AdminLayout>
