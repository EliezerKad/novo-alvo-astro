---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { categoriesList, subCategoriesList } from '../../lib/news';

const categories = [...categoriesList, ...subCategoriesList];

const slashCommands = [
  { command: '/h2', label: 'Subtítulo H2', action: 'h2', hint: 'Abre uma nova seção editorial' },
  { command: '/h3', label: 'Intertítulo H3', action: 'h3', hint: 'Organiza um trecho curto' },
  { command: '/quote', label: 'Citação', action: 'quote', hint: 'Destaca fala ou dado importante' },
  { command: '/imagem', label: 'Imagem', action: 'image', hint: 'Insere a próxima imagem no texto' },
  { command: '/youtube', label: 'YouTube', action: 'youtube', hint: 'Cole o link do vídeo' },
  { command: '/tweet', label: 'Tweet / X', action: 'tweet', hint: 'Cole o link do post' },
  { command: '/carrossel', label: 'Carrossel', action: 'carousel', hint: 'Cria bloco visual com múltiplas imagens' },
  { command: '/embed', label: 'Embed', action: 'embed', hint: 'Insere URL ou iframe confiável' },
];

const aiActions = [
  'Sugerir título',
  'Criar resumo',
  'Resumir texto',
  'Melhorar escrita',
  'Gerar subtítulo',
  'Criar chamada push',
  'Legenda Instagram',
  'SEO automático',
];
---

<AdminLayout title="Nova matéria | Admin Novo Alvo" active="new">
  <form class="editor-studio grid gap-6 xl:grid-cols-[minmax(0,1fr)_348px] 2xl:grid-cols-[minmax(0,1fr)_372px]">
    <section class="min-w-0 space-y-6">
      <header class="relative overflow-hidden rounded-[1.85rem] border border-black/10 bg-[#fffdf8]/86 p-5 shadow-[0_22px_64px_rgba(16,16,16,0.075)] backdrop-blur-2xl dark:border-zinc-800/90 dark:bg-zinc-900/78 md:rounded-[2.25rem] md:p-6">
        <div class="pointer-events-none absolute -right-24 -top-28 h-72 w-72 rounded-full bg-[#8A1F2D]/10 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-32 left-1/4 h-72 w-72 rounded-full bg-[#ebe8df]/80 blur-3xl dark:bg-zinc-800/40"></div>
        <div class="relative">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="rounded-full bg-[#8A1F2D] px-3 py-1.5 text-[9px] font-black uppercase tracking-[0.24em] text-white shadow-lg shadow-[#8A1F2D]/20">Redação</span>
            <span class="text-[11px] font-bold text-zinc-400" data-autosave-status>salvo agora</span>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <button type="button" data-focus-mode class="rounded-full border border-black/10 bg-white/78 px-4 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-500 shadow-sm transition hover:border-[#8A1F2D] hover:text-[#8A1F2D] dark:border-zinc-800 dark:bg-zinc-950 dark:hover:border-white dark:hover:text-white">
              Modo foco
            </button>
            <button type="button" data-open-preview class="rounded-full bg-[#101010] px-4 py-2 text-[9px] font-black uppercase tracking-widest text-white transition hover:bg-[#8A1F2D] dark:bg-white dark:text-zinc-950">
              Preview
            </button>
          </div>
        </div>

        <label class="mt-8 block">
          <span class="sr-only">Título</span>
          <textarea
            data-title-input
            rows="1"
            class="admin-display field-clean w-full resize-none bg-transparent text-5xl outline-none placeholder:text-zinc-300 md:text-7xl dark:placeholder:text-zinc-700"
            placeholder="Título da matéria"
          ></textarea>
        </label>

        <div class="mt-5 grid gap-3 text-[11px] font-black uppercase tracking-widest text-zinc-400 md:grid-cols-5">
          <label class="rounded-2xl border border-black/5 bg-white/62 px-4 py-3 shadow-sm dark:border-zinc-800 dark:bg-zinc-950/70">
            <span class="block text-[8px] text-zinc-300">Slug</span>
            <input data-slug-input class="mt-1 w-full bg-transparent lowercase text-zinc-700 outline-none dark:text-zinc-200" placeholder="slug-automatico" />
          </label>
          <label class="rounded-2xl border border-black/5 bg-white/62 px-4 py-3 shadow-sm dark:border-zinc-800 dark:bg-zinc-950/70">
            <span class="block text-[8px] text-zinc-300">Categoria</span>
            <select data-category-input class="mt-1 w-full bg-transparent text-zinc-700 outline-none dark:text-zinc-200">
              {categories.map((category) => <option>{category}</option>)}
            </select>
          </label>
          <label class="rounded-2xl border border-black/5 bg-white/62 px-4 py-3 shadow-sm dark:border-zinc-800 dark:bg-zinc-950/70">
            <span class="block text-[8px] text-zinc-300">Autor</span>
            <input class="mt-1 w-full bg-transparent text-zinc-700 outline-none dark:text-zinc-200" value="Redação Novo Alvo" />
          </label>
          <div class="rounded-2xl border border-black/5 bg-white/62 px-4 py-3 shadow-sm dark:border-zinc-800 dark:bg-zinc-950/70">
            <span class="block text-[8px] text-zinc-300">Status</span>
            <strong class="mt-1 block text-zinc-700 dark:text-zinc-200" data-editor-status>Rascunho</strong>
          </div>
          <div class="rounded-2xl border border-black/5 bg-white/62 px-4 py-3 shadow-sm dark:border-zinc-800 dark:bg-zinc-950/70">
            <span class="block text-[8px] text-zinc-300">Data</span>
            <strong class="mt-1 block text-zinc-700 dark:text-zinc-200" data-current-date>Hoje</strong>
          </div>
        </div>
        </div>
      </header>

      <section class="relative overflow-hidden rounded-[1.85rem] border border-black/10 bg-[#fffdf8]/90 shadow-[0_22px_64px_rgba(16,16,16,0.07)] backdrop-blur-2xl dark:border-zinc-800/90 dark:bg-zinc-900/82 md:rounded-[2.25rem]">
        <div class="flex flex-wrap items-center gap-3 border-b border-black/10 px-5 py-4 dark:border-zinc-800">
          <div class="flex items-center gap-2 rounded-full bg-[#f5f3ee]/82 p-1 shadow-inner shadow-zinc-950/5 backdrop-blur dark:bg-zinc-950/75">
            {['bold', 'italic', 'link', 'quote', 'highlight', 'comment'].map((action) => (
              <button type="button" data-format={action} class="rounded-full px-3 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-500 transition hover:bg-white hover:text-[#8A1F2D] hover:shadow-sm dark:hover:bg-zinc-900">
                {action === 'bold' ? 'B' : action === 'italic' ? 'I' : action === 'link' ? 'Link' : action === 'quote' ? 'Quote' : action === 'highlight' ? 'Destaque' : 'Comentário'}
              </button>
            ))}
          </div>
          <div class="ml-auto text-[11px] font-bold text-zinc-400" data-editor-stats>
            0 palavras • leitura de 0 min • SEO inicial
          </div>
        </div>

        <div
          data-floating-toolbar
          class="pointer-events-auto fixed z-50 hidden -translate-x-1/2 rounded-full border border-zinc-200 bg-zinc-950 p-1 text-white shadow-2xl shadow-zinc-950/20 dark:border-zinc-700"
        >
          {['bold', 'italic', 'link', 'quote', 'highlight', 'comment'].map((action) => (
            <button type="button" data-format={action} class="rounded-full px-3 py-2 text-[9px] font-black uppercase tracking-widest transition hover:bg-white hover:text-zinc-950">
              {action === 'bold' ? 'B' : action === 'italic' ? 'I' : action === 'link' ? 'Link' : action === 'quote' ? 'Quote' : action === 'highlight' ? 'Mark' : 'Nota'}
            </button>
          ))}
        </div>

        <div
          data-media-toolbar
          class="pointer-events-auto fixed z-50 hidden -translate-x-1/2 items-center gap-1 rounded-full border border-zinc-200 bg-white/95 p-1 text-zinc-700 shadow-2xl shadow-zinc-950/15 backdrop-blur-xl dark:border-zinc-800 dark:bg-zinc-950/95 dark:text-zinc-200"
        >
          <button type="button" data-media-align="left" class="rounded-full px-3 py-2 text-[9px] font-black uppercase tracking-widest transition hover:bg-zinc-950 hover:text-white dark:hover:bg-white dark:hover:text-zinc-950">Esq.</button>
          <button type="button" data-media-align="center" class="rounded-full px-3 py-2 text-[9px] font-black uppercase tracking-widest transition hover:bg-zinc-950 hover:text-white dark:hover:bg-white dark:hover:text-zinc-950">Centro</button>
          <button type="button" data-media-align="right" class="rounded-full px-3 py-2 text-[9px] font-black uppercase tracking-widest transition hover:bg-zinc-950 hover:text-white dark:hover:bg-white dark:hover:text-zinc-950">Dir.</button>
          <span class="mx-1 h-6 w-px bg-zinc-200 dark:bg-zinc-800"></span>
          <button type="button" data-media-size="small" class="rounded-full px-3 py-2 text-[9px] font-black uppercase tracking-widest transition hover:bg-red-600 hover:text-white">P</button>
          <button type="button" data-media-size="medium" class="rounded-full px-3 py-2 text-[9px] font-black uppercase tracking-widest transition hover:bg-red-600 hover:text-white">M</button>
          <button type="button" data-media-size="large" class="rounded-full px-3 py-2 text-[9px] font-black uppercase tracking-widest transition hover:bg-red-600 hover:text-white">G</button>
          <span class="mx-1 hidden text-[9px] font-bold text-zinc-400 md:inline">arraste a borda</span>
        </div>

        <div
          data-slash-palette
          class="absolute left-8 top-24 z-30 hidden w-[min(420px,calc(100%-4rem))] overflow-hidden rounded-3xl border border-zinc-200 bg-white p-2 shadow-2xl shadow-zinc-950/10 dark:border-zinc-800 dark:bg-zinc-950"
        >
          {slashCommands.map((item) => (
            <button type="button" data-slash-action={item.action} class="flex w-full items-center justify-between gap-4 rounded-2xl px-4 py-3 text-left transition hover:bg-zinc-50 dark:hover:bg-zinc-900">
              <span>
                <span class="block text-sm font-black text-zinc-950 dark:text-zinc-50">{item.label}</span>
                <span class="block text-xs font-medium text-zinc-400">{item.command} • {item.hint}</span>
              </span>
              <span class="text-red-600">↵</span>
            </button>
          ))}
        </div>

        <button type="button" data-block-inserter class="absolute left-8 top-72 z-20 hidden h-10 w-10 items-center justify-center rounded-full border border-zinc-200 bg-white/90 text-xl font-black text-zinc-400 shadow-xl shadow-zinc-950/10 backdrop-blur-xl transition hover:border-red-600 hover:bg-red-600 hover:text-white dark:border-zinc-800 dark:bg-zinc-950/90" aria-label="Inserir bloco">
          +
        </button>

        <div data-block-menu class="absolute left-8 top-84 z-30 hidden max-h-[min(420px,70vh)] w-[min(320px,calc(100%-4rem))] overflow-y-auto rounded-3xl border border-zinc-200 bg-white/95 p-2 shadow-2xl shadow-zinc-950/12 backdrop-blur-2xl dark:border-zinc-800 dark:bg-zinc-950/95">
          {[
            ['image', 'Imagem', 'Upload inline com compressão WebP'],
            ['carousel', 'Carrossel', 'Sequência visual narrativa'],
            ['embed', 'Embed', 'Link social ou iframe'],
            ['video', 'Vídeo', 'YouTube, Shorts ou link'],
            ['quote', 'Quote', 'Citação editorial'],
            ['separator', 'Separador', 'Pausa visual no texto'],
          ].map(([action, label, hint]) => (
            <button type="button" data-block-action={action} class="flex w-full items-center justify-between gap-4 rounded-2xl px-4 py-3 text-left transition hover:bg-zinc-50 dark:hover:bg-zinc-900">
              <span>
                <span class="block text-sm font-black text-zinc-950 dark:text-zinc-50">{label}</span>
                <span class="block text-xs font-medium text-zinc-400">{hint}</span>
              </span>
              <span class="text-red-600">+</span>
            </button>
          ))}
        </div>

        <input type="file" accept="image/jpeg,image/png,image/webp" multiple class="sr-only" data-inline-image-input />

        <div data-carousel-modal class="fixed inset-0 z-[120] hidden items-center justify-center bg-zinc-950/45 p-4 backdrop-blur-md">
          <section class="relative grid h-[92vh] max-h-[92vh] w-full max-w-5xl overflow-hidden rounded-[2rem] bg-white shadow-2xl shadow-zinc-950/25 dark:bg-zinc-950 md:grid-cols-[minmax(0,1fr)_320px]">
            <div class="flex min-h-0 flex-col overflow-hidden p-5 md:p-7">
              <div class="shrink-0 flex items-start justify-between gap-4">
                <div>
                  <p class="text-[10px] font-black uppercase tracking-[0.28em] text-red-600">Bloco narrativo</p>
                  <h2 class="admin-display mt-2 text-4xl text-zinc-950 dark:text-white">Carrossel editorial</h2>
                  <p class="mt-2 max-w-xl text-sm font-medium leading-6 text-zinc-500 dark:text-zinc-400">Monte uma sequência visual fluida, com legenda, crédito e ritmo de leitura antes de inserir no texto.</p>
                </div>
                <button type="button" data-close-carousel class="rounded-full bg-zinc-100 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-zinc-500 transition hover:bg-zinc-950 hover:text-white dark:bg-zinc-900 dark:text-zinc-300 dark:hover:bg-white dark:hover:text-zinc-950">Fechar</button>
              </div>

              <label data-carousel-drop class="group mt-6 flex min-h-56 shrink-0 cursor-pointer flex-col items-center justify-center rounded-[2rem] border border-dashed border-zinc-300 bg-gradient-to-br from-zinc-50 to-white p-6 text-center transition hover:border-red-600 hover:shadow-[0_24px_80px_rgba(220,38,38,0.10)] dark:border-zinc-800 dark:from-zinc-900 dark:to-zinc-950">
                <span class="rounded-full bg-red-600 px-4 py-2 text-[10px] font-black uppercase tracking-[0.24em] text-white shadow-lg shadow-red-600/20">Adicionar imagens</span>
                <span class="mt-4 text-sm font-bold text-zinc-500 dark:text-zinc-400">Arraste múltiplas imagens ou clique para selecionar</span>
                <span class="mt-1 text-xs font-medium text-zinc-400">Compressão WebP automática e invisível</span>
                <input type="file" accept="image/jpeg,image/png,image/webp" multiple class="sr-only" data-carousel-file />
              </label>

              <div data-carousel-empty class="mt-5 shrink-0 rounded-[1.5rem] bg-zinc-50 p-5 text-sm font-medium text-zinc-400 dark:bg-zinc-900">Nenhuma imagem ainda. Escolha pelo menos 2 para criar um carrossel.</div>
              <div data-carousel-list class="mt-5 grid min-h-0 flex-1 gap-4 overflow-y-auto pr-2"></div>
            </div>

            <aside class="min-h-0 overflow-y-auto border-t border-zinc-100 bg-zinc-50/80 p-5 dark:border-zinc-800 dark:bg-zinc-900/70 md:border-l md:border-t-0">
              <h3 class="text-xs font-black uppercase tracking-[0.24em] text-zinc-950 dark:text-white">Estilo</h3>
              <div class="mt-4 grid gap-2" data-carousel-layouts>
                {[
                  ['horizontal', 'Horizontal', 'Swipe natural'],
                  ['widescreen', 'Widescreen', 'Cinemático'],
                  ['mosaic', 'Mosaico', 'Ritmo visual'],
                  ['immersive', 'Imersivo', 'Impacto máximo'],
                  ['compact', 'Compacto', 'Galeria rápida'],
                ].map(([value, label, hint]) => (
                  <label class="flex cursor-pointer items-center justify-between gap-3 rounded-2xl bg-white p-3 shadow-sm dark:bg-zinc-950">
                    <span>
                      <span class="block text-xs font-black text-zinc-950 dark:text-white">{label}</span>
                      <span class="block text-[10px] font-bold uppercase tracking-widest text-zinc-400">{hint}</span>
                    </span>
                    <input type="radio" name="carousel-layout" value={value} checked={value === 'horizontal'} class="accent-red-600" />
                  </label>
                ))}
              </div>
              <button type="button" data-insert-carousel-draft class="mt-5 w-full rounded-2xl bg-red-600 px-4 py-4 text-[10px] font-black uppercase tracking-[0.24em] text-white shadow-xl shadow-red-600/20 transition hover:-translate-y-0.5 hover:bg-red-500">Inserir carrossel</button>
              <p class="mt-3 text-xs font-medium leading-5 text-zinc-400">Depois de inserido, o bloco continua editável no hover: legenda, crédito, ordem, destaque e remoção.</p>
            </aside>
          </section>
        </div>

        <label class="block">
          <span class="sr-only">Resumo editorial</span>
          <textarea data-summary-input class="field-clean w-full resize-none bg-transparent px-6 pt-7 text-lg font-medium leading-8 text-zinc-500 outline-none placeholder:text-zinc-300 dark:text-zinc-400 dark:placeholder:text-zinc-700 md:px-8 md:text-xl" rows="2" placeholder="Escreva um resumo forte para cards, SEO e redes sociais"></textarea>
        </label>

        <div
          data-editor-body
          contenteditable="true"
          data-placeholder='Digite "/" para inserir blocos, imagens, carrossel ou embeds...'
          class="editor-canvas min-h-[700px] px-6 pb-14 pt-5 text-xl leading-9 outline-none md:min-h-[760px] md:px-8"
        ></div>
        <textarea data-editor-output class="hidden" aria-hidden="true"></textarea>
      </section>

      <section class="hidden">
        <label data-drop-zone class="group flex min-h-48 cursor-pointer flex-col items-center justify-center rounded-[2rem] border border-dashed border-zinc-300 bg-white/70 p-6 text-center shadow-[0_18px_55px_rgba(15,23,42,0.06)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-red-600 hover:bg-white hover:shadow-[0_24px_70px_rgba(15,23,42,0.10)] dark:border-zinc-700 dark:bg-zinc-900/70">
          <span class="text-sm font-black text-zinc-950 dark:text-zinc-50">Solte imagens aqui</span>
          <span class="mt-2 max-w-56 text-xs font-medium leading-6 text-zinc-400">Upload com preview, compressão WebP e inserção no ponto do texto.</span>
          <input type="file" accept="image/jpeg,image/png,image/webp" multiple class="sr-only" data-local-image />
        </label>

        <div class="rounded-[2rem] border border-white/80 bg-white/72 p-5 shadow-[0_18px_55px_rgba(15,23,42,0.06)] backdrop-blur-xl dark:border-zinc-800 dark:bg-zinc-900/72 md:col-span-2">
          <div class="flex items-center justify-between">
            <h2 class="text-xs font-black uppercase tracking-[0.24em]">Mídia da matéria</h2>
            <button type="button" data-insert-carousel class="rounded-full bg-red-600 px-4 py-2 text-[9px] font-black uppercase tracking-widest text-white">Criar carrossel</button>
          </div>
          <div data-media-list class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>
          <p class="mt-4 text-xs font-medium text-zinc-400">Arraste mentalmente por enquanto: use subir/descer nos blocos inseridos no texto. Reorder real entra quando conectarmos o CMS.</p>
        </div>
      </section>
    </section>

    <aside data-editor-aside class="space-y-4 xl:sticky xl:top-7 xl:h-[calc(100vh-3.5rem)] xl:overflow-y-auto xl:pr-1">
      <section class="relative overflow-hidden rounded-[1.65rem] bg-[#101010] p-5 text-white shadow-[0_20px_58px_rgba(16,16,16,0.18)] dark:bg-white dark:text-zinc-950">
        <div class="pointer-events-none absolute -right-16 -top-16 h-36 w-36 rounded-full bg-red-500/30 blur-3xl"></div>
        <div class="relative">
        <div class="flex items-center justify-between gap-3">
          <div>
            <h2 class="text-sm font-black uppercase tracking-[0.24em]">Publicação</h2>
            <p class="mt-2 text-xs font-medium text-white/50 dark:text-zinc-500" data-autosave-detail>Autosave ativo</p>
          </div>
          <span class="rounded-full bg-emerald-400/15 px-3 py-1 text-[9px] font-black uppercase tracking-widest text-emerald-300 dark:text-emerald-600">Online</span>
        </div>
        <div class="mt-5 grid gap-2">
          <button type="button" data-save-draft class="rounded-2xl bg-white/10 px-4 py-3 text-[10px] font-black uppercase tracking-widest transition hover:bg-white hover:text-zinc-950 dark:bg-zinc-100 dark:hover:bg-zinc-950 dark:hover:text-white">Salvar rascunho</button>
          <button type="button" data-publish-now class="rounded-2xl bg-[#8A1F2D] px-4 py-3 text-[10px] font-black uppercase tracking-widest text-white transition hover:bg-[#a7273b]">Publicar agora</button>
          <label class="rounded-2xl bg-white/10 p-3 dark:bg-zinc-100">
            <span class="text-[8px] font-black uppercase tracking-widest text-white/40 dark:text-zinc-400">Agendar</span>
            <input type="datetime-local" data-schedule-at class="mt-2 w-full bg-transparent text-xs font-bold outline-none" />
          </label>
          <button type="button" data-schedule-post class="rounded-2xl border border-white/15 px-4 py-3 text-[10px] font-black uppercase tracking-widest transition hover:border-white/50 dark:border-zinc-200">Confirmar agendamento</button>
        </div>
        <div class="mt-4 hidden rounded-2xl border border-white/10 bg-white/10 p-3 text-xs font-bold leading-5 text-white/70 dark:border-zinc-200 dark:bg-zinc-100 dark:text-zinc-600" data-publish-feedback></div>
        </div>
      </section>

      <section class="editor-panel">
        <h2>SEO</h2>
        <div class="rounded-2xl bg-emerald-50 p-3 text-xs font-bold leading-5 text-emerald-700 dark:bg-emerald-950/20 dark:text-emerald-300" data-seo-autofill-note>
          Sugestões automáticas ativas. Edite manualmente quando quiser.
        </div>
        <textarea data-seo-description class="input-soft min-h-28" placeholder="Descrição SEO"></textarea>
        <input data-keywords-input class="input-soft" placeholder="Palavras-chave separadas por vírgula" />
        <div class="rounded-2xl bg-white p-4 shadow-sm dark:bg-zinc-950">
          <span class="text-[10px] text-blue-600">portalnovoalvo.com.br</span>
          <strong class="mt-1 block text-sm text-zinc-900 dark:text-zinc-50" data-google-title>Portal Novo Alvo - título da matéria</strong>
          <p class="mt-1 line-clamp-2 text-xs leading-5 text-zinc-500" data-google-description>Prévia Google será montada com título e descrição.</p>
        </div>
        <div class="h-2 overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-800">
          <div class="h-full w-1/3 rounded-full bg-amber-400 transition-all" data-seo-bar></div>
        </div>
      </section>

      <section class="editor-panel">
        <h2>Capa</h2>
        <label data-cover-drop class="group flex aspect-video cursor-pointer flex-col items-center justify-center overflow-hidden rounded-3xl border border-dashed border-zinc-300 bg-white text-center dark:border-zinc-700 dark:bg-zinc-950">
          <img data-cover-preview alt="" class="hidden h-full w-full object-cover" />
          <span data-cover-empty class="px-6 text-xs font-black uppercase tracking-widest text-zinc-400">Upload ou soltar capa</span>
          <input type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" data-cover-file />
        </label>
        <input data-cover-url class="input-soft" placeholder="URL da capa" />
        <input data-cover-alt class="input-soft" placeholder="Alt text da capa" />
      </section>

      <section class="editor-panel">
        <h2>Tags</h2>
        <div class="flex gap-2">
          <input data-tag-input class="input-soft" placeholder="Adicionar tag" />
          <button type="button" data-add-tag class="rounded-2xl bg-zinc-950 px-4 text-[9px] font-black uppercase tracking-widest text-white dark:bg-white dark:text-zinc-950">Add</button>
        </div>
