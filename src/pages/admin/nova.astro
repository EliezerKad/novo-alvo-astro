---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { categoriesList, subCategoriesList } from '../../lib/news';

const categories = [...categoriesList, ...subCategoriesList];

const slashCommands = [
  { command: '/h2', label: 'Subtítulo H2', action: 'h2', hint: 'Abre uma nova seção editorial' },
  { command: '/h3', label: 'Intertítulo H3', action: 'h3', hint: 'Organiza um trecho curto' },
  { command: '/quote', label: 'Citação', action: 'quote', hint: 'Destaca fala ou dado importante' },
  { command: '/imagem', label: 'Imagem', action: 'image', hint: 'Insere a próxima imagem no texto' },
  { command: '/youtube', label: 'YouTube', action: 'youtube', hint: 'Cole o link do vídeo' },
  { command: '/tweet', label: 'Tweet / X', action: 'tweet', hint: 'Cole o link do post' },
  { command: '/carrossel', label: 'Carrossel', action: 'carousel', hint: 'Cria bloco visual com múltiplas imagens' },
  { command: '/embed', label: 'Embed', action: 'embed', hint: 'Insere URL ou iframe confiável' },
];

const aiActions = [
  'Sugerir título',
  'Criar resumo',
  'Resumir texto',
  'Melhorar escrita',
  'Gerar subtítulo',
  'Criar chamada push',
  'Legenda Instagram',
  'SEO automático',
];
---

<AdminLayout title="Nova matéria | Admin Novo Alvo" active="new">
  <form class="editor-studio grid gap-6 xl:grid-cols-[minmax(0,1fr)_360px] 2xl:grid-cols-[minmax(0,1fr)_390px]">
    <section class="min-w-0 space-y-6">
      <header class="relative overflow-hidden rounded-[2.25rem] border border-white/70 bg-white/85 p-5 shadow-[0_24px_80px_rgba(15,23,42,0.08)] backdrop-blur-2xl dark:border-zinc-800 dark:bg-zinc-900/80">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="rounded-full bg-red-600 px-3 py-1.5 text-[9px] font-black uppercase tracking-[0.24em] text-white">Redação</span>
            <span class="text-[11px] font-bold text-zinc-400" data-autosave-status>salvo agora</span>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <button type="button" data-focus-mode class="rounded-full border border-zinc-200 bg-white px-4 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-500 shadow-sm transition hover:border-zinc-950 hover:text-zinc-950 dark:border-zinc-800 dark:bg-zinc-950 dark:hover:border-white dark:hover:text-white">
              Modo foco
            </button>
            <button type="button" data-open-preview class="rounded-full bg-zinc-950 px-4 py-2 text-[9px] font-black uppercase tracking-widest text-white transition hover:bg-red-600 dark:bg-white dark:text-zinc-950">
              Preview
            </button>
          </div>
        </div>

        <label class="mt-8 block">
          <span class="sr-only">Título</span>
          <textarea
            data-title-input
            rows="1"
            class="field-clean w-full resize-none bg-transparent font-serif text-5xl font-black italic leading-[0.95] tracking-tighter outline-none placeholder:text-zinc-300 md:text-7xl dark:placeholder:text-zinc-700"
            placeholder="Título da matéria"
          ></textarea>
        </label>

        <div class="mt-5 grid gap-3 text-[11px] font-black uppercase tracking-widest text-zinc-400 md:grid-cols-5">
          <label class="rounded-2xl bg-zinc-50 px-4 py-3 dark:bg-zinc-950/70">
            <span class="block text-[8px] text-zinc-300">Slug</span>
            <input data-slug-input class="mt-1 w-full bg-transparent lowercase text-zinc-700 outline-none dark:text-zinc-200" placeholder="slug-automatico" />
          </label>
          <label class="rounded-2xl bg-zinc-50 px-4 py-3 dark:bg-zinc-950/70">
            <span class="block text-[8px] text-zinc-300">Categoria</span>
            <select data-category-input class="mt-1 w-full bg-transparent text-zinc-700 outline-none dark:text-zinc-200">
              {categories.map((category) => <option>{category}</option>)}
            </select>
          </label>
          <label class="rounded-2xl bg-zinc-50 px-4 py-3 dark:bg-zinc-950/70">
            <span class="block text-[8px] text-zinc-300">Autor</span>
            <input class="mt-1 w-full bg-transparent text-zinc-700 outline-none dark:text-zinc-200" value="Redação Novo Alvo" />
          </label>
          <div class="rounded-2xl bg-zinc-50 px-4 py-3 dark:bg-zinc-950/70">
            <span class="block text-[8px] text-zinc-300">Status</span>
            <strong class="mt-1 block text-zinc-700 dark:text-zinc-200" data-editor-status>Rascunho</strong>
          </div>
          <div class="rounded-2xl bg-zinc-50 px-4 py-3 dark:bg-zinc-950/70">
            <span class="block text-[8px] text-zinc-300">Data</span>
            <strong class="mt-1 block text-zinc-700 dark:text-zinc-200" data-current-date>Hoje</strong>
          </div>
        </div>
      </header>

      <section class="relative overflow-hidden rounded-[2.25rem] border border-white/70 bg-white/90 shadow-[0_24px_80px_rgba(15,23,42,0.08)] backdrop-blur-2xl dark:border-zinc-800 dark:bg-zinc-900/80">
        <div class="flex flex-wrap items-center gap-3 border-b border-zinc-100 px-5 py-4 dark:border-zinc-800">
          <div class="flex items-center gap-2 rounded-full bg-zinc-50 p-1 dark:bg-zinc-950">
            {['bold', 'italic', 'link', 'quote', 'highlight', 'comment'].map((action) => (
              <button type="button" data-format={action} class="rounded-full px-3 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-500 transition hover:bg-white hover:text-red-600 hover:shadow-sm dark:hover:bg-zinc-900">
                {action === 'bold' ? 'B' : action === 'italic' ? 'I' : action === 'link' ? 'Link' : action === 'quote' ? 'Quote' : action === 'highlight' ? 'Destaque' : 'Comentário'}
              </button>
            ))}
          </div>
          <div class="ml-auto text-[11px] font-bold text-zinc-400" data-editor-stats>
            0 palavras • leitura de 0 min • SEO inicial
          </div>
        </div>

        <div
          data-floating-toolbar
          class="pointer-events-auto fixed z-50 hidden -translate-x-1/2 rounded-full border border-zinc-200 bg-zinc-950 p-1 text-white shadow-2xl shadow-zinc-950/20 dark:border-zinc-700"
        >
          {['bold', 'italic', 'link', 'quote', 'highlight', 'comment'].map((action) => (
            <button type="button" data-format={action} class="rounded-full px-3 py-2 text-[9px] font-black uppercase tracking-widest transition hover:bg-white hover:text-zinc-950">
              {action === 'bold' ? 'B' : action === 'italic' ? 'I' : action === 'link' ? 'Link' : action === 'quote' ? 'Quote' : action === 'highlight' ? 'Mark' : 'Nota'}
            </button>
          ))}
        </div>

        <div
          data-media-toolbar
          class="pointer-events-auto fixed z-50 hidden -translate-x-1/2 items-center gap-1 rounded-full border border-zinc-200 bg-white/95 p-1 text-zinc-700 shadow-2xl shadow-zinc-950/15 backdrop-blur-xl dark:border-zinc-800 dark:bg-zinc-950/95 dark:text-zinc-200"
        >
          <button type="button" data-media-align="left" class="rounded-full px-3 py-2 text-[9px] font-black uppercase tracking-widest transition hover:bg-zinc-950 hover:text-white dark:hover:bg-white dark:hover:text-zinc-950">Esq.</button>
          <button type="button" data-media-align="center" class="rounded-full px-3 py-2 text-[9px] font-black uppercase tracking-widest transition hover:bg-zinc-950 hover:text-white dark:hover:bg-white dark:hover:text-zinc-950">Centro</button>
          <button type="button" data-media-align="right" class="rounded-full px-3 py-2 text-[9px] font-black uppercase tracking-widest transition hover:bg-zinc-950 hover:text-white dark:hover:bg-white dark:hover:text-zinc-950">Dir.</button>
          <span class="mx-1 h-6 w-px bg-zinc-200 dark:bg-zinc-800"></span>
          <button type="button" data-media-size="small" class="rounded-full px-3 py-2 text-[9px] font-black uppercase tracking-widest transition hover:bg-red-600 hover:text-white">P</button>
          <button type="button" data-media-size="medium" class="rounded-full px-3 py-2 text-[9px] font-black uppercase tracking-widest transition hover:bg-red-600 hover:text-white">M</button>
          <button type="button" data-media-size="large" class="rounded-full px-3 py-2 text-[9px] font-black uppercase tracking-widest transition hover:bg-red-600 hover:text-white">G</button>
          <span class="mx-1 hidden text-[9px] font-bold text-zinc-400 md:inline">arraste a borda</span>
        </div>

        <div
          data-slash-palette
          class="absolute left-8 top-24 z-30 hidden w-[min(420px,calc(100%-4rem))] overflow-hidden rounded-3xl border border-zinc-200 bg-white p-2 shadow-2xl shadow-zinc-950/10 dark:border-zinc-800 dark:bg-zinc-950"
        >
          {slashCommands.map((item) => (
            <button type="button" data-slash-action={item.action} class="flex w-full items-center justify-between gap-4 rounded-2xl px-4 py-3 text-left transition hover:bg-zinc-50 dark:hover:bg-zinc-900">
              <span>
                <span class="block text-sm font-black text-zinc-950 dark:text-zinc-50">{item.label}</span>
                <span class="block text-xs font-medium text-zinc-400">{item.command} • {item.hint}</span>
              </span>
              <span class="text-red-600">↵</span>
            </button>
          ))}
        </div>

        <label class="block">
          <span class="sr-only">Resumo editorial</span>
          <textarea data-summary-input class="field-clean w-full resize-none bg-transparent px-8 pt-8 text-xl font-medium leading-8 text-zinc-500 outline-none placeholder:text-zinc-300 dark:text-zinc-400 dark:placeholder:text-zinc-700" rows="2" placeholder="Escreva um resumo forte para cards, SEO e redes sociais"></textarea>
        </label>

        <div
          data-editor-body
          contenteditable="true"
          data-placeholder='Digite "/" para inserir blocos, imagens, carrossel ou embeds...'
          class="editor-canvas min-h-[760px] px-8 pb-14 pt-5 text-xl leading-9 outline-none"
        ></div>
        <textarea data-editor-output class="hidden" aria-hidden="true"></textarea>
      </section>

      <section class="grid gap-4 md:grid-cols-3">
        <label data-drop-zone class="group flex min-h-48 cursor-pointer flex-col items-center justify-center rounded-[2rem] border border-dashed border-zinc-300 bg-white/70 p-6 text-center shadow-sm transition hover:border-red-600 hover:bg-white dark:border-zinc-700 dark:bg-zinc-900/70">
          <span class="text-sm font-black text-zinc-950 dark:text-zinc-50">Solte imagens aqui</span>
          <span class="mt-2 max-w-56 text-xs font-medium leading-6 text-zinc-400">Upload com preview, compressão WebP e inserção no ponto do texto.</span>
          <input type="file" accept="image/jpeg,image/png,image/webp" multiple class="sr-only" data-local-image />
        </label>

        <div class="rounded-[2rem] bg-white/80 p-5 shadow-sm dark:bg-zinc-900/80 md:col-span-2">
          <div class="flex items-center justify-between">
            <h2 class="text-xs font-black uppercase tracking-[0.24em]">Mídia da matéria</h2>
            <button type="button" data-insert-carousel class="rounded-full bg-red-600 px-4 py-2 text-[9px] font-black uppercase tracking-widest text-white">Criar carrossel</button>
          </div>
          <div data-media-list class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>
          <p class="mt-4 text-xs font-medium text-zinc-400">Arraste mentalmente por enquanto: use subir/descer nos blocos inseridos no texto. Reorder real entra quando conectarmos o CMS.</p>
        </div>
      </section>
    </section>

    <aside data-editor-aside class="space-y-4 xl:sticky xl:top-7 xl:h-[calc(100vh-3.5rem)] xl:overflow-y-auto xl:pr-1">
      <section class="rounded-[2rem] bg-zinc-950 p-5 text-white shadow-2xl shadow-zinc-950/20 dark:bg-white dark:text-zinc-950">
        <div class="flex items-center justify-between gap-3">
          <div>
            <h2 class="text-sm font-black uppercase tracking-[0.24em]">Publicação</h2>
            <p class="mt-2 text-xs font-medium text-white/50 dark:text-zinc-500" data-autosave-detail>Autosave ativo</p>
          </div>
          <span class="rounded-full bg-emerald-400/15 px-3 py-1 text-[9px] font-black uppercase tracking-widest text-emerald-300 dark:text-emerald-600">Online</span>
        </div>
        <div class="mt-5 grid gap-2">
          <button type="button" data-save-draft class="rounded-2xl bg-white/10 px-4 py-3 text-[10px] font-black uppercase tracking-widest transition hover:bg-white hover:text-zinc-950 dark:bg-zinc-100 dark:hover:bg-zinc-950 dark:hover:text-white">Salvar rascunho</button>
          <button type="button" data-publish-now class="rounded-2xl bg-red-600 px-4 py-3 text-[10px] font-black uppercase tracking-widest text-white transition hover:bg-red-500">Publicar agora</button>
          <label class="rounded-2xl bg-white/10 p-3 dark:bg-zinc-100">
            <span class="text-[8px] font-black uppercase tracking-widest text-white/40 dark:text-zinc-400">Agendar</span>
            <input type="datetime-local" data-schedule-at class="mt-2 w-full bg-transparent text-xs font-bold outline-none" />
          </label>
          <button type="button" data-schedule-post class="rounded-2xl border border-white/15 px-4 py-3 text-[10px] font-black uppercase tracking-widest transition hover:border-white/50 dark:border-zinc-200">Confirmar agendamento</button>
        </div>
      </section>

      <section class="editor-panel">
        <h2>SEO</h2>
        <div class="rounded-2xl bg-emerald-50 p-3 text-xs font-bold leading-5 text-emerald-700 dark:bg-emerald-950/20 dark:text-emerald-300" data-seo-autofill-note>
          Sugestões automáticas ativas. Edite manualmente quando quiser.
        </div>
        <textarea data-seo-description class="input-soft min-h-28" placeholder="Descrição SEO"></textarea>
        <input data-keywords-input class="input-soft" placeholder="Palavras-chave separadas por vírgula" />
        <div class="rounded-2xl bg-white p-4 shadow-sm dark:bg-zinc-950">
          <span class="text-[10px] text-blue-600">portalnovoalvo.com.br</span>
          <strong class="mt-1 block text-sm text-zinc-900 dark:text-zinc-50" data-google-title>Portal Novo Alvo - título da matéria</strong>
          <p class="mt-1 line-clamp-2 text-xs leading-5 text-zinc-500" data-google-description>Prévia Google será montada com título e descrição.</p>
        </div>
        <div class="h-2 overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-800">
          <div class="h-full w-1/3 rounded-full bg-amber-400 transition-all" data-seo-bar></div>
        </div>
      </section>

      <section class="editor-panel">
        <h2>Capa</h2>
        <label data-cover-drop class="group flex aspect-video cursor-pointer flex-col items-center justify-center overflow-hidden rounded-3xl border border-dashed border-zinc-300 bg-white text-center dark:border-zinc-700 dark:bg-zinc-950">
          <img data-cover-preview alt="" class="hidden h-full w-full object-cover" />
          <span data-cover-empty class="px-6 text-xs font-black uppercase tracking-widest text-zinc-400">Upload ou soltar capa</span>
          <input type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" data-cover-file />
        </label>
        <input data-cover-url class="input-soft" placeholder="URL da capa" />
        <input data-cover-alt class="input-soft" placeholder="Alt text da capa" />
      </section>

      <section class="editor-panel">
        <h2>Tags</h2>
        <div class="flex gap-2">
          <input data-tag-input class="input-soft" placeholder="Adicionar tag" />
          <button type="button" data-add-tag class="rounded-2xl bg-zinc-950 px-4 text-[9px] font-black uppercase tracking-widest text-white dark:bg-white dark:text-zinc-950">Add</button>
        </div>
        <div data-tag-list class="flex flex-wrap gap-2"></div>
      </section>

      <section class="editor-panel">
        <h2>Fontes</h2>
        <input data-source-name class="input-soft" placeholder="Nome da fonte" />
        <input data-source-url class="input-soft" placeholder="URL" />
        <textarea data-source-note class="input-soft min-h-20" placeholder="Observação editorial"></textarea>
        <button type="button" data-add-source class="rounded-2xl border border-zinc-200 px-4 py-3 text-[9px] font-black uppercase tracking-widest text-zinc-500 transition hover:border-red-600 hover:text-red-600 dark:border-zinc-800">Adicionar fonte</button>
        <div data-source-list class="space-y-2"></div>
        <textarea data-sources-output class="hidden" aria-hidden="true"></textarea>
      </section>

      <section class="editor-panel">
        <h2>IA editorial</h2>
        <div class="grid gap-2">
          {aiActions.map((action) => (
            <button type="button" data-ai-action={action} class="rounded-2xl bg-white px-4 py-3 text-left text-[10px] font-black uppercase tracking-widest text-zinc-600 transition hover:bg-red-600 hover:text-white dark:bg-zinc-950 dark:text-zinc-300">
              {action}
            </button>
          ))}
        </div>
        <div data-ai-output class="hidden rounded-3xl bg-white p-4 text-sm leading-6 text-zinc-600 shadow-sm dark:bg-zinc-950 dark:text-zinc-300"></div>
      </section>
    </aside>
  </form>

  <section data-preview-modal class="fixed inset-0 z-[80] hidden bg-zinc-950/70 p-3 backdrop-blur-xl md:p-6">
    <div class="mx-auto flex h-full max-w-6xl flex-col overflow-hidden rounded-[2rem] bg-white shadow-2xl dark:bg-zinc-950">
      <div class="flex items-center justify-between gap-4 border-b border-zinc-100 px-5 py-4 dark:border-zinc-800">
        <div>
          <span class="text-[9px] font-black uppercase tracking-[0.28em] text-red-600">Preview real</span>
          <p class="mt-1 text-xs font-bold text-zinc-400">Simula a página pública da matéria com o conteúdo atual do editor.</p>
        </div>
        <button type="button" data-close-preview class="rounded-full bg-zinc-950 px-4 py-2 text-[9px] font-black uppercase tracking-widest text-white transition hover:bg-red-600 dark:bg-white dark:text-zinc-950">
          Fechar
        </button>
      </div>

      <article class="overflow-y-auto bg-white px-4 py-8 dark:bg-zinc-950 md:px-10">
        <header class="mx-auto max-w-5xl">
          <span data-preview-category class="inline-flex rounded-lg bg-red-600 px-4 py-1.5 text-[10px] font-black uppercase tracking-widest text-white">Categoria</span>
          <h1 data-preview-title class="mt-8 font-serif text-4xl font-black leading-none tracking-tighter text-zinc-950 dark:text-zinc-50 md:text-6xl lg:text-7xl">Título da matéria</h1>
          <p data-preview-summary class="mt-8 max-w-4xl text-2xl font-medium italic leading-tight text-zinc-500 dark:text-zinc-400">Resumo editorial da matéria.</p>
          <div class="mt-6 flex flex-wrap gap-4 text-[10px] font-black uppercase tracking-widest text-zinc-400">
            <span>Por Redação Novo Alvo</span>
            <span data-preview-date>Hoje</span>
            <span data-preview-reading>0 min de leitura</span>
          </div>
          <figure data-preview-cover-wrap class="mt-10 hidden overflow-hidden rounded-[2.5rem] shadow-2xl">
            <img data-preview-cover alt="" class="aspect-[21/9] w-full object-cover" />
          </figure>
        </header>

        <div data-preview-content class="article-preview prose prose-xl prose-zinc mx-auto mt-12 max-w-4xl dark:prose-invert"></div>

        <footer class="mx-auto mt-10 flex max-w-4xl flex-wrap gap-2 border-t border-zinc-100 pt-6 dark:border-zinc-800" data-preview-sources></footer>
      </article>
    </div>
  </section>

  <style is:inline>
    .field-clean {
      scrollbar-width: none;
    }

    .field-clean::-webkit-scrollbar {
      display: none;
    }

    .input-soft {
      width: 100%;
      border-radius: 1rem;
      border: 1px solid rgb(228 228 231);
      background: rgba(255, 255, 255, 0.75);
      padding: 0.85rem 1rem;
      font-size: 0.875rem;
      font-weight: 600;
      outline: none;
    }

    .dark .input-soft {
      border-color: rgb(39 39 42);
      background: rgba(9, 9, 11, 0.75);
    }

    .editor-panel {
      border: 1px solid rgba(228, 228, 231, 0.8);
      border-radius: 2rem;
      background: rgba(255, 255, 255, 0.78);
      box-shadow: 0 16px 50px rgba(15, 23, 42, 0.06);
      display: grid;
      gap: 0.85rem;
      padding: 1.25rem;
    }

    .dark .editor-panel {
      border-color: rgb(39 39 42);
      background: rgba(24, 24, 27, 0.76);
    }

    .editor-panel h2 {
      font-size: 0.75rem;
      font-weight: 900;
      letter-spacing: 0.24em;
      text-transform: uppercase;
    }

    [data-editor-body]:empty::before {
      color: rgb(161 161 170);
      content: attr(data-placeholder);
      pointer-events: none;
    }

    .editor-canvas {
      color: rgb(39 39 42);
      font-family: Georgia, 'Times New Roman', serif;
    }

    .dark .editor-canvas {
      color: rgb(228 228 231);
    }

    .editor-canvas p {
      margin: 1.4rem 0;
    }

    .editor-canvas h2 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(2.3rem, 4vw, 3.6rem);
      font-style: italic;
      font-weight: 900;
      letter-spacing: -0.04em;
      line-height: 1;
      margin: 4rem 0 1.5rem;
    }

    .editor-canvas h3 {
      font-family: Inter, system-ui, sans-serif;
      font-size: 1.55rem;
      font-weight: 900;
      margin: 3rem 0 1rem;
    }

    .editor-canvas blockquote {
      border-left: 4px solid rgb(220 38 38);
      color: rgb(82 82 91);
      font-size: 1.45rem;
      font-style: italic;
      margin: 2.5rem 0;
      padding-left: 1.5rem;
    }

    .editor-canvas mark {
      border-radius: 0.45rem;
      background: rgb(254 240 138);
      padding: 0.05rem 0.28rem;
    }

    .editor-canvas [data-editor-media] {
      border-radius: 1.75rem;
      cursor: pointer;
      margin: 2.5rem 0;
      max-width: 100%;
      min-width: min(260px, 100%);
      overflow: auto;
      position: relative;
      resize: horizontal;
      width: 100%;
    }

    .dark .editor-canvas [data-editor-media] {
    }

    .editor-canvas [data-editor-media].is-selected {
      box-shadow: 0 0 0 5px rgba(220, 38, 38, 0.12);
    }

    .editor-canvas [data-editor-media].is-selected::after {
      align-items: center;
      background: rgb(220 38 38);
      border-radius: 999px;
      bottom: 0.6rem;
      color: white;
      content: "arraste";
      display: flex;
      font-family: Inter, system-ui, sans-serif;
      font-size: 0.55rem;
      font-weight: 900;
      letter-spacing: 0.16em;
      padding: 0.35rem 0.55rem;
      pointer-events: none;
      position: absolute;
      right: 0.6rem;
      text-transform: uppercase;
    }

    .editor-canvas [data-align="left"] {
      float: left;
      margin: 0.55rem 2rem 1.25rem 0;
    }

    .editor-canvas [data-align="center"] {
      clear: both;
      float: none;
      margin-left: auto;
      margin-right: auto;
    }

    .editor-canvas [data-align="right"] {
      float: right;
      margin: 0.55rem 0 1.25rem 2rem;
    }

    .editor-canvas [data-media-size="small"] {
      width: min(22rem, 48%);
    }

    .editor-canvas [data-media-size="medium"] {
      width: min(34rem, 64%);
    }

    .editor-canvas [data-media-size="large"] {
      width: 100%;
    }

    .editor-canvas img {
      border-radius: 1.25rem;
      display: block;
      width: 100%;
    }

    .editor-canvas figcaption {
      color: rgb(113 113 122);
      font-family: Inter, system-ui, sans-serif;
      font-size: 0.8rem;
      font-style: italic;
      margin-top: 0.65rem;
      text-align: center;
    }

    .editor-canvas .editor-note {
      border-radius: 1rem;
      background: rgb(254 242 242);
      color: rgb(185 28 28);
      font-family: Inter, system-ui, sans-serif;
      font-size: 0.85rem;
      font-weight: 800;
      padding: 0.9rem 1rem;
    }

    .editor-canvas .embed-card {
      border-radius: 1.25rem;
      border: 1px solid rgb(228 228 231);
      display: block;
      font-family: Inter, system-ui, sans-serif;
      font-size: 0.8rem;
      font-weight: 900;
      letter-spacing: 0.12em;
      padding: 1.1rem;
      text-transform: uppercase;
    }

    .article-preview {
      color: rgb(39 39 42);
      font-family: Georgia, 'Times New Roman', serif;
      overflow: visible;
    }

    .article-preview::after {
      clear: both;
      content: "";
      display: table;
    }

    .article-preview h2 {
      border-left: 4px solid rgb(220 38 38);
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(2.4rem, 5vw, 4rem);
      font-style: italic;
      font-weight: 900;
      letter-spacing: -0.04em;
      line-height: 1;
      margin-top: 5rem;
      padding-left: 1.5rem;
    }

    .article-preview p {
      line-height: 1.85;
      margin-bottom: 2rem;
    }

    .article-preview [data-editor-media] {
      border: 0 !important;
      box-shadow: none !important;
      max-width: 100%;
      min-width: min(220px, 100%);
      overflow: visible;
      padding: 0 !important;
      resize: none;
    }

    .article-preview [data-editor-media]::after {
      content: none !important;
    }

    .article-preview [data-align="left"] {
      float: left;
      margin: 0.45rem 2rem 1.25rem 0;
    }

    .article-preview [data-align="center"] {
      clear: both;
      float: none;
      margin-left: auto;
      margin-right: auto;
    }

    .article-preview [data-align="right"] {
      float: right;
      margin: 0.45rem 0 1.25rem 2rem;
    }

    .article-preview [data-media-size="small"] {
      width: min(22rem, 48%);
    }

    .article-preview [data-media-size="medium"] {
      width: min(34rem, 64%);
    }

    .article-preview [data-media-size="large"] {
      width: 100%;
    }

    .article-preview img {
      border-radius: 1.5rem;
      display: block;
      width: 100%;
    }

    .article-preview figcaption {
      color: rgb(113 113 122);
      font-family: Inter, system-ui, sans-serif;
      font-size: 0.75rem;
      font-style: italic;
      margin-top: 0.65rem;
      text-align: center;
    }

    @media (max-width: 760px) {
      .editor-canvas [data-align],
      .article-preview [data-align] {
        clear: both;
        float: none;
        margin-left: auto;
        margin-right: auto;
        width: 100% !important;
      }
    }
  </style>

  <script is:inline>
    (() => {
      const editor = document.querySelector('[data-editor-body]');
      if (!editor) return;

      const output = document.querySelector('[data-editor-output]');
      const titleInput = document.querySelector('[data-title-input]');
      const slugInput = document.querySelector('[data-slug-input]');
      const summaryInput = document.querySelector('[data-summary-input]');
      const stats = document.querySelector('[data-editor-stats]');
      const status = document.querySelector('[data-editor-status]');
      const floatingToolbar = document.querySelector('[data-floating-toolbar]');
      const mediaToolbar = document.querySelector('[data-media-toolbar]');
      const slashPalette = document.querySelector('[data-slash-palette]');
      const autosave = document.querySelector('[data-autosave-status]');
      const autosaveDetail = document.querySelector('[data-autosave-detail]');
      const mediaList = document.querySelector('[data-media-list]');
      const sourcesOutput = document.querySelector('[data-sources-output]');
      const sourceList = document.querySelector('[data-source-list]');
      const tagList = document.querySelector('[data-tag-list]');
      const googleTitle = document.querySelector('[data-google-title]');
      const googleDescription = document.querySelector('[data-google-description]');
      const seoBar = document.querySelector('[data-seo-bar]');
      const previewModal = document.querySelector('[data-preview-modal]');
      const previewContent = document.querySelector('[data-preview-content]');
      const previewTitle = document.querySelector('[data-preview-title]');
      const previewSummary = document.querySelector('[data-preview-summary]');
      const previewCategory = document.querySelector('[data-preview-category]');
      const previewCover = document.querySelector('[data-preview-cover]');
      const previewCoverWrap = document.querySelector('[data-preview-cover-wrap]');
      const previewSources = document.querySelector('[data-preview-sources]');
      const previewReading = document.querySelector('[data-preview-reading]');
      const categoryInput = document.querySelector('[data-category-input]');
      const seoDescriptionInput = document.querySelector('[data-seo-description]');
      const keywordsInput = document.querySelector('[data-keywords-input]');
      const seoAutofillNote = document.querySelector('[data-seo-autofill-note]');
      const aiOutput = document.querySelector('[data-ai-output]');

      let savedRange = null;
      let slashRange = null;
      let selectedMedia = null;
      let autosaveTimer = null;
      let seoTouched = false;
      let keywordsTouched = false;
      const mediaItems = [];
      const sources = [];
      const tags = [];
      const categoryKeywordMap = {
        Política: ['política brasileira', 'governo', 'congresso', 'poder público', 'Portal Novo Alvo'],
        Economia: ['economia', 'mercado', 'negócios', 'finanças', 'Portal Novo Alvo'],
        Brasil: ['Brasil', 'notícias do Brasil', 'sociedade', 'atualidade', 'Portal Novo Alvo'],
        Mundo: ['mundo', 'internacional', 'geopolítica', 'notícias internacionais', 'Portal Novo Alvo'],
        Saúde: ['saúde', 'bem-estar', 'hospitais', 'medicina', 'Portal Novo Alvo'],
        Tecnologia: ['tecnologia', 'inovação', 'inteligência artificial', 'internet', 'Portal Novo Alvo'],
        Esportes: ['esportes', 'futebol', 'clubes', 'competição', 'Portal Novo Alvo'],
        Famosos: ['famosos', 'celebridades', 'entretenimento', 'cultura pop', 'Portal Novo Alvo'],
        Entretenimento: ['entretenimento', 'cultura', 'streaming', 'agenda cultural', 'Portal Novo Alvo'],
        Ciência: ['ciência', 'pesquisa', 'descobertas', 'inovação científica', 'Portal Novo Alvo'],
        Educação: ['educação', 'ensino', 'estudantes', 'aprendizagem', 'Portal Novo Alvo'],
        Cultura: ['cultura', 'arte', 'comportamento', 'produção cultural', 'Portal Novo Alvo'],
        Lifestyle: ['lifestyle', 'comportamento', 'tendências', 'vida cotidiana', 'Portal Novo Alvo'],
        Games: ['games', 'jogos', 'eSports', 'tecnologia gamer', 'Portal Novo Alvo'],
        Moda: ['moda', 'estilo', 'tendências', 'comportamento', 'Portal Novo Alvo'],
        Música: ['música', 'artistas', 'shows', 'indústria musical', 'Portal Novo Alvo'],
        Futebol: ['futebol', 'clubes brasileiros', 'campeonatos', 'esporte nacional', 'Portal Novo Alvo'],
        Entrevistas: ['entrevistas', 'personagens', 'bastidores', 'declarações', 'Portal Novo Alvo'],
      };
      const stopWords = new Set([
        'para', 'como', 'com', 'uma', 'umas', 'uns', 'dos', 'das', 'que', 'por', 'sobre', 'entre', 'mais', 'menos',
        'esta', 'este', 'essa', 'esse', 'isso', 'ainda', 'também', 'pela', 'pelo', 'nas', 'nos', 'aos', 'aqui',
        'portal', 'novo', 'alvo', 'notícia', 'noticias', 'matéria', 'materia', 'ser', 'foi', 'são', 'sao', 'tem',
      ]);

      const escapeHtml = (value) =>
        String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');

      const slugify = (value) =>
        String(value || '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '')
          .slice(0, 90);

      const setStatus = (value) => {
        if (status) status.textContent = value;
      };

      const saveSelection = () => {
        const selection = window.getSelection();
        if (!selection || selection.rangeCount === 0) return;
        const range = selection.getRangeAt(0);
        if (editor.contains(range.commonAncestorContainer)) savedRange = range.cloneRange();
      };

      const restoreSelection = () => {
        editor.focus();
        if (!savedRange) return;
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(savedRange);
      };

      const runCommand = (command, value = null) => {
        const commandRunner = Reflect.get(document, 'execCommand')?.bind(document);
        if (!commandRunner) return false;
        return commandRunner(command, false, value);
      };

      const insertHtml = (html) => {
        restoreSelection();
        runCommand('insertHTML', html);
        updateEditorState();
      };

      const insertHtmlAtSlash = (html) => {
        if (slashRange) savedRange = slashRange.cloneRange();
        restoreSelection();
        runCommand('insertHTML', html);
        slashRange = null;
        slashPalette?.classList.add('hidden');
        updateEditorState();
      };

      const syncOutput = () => {
        if (output) output.value = editor.innerHTML.trim();
        if (sourcesOutput) sourcesOutput.value = JSON.stringify(sources);
      };

      const scoreSeo = (words) => {
        let score = 20;
        if ((titleInput?.value || '').length >= 35) score += 20;
        if ((summaryInput?.value || '').length >= 80) score += 15;
        if (words >= 450) score += 20;
        if (tags.length >= 3) score += 10;
        if (sources.length >= 1) score += 10;
        if (mediaItems.length >= 1) score += 5;
        return Math.min(100, score);
      };

      const normalizeText = (value) =>
        String(value || '')
          .replace(/\s+/g, ' ')
          .trim();

      const clampSentence = (value, max = 158) => {
        const clean = normalizeText(value);
        if (clean.length <= max) return clean;
        const cut = clean.slice(0, max - 1);
        const lastSpace = cut.lastIndexOf(' ');
        return `${cut.slice(0, lastSpace > 90 ? lastSpace : max - 1).replace(/[,.!?;:]$/, '')}…`;
      };

      const getPlainText = () => normalizeText(editor.innerText.replace(/\s*\/\s*$/, ''));

      const extractTopTerms = () => {
        const text = `${titleInput?.value || ''} ${summaryInput?.value || ''} ${getPlainText()}`;
        const counts = new Map();
        text
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9\s-]/g, ' ')
          .split(/\s+/)
          .filter((word) => word.length > 3 && !stopWords.has(word))
          .forEach((word) => counts.set(word, (counts.get(word) || 0) + 1));
        return [...counts.entries()]
          .sort((a, b) => b[1] - a[1])
          .slice(0, 8)
          .map(([word]) => word);
      };

      const buildSeoDescription = () => {
        const category = categoryInput?.value || '';
        const title = normalizeText(titleInput?.value);
        const summary = normalizeText(summaryInput?.value);
        const body = getPlainText();
        const firstSentence = body.split(/(?<=[.!?])\s+/).find((sentence) => sentence.length > 45) || body;
        const base = summary || firstSentence || title;
        if (!base) return '';
        const categoryPrefix = category ? `${category}: ` : '';
        const description = `${categoryPrefix}${base}`;
        return clampSentence(description, 158);
      };

      const buildKeywords = () => {
        const category = categoryInput?.value || '';
        const titleWords = normalizeText(titleInput?.value)
          .split(/\s+/)
          .filter((word) => word.length > 3)
          .slice(0, 4)
          .join(' ');
        return [
          category,
          titleWords,
          ...(categoryKeywordMap[category] || []),
          ...extractTopTerms(),
          ...tags,
        ]
          .map((keyword) => normalizeText(keyword))
          .filter(Boolean)
          .filter((keyword, index, list) => list.findIndex((item) => item.toLowerCase() === keyword.toLowerCase()) === index)
          .slice(0, 12)
          .join(', ');
      };

      const autofillSeo = () => {
        if (!seoTouched && seoDescriptionInput) {
          const description = buildSeoDescription();
          if (description) seoDescriptionInput.value = description;
        }
        if (!keywordsTouched && keywordsInput) {
          const keywords = buildKeywords();
          if (keywords) keywordsInput.value = keywords;
        }
        if (seoAutofillNote) {
          seoAutofillNote.textContent = seoTouched || keywordsTouched
            ? 'Sugestões automáticas pausadas nos campos editados manualmente.'
            : 'Sugestões automáticas ativas com base no título, categoria e texto.';
        }
      };

      const updateEditorState = () => {
        const words = editor.innerText.trim().split(/\s+/).filter(Boolean).length;
        const reading = Math.max(0, Math.ceil(words / 220));
        const seo = scoreSeo(words);
        const seoText = seo >= 75 ? 'SEO bom' : seo >= 50 ? 'SEO em ajuste' : 'SEO inicial';
        if (stats) stats.textContent = `${words.toLocaleString('pt-BR')} palavras • leitura de ${reading} min • ${seoText}`;
        if (seoBar) {
          seoBar.style.width = `${seo}%`;
          seoBar.className = `h-full rounded-full transition-all ${seo >= 75 ? 'bg-emerald-500' : seo >= 50 ? 'bg-amber-400' : 'bg-red-500'}`;
        }
        autofillSeo();
        if (googleTitle) googleTitle.textContent = titleInput?.value ? `Portal Novo Alvo - ${titleInput.value}` : 'Portal Novo Alvo - título da matéria';
        if (googleDescription) googleDescription.textContent = seoDescriptionInput?.value || summaryInput?.value || 'Prévia Google será montada com título e descrição.';
        syncOutput();
        scheduleAutosave();
      };

      const getReadingTime = () => {
        const words = editor.innerText.trim().split(/\s+/).filter(Boolean).length;
        return Math.max(0, Math.ceil(words / 220));
      };

      const openPreview = () => {
        const clone = editor.cloneNode(true);
        clone.querySelectorAll('.is-selected').forEach((node) => node.classList.remove('is-selected'));
        clone.querySelectorAll('[contenteditable]').forEach((node) => node.removeAttribute('contenteditable'));

        if (previewTitle) previewTitle.textContent = titleInput?.value || 'Título da matéria';
        if (previewSummary) previewSummary.textContent = summaryInput?.value || 'Resumo editorial da matéria.';
        if (previewCategory) previewCategory.textContent = categoryInput?.value || 'Categoria';
        if (previewReading) previewReading.textContent = `${getReadingTime()} min de leitura`;
        if (previewContent) previewContent.innerHTML = clone.innerHTML || '<p>O conteúdo da matéria aparecerá aqui.</p>';

        const coverUrl = document.querySelector('[data-cover-url]')?.value.trim();
        const coverAlt = document.querySelector('[data-cover-alt]')?.value.trim() || titleInput?.value || 'Imagem de capa';
        if (previewCover && previewCoverWrap) {
          previewCover.src = coverUrl || '';
          previewCover.alt = coverAlt;
          previewCoverWrap.classList.toggle('hidden', !coverUrl);
        }

        if (previewSources) {
          previewSources.innerHTML = sources.length
            ? `<span class="mr-2 text-[9px] font-black uppercase tracking-widest text-zinc-300">Fontes:</span>${sources
                .map((source) => `<span class="rounded-md border border-zinc-100 bg-zinc-50 px-2 py-1 text-[9px] font-bold uppercase tracking-widest text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900">${escapeHtml(source.name)}</span>`)
                .join('')}`
            : '';
        }

        previewModal?.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      };

      const closePreview = () => {
        previewModal?.classList.add('hidden');
        document.body.style.overflow = '';
      };

      const scheduleAutosave = () => {
        if (autosave) autosave.textContent = 'salvando...';
        window.clearTimeout(autosaveTimer);
        autosaveTimer = window.setTimeout(() => {
          if (autosave) autosave.textContent = 'salvo agora';
          if (autosaveDetail) autosaveDetail.textContent = 'Autosave local há poucos segundos';
        }, 700);
      };

      const positionMediaToolbar = () => {
        if (!mediaToolbar) return;
        if (!selectedMedia) {
          mediaToolbar.classList.add('hidden');
          mediaToolbar.classList.remove('flex');
          return;
        }
        const rect = selectedMedia.getBoundingClientRect();
        mediaToolbar.style.left = `${rect.left + rect.width / 2}px`;
        mediaToolbar.style.top = `${Math.max(12, rect.top - 54)}px`;
        mediaToolbar.classList.remove('hidden');
        mediaToolbar.classList.add('flex');
      };

      const setSelectedMedia = (media) => {
        selectedMedia?.classList.remove('is-selected');
        selectedMedia = media;
        selectedMedia?.classList.add('is-selected');
        positionMediaToolbar();
      };

      const hideSlashPalette = () => {
        slashPalette?.classList.add('hidden');
        slashRange = null;
      };

      const getSlashRangeAtCursor = () => {
        const selection = window.getSelection();
        if (!selection || selection.rangeCount === 0 || !selection.isCollapsed) return null;
        const range = selection.getRangeAt(0);
        if (!editor.contains(range.commonAncestorContainer)) return null;

        if (range.startContainer.nodeType === Node.TEXT_NODE) {
          const text = range.startContainer.textContent || '';
          if (text.slice(0, range.startOffset).endsWith('/')) {
            const slash = range.cloneRange();
            slash.setStart(range.startContainer, range.startOffset - 1);
            slash.setEnd(range.startContainer, range.startOffset);
            return slash;
          }
          return null;
        }

        const before = range.startContainer.childNodes[range.startOffset - 1];
        if (before?.nodeType === Node.TEXT_NODE && before.textContent?.endsWith('/')) {
          const slash = document.createRange();
          slash.setStart(before, before.textContent.length - 1);
          slash.setEnd(before, before.textContent.length);
          return slash;
        }
        return null;
      };

      const positionSlashPalette = () => {
        if (!slashPalette || !slashRange) return;
        const rect = slashRange.getBoundingClientRect();
        const editorRect = editor.getBoundingClientRect();
        slashPalette.style.left = `${Math.max(20, rect.left - editorRect.left + 24)}px`;
        slashPalette.style.top = `${Math.max(24, rect.bottom - editorRect.top + 20)}px`;
        slashPalette.classList.remove('hidden');
      };

      const updateSlashPalette = () => {
        slashRange = getSlashRangeAtCursor();
        if (!slashRange) {
          slashPalette?.classList.add('hidden');
          return;
        }
        positionSlashPalette();
      };

      const createImageBlock = (url, alt) =>
        `<figure data-editor-media="image" data-align="center" data-media-size="large" contenteditable="false"><img src="${escapeHtml(url)}" alt="${escapeHtml(alt)}" /><figcaption>${escapeHtml(alt)}</figcaption></figure><p><br></p>`;

      const createCarouselBlock = () => {
        const items = mediaItems.slice(0, 8);
        if (items.length < 2) return '';
        return `<section data-editor-media="carousel" data-align="center" data-media-size="large" contenteditable="false"><div class="grid gap-3 md:grid-cols-2">${items
          .map((item) => `<figure><img src="${escapeHtml(item.url)}" alt="${escapeHtml(item.alt)}" /><figcaption>${escapeHtml(item.alt)}</figcaption></figure>`)
          .join('')}</div></section><p><br></p>`;
      };

      const getYoutubeEmbed = (url) => {
        const match = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/shorts\/)([A-Za-z0-9_-]+)/);
        return match ? `https://www.youtube.com/embed/${match[1]}` : '';
      };

      const createEmbedBlock = (rawUrl, label = 'Embed editorial') => {
        const value = rawUrl.trim();
        const youtube = getYoutubeEmbed(value);
        if (youtube) {
          return `<div data-editor-media="embed" data-align="center" data-media-size="large" contenteditable="false"><iframe src="${youtube}" title="${escapeHtml(label)}" loading="lazy" allowfullscreen class="aspect-video w-full rounded-2xl"></iframe></div><p><br></p>`;
        }
        if (value.startsWith('<iframe')) {
          return `<div data-editor-media="embed" data-align="center" data-media-size="large" contenteditable="false">${value}</div><p><br></p>`;
        }
        return `<div data-editor-media="embed" data-align="center" data-media-size="large" contenteditable="false"><a href="${escapeHtml(value)}" target="_blank" rel="noopener noreferrer" class="embed-card">${escapeHtml(label)} • abrir publicação</a></div><p><br></p>`;
      };

      const renderMediaList = () => {
        if (!mediaList) return;
        mediaList.innerHTML = mediaItems
          .map(
            (item, index) => `
              <article class="group overflow-hidden rounded-3xl bg-zinc-50 p-2 dark:bg-zinc-950">
                <img src="${escapeHtml(item.url)}" alt="${escapeHtml(item.alt)}" class="aspect-video w-full rounded-2xl object-cover" />
                <div class="mt-2 flex gap-2">
                  <button type="button" data-insert-media="${index}" class="flex-1 rounded-full bg-white px-3 py-2 text-[8px] font-black uppercase tracking-widest text-zinc-600 shadow-sm dark:bg-zinc-900">Inserir</button>
                  <button type="button" data-cover-media="${index}" class="flex-1 rounded-full bg-red-600 px-3 py-2 text-[8px] font-black uppercase tracking-widest text-white">Capa</button>
                </div>
              </article>
            `
          )
          .join('');
      };

      const addMedia = (url, alt) => {
        mediaItems.push({ url, alt: alt || 'Imagem editorial' });
        renderMediaList();
        updateEditorState();
      };

      const compressImage = async (file) => {
        const image = await createImageBitmap(file);
        const maxWidth = 1800;
        const ratio = Math.min(1, maxWidth / image.width);
        const width = Math.round(image.width * ratio);
        const height = Math.round(image.height * ratio);
        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        canvas.getContext('2d')?.drawImage(image, 0, 0, width, height);
        const blob = await new Promise((resolve) => canvas.toBlob((result) => resolve(result), 'image/webp', 0.86));
        const url = blob ? URL.createObjectURL(blob) : URL.createObjectURL(file);
        addMedia(url, file.name.replace(/\.[^.]+$/, ''));
        setStatus('Imagem otimizada');
      };

      const applyFormat = (action) => {
        restoreSelection();
        if (action === 'bold') runCommand('bold');
        if (action === 'italic') runCommand('italic');
        if (action === 'link') {
          const url = window.prompt('URL do link');
          if (url) runCommand('createLink', url);
        }
        if (action === 'quote') runCommand('formatBlock', 'blockquote');
        if (action === 'highlight') runCommand('backColor', '#fef08a');
        if (action === 'comment') insertHtml('<span class="editor-note">Comentário editorial</span>');
        updateEditorState();
      };

      const runSlashAction = (action) => {
        slashPalette?.classList.add('hidden');
        if (action === 'h2') insertHtmlAtSlash('<h2>Novo subtítulo</h2>');
        if (action === 'h3') insertHtmlAtSlash('<h3>Novo intertítulo</h3>');
        if (action === 'quote') insertHtmlAtSlash('<blockquote>Citação ou dado relevante</blockquote>');
        if (action === 'image') {
          const item = mediaItems.at(-1);
          if (item) insertHtmlAtSlash(createImageBlock(item.url, item.alt));
        }
        if (action === 'youtube' || action === 'tweet' || action === 'embed') {
          const url = window.prompt('Cole a URL');
          if (url) insertHtmlAtSlash(createEmbedBlock(url, action === 'youtube' ? 'YouTube' : action === 'tweet' ? 'Post no X' : 'Embed editorial'));
        }
        if (action === 'carousel') {
          const carousel = createCarouselBlock();
          if (carousel) insertHtmlAtSlash(carousel);
        }
      };

      document.querySelectorAll('[data-format]').forEach((button) => {
        button.addEventListener('click', () => applyFormat(button.dataset.format));
      });

      document.querySelectorAll('[data-slash-action]').forEach((button) => {
        button.addEventListener('click', () => runSlashAction(button.dataset.slashAction));
      });

      document.querySelectorAll('[data-media-align]').forEach((button) => {
        button.addEventListener('click', () => {
          if (!selectedMedia) return;
          selectedMedia.dataset.align = button.dataset.mediaAlign;
          setStatus(`Mídia alinhada: ${button.dataset.mediaAlign}`);
          updateEditorState();
          positionMediaToolbar();
        });
      });

      document.querySelectorAll('[data-media-size]').forEach((button) => {
        button.addEventListener('click', () => {
          if (!selectedMedia) return;
          selectedMedia.dataset.mediaSize = button.dataset.mediaSize;
          selectedMedia.style.width = '';
          setStatus(`Tamanho da mídia: ${button.dataset.mediaSize}`);
          updateEditorState();
          positionMediaToolbar();
        });
      });

      editor.addEventListener('input', () => {
        updateSlashPalette();
        updateEditorState();
      });
      editor.addEventListener('keyup', (event) => {
        saveSelection();
        if (event.key === 'Escape') hideSlashPalette();
        if (event.key === '/') updateSlashPalette();
      });
      editor.addEventListener('mouseup', () => {
        saveSelection();
        updateSlashPalette();
      });
      editor.addEventListener('focus', saveSelection);
      editor.addEventListener('click', (event) => {
        const media = event.target.closest('[data-editor-media]');
        setSelectedMedia(media && editor.contains(media) ? media : null);
        updateSlashPalette();
      });
      editor.addEventListener('pointerup', () => {
        if (!selectedMedia) return;
        selectedMedia.dataset.mediaSize = 'custom';
        window.setTimeout(() => {
          updateEditorState();
          positionMediaToolbar();
        }, 0);
      });
      editor.addEventListener('paste', (event) => {
        const text = event.clipboardData?.getData('text/plain') || '';
        if (/https?:\/\/\S+/.test(text) && /(youtube|youtu\.be|twitter|x\.com|instagram|tiktok)/i.test(text)) {
          event.preventDefault();
          insertHtml(createEmbedBlock(text, 'Embed social'));
        } else {
          window.setTimeout(updateEditorState, 0);
        }
      });

      document.addEventListener('selectionchange', () => {
        const selection = window.getSelection();
        if (!selection || selection.isCollapsed || !editor.contains(selection.anchorNode)) {
          floatingToolbar?.classList.add('hidden');
          return;
        }
        const rect = selection.getRangeAt(0).getBoundingClientRect();
        if (!rect.width) return;
        floatingToolbar.style.left = `${rect.left + rect.width / 2}px`;
        floatingToolbar.style.top = `${Math.max(12, rect.top - 54)}px`;
        floatingToolbar?.classList.remove('hidden');
        saveSelection();
      });
      window.addEventListener('scroll', positionMediaToolbar, { passive: true });
      window.addEventListener('resize', () => {
        positionMediaToolbar();
        positionSlashPalette();
      });

      titleInput?.addEventListener('input', () => {
        titleInput.style.height = 'auto';
        titleInput.style.height = `${titleInput.scrollHeight}px`;
        if (slugInput && !slugInput.dataset.edited) slugInput.value = slugify(titleInput.value);
        updateEditorState();
      });
      slugInput?.addEventListener('input', () => {
        slugInput.dataset.edited = 'true';
      });
      summaryInput?.addEventListener('input', updateEditorState);
      categoryInput?.addEventListener('change', updateEditorState);
      seoDescriptionInput?.addEventListener('input', () => {
        seoTouched = true;
        updateEditorState();
      });
      keywordsInput?.addEventListener('input', () => {
        keywordsTouched = true;
        updateEditorState();
      });

      document.querySelector('[data-local-image]')?.addEventListener('change', async (event) => {
        const files = Array.from(event.target.files || []);
        for (const file of files) await compressImage(file);
      });
      document.querySelector('[data-cover-file]')?.addEventListener('change', async (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        const url = URL.createObjectURL(file);
        const preview = document.querySelector('[data-cover-preview]');
        const empty = document.querySelector('[data-cover-empty]');
        const coverUrl = document.querySelector('[data-cover-url]');
        if (preview) {
          preview.src = url;
          preview.classList.remove('hidden');
        }
        empty?.classList.add('hidden');
        if (coverUrl) coverUrl.value = url;
      });

      document.querySelectorAll('[data-drop-zone], [data-cover-drop]').forEach((zone) => {
        zone.addEventListener('dragover', (event) => {
          event.preventDefault();
          zone.classList.add('border-red-600');
        });
        zone.addEventListener('dragleave', () => zone.classList.remove('border-red-600'));
        zone.addEventListener('drop', async (event) => {
          event.preventDefault();
          zone.classList.remove('border-red-600');
          const files = Array.from(event.dataTransfer?.files || []).filter((file) => file.type.startsWith('image/'));
          for (const file of files) await compressImage(file);
        });
      });

      mediaList?.addEventListener('click', (event) => {
        const insertButton = event.target.closest('[data-insert-media]');
        const coverButton = event.target.closest('[data-cover-media]');
        if (insertButton) {
          const item = mediaItems[Number(insertButton.dataset.insertMedia)];
          if (item) insertHtml(createImageBlock(item.url, item.alt));
        }
        if (coverButton) {
          const item = mediaItems[Number(coverButton.dataset.coverMedia)];
          const coverUrl = document.querySelector('[data-cover-url]');
          const coverAlt = document.querySelector('[data-cover-alt]');
          const preview = document.querySelector('[data-cover-preview]');
          const empty = document.querySelector('[data-cover-empty]');
          if (item && coverUrl) coverUrl.value = item.url;
          if (item && coverAlt) coverAlt.value = item.alt;
          if (item && preview) {
            preview.src = item.url;
            preview.classList.remove('hidden');
          }
          empty?.classList.add('hidden');
        }
      });

      document.querySelector('[data-insert-carousel]')?.addEventListener('click', () => {
        const carousel = createCarouselBlock();
        if (!carousel) {
          setStatus('Adicione pelo menos 2 imagens');
          return;
        }
        insertHtml(carousel);
        setStatus('Carrossel inserido');
      });

      document.querySelector('[data-focus-mode]')?.addEventListener('click', () => {
        document.documentElement.classList.toggle('admin-focus-mode');
      });
      document.querySelector('[data-open-preview]')?.addEventListener('click', openPreview);
      document.querySelector('[data-close-preview]')?.addEventListener('click', closePreview);
      previewModal?.addEventListener('click', (event) => {
        if (event.target === previewModal) closePreview();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !previewModal?.classList.contains('hidden')) closePreview();
      });

      document.querySelector('[data-save-draft]')?.addEventListener('click', () => setStatus('Rascunho salvo'));
      document.querySelector('[data-publish-now]')?.addEventListener('click', () => setStatus('Pronta para publicar'));
      document.querySelector('[data-schedule-post]')?.addEventListener('click', () => {
        const scheduledAt = document.querySelector('[data-schedule-at]')?.value;
        setStatus(scheduledAt ? 'Agendada' : 'Informe data e hora');
      });

      document.querySelector('[data-add-tag]')?.addEventListener('click', () => {
        const input = document.querySelector('[data-tag-input]');
        const value = input?.value.trim();
        if (!value) return;
        tags.push(value);
        input.value = '';
        tagList.innerHTML = tags.map((tag) => `<span class="rounded-full bg-zinc-950 px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-white dark:bg-white dark:text-zinc-950">${escapeHtml(tag)}</span>`).join('');
        updateEditorState();
      });

      const renderSources = () => {
        sourceList.innerHTML = sources
          .map(
            (source, index) => `
              <div class="rounded-2xl bg-white p-3 text-xs shadow-sm dark:bg-zinc-950">
                <div class="flex items-center justify-between gap-3">
                  <strong class="truncate">${escapeHtml(source.name)}</strong>
                  <button type="button" data-remove-source="${index}" class="text-[8px] font-black uppercase tracking-widest text-red-600">Remover</button>
                </div>
                ${source.url ? `<span class="mt-1 block truncate text-zinc-400">${escapeHtml(source.url)}</span>` : ''}
                ${source.note ? `<p class="mt-2 leading-5 text-zinc-500">${escapeHtml(source.note)}</p>` : ''}
              </div>
            `
          )
          .join('');
        updateEditorState();
      };

      document.querySelector('[data-add-source]')?.addEventListener('click', () => {
        const nameInput = document.querySelector('[data-source-name]');
        const urlInput = document.querySelector('[data-source-url]');
        const noteInput = document.querySelector('[data-source-note]');
        const name = nameInput?.value.trim();
        if (!name) return;
        sources.push({ name, url: urlInput?.value.trim() || '', note: noteInput?.value.trim() || '' });
        nameInput.value = '';
        urlInput.value = '';
        noteInput.value = '';
        renderSources();
      });
      sourceList?.addEventListener('click', (event) => {
        const button = event.target.closest('[data-remove-source]');
        if (!button) return;
        sources.splice(Number(button.dataset.removeSource), 1);
        renderSources();
      });

      const normalizeAction = (value) =>
        String(value || '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase();

      const getSelectedEditorText = () => {
        const selection = window.getSelection();
        if (!selection || selection.rangeCount === 0 || selection.isCollapsed) return '';
        const range = selection.getRangeAt(0);
        return editor.contains(range.commonAncestorContainer) ? selection.toString().trim() : '';
      };

      const getSavedEditorText = () => {
        if (!savedRange || !editor.contains(savedRange.commonAncestorContainer)) return '';
        return savedRange.toString().trim();
      };

      const getAiText = (result) => {
        if (!result) return '';
        if (typeof result === 'string') return result;
        return result.text || result.subtitle || result.push || result.instagram || '';
      };

      const replaceSelectionOrInsert = (text) => {
        const clean = String(text || '').trim();
        if (!clean) return;
        restoreSelection();
        const selection = window.getSelection();
        if (selection && selection.rangeCount > 0 && !selection.isCollapsed && editor.contains(selection.getRangeAt(0).commonAncestorContainer)) {
          runCommand('insertText', clean);
        } else {
          insertHtml(`<p>${escapeHtml(clean).replace(/\n{2,}/g, '</p><p>').replace(/\n/g, '<br>')}</p>`);
        }
        updateEditorState();
      };

      const renderAiOutput = (action, result) => {
        if (!aiOutput) return;
        const titleOptions = Array.isArray(result?.titleOptions) ? result.titleOptions.filter(Boolean).slice(0, 4) : [];
        const keywords = Array.isArray(result?.keywords) ? result.keywords.filter(Boolean).join(', ') : result?.keywords || '';
        const text = getAiText(result);

        aiOutput.classList.remove('hidden');
        aiOutput.innerHTML = `
          <div class="mb-3 flex items-center justify-between gap-3">
            <strong class="text-[10px] font-black uppercase tracking-[0.24em] text-red-600">${escapeHtml(action)}</strong>
            <span class="text-[9px] font-black uppercase tracking-widest text-zinc-300">Workers AI</span>
          </div>
          ${titleOptions.length ? `
            <div class="mb-3 grid gap-2">
              ${titleOptions.map((title) => `<button type="button" data-ai-title="${escapeHtml(title)}" class="rounded-2xl bg-zinc-50 px-3 py-2 text-left text-xs font-bold text-zinc-700 transition hover:bg-red-600 hover:text-white dark:bg-zinc-900 dark:text-zinc-200">${escapeHtml(title)}</button>`).join('')}
            </div>
          ` : ''}
          ${text ? `<p class="whitespace-pre-line">${escapeHtml(text)}</p>` : ''}
          ${result?.seoDescription ? `<p class="mt-3 rounded-2xl bg-emerald-50 p-3 text-xs font-bold text-emerald-700 dark:bg-emerald-950/20 dark:text-emerald-300">${escapeHtml(result.seoDescription)}</p>` : ''}
          ${keywords ? `<p class="mt-2 text-xs font-bold text-zinc-400">${escapeHtml(keywords)}</p>` : ''}
        `;
      };

      const applyAiResult = (action, result) => {
        const actionKey = normalizeAction(action);
        const text = getAiText(result);
        if (actionKey.includes('seo')) {
          if (result?.seoDescription && seoDescriptionInput) {
            seoDescriptionInput.value = String(result.seoDescription).slice(0, 158);
            seoTouched = true;
          }
          if (result?.keywords && keywordsInput) {
            keywordsInput.value = Array.isArray(result.keywords) ? result.keywords.join(', ') : String(result.keywords);
            keywordsTouched = true;
          }
        }
        if (actionKey.includes('criar resumo') && text && summaryInput) {
          summaryInput.value = text.slice(0, 320);
          summaryInput.dispatchEvent(new Event('input', { bubbles: true }));
        }
        if (actionKey.includes('resumir') && text) {
          replaceSelectionOrInsert(text);
        }
        if (actionKey.includes('melhorar escrita') && text) {
          replaceSelectionOrInsert(text);
        }
        if (actionKey.includes('subtitulo') && result?.subtitle) {
          insertHtml(`<h2>${escapeHtml(result.subtitle)}</h2>`);
        }
        renderAiOutput(action, result);
        updateEditorState();
      };

      document.querySelectorAll('[data-ai-action]').forEach((button) => {
        button.addEventListener('click', async () => {
          const action = button.dataset.aiAction;
          setStatus(`${action}: gerando...`);
          button.disabled = true;
          button.classList.add('opacity-60');
          try {
            const selectedText = getSelectedEditorText() || getSavedEditorText();
            const response = await fetch('/api/editorial-ai', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                action,
                title: titleInput?.value || '',
                summary: summaryInput?.value || '',
                category: categoryInput?.value || '',
                body: getPlainText(),
                selection: selectedText,
                seoDescription: seoDescriptionInput?.value || '',
                keywords: keywordsInput?.value || '',
              }),
            });
            const data = await response.json();
            if (!response.ok) throw new Error(data.error || 'Falha ao gerar sugestao.');
            applyAiResult(action, data.result || {});
            setStatus(`${action}: pronto`);
          } catch (error) {
            if (aiOutput) {
              aiOutput.classList.remove('hidden');
              aiOutput.innerHTML = `<strong class="text-red-600">IA indisponivel</strong><p class="mt-2">${escapeHtml(error.message || 'Confira o binding AI no Cloudflare Pages.')}</p>`;
            }
            setStatus('IA indisponivel');
          } finally {
            button.disabled = false;
            button.classList.remove('opacity-60');
          }
        });
      });

      aiOutput?.addEventListener('click', (event) => {
        const button = event.target.closest('[data-ai-title]');
        if (!button || !titleInput) return;
        titleInput.value = button.dataset.aiTitle || '';
        titleInput.dispatchEvent(new Event('input', { bubbles: true }));
        setStatus('Titulo aplicado');
      });

      document.querySelector('[data-current-date]').textContent = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short' }).format(new Date());
      updateEditorState();
    })();
  </script>
</AdminLayout>
