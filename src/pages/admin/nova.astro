---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { categoriesList, subCategoriesList } from '../../lib/news';

const categories = [...categoriesList, ...subCategoriesList];
const toolbarGroups = [
  [
    { label: 'H2', action: 'h2' },
    { label: 'H3', action: 'h3' },
    { label: 'B', action: 'bold' },
    { label: 'I', action: 'italic' },
  ],
  [
    { label: 'Lista', action: 'list' },
    { label: 'Quote', action: 'quote' },
    { label: 'Link', action: 'link' },
    { label: 'Linha', action: 'divider' },
  ],
  [
    { label: 'Imagem', action: 'image' },
    { label: 'Carrossel', action: 'carousel' },
    { label: 'Embed', action: 'embed' },
    { label: 'Ponto', action: 'marker' },
  ],
];
---

<AdminLayout title="Nova materia | Admin Novo Alvo" active="new">
  <section class="space-y-6">
    <header class="rounded-[2rem] bg-white p-6 shadow-sm dark:bg-zinc-900">
      <span class="text-[10px] font-black uppercase tracking-[0.35em] text-red-600">Editor</span>
      <h1 class="mt-3 font-serif text-4xl font-black italic tracking-tighter md:text-5xl">Nova materia</h1>
      <p class="mt-2 max-w-3xl text-sm font-medium leading-7 text-zinc-500 dark:text-zinc-400">
        Editor editorial amplo, com ferramentas de Markdown, upload local otimizado e estrutura para imagens/carrossel. A proxima fase liga isso ao gerador real de arquivos.
      </p>
    </header>

    <form class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1fr)_360px]">
      <div class="space-y-6">
        <section class="space-y-5 rounded-[2rem] border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <label class="block">
            <span class="text-[9px] font-black uppercase tracking-widest text-zinc-400">Titulo</span>
            <input class="mt-2 w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-4 text-2xl font-black outline-none focus:border-red-600 dark:border-zinc-800 dark:bg-zinc-950" placeholder="Titulo da materia" />
          </label>
          <label class="block">
            <span class="text-[9px] font-black uppercase tracking-widest text-zinc-400">Resumo editorial</span>
            <textarea class="mt-2 min-h-24 w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-4 text-sm font-medium outline-none focus:border-red-600 dark:border-zinc-800 dark:bg-zinc-950" placeholder="Resumo curto para chamadas, cards e redes sociais"></textarea>
          </label>
        </section>

        <section class="overflow-hidden rounded-[2rem] border border-zinc-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <div class="border-b border-zinc-200 p-3 dark:border-zinc-800">
            <div class="flex flex-wrap items-center gap-3">
              {toolbarGroups.map((group) => (
                <div class="flex rounded-2xl border border-zinc-200 bg-zinc-50 p-1 dark:border-zinc-800 dark:bg-zinc-950">
                  {group.map((item) => (
                    <button
                      type="button"
                      class="rounded-xl px-3 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-500 transition hover:bg-red-600 hover:text-white dark:text-zinc-400"
                      data-md-action={item.action}
                    >
                      {item.label}
                    </button>
                  ))}
                </div>
              ))}
              <div class="ml-auto hidden grid-cols-2 gap-3 text-center md:grid">
                <div class="rounded-2xl border border-zinc-200 px-4 py-2 dark:border-zinc-800">
                  <span class="block text-[8px] font-black uppercase tracking-widest text-zinc-400">Palavras</span>
                  <strong class="font-serif text-xl font-black italic" data-word-count>0</strong>
                </div>
                <div class="rounded-2xl border border-zinc-200 px-4 py-2 dark:border-zinc-800">
                  <span class="block text-[8px] font-black uppercase tracking-widest text-zinc-400">Leitura</span>
                  <strong class="font-serif text-xl font-black italic"><span data-reading-time>0</span>m</strong>
                </div>
              </div>
            </div>
            <div class="mt-3 hidden items-center justify-between gap-3 rounded-2xl border border-red-100 bg-red-50 px-4 py-3 text-red-700 dark:border-red-900/40 dark:bg-red-950/20 dark:text-red-200" data-media-toolbar>
              <span class="text-[9px] font-black uppercase tracking-widest">Midia selecionada</span>
              <div class="flex flex-wrap gap-2">
                <button type="button" data-media-move="up" class="rounded-xl bg-white px-3 py-2 text-[8px] font-black uppercase tracking-widest shadow-sm dark:bg-zinc-900">Subir</button>
                <button type="button" data-media-move="down" class="rounded-xl bg-white px-3 py-2 text-[8px] font-black uppercase tracking-widest shadow-sm dark:bg-zinc-900">Descer</button>
                <button type="button" data-media-remove class="rounded-xl bg-red-600 px-3 py-2 text-[8px] font-black uppercase tracking-widest text-white">Remover</button>
              </div>
            </div>
          </div>

          <label class="block">
            <span class="sr-only">Corpo da materia</span>
            <div
              data-editor-body
              contenteditable="true"
              data-placeholder="Escreva a materia aqui..."
              class="min-h-[760px] w-full overflow-y-auto border-0 bg-zinc-50 px-6 py-6 text-lg leading-9 outline-none dark:bg-zinc-950 [&_.editor-insert-marker]:my-6 [&_.editor-insert-marker]:rounded-2xl [&_.editor-insert-marker]:border [&_.editor-insert-marker]:border-dashed [&_.editor-insert-marker]:border-red-300 [&_.editor-insert-marker]:bg-red-50 [&_.editor-insert-marker]:px-4 [&_.editor-insert-marker]:py-3 [&_.editor-insert-marker]:text-center [&_.editor-insert-marker]:text-[9px] [&_.editor-insert-marker]:font-black [&_.editor-insert-marker]:uppercase [&_.editor-insert-marker]:tracking-widest [&_.editor-insert-marker]:text-red-600 [&_[data-editor-media]]:my-8 [&_[data-editor-media]]:cursor-pointer [&_[data-editor-media]]:rounded-3xl [&_[data-editor-media]]:border [&_[data-editor-media]]:border-zinc-200 [&_[data-editor-media]]:bg-white [&_[data-editor-media]]:p-4 [&_[data-editor-media]]:shadow-sm [&_[data-editor-media].is-selected]:border-red-600 [&_[data-editor-media].is-selected]:ring-4 [&_[data-editor-media].is-selected]:ring-red-100 [&_a]:font-bold [&_a]:text-red-600 [&_blockquote]:border-l-4 [&_blockquote]:border-red-600 [&_blockquote]:pl-5 [&_blockquote]:italic [&_figcaption]:mt-2 [&_figcaption]:text-center [&_figcaption]:text-xs [&_figcaption]:italic [&_figcaption]:text-zinc-500 [&_h2]:mt-10 [&_h2]:font-serif [&_h2]:text-4xl [&_h2]:font-black [&_h2]:italic [&_h2]:tracking-tighter [&_h3]:mt-8 [&_h3]:text-2xl [&_h3]:font-black [&_hr]:my-10 [&_hr]:border-zinc-200 [&_img]:rounded-2xl [&_img]:shadow-lg [&_li]:my-2 [&_p]:my-5"
            ></div>
            <textarea data-editor-output class="hidden" aria-hidden="true"></textarea>
          </label>
        </section>

        <section class="grid grid-cols-1 gap-6 lg:grid-cols-2 xl:grid-cols-4">
          <div class="space-y-4 rounded-[2rem] border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
            <h2 class="text-xs font-black uppercase tracking-[0.24em]">Imagem por URL</h2>
            <input data-image-url class="w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm dark:border-zinc-800 dark:bg-zinc-950" placeholder="URL da imagem" />
            <input data-image-alt class="w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm dark:border-zinc-800 dark:bg-zinc-950" placeholder="Alt/legenda da imagem" />
            <button type="button" data-insert-image class="w-full rounded-2xl border border-zinc-200 px-4 py-3 text-[9px] font-black uppercase tracking-widest text-zinc-500 transition hover:border-red-600 hover:text-red-600 dark:border-zinc-800">
              Inserir imagem
            </button>
          </div>

          <div class="space-y-4 rounded-[2rem] border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
            <h2 class="text-xs font-black uppercase tracking-[0.24em]">Upload local</h2>
            <label class="flex min-h-36 cursor-pointer flex-col items-center justify-center rounded-2xl border border-dashed border-zinc-300 bg-zinc-50 p-4 text-center transition hover:border-red-600 dark:border-zinc-700 dark:bg-zinc-950">
              <span class="text-[10px] font-black uppercase tracking-widest text-zinc-500">Selecionar imagem</span>
              <span class="mt-2 text-xs text-zinc-400">JPG, PNG ou WebP</span>
              <input type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" data-local-image />
            </label>
            <div class="hidden space-y-3" data-optimized-panel>
              <img data-optimized-preview alt="" class="aspect-video w-full rounded-2xl object-cover" />
              <div class="grid grid-cols-2 gap-3 text-center">
                <div class="rounded-2xl bg-zinc-50 p-3 dark:bg-zinc-950">
                  <span class="block text-[8px] font-black uppercase tracking-widest text-zinc-400">Original</span>
                  <strong class="text-sm" data-original-size>0 KB</strong>
                </div>
                <div class="rounded-2xl bg-zinc-50 p-3 dark:bg-zinc-950">
                  <span class="block text-[8px] font-black uppercase tracking-widest text-zinc-400">Otimizada</span>
                  <strong class="text-sm" data-optimized-size>0 KB</strong>
                </div>
              </div>
              <input data-optimized-path class="w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-xs dark:border-zinc-800 dark:bg-zinc-950" readonly />
              <div class="grid grid-cols-2 gap-3">
                <a data-download-optimized class="rounded-2xl border border-zinc-200 px-4 py-3 text-center text-[9px] font-black uppercase tracking-widest text-zinc-500 dark:border-zinc-800">Baixar</a>
                <button type="button" data-insert-optimized class="rounded-2xl bg-red-600 px-4 py-3 text-[9px] font-black uppercase tracking-widest text-white">Inserir</button>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <button type="button" data-use-cover class="rounded-2xl border border-zinc-200 px-4 py-3 text-[9px] font-black uppercase tracking-widest text-zinc-500 transition hover:border-red-600 hover:text-red-600 dark:border-zinc-800">
                  Usar capa
                </button>
                <button type="button" data-add-carousel class="rounded-2xl border border-zinc-200 px-4 py-3 text-[9px] font-black uppercase tracking-widest text-zinc-500 transition hover:border-red-600 hover:text-red-600 dark:border-zinc-800">
                  Carrossel
                </button>
              </div>
            </div>
          </div>

          <div class="space-y-4 rounded-[2rem] border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
            <h2 class="text-xs font-black uppercase tracking-[0.24em]">Carrossel</h2>
            <p class="text-xs font-medium leading-6 text-zinc-500 dark:text-zinc-400">Use quando a materia tiver 3 ou mais imagens importantes.</p>
            {[1, 2, 3].map((item) => (
              <input data-carousel-image class="w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm dark:border-zinc-800 dark:bg-zinc-950" placeholder={`Imagem ${item}`} />
            ))}
            <button type="button" data-insert-carousel class="w-full rounded-2xl bg-red-600 px-4 py-3 text-[9px] font-black uppercase tracking-widest text-white">
              Inserir carrossel
            </button>
          </div>

          <div class="space-y-4 rounded-[2rem] border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
            <h2 class="text-xs font-black uppercase tracking-[0.24em]">Embed</h2>
            <p class="text-xs font-medium leading-6 text-zinc-500 dark:text-zinc-400">Cole uma URL de video/post permitido ou um iframe confiavel.</p>
            <input data-embed-url class="w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm dark:border-zinc-800 dark:bg-zinc-950" placeholder="URL ou iframe embed" />
            <input data-embed-title class="w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm dark:border-zinc-800 dark:bg-zinc-950" placeholder="Titulo do embed" />
            <button type="button" data-insert-embed class="w-full rounded-2xl border border-zinc-200 px-4 py-3 text-[9px] font-black uppercase tracking-widest text-zinc-500 transition hover:border-red-600 hover:text-red-600 dark:border-zinc-800">
              Inserir embed
            </button>
          </div>
        </section>
      </div>

      <aside class="space-y-5 xl:sticky xl:top-6 xl:h-fit">
        <section class="rounded-[2rem] border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <h2 class="mb-4 text-xs font-black uppercase tracking-[0.24em]">Publicacao</h2>
          <div class="mb-4 rounded-2xl bg-amber-50 p-4 dark:bg-amber-950/20">
            <span class="text-[8px] font-black uppercase tracking-widest text-amber-600">Status atual</span>
            <p class="mt-1 text-sm font-black" data-editor-status>Rascunho local</p>
          </div>
          <label class="mb-4 block">
            <span class="text-[9px] font-black uppercase tracking-widest text-zinc-400">Agendar para</span>
            <input type="datetime-local" data-schedule-at class="mt-2 w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm font-bold dark:border-zinc-800 dark:bg-zinc-950" />
          </label>
          <div class="grid gap-3">
            <button type="button" data-save-draft class="rounded-2xl border border-zinc-200 px-4 py-3 text-[9px] font-black uppercase tracking-widest text-zinc-500 transition hover:border-red-600 hover:text-red-600 dark:border-zinc-800">
              Salvar rascunho
            </button>
            <button type="button" data-schedule-post class="rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-[9px] font-black uppercase tracking-widest text-zinc-700 transition hover:border-red-600 hover:text-red-600 dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-200">
              Agendar publicacao
            </button>
            <button type="button" data-publish-now class="rounded-2xl bg-red-600 px-4 py-3 text-[9px] font-black uppercase tracking-widest text-white">
              Publicar agora
            </button>
          </div>
        </section>

        <section class="space-y-4 rounded-[2rem] border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <h2 class="text-xs font-black uppercase tracking-[0.24em]">Classificacao</h2>
          <label class="block">
            <span class="text-[9px] font-black uppercase tracking-widest text-zinc-400">Categoria</span>
            <select class="mt-2 w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm font-bold dark:border-zinc-800 dark:bg-zinc-950">
              {categories.map((category) => <option>{category}</option>)}
            </select>
          </label>
          <div class="grid grid-cols-2 gap-3">
            <label class="flex items-center gap-2 rounded-2xl border border-zinc-200 p-3 text-[10px] font-black uppercase tracking-widest dark:border-zinc-800">
              <input type="checkbox" /> Destaque
            </label>
            <label class="flex items-center gap-2 rounded-2xl border border-zinc-200 p-3 text-[10px] font-black uppercase tracking-widest dark:border-zinc-800">
              <input type="checkbox" /> Urgente
            </label>
          </div>
        </section>

        <section class="space-y-4 rounded-[2rem] border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <h2 class="text-xs font-black uppercase tracking-[0.24em]">Capa e SEO</h2>
          <input data-cover-url class="w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm dark:border-zinc-800 dark:bg-zinc-950" placeholder="URL da imagem de capa" />
          <input data-cover-alt class="w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm dark:border-zinc-800 dark:bg-zinc-950" placeholder="Texto alternativo" />
          <textarea class="min-h-32 w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm dark:border-zinc-800 dark:bg-zinc-950" placeholder="Descricao SEO"></textarea>
        </section>

        <section class="space-y-4 rounded-[2rem] border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <h2 class="text-xs font-black uppercase tracking-[0.24em]">Fontes</h2>
          <p class="text-xs font-medium leading-6 text-zinc-500 dark:text-zinc-400">
            Cadastre as fontes aqui. Elas ficam separadas do texto e aparecem no fim da materia.
          </p>
          <input data-source-name class="w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm dark:border-zinc-800 dark:bg-zinc-950" placeholder="Nome da fonte" />
          <input data-source-url class="w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm dark:border-zinc-800 dark:bg-zinc-950" placeholder="URL opcional" />
          <button type="button" data-add-source class="w-full rounded-2xl border border-zinc-200 px-4 py-3 text-[9px] font-black uppercase tracking-widest text-zinc-500 transition hover:border-red-600 hover:text-red-600 dark:border-zinc-800">
            Adicionar fonte
          </button>
          <div class="space-y-2" data-source-list></div>
          <textarea data-sources-output class="hidden" aria-hidden="true"></textarea>
        </section>
      </aside>
    </form>
  </section>

  <style is:inline>
    [data-editor-body]:empty::before {
      color: rgb(161 161 170);
      content: attr(data-placeholder);
      pointer-events: none;
    }
  </style>

  <script is:inline>
    (() => {
      const editor = document.querySelector('[data-editor-body]');
      if (!editor) return;

      const output = document.querySelector('[data-editor-output]');
      const wordCount = document.querySelector('[data-word-count]');
      const readingTime = document.querySelector('[data-reading-time]');
      const status = document.querySelector('[data-editor-status]');
      const mediaToolbar = document.querySelector('[data-media-toolbar]');
      const sourcesOutput = document.querySelector('[data-sources-output]');
      const sourceList = document.querySelector('[data-source-list]');

      let savedRange = null;
      let selectedMedia = null;
      const sources = [];
      const escapeHtml = (value) =>
        String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      const saveSelection = () => {
        const selection = window.getSelection();
        if (!selection || selection.rangeCount === 0) return;
        const range = selection.getRangeAt(0);
        if (editor.contains(range.commonAncestorContainer)) savedRange = range.cloneRange();
      };
      const restoreSelection = () => {
        editor.focus();
        if (!savedRange) return;
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(savedRange);
      };
      const syncOutput = () => {
        if (output) output.value = editor.innerHTML.trim();
        if (sourcesOutput) sourcesOutput.value = JSON.stringify(sources);
      };
      const runEditorCommand = (command, value = null) => {
        const commandRunner = Reflect.get(document, 'execCommand')?.bind(document);
        if (!commandRunner) return false;
        return commandRunner(command, false, value);
      };
      const insertHtml = (html) => {
        restoreSelection();
        runEditorCommand('insertHTML', html);
        updateStats();
      };
      const createImageBlock = (url, alt) =>
        `<figure data-editor-media="image" contenteditable="false"><img src="${escapeHtml(url)}" alt="${escapeHtml(alt)}" /><figcaption>${escapeHtml(alt)}</figcaption></figure><p><br></p>`;
      const createEmbedBlock = (rawValue, title) => {
        const value = rawValue.trim();
        const safeTitle = escapeHtml(title || 'Embed editorial');
        if (value.startsWith('<iframe')) {
          return `<div data-editor-media="embed" contenteditable="false">${value}</div><p><br></p>`;
        }
        return `<div data-editor-media="embed" contenteditable="false"><a href="${escapeHtml(value)}" target="_blank" rel="noopener noreferrer" class="block rounded-2xl border border-zinc-200 p-5 text-sm font-black uppercase tracking-widest text-red-600">${safeTitle}</a></div><p><br></p>`;
      };
      const setSelectedMedia = (media) => {
        selectedMedia?.classList.remove('is-selected');
        selectedMedia = media;
        selectedMedia?.classList.add('is-selected');
        mediaToolbar?.classList.toggle('hidden', !selectedMedia);
        mediaToolbar?.classList.toggle('flex', Boolean(selectedMedia));
      };

      const updateStats = () => {
        const words = editor.innerText.trim().split(/\s+/).filter(Boolean).length;
        if (wordCount) wordCount.textContent = String(words);
        if (readingTime) readingTime.textContent = String(Math.max(0, Math.ceil(words / 220)));
        syncOutput();
      };

      const toKb = (bytes) => `${Math.max(1, Math.round(bytes / 1024)).toLocaleString('pt-BR')} KB`;
      const setStatus = (value) => {
        if (status) status.textContent = value;
      };
      const slugifyFile = (name) =>
        name
          .replace(/\.[^.]+$/, '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '')
          .slice(0, 72);

      document.querySelectorAll('[data-md-action]').forEach((button) => {
        button.addEventListener('click', () => {
          const action = button.dataset.mdAction;
          if (action === 'image') {
            saveSelection();
            document.querySelector('[data-image-url]')?.focus();
            return;
          }
          if (action === 'carousel') {
            saveSelection();
            document.querySelector('[data-carousel-image]')?.focus();
            return;
          }
          if (action === 'embed') {
            saveSelection();
            document.querySelector('[data-embed-url]')?.focus();
            return;
          }
          restoreSelection();
          if (action === 'h2') runEditorCommand('formatBlock', 'h2');
          if (action === 'h3') runEditorCommand('formatBlock', 'h3');
          if (action === 'bold') runEditorCommand('bold');
          if (action === 'italic') runEditorCommand('italic');
          if (action === 'list') runEditorCommand('insertUnorderedList');
          if (action === 'quote') runEditorCommand('formatBlock', 'blockquote');
          if (action === 'divider') runEditorCommand('insertHorizontalRule');
          if (action === 'link') {
            const url = window.prompt('URL do link');
            if (url) runEditorCommand('createLink', url);
          }
          if (action === 'marker') {
            insertHtml('<p class="editor-insert-marker">Ponto de insercao de midia</p>');
          }
          updateStats();
          saveSelection();
        });
      });

      document.querySelector('[data-insert-image]')?.addEventListener('click', () => {
        const url = document.querySelector('[data-image-url]')?.value.trim();
        const alt = document.querySelector('[data-image-alt]')?.value.trim() || 'Imagem da materia';
        if (!url) return;
        insertHtml(createImageBlock(url, alt));
        setStatus('Imagem inserida no ponto selecionado');
      });

      document.querySelector('[data-insert-carousel]')?.addEventListener('click', () => {
        const images = Array.from(document.querySelectorAll('[data-carousel-image]'))
          .map((input) => input.value.trim())
          .filter(Boolean);
        if (images.length < 3) return;
        const items = images
          .map((url, index) => `<figure><img src="${escapeHtml(url)}" alt="Imagem ${index + 1}" /><figcaption>Imagem ${index + 1}</figcaption></figure>`)
          .join('');
        insertHtml(`<section data-editor-media="carousel" contenteditable="false"><p class="mb-3 text-xs font-black uppercase tracking-widest text-red-600">Carrossel editorial</p><div class="grid gap-3 md:grid-cols-3">${items}</div></section><p><br></p>`);
        setStatus('Carrossel inserido no ponto selecionado');
      });

      document.querySelector('[data-insert-embed]')?.addEventListener('click', () => {
        const value = document.querySelector('[data-embed-url]')?.value.trim();
        const title = document.querySelector('[data-embed-title]')?.value.trim();
        if (!value) return;
        insertHtml(createEmbedBlock(value, title));
        setStatus('Embed inserido no ponto selecionado');
      });

      document.querySelector('[data-local-image]')?.addEventListener('change', async (event) => {
        const file = event.target.files?.[0];
        if (!file) return;

        const image = await createImageBitmap(file);
        const maxWidth = 1800;
        const ratio = Math.min(1, maxWidth / image.width);
        const width = Math.round(image.width * ratio);
        const height = Math.round(image.height * ratio);
        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        canvas.getContext('2d')?.drawImage(image, 0, 0, width, height);

        const blob = await new Promise((resolve) => {
          canvas.toBlob((result) => resolve(result), 'image/webp', 0.86);
        });
        if (!blob) return;

        const optimizedUrl = URL.createObjectURL(blob);
        const fileName = `${slugifyFile(file.name) || 'imagem-editorial'}.webp`;
        const suggestedPath = `/uploads/news/${fileName}`;

        const panel = document.querySelector('[data-optimized-panel]');
        const preview = document.querySelector('[data-optimized-preview]');
        const originalSize = document.querySelector('[data-original-size]');
        const optimizedSize = document.querySelector('[data-optimized-size]');
        const path = document.querySelector('[data-optimized-path]');
        const download = document.querySelector('[data-download-optimized]');

        panel?.classList.remove('hidden');
        if (preview) preview.src = optimizedUrl;
        if (originalSize) originalSize.textContent = toKb(file.size);
        if (optimizedSize) optimizedSize.textContent = toKb(blob.size);
        if (path) path.value = suggestedPath;
        if (download) {
          download.href = optimizedUrl;
          download.download = fileName;
        }
        setStatus('Imagem otimizada pronta');
      });

      document.querySelector('[data-insert-optimized]')?.addEventListener('click', () => {
        const path = document.querySelector('[data-optimized-path]')?.value.trim();
        if (!path) return;
        insertHtml(createImageBlock(path, 'Imagem otimizada'));
        setStatus('Imagem inserida no corpo');
      });

      document.querySelector('[data-use-cover]')?.addEventListener('click', () => {
        const path = document.querySelector('[data-optimized-path]')?.value.trim();
        if (!path) return;
        const cover = document.querySelector('[data-cover-url]');
        const alt = document.querySelector('[data-cover-alt]');
        if (cover) cover.value = path;
        if (alt && !alt.value) alt.value = 'Imagem de capa da materia';
        setStatus('Capa definida com imagem otimizada');
      });

      document.querySelector('[data-add-carousel]')?.addEventListener('click', () => {
        const path = document.querySelector('[data-optimized-path]')?.value.trim();
        if (!path) return;
        const target = Array.from(document.querySelectorAll('[data-carousel-image]')).find((input) => !input.value.trim());
        if (target) {
          target.value = path;
          setStatus('Imagem adicionada ao carrossel');
        }
      });

      document.querySelector('[data-save-draft]')?.addEventListener('click', () => {
        setStatus('Rascunho pronto para salvar');
      });

      document.querySelector('[data-schedule-post]')?.addEventListener('click', () => {
        const scheduledAt = document.querySelector('[data-schedule-at]')?.value;
        setStatus(scheduledAt ? `Agendada para ${scheduledAt}` : 'Informe data e hora para agendar');
      });

      document.querySelector('[data-publish-now]')?.addEventListener('click', () => {
        setStatus('Pronta para publicacao imediata');
      });

      document.querySelectorAll('[data-media-move]').forEach((button) => {
        button.addEventListener('click', () => {
          if (!selectedMedia) return;
          const direction = button.dataset.mediaMove;
          const sibling = direction === 'up' ? selectedMedia.previousElementSibling : selectedMedia.nextElementSibling;
          if (!sibling) return;
          if (direction === 'up') {
            editor.insertBefore(selectedMedia, sibling);
          } else {
            editor.insertBefore(sibling, selectedMedia);
          }
          updateStats();
          setStatus('Midia reposicionada');
        });
      });

      document.querySelector('[data-media-remove]')?.addEventListener('click', () => {
        if (!selectedMedia) return;
        selectedMedia.remove();
        setSelectedMedia(null);
        updateStats();
        setStatus('Midia removida');
      });

      const renderSources = () => {
        if (!sourceList) return;
        sourceList.innerHTML = sources
          .map(
            (source, index) => `
              <div class="flex items-center justify-between gap-3 rounded-2xl bg-zinc-50 p-3 text-xs dark:bg-zinc-950">
                <div class="min-w-0">
                  <strong class="block truncate text-zinc-900 dark:text-zinc-50">${escapeHtml(source.name)}</strong>
                  ${source.url ? `<span class="block truncate text-zinc-400">${escapeHtml(source.url)}</span>` : ''}
                </div>
                <button type="button" data-remove-source="${index}" class="text-[8px] font-black uppercase tracking-widest text-red-600">Remover</button>
              </div>
            `
          )
          .join('');
        syncOutput();
      };

      document.querySelector('[data-add-source]')?.addEventListener('click', () => {
        const nameInput = document.querySelector('[data-source-name]');
        const urlInput = document.querySelector('[data-source-url]');
        const name = nameInput?.value.trim();
        const url = urlInput?.value.trim();
        if (!name) return;
        sources.push({ name, url });
        if (nameInput) nameInput.value = '';
        if (urlInput) urlInput.value = '';
        renderSources();
        setStatus('Fonte adicionada');
      });

      sourceList?.addEventListener('click', (event) => {
        const button = event.target.closest('[data-remove-source]');
        if (!button) return;
        sources.splice(Number(button.dataset.removeSource), 1);
        renderSources();
      });

      editor.addEventListener('input', updateStats);
      editor.addEventListener('keyup', saveSelection);
      editor.addEventListener('mouseup', saveSelection);
      editor.addEventListener('focus', saveSelection);
      editor.addEventListener('paste', () => window.setTimeout(updateStats, 0));
      editor.addEventListener('click', (event) => {
        const media = event.target.closest('[data-editor-media]');
        setSelectedMedia(media && editor.contains(media) ? media : null);
      });
      updateStats();
    })();
  </script>
</AdminLayout>
