---
import AdminLayout from '../../layouts/AdminLayout.astro';

const settings = [
  ['Portal', 'Portal Novo Alvo'],
  ['Dominio canonico', 'https://portalnovoalvo.com.br'],
  ['Build', 'Astro static'],
  ['Deploy', 'Cloudflare Pages'],
  ['Conteudo', 'Astro Content Collections'],
  ['Monetizacao', 'Google AdSense'],
  ['Presenca', 'Cloudflare KV otimizado'],
];
---

<AdminLayout title="Configurações | Admin Novo Alvo" active="settings">
  <section class="space-y-6">
    <header class="rounded-[2rem] bg-white p-6 shadow-sm dark:bg-zinc-900">
      <span class="text-[10px] font-black uppercase tracking-[0.35em] text-red-600">Sistema</span>
      <h1 class="mt-3 admin-display text-4xl md:text-5xl">Configurações</h1>
      <p class="mt-2 max-w-2xl text-sm font-medium leading-7 text-zinc-500 dark:text-zinc-400">
        Painel de referencia para dados institucionais, deploy, monetizacao e futuras integracoes.
      </p>
    </header>

    <section class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {settings.map(([label, value]) => (
        <div class="rounded-[1.5rem] border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
          <span class="text-[9px] font-black uppercase tracking-widest text-zinc-400">{label}</span>
          <p class="mt-2 text-lg font-black text-zinc-800 dark:text-zinc-100">{value}</p>
        </div>
      ))}
    </section>

    <section class="rounded-[2rem] border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
      <h2 class="mb-5 text-xs font-black uppercase tracking-[0.24em]">Proximas integracoes</h2>
      <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
        {['Autenticacao com Cloudflare Access', 'Gerador de Markdown', 'Upload de imagens', 'Agendamento editorial', 'Buffer/Zapier social', 'Dashboard de visitas'].map((item) => (
          <div class="rounded-2xl bg-zinc-50 p-4 text-sm font-bold text-zinc-600 dark:bg-zinc-950 dark:text-zinc-300">{item}</div>
        ))}
      </div>
    </section>
  </section>
</AdminLayout>
