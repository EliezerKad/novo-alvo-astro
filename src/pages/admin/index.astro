---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';
import { categoryUrl, sortNewsByDate } from '../../lib/news';
import { formatEditorialDate } from '../../lib/utils';

const newsEntries = sortNewsByDate(await getCollection('news'));
const published = newsEntries.length;
const featured = newsEntries.filter((entry) => entry.data.featured || entry.data.isFeatured).length;
const urgent = newsEntries.filter((entry) => entry.data.urgent || entry.data.breakingSummary).length;
const totalViews = newsEntries.reduce((sum, entry) => sum + (entry.data.views || 0), 0);
const categories = [...new Set(newsEntries.map((entry) => entry.data.category))];
const latest = newsEntries.slice(0, 5);
const mostRead = [...newsEntries].sort((a, b) => (b.data.views || 0) - (a.data.views || 0)).slice(0, 4);
const latestSlugs = latest.map((entry) => entry.data.slug);

const cards = [
  { label: 'Publicadas', value: published, tone: 'bg-red-600' },
  { label: 'Destaques', value: featured, tone: 'bg-zinc-950 dark:bg-zinc-50 dark:text-zinc-950' },
  { label: 'Urgentes', value: urgent, tone: 'bg-amber-500' },
  { label: 'Views editoriais', value: totalViews.toLocaleString('pt-BR'), tone: 'bg-emerald-600' },
];
---

<AdminLayout title="Admin Editorial | Portal Novo Alvo" active="dashboard">
  <section class="space-y-8">
    <header class="relative overflow-hidden flex flex-col gap-5 rounded-[2rem] border border-white/80 bg-white/72 p-6 shadow-[0_24px_80px_rgba(15,23,42,0.08)] backdrop-blur-2xl dark:border-zinc-800 dark:bg-zinc-900/72 md:flex-row md:items-end md:justify-between">
      <div class="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full bg-red-500/10 blur-3xl"></div>
      <div class="pointer-events-none absolute bottom-0 left-1/3 h-40 w-40 rounded-full bg-blue-500/10 blur-3xl"></div>
      <div class="space-y-3">
        <span class="text-[10px] font-black uppercase tracking-[0.35em] text-red-600">Painel editorial</span>
        <h1 class="admin-display text-4xl md:text-6xl">Redação Novo Alvo</h1>
        <p class="max-w-2xl text-sm font-medium leading-7 text-zinc-500 dark:text-zinc-400">
          Central inicial para acompanhar materias, destaques, SEO tecnico e preparacao do fluxo futuro de publicacao.
        </p>
      </div>
      <a href="/admin/nova/" class="relative inline-flex rounded-2xl bg-red-600 px-5 py-4 text-[10px] font-black uppercase tracking-widest text-white shadow-lg shadow-red-600/20 transition-all hover:-translate-y-0.5 hover:bg-red-700 hover:shadow-xl hover:shadow-red-600/25">
        Nova materia
      </a>
    </header>

    <section class="grid grid-cols-1 gap-4 md:grid-cols-4">
      {cards.map((card) => (
        <div class="rounded-[1.5rem] border border-white/80 bg-white/70 p-5 shadow-[0_18px_55px_rgba(15,23,42,0.06)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_70px_rgba(15,23,42,0.10)] dark:border-zinc-800 dark:bg-zinc-900/70">
          <div class={`mb-6 h-2 w-12 rounded-full ${card.tone}`}></div>
          <strong class="block admin-display text-4xl" data-admin-total-views={card.label === 'Views editoriais' ? 'true' : undefined}>{card.value}</strong>
          <span class="mt-2 block text-[9px] font-black uppercase tracking-widest text-zinc-400">{card.label}</span>
        </div>
      ))}
    </section>

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-[1.3fr_0.7fr]">
      <section class="rounded-[2rem] border border-white/80 bg-white/70 p-6 shadow-[0_18px_55px_rgba(15,23,42,0.06)] backdrop-blur-xl dark:border-zinc-800 dark:bg-zinc-900/70">
        <div class="mb-6 flex items-center justify-between border-b border-zinc-100 pb-4 dark:border-zinc-800">
          <h2 class="text-xs font-black uppercase tracking-[0.24em]">Ultimas materias</h2>
          <a href="/admin/noticias/" class="text-[9px] font-black uppercase tracking-widest text-red-600">Ver todas</a>
        </div>
        <div class="space-y-4">
          {latest.map((entry) => (
            <a href={`/noticia/${entry.data.slug}/`} class="grid gap-4 rounded-2xl border border-zinc-100 bg-white/40 p-3 transition-all hover:-translate-y-0.5 hover:border-red-200 hover:shadow-lg dark:border-zinc-800 dark:bg-zinc-950/30 md:grid-cols-[96px_1fr_auto]">
              <img src={entry.data.cover.src} alt="" class="h-20 w-full rounded-xl object-cover md:w-24" loading="lazy" />
              <div class="min-w-0">
                <span class="text-[8px] font-black uppercase tracking-widest text-red-600">{entry.data.category}</span>
                <h3 class="mt-1 line-clamp-2 admin-display text-xl leading-tight">{entry.data.title}</h3>
                <p class="mt-2 text-xs font-bold uppercase tracking-widest text-zinc-400">{formatEditorialDate(entry.data.publishedAt.toISOString())}</p>
              </div>
              <span data-admin-view-count={entry.data.slug} class="self-center rounded-full bg-zinc-100 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-500 dark:bg-zinc-800">
                {(entry.data.views || 0).toLocaleString('pt-BR')}
              </span>
            </a>
          ))}
        </div>
      </section>

      <aside class="space-y-6">
        <section class="rounded-[2rem] border border-white/80 bg-white/70 p-6 shadow-[0_18px_55px_rgba(15,23,42,0.06)] backdrop-blur-xl dark:border-zinc-800 dark:bg-zinc-900/70">
          <h2 class="mb-5 text-xs font-black uppercase tracking-[0.24em]">Categorias ativas</h2>
          <div class="flex flex-wrap gap-2">
            {categories.map((category) => (
              <a href={categoryUrl(category)} class="rounded-full border border-zinc-200 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-500 transition hover:border-red-600 hover:text-red-600 dark:border-zinc-800">
                {category}
              </a>
            ))}
          </div>
        </section>

        <section class="rounded-[2rem] border border-white/80 bg-white/70 p-6 shadow-[0_18px_55px_rgba(15,23,42,0.06)] backdrop-blur-xl dark:border-zinc-800 dark:bg-zinc-900/70">
          <h2 class="mb-5 text-xs font-black uppercase tracking-[0.24em]">Mais lidas</h2>
          <div class="space-y-4" data-admin-most-read>
            {mostRead.map((entry, index) => (
              <a href={`/noticia/${entry.data.slug}/`} class="flex gap-4 rounded-2xl p-1 transition hover:bg-white/60 dark:hover:bg-zinc-950/30">
                <span class="admin-display text-3xl text-[#8A1F2D]">{index + 1}</span>
                <div>
                  <p class="line-clamp-2 text-sm font-black leading-tight">{entry.data.title}</p>
                  <p class="mt-1 text-[9px] font-black uppercase tracking-widest text-zinc-400">{(entry.data.views || 0).toLocaleString('pt-BR')} views</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      </aside>
    </div>
  </section>
</AdminLayout>

<script define:vars={{ latestSlugs }}>
  const formatNumber = (value) => Number(value || 0).toLocaleString('pt-BR');
  const escapeHtml = (value) =>
    String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');

  const renderMostRead = (articles) => {
    const root = document.querySelector('[data-admin-most-read]');
    if (!root || !Array.isArray(articles) || articles.length === 0) return;
    root.innerHTML = articles
      .map(
        (article, index) => `
          <a href="/noticia/${encodeURIComponent(article.slug)}/" class="flex gap-4 rounded-2xl p-1 transition hover:bg-white/60 dark:hover:bg-zinc-950/30">
            <span class="admin-display text-3xl text-[#8A1F2D]">${index + 1}</span>
            <div>
              <p class="line-clamp-2 text-sm font-black leading-tight">${escapeHtml(article.title)}</p>
              <p class="mt-1 text-[9px] font-black uppercase tracking-widest text-zinc-400">${formatNumber(article.views)} views</p>
            </div>
          </a>
        `,
      )
      .join('');
  };

  const hydrateAdminViews = async () => {
    const slugs = Array.isArray(latestSlugs) ? latestSlugs : [];
    const query = new URLSearchParams({ limit: '4' });
    if (slugs.length) query.set('slugs', slugs.join(','));

    const response = await fetch(`/api/public/view-stats?${query.toString()}`, { cache: 'no-store' });
    if (!response.ok) return;
    const data = await response.json();

    const totalNode = document.querySelector('[data-admin-total-views]');
    if (totalNode && Number.isFinite(Number(data.totalViews))) {
      totalNode.textContent = formatNumber(data.totalViews);
    }

    const views = data && typeof data.views === 'object' ? data.views : {};
    document.querySelectorAll('[data-admin-view-count]').forEach((node) => {
      const slug = node.getAttribute('data-admin-view-count');
      node.textContent = formatNumber(views[slug] || 0);
    });

    renderMostRead(data.top);
  };

  hydrateAdminViews().catch(() => {});
</script>
