---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { categoriesList, newsEntryToArticle, sortNewsByDate, subCategoriesList, urgentNews } from '../../lib/news';

const newsEntries = sortNewsByDate(await getCollection('news'));
const articles = newsEntries.map(newsEntryToArticle);
const tickerArticles = urgentNews(newsEntries).map(newsEntryToArticle);
---

<BaseLayout
  title="Admin Editorial | Novo Alvo"
  description="Painel editorial inicial do Novo Alvo para organizar noticias, categorias e preparacao para CMS futuro."
  canonical={new URL('/admin/', Astro.site ?? Astro.url.origin).href}
>
  <div class="min-h-screen bg-zinc-50 dark:bg-zinc-950">
    <Navbar tickerArticles={tickerArticles} categories={categoriesList} subCategories={subCategoriesList} />
    <main class="max-w-7xl mx-auto px-4 py-12 space-y-10">
      <header class="space-y-3">
        <span class="text-[10px] font-black uppercase tracking-[0.4em] text-red-600">Estrutura editorial</span>
        <h1 class="text-4xl md:text-6xl font-serif font-black tracking-tighter italic text-zinc-900 dark:text-zinc-50">
          Painel Novo Alvo
        </h1>
        <p class="max-w-2xl text-zinc-500 dark:text-zinc-400 text-sm leading-7 font-medium">
          Base simples para acompanhar conteudos em Markdown e preparar uma futura integracao com CMS, sem backend complexo nesta etapa.
        </p>
      </header>

      <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/admin/" class="rounded-[2rem] bg-white dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800 p-6 shadow-sm hover:border-red-200 transition-colors">
          <span class="text-4xl font-serif font-black text-red-600">{articles.length}</span>
          <p class="text-[10px] font-black uppercase tracking-widest text-zinc-400 mt-2">Noticias publicadas</p>
        </a>
        <a href="/rss.xml" class="rounded-[2rem] bg-white dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800 p-6 shadow-sm hover:border-red-200 transition-colors">
          <span class="text-4xl font-serif font-black text-red-600">RSS</span>
          <p class="text-[10px] font-black uppercase tracking-widest text-zinc-400 mt-2">Feed editorial automatico</p>
        </a>
        <a href="/sitemap-index.xml" class="rounded-[2rem] bg-white dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800 p-6 shadow-sm hover:border-red-200 transition-colors">
          <span class="text-4xl font-serif font-black text-red-600">SEO</span>
          <p class="text-[10px] font-black uppercase tracking-widest text-zinc-400 mt-2">Sitemap estatico</p>
        </a>
      </section>

      <section class="space-y-8">
        <div class="flex items-center justify-between border-b-2 border-red-600 pb-3">
          <h2 class="uppercase text-xs font-black tracking-[0.2em] italic text-zinc-900 dark:text-zinc-50">Noticias na collection</h2>
          <span class="text-[9px] font-black uppercase tracking-widest text-zinc-400">src/content/news</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
          {articles.map((article) => <ArticleCard article={article} variant="pulse" />)}
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
