        const featuredHomeInput = document.querySelector('[data-generated-featured-home]');
        const editorialMedia = (Array.isArray(article.media) ? article.media : []).filter((item) => item?.type !== 'editorialFlag');
        if (featuredHomeInput?.checked) {
          editorialMedia.push({ type: 'editorialFlag', homeSection: 'featured' });
