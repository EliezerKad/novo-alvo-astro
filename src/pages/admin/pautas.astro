        if (statusNode) statusNode.textContent = 'Salvando versao editavel da materia...';

        try {
          const slug = String(article.slug || pitch.slug || pitch.title || id)
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '')
            .slice(0, 120);
          const response = await fetch('/api/admin/articles', {
            method: 'POST',
            headers: {
              'content-type': 'application/json',
              authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({
              id: `draft:${slug || id}`,
              slug,
              title: article.title || pitch.title,
              summary: article.summary || pitch.summary || '',
              bodyHtml: editedBody || article.bodyHtml || '<p></p>',
              category: article.category || pitch.category || 'Politica',
              author: article.author || 'Redacao Novo Alvo',
              status: 'draft',
              coverUrl: editedCoverUrl || article.coverUrl || '',
              coverAlt: editedCoverAlt || article.coverAlt || article.title || pitch.title || '',
              seoDescription: article.seoDescription || article.metaDescription || article.summary || pitch.summary || '',
              keywords: article.keywords || pitch.keywords || '',
              tags: Array.isArray(article.tags) ? article.tags : parseArray(pitch.tags),
              sources: Array.isArray(article.sources) ? article.sources : parseArray(pitch.sources),
              media: editorialMedia,
              readingMinutes: article.readingMinutes || 0,
            }),
          });
          const data = await response.json().catch(() => ({}));
          if (response.status === 401) {
            try {
              localStorage.removeItem('admin-token');
            } catch {}
            redirectToLogin();
            return;
          }
          if (!response.ok) throw new Error(data.error || 'Nao foi possivel abrir a materia para edicao.');
          const articleId = data.article?.id || `draft:${slug || id}`;
          window.location.href = `/admin/nova/?id=${encodeURIComponent(articleId)}`;
        } catch (error) {
          if (statusNode) statusNode.textContent = error.message || 'Falha ao abrir editor.';
          if (button) {
            button.disabled = false;
            button.textContent = previousLabel;
            button.classList.remove('opacity-60');
          }
        }
      };

      const setActiveStatus = () => {
        statusButtons.forEach((button) => {
          const active = button.dataset.statusFilter === status;
          button.className = active
            ? 'rounded-3xl bg-zinc-950 px-5 py-4 text-left text-sm font-black text-white dark:bg-white dark:text-zinc-950'
            : 'rounded-3xl bg-zinc-50 px-5 py-4 text-left text-sm font-black text-zinc-500 transition hover:text-red-600 dark:bg-zinc-900 dark:text-zinc-400';
        });
      };

      const loadPitches = async () => {
        const token = getToken();
        if (!token) return;
        const category = String(categoryFilter?.value || '');
        const params = new URLSearchParams({ status, limit: '100', minSources: visibleMinSources });
        if (category) params.set('category', category);
        if (statusNode) statusNode.textContent = 'Buscando pautas no D1...';

        try {
          const response = await fetch(`/api/admin/pitches?${params.toString()}`, {
            headers: { authorization: `Bearer ${token}` },
          });
          const data = await response.json().catch(() => ({}));
          if (response.status === 401) {
            try {
              localStorage.removeItem('admin-token');
            } catch {}
            redirectToLogin();
            return;
          }
          if (!response.ok) throw new Error(data.error || 'Erro ao buscar pautas.');
          pitches = Array.isArray(data.pitches) ? data.pitches : [];
          render();
          loadIngestDiagnostics();
          loadEditorialStats();
        } catch (error) {
          if (statusNode) statusNode.textContent = error.message || 'Falha ao conectar com o CMS.';
          if (list) list.innerHTML = '';
        }
      };

      const updatePitchStatus = async (button, id, nextStatus, clusterKey = '') => {
        const token = getToken();
        if (!token) return;
        if (!id) {
          if (statusNode) statusNode.textContent = 'Pauta sem ID para atualizar.';
          return;
        }

        const previousLabel = button?.textContent || '';
        if (button) {
          button.disabled = true;
          button.textContent = 'Movendo...';
          button.classList.add('opacity-60');
        }
        if (statusNode) statusNode.textContent = nextStatus === 'reviewed' ? 'Marcando pauta como revisada...' : nextStatus === 'queued' ? 'Aprovando pauta para a fila editorial...' : 'Atualizando pauta...';

        try {
          const response = await fetch('/api/admin/pitches', {
            method: 'PATCH',
            headers: {
              'content-type': 'application/json',
              authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({ id, clusterKey, status: nextStatus }),
          });
          const data = await response.json().catch(() => ({}));
          if (response.status === 401) {
            try {
              localStorage.removeItem('admin-token');
            } catch {}
            redirectToLogin();
            return;
          }
          if (!response.ok) throw new Error(data.error || 'Nao foi possivel atualizar a pauta.');

          if (nextStatus === 'dismissed') {
            const removedCluster = String(clusterKey || '');
            pitches = pitches.filter((pitch) => {
              const pitchId = String(pitch.id || '');
              const pitchCluster = String(pitch.cluster_key || pitch.clusterKey || '');
              return pitchId !== String(id) && (!removedCluster || pitchCluster !== removedCluster);
            });
            render();
            if (statusNode) statusNode.textContent = 'Pauta descartada.';
            return;
          }

          if (nextStatus === 'reviewed') {
            const pitch = pitches.find((item) => String(item.id || '') === String(id));
            if (pitch) pitch.status = 'reviewed';
            render();
            if (statusNode) statusNode.textContent = 'Pauta revisada. Ela continua aqui para voce aprovar para a fila.';
            return;
          }

          if (nextStatus === 'queued' || nextStatus === 'converted') {
            status = nextStatus;
            setActiveStatus();
          }
          await loadPitches();
        } catch (error) {
          if (statusNode) statusNode.textContent = error.message || 'Falha ao atualizar pauta.';
        } finally {
          if (button) {
            button.disabled = false;
            button.textContent = previousLabel;
            button.classList.remove('opacity-60');
          }
        }
      };

      const dismissVisiblePitches = async () => {
        const token = getToken();
        if (!token) return;
        if (!['new', 'reviewed'].includes(status)) {
          if (statusNode) statusNode.textContent = 'Descarte em massa vale apenas para Novas ou Revisadas.';
          return;
        }
        if (!pitches.length) {
          if (statusNode) statusNode.textContent = 'Nenhuma pauta para descartar nesta leva.';
          return;
        }

        const category = String(categoryFilter?.value || '');
        const statusLabel = status === 'new' ? 'Novas' : 'Revisadas';
        const label = category ? `${pitches.length} pauta(s) de ${category}` : `${pitches.length} pauta(s) em ${statusLabel}`;
        const confirmed = window.confirm(`Descartar ${label}? Elas nao voltam nas proximas ingestoes.`);
        if (!confirmed) return;

        const previousLabel = dismissVisibleButton?.textContent || '';
        if (dismissVisibleButton) {
          dismissVisibleButton.disabled = true;
          dismissVisibleButton.textContent = 'Descartando...';
          dismissVisibleButton.classList.add('opacity-60');
        }
        if (statusNode) statusNode.textContent = 'Descartando leva editorial...';

        try {
          const response = await fetch('/api/admin/pitches', {
            method: 'PATCH',
            headers: {
              'content-type': 'application/json',
              authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({ all: true, status: 'dismissed', currentStatus: status, category, minSources: Number(visibleMinSources) }),
          });
          const data = await response.json().catch(() => ({}));
          if (response.status === 401) {
            try {
              localStorage.removeItem('admin-token');
            } catch {}
            redirectToLogin();
            return;
          }
          if (!response.ok) throw new Error(data.error || 'Nao foi possivel descartar a leva.');
          pitches = [];
          render();
          loadIngestDiagnostics();
          if (statusNode) statusNode.textContent = `${Number(data.dismissed || 0)} pauta(s) descartada(s).`;
        } catch (error) {
          if (statusNode) statusNode.textContent = error.message || 'Falha ao descartar pautas.';
        } finally {
          if (dismissVisibleButton) {
            dismissVisibleButton.disabled = false;
            dismissVisibleButton.textContent = previousLabel;
            dismissVisibleButton.classList.remove('opacity-60');
          }
        }
      };

      const updatePitchImageRole = async (button, id, imageUrl, imageRole) => {
        const token = getToken();
        if (!token || !id || !imageUrl || !imageRole) return;
        const previousLabel = button?.textContent || '';
        if (button) {
          button.disabled = true;
          button.textContent = 'Salvando...';
          button.classList.add('opacity-60');
        }
        if (statusNode) statusNode.textContent = 'Salvando escolha visual da pauta...';

        try {
          const response = await fetch('/api/admin/pitches', {
            method: 'PATCH',
            headers: {
              'content-type': 'application/json',
              authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({ id, imageUrl, imageRole }),
          });
          const data = await response.json().catch(() => ({}));
          if (response.status === 401) {
            try {
              localStorage.removeItem('admin-token');
            } catch {}
            redirectToLogin();
            return;
          }
          if (!response.ok) throw new Error(data.error || 'Nao foi possivel salvar a escolha da imagem.');
          const pitch = pitches.find((item) => String(item.id || '') === String(id));
          if (pitch && Array.isArray(data.imageCandidates)) {
            pitch.image_candidates = JSON.stringify(data.imageCandidates);
          }
          if (statusNode) statusNode.textContent = imageRole === 'cover' ? 'Capa definida para esta pauta.' : imageRole === 'body' ? 'Imagem marcada para o corpo da matéria.' : 'Imagem ignorada nesta pauta.';
          if (activePitchMode === 'article' && String(activePitchId) === String(id)) {
            if (statusNode) statusNode.textContent += ' A materia gerada foi preservada.';
          } else {
            openPitchPreview(id, activePitchMode || 'pitch');
          }
        } catch (error) {
          if (statusNode) statusNode.textContent = error.message || 'Falha ao salvar imagem.';
        } finally {
          if (button) {
            button.disabled = false;
            button.textContent = previousLabel;
            button.classList.remove('opacity-60');
          }
        }
      };

      const fetchPitchImages = async (button, id, clusterKey = '') => {
        const token = getToken();
        if (!token || !id) return;
        const previousLabel = button?.textContent || '';
        if (button) {
          button.disabled = true;
          button.textContent = 'Buscando...';
          button.classList.add('opacity-60');
        }
        if (statusNode) statusNode.textContent = 'Mesa de imagens vasculhando metadados das fontes...';

        try {
          const response = await fetch('/api/admin/pitch-images', {
            method: 'POST',
            headers: {
              'content-type': 'application/json',
              authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({ id, clusterKey, limit: 6 }),
          });
          const data = await response.json().catch(() => ({}));
          if (response.status === 401) {
            try {
              localStorage.removeItem('admin-token');
            } catch {}
            redirectToLogin();
            return;
          }
          if (!response.ok) throw new Error(data.error || 'Nao foi possivel buscar imagens.');
          const pitch = pitches.find((item) => String(item.id || '') === String(id));
          if (pitch && Array.isArray(data.candidates)) {
            pitch.image_candidates = JSON.stringify(data.candidates);
          }
          if (statusNode) {
            statusNode.textContent = Number(data.found || 0)
              ? `Mesa visual encontrou ${Number(data.found || 0)} imagem(ns) em ${Number(data.tried || 0)} fonte(s).`
              : `Nenhuma imagem editorial segura encontrada em ${Number(data.tried || 0)} fonte(s).`;
          }
          if (activePitchMode === 'article' && String(activePitchId) === String(id)) {
            if (statusNode) statusNode.textContent += ' A materia gerada foi preservada.';
          } else {
            openPitchPreview(id, activePitchMode || 'pitch');
          }
        } catch (error) {
          if (statusNode) statusNode.textContent = error.message || 'Falha ao buscar imagens.';
        } finally {
          if (button) {
            button.disabled = false;
            button.textContent = previousLabel;
            button.classList.remove('opacity-60');
          }
        }
      };

      statusButtons.forEach((button) => {
        button.addEventListener('click', () => {
          status = button.dataset.statusFilter || 'new';
          setActiveStatus();
          loadPitches();
        });
      });

      list?.addEventListener('click', (event) => {
        const previewButton = event.target.closest('[data-pitch-preview]');
        if (previewButton) {
          openPitchPreview(previewButton.dataset.pitchPreview || '');
          return;
        }

        const articleButton = event.target.closest('[data-pitch-article]');
        if (articleButton) {
          openPitchPreview(articleButton.dataset.pitchArticle || '', 'article');
          return;
        }

        const inlineArticleButton = event.target.closest('[data-pitch-article-inline]');
        if (inlineArticleButton) {
          openPitchPreview(inlineArticleButton.dataset.pitchArticleInline || '', 'article');
          return;
        }

        const button = event.target.closest('[data-pitch-action]');
        if (!button) return;
        updatePitchStatus(button, button.dataset.pitchId || '', button.dataset.pitchAction || 'reviewed', button.dataset.pitchCluster || '');
      });

      modalClose?.addEventListener('click', closePitchPreview);
      modal?.addEventListener('click', (event) => {
        const editButton = event.target.closest('[data-edit-generated-article]');
        if (editButton) {
          editGeneratedArticle(editButton, editButton.dataset.editGeneratedArticle || '');
          return;
        }

        const queueButton = event.target.closest('[data-send-generated-to-queue]');
        if (queueButton) {
          updatePitchStatus(queueButton, queueButton.dataset.sendGeneratedToQueue || '', 'queued', queueButton.dataset.pitchCluster || '').then(closePitchPreview);
          return;
        }

        if (event.target.closest('[data-close-generated-article]')) {
          closePitchPreview();
          return;
        }

        const removeGeneratedImage = event.target.closest('[data-remove-generated-image]');
        if (removeGeneratedImage) {
          removeGeneratedImage.closest('[data-generated-image-block]')?.remove();
          const article = generatedArticles.get(String(activePitchId || ''));
          const editedBody = document.querySelector(`[data-generated-editor="${CSS.escape(String(activePitchId || ''))}"] [data-generated-body-edit]`)?.innerHTML;
          if (article && editedBody) article.bodyHtml = editedBody;
          if (statusNode) statusNode.textContent = 'Imagem removida do corpo da materia. Envie para fila ou abra no editor para salvar.';
          return;
        }

        const imageButton = event.target.closest('[data-pitch-image-role]');
        if (imageButton) {
          updatePitchImageRole(
            imageButton,
            imageButton.dataset.pitchId || '',
            imageButton.dataset.imageUrl || '',
            imageButton.dataset.pitchImageRole || '',
          );
          return;
        }

        const fetchImagesButton = event.target.closest('[data-fetch-pitch-images]');
        if (fetchImagesButton) {
          fetchPitchImages(fetchImagesButton, fetchImagesButton.dataset.fetchPitchImages || '', fetchImagesButton.dataset.pitchCluster || '');
          return;
        }

        const inlineArticleButton = event.target.closest('[data-pitch-article-inline]');
        if (inlineArticleButton) {
          openPitchPreview(inlineArticleButton.dataset.pitchArticleInline || '', 'article');
          return;
        }
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closePitchPreview();
      });

      filterInput?.addEventListener('input', render);
      categoryFilter?.addEventListener('change', loadPitches);
      refreshButton?.addEventListener('click', loadPitches);
      dismissVisibleButton?.addEventListener('click', dismissVisiblePitches);
      setActiveStatus();
      loadPitches();
      loadIngestDiagnostics();
    })();
  </script>
</AdminLayout>
