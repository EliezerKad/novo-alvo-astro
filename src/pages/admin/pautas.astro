---
import AdminLayout from '../../layouts/AdminLayout.astro';

const categories = [
  'Politica',
  'Economia',
  'Brasil',
  'Mundo',
  'Saude',
  'Tecnologia',
  'Esportes',
  'Famosos',
  'Cinema',
  'Entretenimento',
  'Ciencia',
  'Educacao',
  'Cultura',
  'Lifestyle',
  'Games',
  'Moda',
  'Musica',
  'Futebol',
  'Ocorrencias',
];
---

<AdminLayout title="Pautas editoriais | Admin Novo Alvo" active="pitches">
  <section class="space-y-6" data-pitches-admin>
    <header class="overflow-hidden rounded-[2rem] border border-white/70 bg-white/78 p-6 shadow-[0_24px_80px_rgba(15,23,42,0.07)] backdrop-blur-2xl dark:border-zinc-800 dark:bg-zinc-950/78">
      <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
        <div>
          <span class="text-[10px] font-black uppercase tracking-[0.35em] text-red-600">Radar editorial</span>
          <h1 class="admin-display mt-3 text-4xl md:text-6xl">Pautas em curadoria</h1>
          <p class="mt-3 max-w-2xl text-sm font-medium leading-6 text-zinc-500 dark:text-zinc-400">
            Sinais coletados pela engine de descoberta e agrupados como ideias de pauta. Nada aqui é publicado automaticamente.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <button type="button" data-refresh-pitches class="rounded-2xl border border-zinc-200 bg-white px-5 py-4 text-[10px] font-black uppercase tracking-widest text-zinc-500 transition hover:border-red-600 hover:text-red-600 dark:border-zinc-800 dark:bg-zinc-900">
            Atualizar
          </button>
          <button type="button" data-dismiss-visible-pitches class="group inline-flex items-center gap-2 rounded-2xl border border-zinc-200 bg-white/70 px-4 py-3 text-[10px] font-black uppercase tracking-widest text-zinc-500 transition hover:border-red-300 hover:bg-red-50 hover:text-red-700 dark:border-zinc-800 dark:bg-zinc-900/70 dark:text-zinc-400 dark:hover:border-red-950 dark:hover:bg-red-950/20 dark:hover:text-red-300" title="Descartar todas as pautas visiveis nesta aba">
            <span class="flex h-5 w-5 items-center justify-center rounded-full bg-zinc-100 text-xs text-zinc-500 transition group-hover:bg-red-600 group-hover:text-white dark:bg-zinc-800">x</span>
            Limpar visiveis
          </button>
          <a href="/admin/nova/" class="rounded-2xl bg-red-600 px-5 py-4 text-[10px] font-black uppercase tracking-widest text-white shadow-xl shadow-red-600/20 transition hover:-translate-y-0.5 hover:bg-red-500">
            Nova matéria
          </a>
        </div>
      </div>

      <div class="mt-6 grid gap-3 md:grid-cols-[1fr_220px]">
        <div class="grid gap-3 md:grid-cols-4">
          <button type="button" data-status-filter="new" class="rounded-3xl bg-zinc-950 px-5 py-4 text-left text-sm font-black text-white dark:bg-white dark:text-zinc-950">Novas</button>
          <button type="button" data-status-filter="reviewed" class="rounded-3xl bg-zinc-50 px-5 py-4 text-left text-sm font-black text-zinc-500 transition hover:text-red-600 dark:bg-zinc-900 dark:text-zinc-400">Revisadas</button>
          <button type="button" data-status-filter="queued" class="rounded-3xl bg-zinc-50 px-5 py-4 text-left text-sm font-black text-zinc-500 transition hover:text-red-600 dark:bg-zinc-900 dark:text-zinc-400">Fila</button>
          <button type="button" data-status-filter="converted" class="rounded-3xl bg-zinc-50 px-5 py-4 text-left text-sm font-black text-zinc-500 transition hover:text-red-600 dark:bg-zinc-900 dark:text-zinc-400">Convertidas</button>
        </div>
        <label>
          <span class="sr-only">Filtrar categoria</span>
          <select data-category-filter class="h-full w-full rounded-3xl border border-zinc-200 bg-zinc-50 px-5 py-4 text-sm font-black text-zinc-600 outline-none transition focus:border-red-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300">
            <option value="">Todas categorias</option>
            {categories.map((category) => <option value={category}>{category}</option>)}
          </select>
        </label>
      </div>
    </header>

    <section class="grid items-start gap-3 rounded-[2rem] border border-white/70 bg-white/70 p-4 shadow-[0_24px_80px_rgba(15,23,42,0.05)] backdrop-blur-2xl dark:border-zinc-800 dark:bg-zinc-950/70 lg:grid-cols-[1fr_0.86fr_0.92fr]">
      <div class="rounded-[1.5rem] bg-zinc-950 p-4 text-white dark:bg-white dark:text-zinc-950">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.28em] text-red-400">Pulso da ingestao</p>
            <strong class="mt-2 block text-2xl font-black" data-ingest-latest>Sem historico ainda</strong>
          </div>
          <span class="rounded-full bg-white/10 px-3 py-1 text-[9px] font-black uppercase tracking-widest text-white/70 dark:bg-zinc-950/10 dark:text-zinc-600" data-ingest-state>Diagnostico</span>
        </div>
        <div class="mt-4 grid grid-cols-3 gap-2">
          <div class="rounded-2xl bg-white/8 p-3 dark:bg-zinc-950/5">
            <p class="text-[9px] font-black uppercase tracking-widest text-white/50 dark:text-zinc-500">Itens</p>
            <strong class="mt-1 block text-lg" data-ingest-items>0</strong>
          </div>
          <div class="rounded-2xl bg-white/8 p-3 dark:bg-zinc-950/5">
            <p class="text-[9px] font-black uppercase tracking-widest text-white/50 dark:text-zinc-500">Clusters</p>
            <strong class="mt-1 block text-lg" data-ingest-clusters>0</strong>
          </div>
          <div class="rounded-2xl bg-white/8 p-3 dark:bg-zinc-950/5">
            <p class="text-[9px] font-black uppercase tracking-widest text-white/50 dark:text-zinc-500">Salvas</p>
            <strong class="mt-1 block text-lg" data-ingest-saved>0</strong>
          </div>
        </div>
        <p class="mt-3 text-[11px] font-bold leading-5 text-white/55 dark:text-zinc-500" data-ingest-note>
          Depois de ativar a tabela de historico, cada rodada aparece aqui com itens, clusters e descartes.
        </p>
      </div>

      <div class="rounded-[1.5rem] border border-zinc-100 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-950">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.28em] text-zinc-400">Categorias captadas</p>
            <strong class="mt-2 block text-xs leading-5 text-zinc-700 dark:text-zinc-200" data-ingest-categories-title>Aguardando leitura...</strong>
          </div>
          <span class="rounded-full bg-red-50 px-3 py-1 text-[9px] font-black uppercase tracking-widest text-red-700 dark:bg-red-950/30 dark:text-red-300" data-ingest-skipped>0 ignoradas</span>
        </div>
        <div class="mt-3 flex max-h-24 flex-wrap gap-2 overflow-hidden" data-ingest-categories>
          <span class="rounded-full bg-zinc-100 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-zinc-400 dark:bg-zinc-900">Carregando</span>
        </div>
      </div>

      <div class="rounded-[1.5rem] border border-zinc-100 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-950">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.28em] text-zinc-400">Estoque editorial</p>
            <strong class="mt-2 block text-xs leading-5 text-zinc-700 dark:text-zinc-200" data-stock-title>Conectando D1...</strong>
          </div>
          <a href="/admin/fontes/" class="rounded-full bg-zinc-950 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-white transition hover:bg-red-600 dark:bg-white dark:text-zinc-950">
            Fontes
          </a>
        </div>
        <div class="mt-4 grid grid-cols-3 gap-2">
          <div class="rounded-2xl bg-zinc-50 p-3 dark:bg-zinc-900">
            <p class="text-[9px] font-black uppercase tracking-widest text-zinc-400">RSS</p>
            <strong class="mt-1 block text-lg" data-stock-sources>0</strong>
          </div>
          <div class="rounded-2xl bg-zinc-50 p-3 dark:bg-zinc-900">
            <p class="text-[9px] font-black uppercase tracking-widest text-zinc-400">Novas</p>
            <strong class="mt-1 block text-lg" data-stock-new>0</strong>
          </div>
          <div class="rounded-2xl bg-zinc-50 p-3 dark:bg-zinc-900">
            <p class="text-[9px] font-black uppercase tracking-widest text-zinc-400">Fila</p>
            <strong class="mt-1 block text-lg" data-stock-queued>0</strong>
          </div>
        </div>
        <p class="mt-3 text-[11px] font-bold leading-5 text-zinc-500 dark:text-zinc-400" data-stock-note>
          Mostra o estoque real do banco, independente da ultima rodada de ingestao.
        </p>
        <div class="mt-3 flex max-h-20 flex-wrap gap-2 overflow-hidden" data-stock-categories>
          <span class="rounded-full bg-zinc-100 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-zinc-400 dark:bg-zinc-900">Carregando</span>
        </div>
      </div>
    </section>

    <section class="overflow-hidden rounded-[2rem] border border-white/70 bg-white/82 shadow-[0_24px_80px_rgba(15,23,42,0.07)] backdrop-blur-2xl dark:border-zinc-800 dark:bg-zinc-950/82">
      <div class="flex flex-col gap-3 border-b border-zinc-100 p-5 dark:border-zinc-800 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="text-[10px] font-black uppercase tracking-[0.28em] text-zinc-400">Banco editorial D1</p>
          <strong class="mt-1 block text-sm text-zinc-700 dark:text-zinc-200" data-pitches-status>Carregando pautas...</strong>
        </div>
        <label class="relative block md:w-80">
          <span class="sr-only">Filtrar pautas</span>
          <input data-filter-pitches class="w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm font-bold outline-none transition focus:border-red-600 dark:border-zinc-800 dark:bg-zinc-900" placeholder="Filtrar por título, categoria..." />
        </label>
      </div>

      <div data-empty-state class="hidden p-10 text-center">
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-3xl bg-zinc-100 text-2xl dark:bg-zinc-900">+</span>
        <h2 class="admin-display mt-4 text-3xl">Nenhuma pauta encontrada</h2>
        <p class="mx-auto mt-2 max-w-md text-sm font-medium leading-6 text-zinc-500" data-empty-copy>Quando o script de ingestão rodar, os sinais editoriais aparecem aqui.</p>
      </div>

      <section data-gnews-pitches-section class="hidden border-b border-zinc-100 bg-red-50/40 p-5 dark:border-zinc-800 dark:bg-red-950/10">
        <div class="mb-4 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.32em] text-red-600">Radar GNews</p>
            <h2 class="admin-display mt-2 text-3xl leading-none">Pautas vindas do GNews</h2>
            <p class="mt-2 max-w-2xl text-xs font-bold leading-5 text-zinc-500 dark:text-zinc-400">
              Sinais captados pela API GNews ficam separados aqui para comparar com o estoque RSS.
            </p>
          </div>
          <span class="rounded-full bg-red-600 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-white" data-gnews-pitches-count>0 pautas</span>
        </div>
        <div data-gnews-pitches-list class="divide-y divide-red-100 overflow-hidden rounded-[1.5rem] border border-red-100 bg-white/80 dark:divide-red-950/50 dark:border-red-950/50 dark:bg-zinc-950/70"></div>
      </section>

      <div data-pitches-list class="divide-y divide-zinc-100 dark:divide-zinc-800">
        <div class="p-5">
          <div class="h-28 animate-pulse rounded-3xl bg-zinc-100 dark:bg-zinc-900"></div>
        </div>
      </div>
    </section>

    <div class="fixed inset-0 z-[80] hidden items-center justify-center bg-zinc-950/55 p-4 backdrop-blur-sm" data-pitch-modal>
      <article class="max-h-[88vh] w-full max-w-4xl overflow-hidden rounded-[2rem] border border-white/70 bg-white shadow-[0_30px_120px_rgba(15,23,42,0.25)] dark:border-zinc-800 dark:bg-zinc-950">
        <header class="flex items-start justify-between gap-4 border-b border-zinc-100 p-5 dark:border-zinc-800 md:p-7">
          <div>
            <span class="text-[10px] font-black uppercase tracking-[0.35em] text-red-600" data-pitch-modal-category>Pauta</span>
            <h2 class="admin-display mt-3 text-3xl leading-none md:text-5xl" data-pitch-modal-title>Pauta editorial</h2>
          </div>
          <button type="button" class="rounded-2xl bg-zinc-950 px-4 py-3 text-[10px] font-black uppercase tracking-widest text-white transition hover:bg-red-600 dark:bg-white dark:text-zinc-950" data-pitch-modal-close>
            Fechar
          </button>
        </header>

        <div class="max-h-[calc(88vh-132px)] overflow-y-auto p-5 md:p-7">
          <div data-pitch-modal-body class="space-y-6"></div>
        </div>
      </article>
    </div>
  </section>

  <style is:global>
    .generated-article-body {
      color: inherit;
      font-size: 1.02rem;
      line-height: 1.9;
    }

    .generated-article-body h2,
    .generated-article-body h3 {
      margin: 1.75rem 0 0.7rem;
      color: inherit;
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      font-weight: 900;
      letter-spacing: -0.025em;
      line-height: 1.08;
    }

    .generated-article-body h2 {
      font-size: clamp(1.25rem, 2.3vw, 1.8rem);
    }

    .generated-article-body h3 {
      font-size: clamp(1.08rem, 2vw, 1.38rem);
    }

    .generated-article-body p {
      margin: 0 0 1.25rem;
      max-width: 70ch;
      color: rgb(63 63 70);
    }

    .dark .generated-article-body p {
      color: rgb(212 212 216);
    }

    .generated-article-body strong {
      color: inherit;
      font-weight: 900;
    }

    .generated-article-body .editorial-inline-image {
      position: relative;
      margin: 2rem 0;
      overflow: hidden;
      border-radius: 1.6rem;
      background: rgb(244 241 232);
    }

    .generated-article-body .editorial-inline-image img {
      display: block;
      width: 100%;
      max-height: 440px;
      object-fit: cover;
    }

    .generated-article-body .editorial-inline-image figcaption {
      padding: 0.75rem 1rem 1rem;
      color: rgb(113 113 122);
      font-size: 0.78rem;
      font-weight: 800;
      line-height: 1.45;
    }

    .dark .generated-article-body .editorial-inline-image {
      background: rgb(24 24 27);
    }

    .generated-image-remove {
      position: absolute;
      right: 0.75rem;
      top: 0.75rem;
      z-index: 2;
      border-radius: 999px;
      background: rgb(9 9 11 / 0.86);
      color: white;
      padding: 0.55rem 0.75rem;
      font-size: 0.58rem;
      font-weight: 900;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      opacity: 0;
      transform: translateY(-4px);
      transition: 0.18s ease;
    }

    .generated-article-body [data-generated-image-block]:hover .generated-image-remove,
    .generated-image-remove:focus-visible {
      opacity: 1;
      transform: translateY(0);
    }
  </style>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-pitches-admin]');
      if (!root) return;

      const list = document.querySelector('[data-pitches-list]');
      const gnewsSection = document.querySelector('[data-gnews-pitches-section]');
      const gnewsList = document.querySelector('[data-gnews-pitches-list]');
      const gnewsCount = document.querySelector('[data-gnews-pitches-count]');
      const statusNode = document.querySelector('[data-pitches-status]');
      const emptyState = document.querySelector('[data-empty-state]');
      const filterInput = document.querySelector('[data-filter-pitches]');
      const refreshButton = document.querySelector('[data-refresh-pitches]');
      const dismissVisibleButton = document.querySelector('[data-dismiss-visible-pitches]');
      const ingestLatest = document.querySelector('[data-ingest-latest]');
      const ingestState = document.querySelector('[data-ingest-state]');
      const ingestItems = document.querySelector('[data-ingest-items]');
      const ingestClusters = document.querySelector('[data-ingest-clusters]');
      const ingestSaved = document.querySelector('[data-ingest-saved]');
      const ingestSkipped = document.querySelector('[data-ingest-skipped]');
      const ingestNote = document.querySelector('[data-ingest-note]');
      const ingestCategoriesTitle = document.querySelector('[data-ingest-categories-title]');
      const ingestCategories = document.querySelector('[data-ingest-categories]');
      const stockTitle = document.querySelector('[data-stock-title]');
      const stockSources = document.querySelector('[data-stock-sources]');
      const stockNew = document.querySelector('[data-stock-new]');
      const stockQueued = document.querySelector('[data-stock-queued]');
      const stockNote = document.querySelector('[data-stock-note]');
      const stockCategories = document.querySelector('[data-stock-categories]');
      const emptyCopy = document.querySelector('[data-empty-copy]');
      const categoryFilter = document.querySelector('[data-category-filter]');
      const statusButtons = [...document.querySelectorAll('[data-status-filter]')];
      const modal = document.querySelector('[data-pitch-modal]');
      const modalTitle = document.querySelector('[data-pitch-modal-title]');
      const modalCategory = document.querySelector('[data-pitch-modal-category]');
      const modalBody = document.querySelector('[data-pitch-modal-body]');
      const modalClose = document.querySelector('[data-pitch-modal-close]');
      const visibleMinSources = '5';
      let pitches = [];
      let status = 'new';
      let editorialStats = null;
      const generatedArticles = new Map();
      let activePitchId = '';
      let activePitchMode = 'pitch';

      const escapeHtml = (value) =>
        String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');

      const redirectToLogin = () => {
        const next = `${window.location.pathname}${window.location.search}${window.location.hash}`;
        window.location.href = `/redacao/?next=${encodeURIComponent(next)}`;
      };

      const getToken = () => {
        try {
          const token = localStorage.getItem('admin-token') || '';
          if (token) return token;
        } catch {}
        redirectToLogin();
        return '';
      };

      const parseArray = (value) => {
        try {
          const parsed = JSON.parse(value || '[]');
          return Array.isArray(parsed) ? parsed : [];
        } catch {
          return [];
        }
      };

      const imageUrl = (image) => {
        if (!image) return '';
        if (typeof image === 'string') return image;
        return String(image.url || image.src || '');
      };

      const imageRole = (image) => {
        if (!image || typeof image !== 'object') return '';
        return String(image.role || '');
      };

      const pitchProvider = (pitch) => {
        const sources = parseArray(pitch?.sources);
        if (sources.some((source) => String(source?.provider || '').toLowerCase() === 'gnews')) return 'gnews';
        const primaryUrl = String(pitch?.primary_url || pitch?.primaryUrl || '');
        if (/gnews\.io/i.test(primaryUrl)) return 'gnews';
        return 'rss';
      };

      const isGNewsPitch = (pitch) => pitchProvider(pitch) === 'gnews';

      const formatDate = (value) => {
        if (!value) return 'Sem data';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return 'Sem data';
        return new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }).format(date);
      };

      const parseObject = (value) => {
        try {
          const parsed = typeof value === 'string' ? JSON.parse(value || '{}') : value;
          return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};
        } catch {
          return {};
        }
      };

      const htmlToText = (value) => {
        const holder = document.createElement('div');
        holder.innerHTML = String(value || '');
        return String(holder.textContent || holder.innerText || '').replace(/\s+/g, ' ').trim();
      };

      const normalized = (value) =>
        String(value || '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase();

      const wordSet = (value) =>
        new Set(
          normalized(value)
            .replace(/[^a-z0-9\s]/g, ' ')
            .split(/\s+/)
            .filter((word) => word.length > 3),
        );

      const overlapRatio = (left, right) => {
        const a = wordSet(left);
        const b = wordSet(right);
        if (!a.size || !b.size) return 0;
        let hits = 0;
        a.forEach((word) => {
          if (b.has(word)) hits += 1;
        });
        return hits / Math.min(a.size, b.size);
      };

      const categorySignals = [
        ['Futebol', /\b(flamengo|corinthians|palmeiras|vasco|santos|botafogo|fluminense|gremio|cruzeiro|atletico|serie\s+[ab]|brasileirao|copa do brasil|libertadores|tecnico|jogador|gol|cbf|neymar|ancelotti)\b/i],
        ['Esportes', /\b(olimpiada|volei|basquete|nba|tenis|ufc|mma|corrida|atleta|podio|competicao)\b/i],
        ['Entretenimento', /\b(reality|show|programa|tv|novela|streaming|audiencia|apresentador|participante|casa do patrao|bbb|festival)\b/i],
        ['Musica', /\b(album|single|turne|show|cantor|cantora|banda|musica|spotify|palco|fonografico)\b/i],
        ['Cinema', /\b(filme|cinema|diretor|atriz|ator|oscar|cannes|bilheteria|roteiro|longa|curta)\b/i],
        ['Politica', /\b(governo|congresso|camara|senado|deputado|senador|presidente|ministro|stf|eleicao|partido|pl|pt)\b/i],
        ['Economia', /\b(juros|inflacao|banco central|mercado|bolsa|dolar|credito|varejo|arrecadacao|pib|preco)\b/i],
        ['Tecnologia', /\b(ia|chip|software|app|big tech|dados|celular|android|iphone|seguranca cibernetica|vazamento)\b/i],
        ['Saude', /\b(saude|hospital|medico|vacina|doenca|tratamento|ansiedade|sus|medicamento|paciente)\b/i],
        ['Educacao', /\b(enem|escola|universidade|professor|aluno|vestibular|mec|inep|educacao|carreira)\b/i],
        ['Ocorrencias', /\b(acidente|mortes|feridos|incendio|colisao|tiroteio|desabamento|explosao|resgate)\b/i],
      ];

      const inferCategory = (pitch, article) => {
        const text = `${pitch?.title || ''} ${pitch?.summary || ''} ${article?.title || ''} ${article?.summary || ''} ${htmlToText(article?.bodyHtml || '')}`;
        const match = categorySignals.find(([, pattern]) => pattern.test(text));
        return match?.[0] || '';
      };

      const imageCandidateUrls = (pitch, article) => {
        const pitchImages = parseArray(pitch?.image_candidates).map(imageUrl).filter(Boolean);
        const articleImages = [article?.coverUrl, article?.featuredImageUrl, article?.inlineImageUrl]
          .map((item) => String(item || '').trim())
          .filter(Boolean);
        return [...new Set([...articleImages, ...pitchImages])];
      };

      const weakImagePattern = /(googleusercontent\.com.*news|gstatic\.com|google\.com|google.*logo|news\.google|images\.unsplash\.com|source\.unsplash\.com|picsum\.photos|og-default\.svg)/i;

      const classifyAgentItem = (severity) => {
        if (severity === 'blocker') return 'border-red-200 bg-red-50 text-red-900 dark:border-red-950 dark:bg-red-950/30 dark:text-red-100';
        if (severity === 'warn') return 'border-amber-200 bg-amber-50 text-amber-900 dark:border-amber-950 dark:bg-amber-950/30 dark:text-amber-100';
        return 'border-emerald-200 bg-emerald-50 text-emerald-900 dark:border-emerald-950 dark:bg-emerald-950/30 dark:text-emerald-100';
      };

      const runEditorialAgents = (pitch, article = {}) => {
        const sources = parseArray(pitch?.sources);
        const sourceCount = Number(pitch?.source_count || sources.length || 0);
        const score = Number(pitch?.score || 0);
        const title = String(article?.title || pitch?.title || '');
        const bodyText = htmlToText(article?.bodyHtml || '');
        const summary = String(article?.summary || pitch?.summary || '');
        const inferredCategory = inferCategory(pitch, article);
        const currentCategory = String(article?.category || pitch?.category || '');
        const urls = imageCandidateUrls(pitch, article);
        const hasWeakImage = urls.some((url) => weakImagePattern.test(url));
        const hasUsableImage = urls.some((url) => !weakImagePattern.test(url));
        const sourceTitles = sources.map((source) => String(source?.title || '')).filter(Boolean);
        const copiedTitle = sourceTitles.some((sourceTitle) => overlapRatio(title, sourceTitle) >= 0.82);
        const staleHours = pitch?.updated_at ? (Date.now() - new Date(pitch.updated_at).getTime()) / 36e5 : 0;
        const vagueAgent = /\b(um pre-candidato|um politico|uma autoridade|um dirigente|uma celebridade|uma fonte|um especialista)\b/i.test(`${summary} ${bodyText}`);
        const internalLeak = /\b(pauta consolidada|cluster|engine|prompt|fontes consolidadas|fila editorial|processo editorial|portal novo alvo registra|modelo de seguranca)\b/i.test(`${title} ${summary} ${bodyText}`);
        const shortBody = article?.bodyHtml && bodyText.length < 1800;
        const items = [];

        if (sourceCount < 8) {
          items.push({ agent: 'Reality Checker', severity: 'blocker', text: `So ${sourceCount} fonte(s). A sintese forte pede no minimo 8.` });
        } else if (sourceCount < 10) {
          items.push({ agent: 'Reality Checker', severity: 'warn', text: `${sourceCount} fontes. Publicavel, mas abaixo do ideal editorial de 10+.` });
        } else {
          items.push({ agent: 'Reality Checker', severity: 'ok', text: `${sourceCount} fontes. Boa densidade para sintese.` });
        }

        if (inferredCategory && currentCategory && inferredCategory !== currentCategory) {
          items.push({ agent: 'Category Guardian', severity: 'warn', text: `Sinal de categoria: ${inferredCategory}. Atual: ${currentCategory}. Revisar antes da fila.` });
        } else {
          items.push({ agent: 'Category Guardian', severity: 'ok', text: currentCategory ? `Categoria coerente: ${currentCategory}.` : 'Categoria pendente.' });
        }

        if (/^radar\b/i.test(title) || copiedTitle) {
          items.push({ agent: 'Headline Doctor', severity: 'warn', text: 'Titulo parece repetitivo ou proximo demais de uma fonte. Reescrever com angulo proprio.' });
        } else {
          items.push({ agent: 'Headline Doctor', severity: 'ok', text: 'Titulo nao aciona alerta forte de copia/repeticao.' });
        }

        if (vagueAgent) {
          items.push({ agent: 'Fact Integrity', severity: 'blocker', text: 'Ha sujeito vago em frase sensivel. Nomear agente ativo ou reescrever o trecho.' });
        } else if (internalLeak) {
          items.push({ agent: 'Fact Integrity', severity: 'blocker', text: 'Texto vazou termo interno de pauta/engine. Nao enviar para fila sem editar.' });
        } else if (shortBody) {
          items.push({ agent: 'Fact Integrity', severity: 'warn', text: 'Materia curta. Verificar se cumpre lide, consequencia e fechamento.' });
        } else {
          items.push({ agent: 'Fact Integrity', severity: 'ok', text: 'Sem vazamento interno ou sujeito vago evidente.' });
        }

        if (!hasUsableImage) {
          items.push({ agent: 'Image Desk', severity: 'warn', text: 'Sem imagem real forte. Defina capa manual ou publique com fallback consciente.' });
        } else if (hasWeakImage) {
          items.push({ agent: 'Image Desk', severity: 'warn', text: 'Ha imagem fraca/generica entre candidatas. Evite Google logo, Unsplash repetido e placeholder.' });
        } else {
          items.push({ agent: 'Image Desk', severity: 'ok', text: 'Mesa visual encontrou imagem potencialmente utilizavel.' });
        }

        if (score >= 900 && sourceCount >= 8 && hasUsableImage) {
          items.push({ agent: 'Home Desk', severity: 'ok', text: 'Candidata forte a destaque principal ou Agora no Portal.' });
        } else if (score >= 850) {
          items.push({ agent: 'Home Desk', severity: 'warn', text: 'Boa pauta, mas precisa de imagem/categoria/texto antes de virar destaque.' });
        }

        if (staleHours > 24) {
          items.push({ agent: 'Queue Sentinel', severity: 'warn', text: `Pauta com mais de ${Math.round(staleHours)}h. Checar validade antes de publicar.` });
        }

        return items;
      };

      const renderAgentsPanel = (pitch, article = {}) => {
        const items = runEditorialAgents(pitch, article);
        const blockers = items.filter((item) => item.severity === 'blocker').length;
        const warnings = items.filter((item) => item.severity === 'warn').length;
        const label = blockers ? `${blockers} bloqueio(s)` : warnings ? `${warnings} alerta(s)` : 'Liberado';
        const labelClass = blockers
          ? 'bg-red-600 text-white'
          : warnings
            ? 'bg-amber-100 text-amber-800 dark:bg-amber-950/50 dark:text-amber-100'
            : 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-100';

        return `
          <section class="rounded-[1.75rem] border border-zinc-100 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-950 md:p-6" data-editorial-agents>
            <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
              <div>
                <p class="text-[10px] font-black uppercase tracking-[0.28em] text-red-600">Agentes editoriais</p>
                <h3 class="admin-display mt-2 text-3xl leading-none">Mesa de revisao</h3>
                <p class="mt-2 max-w-2xl text-sm font-medium leading-6 text-zinc-500 dark:text-zinc-400">Diagnostico local, sem custo de IA. Ele nao publica nem altera nada sozinho.</p>
              </div>
              <span class="rounded-full px-3 py-2 text-[10px] font-black uppercase tracking-widest ${labelClass}">${escapeHtml(label)}</span>
            </div>
            <div class="mt-5 grid gap-3 md:grid-cols-2">
              ${items
                .map(
                  (item) => `
                    <article class="rounded-[1.25rem] border p-4 ${classifyAgentItem(item.severity)}">
                      <span class="text-[9px] font-black uppercase tracking-[0.22em] opacity-70">${escapeHtml(item.agent)}</span>
                      <p class="mt-2 text-sm font-black leading-6">${escapeHtml(item.text)}</p>
                    </article>
                  `,
                )
                .join('')}
            </div>
          </section>
        `;
      };

      const renderIngestDiagnostics = (data) => {
        const runs = Array.isArray(data?.runs) ? data.runs : [];
        const latest = runs[0];
        if (!latest) {
          if (ingestLatest) ingestLatest.textContent = data?.warning ? 'Historico pendente' : 'Sem rodadas registradas';
          if (ingestState) ingestState.textContent = data?.configured === false ? 'Ativar D1' : 'Pronto';
          if (ingestNote) ingestNote.textContent = data?.warning || 'Rode a ingestao para preencher este painel.';
          if (ingestCategoriesTitle) ingestCategoriesTitle.textContent = 'Nenhuma rodada lida ainda';
          if (ingestCategories) ingestCategories.innerHTML = '<span class="rounded-full bg-zinc-100 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-zinc-400 dark:bg-zinc-900">Sem dados</span>';
          return;
        }

        const feedCounts = parseObject(latest.feed_counts);
        const categoryEntries = Object.entries(feedCounts)
          .sort((a, b) => Number(b[1] || 0) - Number(a[1] || 0))
          .filter(([, count]) => Number(count || 0) > 0);
        const categories = categoryEntries.slice(0, 4);
        const topicClusters = Number(latest.topic_clusters || 0);
        const radarClusters = Number(latest.radar_clusters || 0);
        const selected = Number(latest.selected_pitches || 0);
        const saved = Number(latest.saved_pitches || 0);
        const skipped = Number(latest.skipped_pitches || Math.max(0, selected - saved));

        if (ingestLatest) ingestLatest.textContent = formatDate(latest.finished_at || latest.started_at);
        if (ingestState) ingestState.textContent = latest.status === 'partial' ? 'Parcial' : latest.status || 'Ok';
        if (ingestItems) ingestItems.textContent = Number(latest.items_total || 0);
        if (ingestClusters) ingestClusters.textContent = topicClusters + radarClusters;
        if (ingestSaved) ingestSaved.textContent = saved;
        if (ingestSkipped) ingestSkipped.textContent = `${skipped} ignorada${skipped === 1 ? '' : 's'}`;
        if (ingestNote) ingestNote.textContent = `${selected} pautas selecionadas. ${topicClusters} clusters por assunto e ${radarClusters} radares por categoria.`;
        if (ingestCategoriesTitle) {
          const totalCategories = categoryEntries.length;
          ingestCategoriesTitle.textContent = `${totalCategories} categoria${totalCategories === 1 ? '' : 's'} com sinal na ultima rodada`;
        }
        if (ingestCategories) {
          ingestCategories.innerHTML = categories.length
            ? categories
                .map(([category, count]) => {
                  const total = Number(count || 0);
                  const label = total >= 1000 ? `${category} dominante` : `${category} ${total}`;
                  return `<span class="rounded-full bg-zinc-100 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-zinc-500 dark:bg-zinc-900 dark:text-zinc-400">${escapeHtml(label)}</span>`;
                })
                .join('')
            : '<span class="rounded-full bg-zinc-100 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-zinc-400 dark:bg-zinc-900">Sem categorias</span>';
        }
      };

      const renderEditorialStats = (data) => {
        editorialStats = data || null;
        const sources = data?.sources || {};
        const pitchStats = data?.pitches || {};
        const statuses = pitchStats.visibleStatuses || pitchStats.statuses || {};
        const sourceTotal = Number(sources.total || 0);
        const activeSources = Number(sources.active || 0);
        const newCount = Number(statuses.new || pitchStats.visibleNew || 0);
        const queuedCount = Number(statuses.queued || 0);
        const convertedCount = Number(statuses.converted || 0);
        const categories = Array.isArray(sources.categories) ? sources.categories : [];

        if (stockTitle) stockTitle.textContent = `${activeSources || sourceTotal} fontes ativas no D1`;
        if (stockSources) stockSources.textContent = activeSources || sourceTotal;
        if (stockNew) stockNew.textContent = newCount;
        if (stockQueued) stockQueued.textContent = queuedCount;
        if (stockNote) {
          stockNote.textContent = `${Number(pitchStats.total || 0)} pautas historicas. ${convertedCount} convertidas e ${queuedCount} em fila passam pelo fluxo de publicacao.`;
        }
        if (stockCategories) {
          stockCategories.innerHTML = categories.length
            ? categories
                .slice(0, 6)
                .map(
                  (item) =>
                    `<span class="rounded-full bg-zinc-100 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-zinc-500 dark:bg-zinc-900 dark:text-zinc-400">${escapeHtml(item.category || 'Fonte')} ${Number(item.active || item.total || 0)}</span>`,
                )
                .join('')
            : '<span class="rounded-full bg-zinc-100 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-zinc-400 dark:bg-zinc-900">Sem fontes cadastradas</span>';
        }
      };

      const loadEditorialStats = async () => {
        const token = getToken();
        if (!token) return;
        try {
          const response = await fetch(`/api/admin/editorial-stats?minSources=${encodeURIComponent(visibleMinSources)}`, {
            headers: { authorization: `Bearer ${token}` },
          });
          const data = await response.json().catch(() => ({}));
          if (response.status === 401) {
            try {
              localStorage.removeItem('admin-token');
            } catch {}
            redirectToLogin();
            return;
          }
          if (!response.ok) throw new Error(data.error || 'Falha ao ler estoque editorial.');
          renderEditorialStats(data);
          render();
        } catch (error) {
          if (stockTitle) stockTitle.textContent = 'Estoque indisponivel';
          if (stockNote) stockNote.textContent = error.message || 'Nao foi possivel ler fontes e pautas do D1.';
          if (stockCategories) stockCategories.innerHTML = '<span class="rounded-full bg-red-50 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-red-700 dark:bg-red-950/30 dark:text-red-300">Falha no diagnostico</span>';
        }
      };

      const loadIngestDiagnostics = async () => {
        const token = getToken();
        if (!token) return;
        try {
          const response = await fetch('/api/admin/ingest-runs', {
            headers: { authorization: `Bearer ${token}` },
          });
          const data = await response.json().catch(() => ({}));
          if (response.status === 401) {
            try {
              localStorage.removeItem('admin-token');
            } catch {}
            redirectToLogin();
            return;
          }
          renderIngestDiagnostics(data);
        } catch {
          renderIngestDiagnostics({ configured: false, warning: 'Nao foi possivel ler o historico da ingestao.' });
        }
      };

      const renderPitchCard = (pitch) => {
        const sources = parseArray(pitch.sources);
        const sourceCount = Number(pitch.source_count || sources.length || 0);
        const provider = pitchProvider(pitch);
        const isFromGNews = provider === 'gnews';
        const sourceLabels = sources
          .slice(0, 4)
          .map((source) => escapeHtml(source.publisher || source.title || 'Fonte'))
          .join(', ');

        return `
          <article class="grid gap-4 p-5 transition hover:bg-zinc-50/80 dark:hover:bg-zinc-900/50 md:grid-cols-[minmax(0,1fr)_160px_auto] md:items-center">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-red-600 px-3 py-1 text-[9px] font-black uppercase tracking-widest text-white">${escapeHtml(pitch.category || 'Editorial')}</span>
                ${isFromGNews ? '<span class="rounded-full bg-red-50 px-2 py-1 text-[9px] font-black uppercase tracking-widest text-red-700 dark:bg-red-950/30 dark:text-red-300">GNews</span>' : ''}
                <span class="text-[10px] font-black uppercase tracking-widest text-zinc-400">${sourceCount} fonte${sourceCount === 1 ? '' : 's'}</span>
                <span class="text-[10px] font-bold text-zinc-400">${formatDate(pitch.updated_at || pitch.created_at)}</span>
              </div>
              <h2 class="admin-display mt-3 line-clamp-2 text-3xl leading-tight">${escapeHtml(pitch.title || 'Pauta sem titulo')}</h2>
              <p class="mt-2 line-clamp-2 text-sm font-medium leading-6 text-zinc-500">${escapeHtml(pitch.summary || 'Sem resumo ainda.')}</p>
              ${sourceLabels ? `<p class="mt-3 truncate text-[10px] font-black uppercase tracking-widest text-zinc-400">${sourceLabels}</p>` : ''}
            </div>
            <div class="rounded-3xl bg-zinc-50 p-4 dark:bg-zinc-900">
              <p class="text-[9px] font-black uppercase tracking-[0.22em] text-zinc-400">Score</p>
              <strong class="mt-1 block text-2xl font-black">${Number(pitch.score || 0)}</strong>
            </div>
            <div class="flex flex-wrap gap-2 md:justify-end">
              <button type="button" data-pitch-preview="${escapeHtml(pitch.id)}" class="rounded-xl border border-zinc-200 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-500 hover:border-zinc-950 hover:text-zinc-950 dark:border-zinc-800 dark:hover:border-white dark:hover:text-white">Ver pauta</button>
              <button type="button" data-pitch-article="${escapeHtml(pitch.id)}" data-pitch-cluster="${escapeHtml(pitch.cluster_key || pitch.clusterKey || '')}" class="rounded-xl bg-red-600 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-white transition hover:bg-red-500">Ver materia</button>
              ${pitch.primary_url ? `<a href="${escapeHtml(pitch.primary_url)}" target="_blank" rel="noopener noreferrer" class="rounded-xl border border-zinc-200 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-500 hover:border-red-600 hover:text-red-600 dark:border-zinc-800">Fonte</a>` : ''}
              ${
                pitch.status === 'queued'
                  ? `<span class="rounded-xl bg-emerald-50 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">Na fila</span>`
                  : `<button type="button" data-pitch-action="${pitch.status === 'reviewed' ? 'queued' : 'reviewed'}" data-pitch-id="${escapeHtml(pitch.id)}" data-pitch-cluster="${escapeHtml(pitch.cluster_key || pitch.clusterKey || '')}" class="rounded-xl bg-zinc-950 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-white transition hover:bg-red-600 dark:bg-white dark:text-zinc-950 dark:hover:bg-red-600 dark:hover:text-white">${pitch.status === 'reviewed' ? 'Aprovar para Fila' : 'Revisar'}</button>`
              }
              <button type="button" data-pitch-action="dismissed" data-pitch-id="${escapeHtml(pitch.id)}" data-pitch-cluster="${escapeHtml(pitch.cluster_key || pitch.clusterKey || '')}" class="rounded-xl border border-zinc-200 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-500 hover:border-red-600 hover:text-red-600 dark:border-zinc-800">Descartar</button>
            </div>
          </article>
        `;
      };

      const render = () => {
        const term = String(filterInput?.value || '').trim().toLowerCase();
        const filtered = pitches.filter((pitch) =>
          `${pitch.title || ''} ${pitch.category || ''} ${pitch.summary || ''}`.toLowerCase().includes(term),
        );
        const gnewsFiltered = filtered.filter(isGNewsPitch);
        const regularFiltered = filtered.filter((pitch) => !isGNewsPitch(pitch));

        if (statusNode) {
          statusNode.textContent = `${filtered.length} de ${pitches.length} pauta${pitches.length === 1 ? '' : 's'} encontrada${pitches.length === 1 ? '' : 's'}`;
        }
        if (emptyCopy && filtered.length === 0) {
          const statuses = editorialStats?.pitches?.visibleStatuses || editorialStats?.pitches?.statuses || {};
          const currentCount = Number(statuses[status] || 0);
          const sourceCount = Number(editorialStats?.sources?.active || editorialStats?.sources?.total || 0);
          const labels = { new: 'novas', reviewed: 'revisadas', queued: 'em fila', converted: 'convertidas' };
          emptyCopy.textContent = currentCount > 0
            ? `Existem ${currentCount} pautas ${labels[status] || status} no D1, mas o filtro atual de categoria/texto nao encontrou resultados.`
            : sourceCount > 0
              ? `O banco tem ${sourceCount} fontes cadastradas. Nesta aba nao ha pautas ${labels[status] || status} com a regua atual de fontes e validade.`
              : 'Cadastre fontes em /admin/fontes/ ou rode a ingestao para preencher este painel.';
        }

        emptyState?.classList.toggle('hidden', filtered.length > 0);
        gnewsSection?.classList.toggle('hidden', gnewsFiltered.length === 0);
        if (gnewsCount) {
          gnewsCount.textContent = `${gnewsFiltered.length} pauta${gnewsFiltered.length === 1 ? '' : 's'}`;
        }
        if (gnewsList) {
          gnewsList.innerHTML = gnewsFiltered.map(renderPitchCard).join('');
        }
        if (!list) return;
        list.classList.toggle('hidden', regularFiltered.length === 0);
        list.innerHTML = regularFiltered
          .map((pitch) => {
            const sources = parseArray(pitch.sources);
            const sourceCount = Number(pitch.source_count || sources.length || 0);
            const sourceLabels = sources
              .slice(0, 4)
              .map((source) => escapeHtml(source.publisher || source.title || 'Fonte'))
              .join(', ');
            return `
              <article class="grid gap-4 p-5 transition hover:bg-zinc-50/80 dark:hover:bg-zinc-900/50 md:grid-cols-[minmax(0,1fr)_160px_auto] md:items-center">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="rounded-full bg-red-600 px-3 py-1 text-[9px] font-black uppercase tracking-widest text-white">${escapeHtml(pitch.category || 'Editorial')}</span>
                    <span class="text-[10px] font-black uppercase tracking-widest text-zinc-400">${sourceCount} fonte${sourceCount === 1 ? '' : 's'}</span>
                    <span class="text-[10px] font-bold text-zinc-400">${formatDate(pitch.updated_at || pitch.created_at)}</span>
                  </div>
                  <h2 class="admin-display mt-3 line-clamp-2 text-3xl leading-tight">${escapeHtml(pitch.title || 'Pauta sem título')}</h2>
                  <p class="mt-2 line-clamp-2 text-sm font-medium leading-6 text-zinc-500">${escapeHtml(pitch.summary || 'Sem resumo ainda.')}</p>
                  ${sourceLabels ? `<p class="mt-3 truncate text-[10px] font-black uppercase tracking-widest text-zinc-400">${sourceLabels}</p>` : ''}
                </div>
                <div class="rounded-3xl bg-zinc-50 p-4 dark:bg-zinc-900">
                  <p class="text-[9px] font-black uppercase tracking-[0.22em] text-zinc-400">Score</p>
                  <strong class="mt-1 block text-2xl font-black">${Number(pitch.score || 0)}</strong>
                </div>
                <div class="flex flex-wrap gap-2 md:justify-end">
                  <button type="button" data-pitch-preview="${escapeHtml(pitch.id)}" class="rounded-xl border border-zinc-200 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-500 hover:border-zinc-950 hover:text-zinc-950 dark:border-zinc-800 dark:hover:border-white dark:hover:text-white">Ver pauta</button>
                  <button type="button" data-pitch-article="${escapeHtml(pitch.id)}" data-pitch-cluster="${escapeHtml(pitch.cluster_key || pitch.clusterKey || '')}" class="rounded-xl bg-red-600 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-white transition hover:bg-red-500">Ver matéria</button>
                  ${pitch.primary_url ? `<a href="${escapeHtml(pitch.primary_url)}" target="_blank" rel="noopener noreferrer" class="rounded-xl border border-zinc-200 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-500 hover:border-red-600 hover:text-red-600 dark:border-zinc-800">Fonte</a>` : ''}
                  ${
                    pitch.status === 'queued'
                      ? `<span class="rounded-xl bg-emerald-50 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">Na fila</span>`
                      : `<button type="button" data-pitch-action="${pitch.status === 'reviewed' ? 'queued' : 'reviewed'}" data-pitch-id="${escapeHtml(pitch.id)}" data-pitch-cluster="${escapeHtml(pitch.cluster_key || pitch.clusterKey || '')}" class="rounded-xl bg-zinc-950 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-white transition hover:bg-red-600 dark:bg-white dark:text-zinc-950 dark:hover:bg-red-600 dark:hover:text-white">${pitch.status === 'reviewed' ? 'Aprovar para Fila' : 'Revisar'}</button>`
                  }
                  <button type="button" data-pitch-action="dismissed" data-pitch-id="${escapeHtml(pitch.id)}" data-pitch-cluster="${escapeHtml(pitch.cluster_key || pitch.clusterKey || '')}" class="rounded-xl border border-zinc-200 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-500 hover:border-red-600 hover:text-red-600 dark:border-zinc-800">Descartar</button>
                </div>
              </article>
            `;
          })
          .join('');
      };

      const openPitchPreview = (id, mode = 'pitch') => {
        const pitch = pitches.find((item) => String(item.id || '') === String(id || ''));
        if (!pitch || !modal || !modalBody) return;
        activePitchId = String(id || '');
        activePitchMode = mode || 'pitch';

        const sources = parseArray(pitch.sources);
        const tags = parseArray(pitch.tags);
