---
import AdminLayout from '../../layouts/AdminLayout.astro';

const categories = ['Brasil', 'Mundo', 'Economia', 'Tecnologia', 'Entretenimento', 'Esportes', 'Ciencia', 'Saude', 'Famosos', 'Cinema', 'Futebol', 'Games', 'Lifestyle', 'Educacao', 'Moda'];
---

<AdminLayout title="Pautas editoriais | Admin Novo Alvo" active="pitches">
  <section class="space-y-6" data-pitches-admin>
    <header class="overflow-hidden rounded-[2rem] border border-white/70 bg-white/78 p-6 shadow-[0_24px_80px_rgba(15,23,42,0.07)] backdrop-blur-2xl dark:border-zinc-800 dark:bg-zinc-950/78">
      <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
        <div>
          <span class="text-[10px] font-black uppercase tracking-[0.35em] text-red-600">Radar editorial</span>
          <h1 class="admin-display mt-3 text-4xl md:text-6xl">Pautas em curadoria</h1>
          <p class="mt-3 max-w-2xl text-sm font-medium leading-6 text-zinc-500 dark:text-zinc-400">
            Sinais coletados por RSS e agrupados como ideias de pauta. Nada aqui é publicado automaticamente.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" data-refresh-pitches class="rounded-2xl border border-zinc-200 bg-white px-5 py-4 text-[10px] font-black uppercase tracking-widest text-zinc-500 transition hover:border-red-600 hover:text-red-600 dark:border-zinc-800 dark:bg-zinc-900">
            Atualizar
          </button>
          <a href="/admin/nova/" class="rounded-2xl bg-red-600 px-5 py-4 text-[10px] font-black uppercase tracking-widest text-white shadow-xl shadow-red-600/20 transition hover:-translate-y-0.5 hover:bg-red-500">
            Nova matéria
          </a>
        </div>
      </div>

      <div class="mt-6 grid gap-3 md:grid-cols-[1fr_220px]">
        <div class="grid gap-3 md:grid-cols-4">
          <button type="button" data-status-filter="new" class="rounded-3xl bg-zinc-950 px-5 py-4 text-left text-sm font-black text-white dark:bg-white dark:text-zinc-950">Novas</button>
          <button type="button" data-status-filter="reviewed" class="rounded-3xl bg-zinc-50 px-5 py-4 text-left text-sm font-black text-zinc-500 transition hover:text-red-600 dark:bg-zinc-900 dark:text-zinc-400">Revisadas</button>
          <button type="button" data-status-filter="queued" class="rounded-3xl bg-zinc-50 px-5 py-4 text-left text-sm font-black text-zinc-500 transition hover:text-red-600 dark:bg-zinc-900 dark:text-zinc-400">Fila</button>
          <button type="button" data-status-filter="converted" class="rounded-3xl bg-zinc-50 px-5 py-4 text-left text-sm font-black text-zinc-500 transition hover:text-red-600 dark:bg-zinc-900 dark:text-zinc-400">Convertidas</button>
        </div>
        <label>
          <span class="sr-only">Filtrar categoria</span>
          <select data-category-filter class="h-full w-full rounded-3xl border border-zinc-200 bg-zinc-50 px-5 py-4 text-sm font-black text-zinc-600 outline-none transition focus:border-red-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300">
            <option value="">Todas categorias</option>
            {categories.map((category) => <option value={category}>{category}</option>)}
          </select>
        </label>
      </div>
    </header>

    <section class="overflow-hidden rounded-[2rem] border border-white/70 bg-white/82 shadow-[0_24px_80px_rgba(15,23,42,0.07)] backdrop-blur-2xl dark:border-zinc-800 dark:bg-zinc-950/82">
      <div class="flex flex-col gap-3 border-b border-zinc-100 p-5 dark:border-zinc-800 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="text-[10px] font-black uppercase tracking-[0.28em] text-zinc-400">Banco editorial D1</p>
          <strong class="mt-1 block text-sm text-zinc-700 dark:text-zinc-200" data-pitches-status>Carregando pautas...</strong>
        </div>
        <label class="relative block md:w-80">
          <span class="sr-only">Filtrar pautas</span>
          <input data-filter-pitches class="w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm font-bold outline-none transition focus:border-red-600 dark:border-zinc-800 dark:bg-zinc-900" placeholder="Filtrar por título, categoria..." />
        </label>
      </div>

      <div data-empty-state class="hidden p-10 text-center">
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-3xl bg-zinc-100 text-2xl dark:bg-zinc-900">+</span>
        <h2 class="admin-display mt-4 text-3xl">Nenhuma pauta encontrada</h2>
        <p class="mx-auto mt-2 max-w-md text-sm font-medium leading-6 text-zinc-500">Quando o script de ingestão rodar, os sinais editoriais aparecem aqui.</p>
      </div>

      <div data-pitches-list class="divide-y divide-zinc-100 dark:divide-zinc-800">
        <div class="p-5">
          <div class="h-28 animate-pulse rounded-3xl bg-zinc-100 dark:bg-zinc-900"></div>
        </div>
      </div>
    </section>

    <div class="fixed inset-0 z-[80] hidden items-center justify-center bg-zinc-950/55 p-4 backdrop-blur-sm" data-pitch-modal>
      <article class="max-h-[88vh] w-full max-w-4xl overflow-hidden rounded-[2rem] border border-white/70 bg-white shadow-[0_30px_120px_rgba(15,23,42,0.25)] dark:border-zinc-800 dark:bg-zinc-950">
        <header class="flex items-start justify-between gap-4 border-b border-zinc-100 p-5 dark:border-zinc-800 md:p-7">
          <div>
            <span class="text-[10px] font-black uppercase tracking-[0.35em] text-red-600" data-pitch-modal-category>Pauta</span>
            <h2 class="admin-display mt-3 text-3xl leading-none md:text-5xl" data-pitch-modal-title>Pauta editorial</h2>
          </div>
          <button type="button" class="rounded-2xl bg-zinc-950 px-4 py-3 text-[10px] font-black uppercase tracking-widest text-white transition hover:bg-red-600 dark:bg-white dark:text-zinc-950" data-pitch-modal-close>
            Fechar
          </button>
        </header>

        <div class="max-h-[calc(88vh-132px)] overflow-y-auto p-5 md:p-7">
          <div data-pitch-modal-body class="space-y-6"></div>
        </div>
      </article>
    </div>
  </section>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-pitches-admin]');
      if (!root) return;

      const list = document.querySelector('[data-pitches-list]');
      const statusNode = document.querySelector('[data-pitches-status]');
      const emptyState = document.querySelector('[data-empty-state]');
      const filterInput = document.querySelector('[data-filter-pitches]');
      const refreshButton = document.querySelector('[data-refresh-pitches]');
      const categoryFilter = document.querySelector('[data-category-filter]');
      const statusButtons = [...document.querySelectorAll('[data-status-filter]')];
      const modal = document.querySelector('[data-pitch-modal]');
      const modalTitle = document.querySelector('[data-pitch-modal-title]');
      const modalCategory = document.querySelector('[data-pitch-modal-category]');
      const modalBody = document.querySelector('[data-pitch-modal-body]');
      const modalClose = document.querySelector('[data-pitch-modal-close]');
      let pitches = [];
      let status = 'new';

      const escapeHtml = (value) =>
        String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');

      const redirectToLogin = () => {
        const next = `${window.location.pathname}${window.location.search}${window.location.hash}`;
        window.location.href = `/redacao/?next=${encodeURIComponent(next)}`;
      };

      const getToken = () => {
        try {
          const token = localStorage.getItem('admin-token') || '';
          if (token) return token;
        } catch {}
        redirectToLogin();
        return '';
      };

      const parseArray = (value) => {
        try {
          const parsed = JSON.parse(value || '[]');
          return Array.isArray(parsed) ? parsed : [];
        } catch {
          return [];
        }
      };

      const formatDate = (value) => {
        if (!value) return 'Sem data';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return 'Sem data';
        return new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }).format(date);
      };

      const render = () => {
        const term = String(filterInput?.value || '').trim().toLowerCase();
        const filtered = pitches.filter((pitch) =>
          `${pitch.title || ''} ${pitch.category || ''} ${pitch.summary || ''}`.toLowerCase().includes(term),
        );

        if (statusNode) {
          statusNode.textContent = `${filtered.length} de ${pitches.length} pauta${pitches.length === 1 ? '' : 's'} encontrada${pitches.length === 1 ? '' : 's'}`;
        }

        emptyState?.classList.toggle('hidden', filtered.length > 0);
        if (!list) return;
        list.classList.toggle('hidden', filtered.length === 0);
        list.innerHTML = filtered
          .map((pitch) => {
            const sources = parseArray(pitch.sources);
            const sourceCount = Number(pitch.source_count || sources.length || 0);
            const sourceLabels = sources
              .slice(0, 4)
              .map((source) => escapeHtml(source.publisher || source.title || 'Fonte'))
              .join(', ');
            return `
              <article class="grid gap-4 p-5 transition hover:bg-zinc-50/80 dark:hover:bg-zinc-900/50 md:grid-cols-[minmax(0,1fr)_160px_auto] md:items-center">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="rounded-full bg-red-600 px-3 py-1 text-[9px] font-black uppercase tracking-widest text-white">${escapeHtml(pitch.category || 'Editorial')}</span>
                    <span class="text-[10px] font-black uppercase tracking-widest text-zinc-400">${sourceCount} fonte${sourceCount === 1 ? '' : 's'}</span>
                    <span class="text-[10px] font-bold text-zinc-400">${formatDate(pitch.updated_at || pitch.created_at)}</span>
                  </div>
                  <h2 class="admin-display mt-3 line-clamp-2 text-3xl leading-tight">${escapeHtml(pitch.title || 'Pauta sem título')}</h2>
                  <p class="mt-2 line-clamp-2 text-sm font-medium leading-6 text-zinc-500">${escapeHtml(pitch.summary || 'Sem resumo ainda.')}</p>
                  ${sourceLabels ? `<p class="mt-3 truncate text-[10px] font-black uppercase tracking-widest text-zinc-400">${sourceLabels}</p>` : ''}
                </div>
                <div class="rounded-3xl bg-zinc-50 p-4 dark:bg-zinc-900">
                  <p class="text-[9px] font-black uppercase tracking-[0.22em] text-zinc-400">Score</p>
                  <strong class="mt-1 block text-2xl font-black">${Number(pitch.score || 0)}</strong>
                </div>
                <div class="flex flex-wrap gap-2 md:justify-end">
                  <button type="button" data-pitch-preview="${escapeHtml(pitch.id)}" class="rounded-xl border border-zinc-200 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-500 hover:border-zinc-950 hover:text-zinc-950 dark:border-zinc-800 dark:hover:border-white dark:hover:text-white">Ver pauta</button>
                  <button type="button" data-pitch-article="${escapeHtml(pitch.id)}" class="rounded-xl bg-red-600 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-white transition hover:bg-red-500">Ver matéria</button>
                  ${pitch.primary_url ? `<a href="${escapeHtml(pitch.primary_url)}" target="_blank" rel="noopener noreferrer" class="rounded-xl border border-zinc-200 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-500 hover:border-red-600 hover:text-red-600 dark:border-zinc-800">Fonte</a>` : ''}
                  ${
                    pitch.status === 'queued'
                      ? `<span class="rounded-xl bg-emerald-50 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">Na fila</span>`
                      : `<button type="button" data-pitch-action="${pitch.status === 'reviewed' ? 'queued' : 'reviewed'}" data-pitch-id="${escapeHtml(pitch.id)}" class="rounded-xl bg-zinc-950 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-white transition hover:bg-red-600 dark:bg-white dark:text-zinc-950 dark:hover:bg-red-600 dark:hover:text-white">${pitch.status === 'reviewed' ? 'Aprovar para Fila' : 'Revisar'}</button>`
                  }
                  <button type="button" data-pitch-action="dismissed" data-pitch-id="${escapeHtml(pitch.id)}" class="rounded-xl border border-zinc-200 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-500 hover:border-red-600 hover:text-red-600 dark:border-zinc-800">Descartar</button>
                </div>
              </article>
            `;
          })
          .join('');
      };

      const openPitchPreview = (id, mode = 'pitch') => {
        const pitch = pitches.find((item) => String(item.id || '') === String(id || ''));
        if (!pitch || !modal || !modalBody) return;

        const sources = parseArray(pitch.sources);
        const tags = parseArray(pitch.tags);
        const images = parseArray(pitch.image_candidates);
        const keywords = String(pitch.keywords || '')
          .split(',')
          .map((item) => item.trim())
          .filter(Boolean);
        const sourceCount = Number(pitch.source_count || sources.length || 0);

        if (modalTitle) modalTitle.textContent = pitch.title || 'Pauta editorial';
        if (modalCategory) {
          modalCategory.textContent = `${pitch.category || 'Editorial'} • ${sourceCount} fonte${sourceCount === 1 ? '' : 's'} • score ${Number(pitch.score || 0)}`;
        }

        modalBody.innerHTML = `
          <section class="${mode === 'article' ? 'rounded-[1.75rem] border border-zinc-100 bg-gradient-to-br from-zinc-950 via-zinc-900 to-red-950 p-5 text-white shadow-2xl shadow-zinc-950/10 dark:border-zinc-800 md:p-6' : 'rounded-[1.5rem] bg-zinc-50 p-5 dark:bg-zinc-900/70'}">
            <p class="text-[10px] font-black uppercase tracking-[0.28em] text-zinc-400">Resumo editorial</p>
            <p class="mt-3 text-base font-medium leading-8 ${mode === 'article' ? 'text-zinc-200' : 'text-zinc-700 dark:text-zinc-300'}">${mode === 'article' ? 'Texto final sintetizado pela engine. Os sinais técnicos ficam abaixo, como bastidor de curadoria.' : escapeHtml(pitch.summary || 'Sem resumo ainda.')}</p>
          </section>

          ${
            mode === 'article'
              ? `<section class="rounded-[1.75rem] border border-zinc-100 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-950 md:p-7" data-generated-article>
                  <p class="text-[10px] font-black uppercase tracking-[0.28em] text-zinc-400">Matéria completa gerada</p>
                  <div class="mt-4 animate-pulse rounded-2xl bg-zinc-100 p-5 text-sm font-bold text-zinc-400 dark:bg-zinc-900">Gerando a matéria que irá para a fila...</div>
                </section>`
              : `<section class="rounded-[1.5rem] border border-zinc-100 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-950">
                  <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                    <div>
                      <p class="text-[10px] font-black uppercase tracking-[0.28em] text-zinc-400">Matéria final</p>
                      <p class="mt-2 text-sm font-medium leading-6 text-zinc-500">Gere uma prévia separada para ver exatamente o texto que será enviado para a fila.</p>
                    </div>
                    <button type="button" data-pitch-article-inline="${escapeHtml(id)}" class="rounded-xl bg-red-600 px-4 py-3 text-[10px] font-black uppercase tracking-widest text-white transition hover:bg-red-500">Ver matéria gerada</button>
                  </div>
                </section>`
          }

          ${
            tags.length || keywords.length
              ? `<section>
                  <p class="text-[10px] font-black uppercase tracking-[0.28em] text-zinc-400">Tags e contexto</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    ${[...new Set([...tags, ...keywords])]
                      .slice(0, 18)
                      .map((tag) => `<span class="rounded-full bg-red-50 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-red-700 dark:bg-red-950/30 dark:text-red-300">${escapeHtml(tag)}</span>`)
                      .join('')}
                  </div>
                </section>`
              : ''
          }

          ${
            sources.length
              ? `<section>
                  <p class="text-[10px] font-black uppercase tracking-[0.28em] text-zinc-400">Fontes do cluster</p>
                  <div class="mt-3 divide-y divide-zinc-100 overflow-hidden rounded-[1.5rem] border border-zinc-100 dark:divide-zinc-800 dark:border-zinc-800">
                    ${sources
                      .map((source) => `
                        <a href="${escapeHtml(source.url || '#')}" target="_blank" rel="noopener noreferrer" class="block p-4 transition hover:bg-zinc-50 dark:hover:bg-zinc-900">
                          <strong class="block text-sm font-black text-zinc-900 dark:text-zinc-100">${escapeHtml(source.publisher || 'Fonte')}</strong>
                          <span class="mt-1 block text-sm font-medium leading-6 text-zinc-500">${escapeHtml(source.title || source.url || '')}</span>
                        </a>
                      `)
                      .join('')}
                  </div>
                </section>`
              : ''
          }

          ${
            images.length
              ? `<section>
                  <p class="text-[10px] font-black uppercase tracking-[0.28em] text-zinc-400">Imagens candidatas</p>
                  <div class="mt-3 grid gap-3 sm:grid-cols-2 md:grid-cols-3">
                    ${images
                      .slice(0, 6)
                      .map((image) => `
                        <a href="${escapeHtml(image)}" target="_blank" rel="noopener noreferrer" class="group block overflow-hidden rounded-[1.25rem] bg-zinc-100 dark:bg-zinc-900">
                          <img src="${escapeHtml(image)}" alt="" class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" referrerpolicy="no-referrer" />
                        </a>
                      `)
                      .join('')}
                  </div>
                </section>`
              : ''
          }

          <footer class="flex flex-wrap gap-2 border-t border-zinc-100 pt-5 dark:border-zinc-800">
            ${pitch.primary_url ? `<a href="${escapeHtml(pitch.primary_url)}" target="_blank" rel="noopener noreferrer" class="rounded-xl bg-zinc-950 px-4 py-3 text-[10px] font-black uppercase tracking-widest text-white transition hover:bg-red-600 dark:bg-white dark:text-zinc-950">Abrir fonte principal</a>` : ''}
          </footer>
        `;

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        if (mode === 'article') loadGeneratedArticle(id);
      };

      const loadGeneratedArticle = async (id) => {
        const target = document.querySelector('[data-generated-article]');
        const token = getToken();
        if (!target || !token) return;

        try {
          const response = await fetch(`/api/admin/pitch-draft?id=${encodeURIComponent(id)}`, {
            headers: { authorization: `Bearer ${token}` },
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.error || 'Não foi possível gerar a matéria.');
          const article = data.article || {};
          const fallbackWarning =
            data.generatedWithAi === false
              ? `<p class="mt-4 rounded-2xl bg-amber-50 p-4 text-sm font-bold leading-6 text-amber-800 dark:bg-amber-950/30 dark:text-amber-200">Atenção: esta prévia caiu no modelo de segurança, não na geração final do Gemini. Motivo: ${escapeHtml(data.generationError || 'IA indisponível.')}</p>`
              : '';
          target.innerHTML = `
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-zinc-100 pb-5 dark:border-zinc-800">
              <p class="text-[10px] font-black uppercase tracking-[0.28em] text-red-600">Matéria completa gerada</p>
              <span class="rounded-full bg-zinc-100 px-3 py-1 text-[9px] font-black uppercase tracking-widest text-zinc-500 dark:bg-zinc-900">${escapeHtml(data.model || (data.aiEnabled ? 'Gemini' : 'Modelo local'))}</span>
              ${article.generationTier === 'nexa-premium' ? '<span class="rounded-full bg-red-600 px-3 py-1 text-[9px] font-black uppercase tracking-widest text-white">Nexa premium</span>' : ''}
            </div>
            ${fallbackWarning}
            ${
              article.coverUrl
                ? `<img src="${escapeHtml(article.coverUrl)}" alt="${escapeHtml(article.coverAlt || article.title || '')}" class="mt-5 aspect-[16/9] w-full rounded-[1.5rem] object-cover" loading="lazy" referrerpolicy="no-referrer" />`
                : ''
            }
            <h3 class="admin-display mt-4 text-3xl leading-none">${escapeHtml(article.title || 'Sem título')}</h3>
            <article class="mt-6 rounded-[1.5rem] bg-[#f7f3ea] p-5 text-zinc-950 dark:bg-zinc-900 dark:text-zinc-50 md:p-7">
              <p class="text-lg font-medium leading-8 text-zinc-600 dark:text-zinc-300">${escapeHtml(article.summary || '')}</p>
              <div class="prose prose-zinc mt-8 max-w-none dark:prose-invert">${article.bodyHtml || ''}</div>
            </article>
          `;
        } catch (error) {
          target.innerHTML = `
            <p class="text-[10px] font-black uppercase tracking-[0.28em] text-red-600">Matéria completa gerada</p>
            <p class="mt-3 rounded-2xl bg-red-50 p-4 text-sm font-bold leading-6 text-red-700 dark:bg-red-950/30 dark:text-red-300">${escapeHtml(error.message || 'Falha ao gerar prévia.')}</p>
          `;
        }
      };

      const closePitchPreview = () => {
        modal?.classList.add('hidden');
        modal?.classList.remove('flex');
      };

      const setActiveStatus = () => {
        statusButtons.forEach((button) => {
          const active = button.dataset.statusFilter === status;
          button.className = active
            ? 'rounded-3xl bg-zinc-950 px-5 py-4 text-left text-sm font-black text-white dark:bg-white dark:text-zinc-950'
            : 'rounded-3xl bg-zinc-50 px-5 py-4 text-left text-sm font-black text-zinc-500 transition hover:text-red-600 dark:bg-zinc-900 dark:text-zinc-400';
        });
      };

      const loadPitches = async () => {
        const token = getToken();
        if (!token) return;
        const category = String(categoryFilter?.value || '');
        const params = new URLSearchParams({ status, limit: '100' });
        if (category) params.set('category', category);
        if (statusNode) statusNode.textContent = 'Buscando pautas no D1...';

        try {
          const response = await fetch(`/api/admin/pitches?${params.toString()}`, {
            headers: { authorization: `Bearer ${token}` },
          });
          const data = await response.json().catch(() => ({}));
          if (response.status === 401) {
            try {
              localStorage.removeItem('admin-token');
            } catch {}
            redirectToLogin();
            return;
          }
          if (!response.ok) throw new Error(data.error || 'Erro ao buscar pautas.');
          pitches = Array.isArray(data.pitches) ? data.pitches : [];
          render();
        } catch (error) {
          if (statusNode) statusNode.textContent = error.message || 'Falha ao conectar com o CMS.';
          if (list) list.innerHTML = '';
        }
      };

      const updatePitchStatus = async (button, id, nextStatus) => {
        const token = getToken();
        if (!token) return;
        if (!id) {
          if (statusNode) statusNode.textContent = 'Pauta sem ID para atualizar.';
          return;
        }

        const previousLabel = button?.textContent || '';
        if (button) {
          button.disabled = true;
          button.textContent = 'Movendo...';
          button.classList.add('opacity-60');
        }
        if (statusNode) statusNode.textContent = nextStatus === 'reviewed' ? 'Movendo pauta para Revisadas...' : nextStatus === 'queued' ? 'Aprovando pauta para a Fila Nexa...' : 'Atualizando pauta...';

        try {
          const response = await fetch('/api/admin/pitches', {
            method: 'PATCH',
            headers: {
              'content-type': 'application/json',
              authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({ id, status: nextStatus }),
          });
          const data = await response.json().catch(() => ({}));
          if (response.status === 401) {
            try {
              localStorage.removeItem('admin-token');
            } catch {}
            redirectToLogin();
            return;
          }
          if (!response.ok) throw new Error(data.error || 'Nao foi possivel atualizar a pauta.');

          if (nextStatus === 'reviewed' || nextStatus === 'queued' || nextStatus === 'dismissed' || nextStatus === 'converted') {
            status = nextStatus;
            setActiveStatus();
          }
          await loadPitches();
        } catch (error) {
          if (statusNode) statusNode.textContent = error.message || 'Falha ao atualizar pauta.';
        } finally {
          if (button) {
            button.disabled = false;
            button.textContent = previousLabel;
            button.classList.remove('opacity-60');
          }
        }
      };

      statusButtons.forEach((button) => {
        button.addEventListener('click', () => {
          status = button.dataset.statusFilter || 'new';
          setActiveStatus();
          loadPitches();
        });
      });

      list?.addEventListener('click', (event) => {
        const previewButton = event.target.closest('[data-pitch-preview]');
        if (previewButton) {
          openPitchPreview(previewButton.dataset.pitchPreview || '');
          return;
        }

        const articleButton = event.target.closest('[data-pitch-article]');
        if (articleButton) {
          openPitchPreview(articleButton.dataset.pitchArticle || '', 'article');
          return;
        }

        const inlineArticleButton = event.target.closest('[data-pitch-article-inline]');
        if (inlineArticleButton) {
          openPitchPreview(inlineArticleButton.dataset.pitchArticleInline || '', 'article');
          return;
        }

        const button = event.target.closest('[data-pitch-action]');
        if (!button) return;
        updatePitchStatus(button, button.dataset.pitchId || '', button.dataset.pitchAction || 'reviewed');
      });

      modalClose?.addEventListener('click', closePitchPreview);
      modal?.addEventListener('click', (event) => {
        if (event.target === modal) closePitchPreview();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closePitchPreview();
      });

      filterInput?.addEventListener('input', render);
      categoryFilter?.addEventListener('change', loadPitches);
      refreshButton?.addEventListener('click', loadPitches);
      setActiveStatus();
      loadPitches();
    })();
  </script>
</AdminLayout>
