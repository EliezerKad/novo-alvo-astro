---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import AdCard from '../components/AdCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import { getCollection } from 'astro:content';
import {
  categoriesList,
  newsEntryToArticle,
  sortNewsByDate,
  subCategoriesList,
  urgentNews,
} from '../lib/news';

const normalize = (value: string) =>
  value
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim();

const query = Astro.url.searchParams.get('q')?.trim() || '';
const normalizedQuery = normalize(query);
const terms = normalizedQuery.split(/\s+/).filter(Boolean);

const newsEntries = sortNewsByDate(await getCollection('news'));
const tickerArticles = urgentNews(newsEntries).map(newsEntryToArticle);
const articles = newsEntries.map(newsEntryToArticle);
const mostRead = [...articles].sort((a, b) => (b.views || 0) - (a.views || 0)).slice(0, 5);

const scoredEntries = newsEntries
  .map((entry) => {
    const body = normalize(entry.body || '');
    const fields = {
      title: normalize(entry.data.title),
      summary: normalize(entry.data.summary),
      seo: normalize(entry.data.seoDescription),
      category: normalize([entry.data.category, entry.data.subcategory || ''].join(' ')),
      author: normalize(entry.data.author),
      tags: normalize(entry.data.tags.join(' ')),
      body,
    };

    if (!terms.length) return { entry, score: 0 };

    const score = terms.reduce((total, term) => {
      let next = total;
      if (fields.title.includes(term)) next += 12;
      if (fields.summary.includes(term)) next += 7;
      if (fields.seo.includes(term)) next += 5;
      if (fields.category.includes(term)) next += 4;
      if (fields.tags.includes(term)) next += 4;
      if (fields.author.includes(term)) next += 2;
      if (fields.body.includes(term)) next += 1;
      return next;
    }, 0);

    return { entry, score };
  })
  .filter((item) => item.score > 0)
  .sort((a, b) => b.score - a.score || b.entry.data.publishedAt.getTime() - a.entry.data.publishedAt.getTime());

const results = scoredEntries.slice(0, 30).map((item) => newsEntryToArticle(item.entry));
const totalMatches = scoredEntries.length;
const canonical = new URL('/buscar', Astro.site ?? Astro.url.origin).href;
const title = query
  ? `Busca por "${query}" | Portal Novo Alvo`
  : 'Buscar notícias | Portal Novo Alvo';
const description = query
  ? `Resultados de busca por "${query}" no Portal Novo Alvo.`
  : 'Busque notícias, categorias, temas e coberturas editoriais no Portal Novo Alvo.';
const breadcrumbs = [
  { name: 'Início', url: new URL('/', Astro.site ?? Astro.url.origin).href },
  { name: 'Busca', url: canonical },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  breadcrumbs={breadcrumbs}
>
  <div class="min-h-screen bg-zinc-50 dark:bg-zinc-950 transition-colors duration-300">
    <Navbar tickerArticles={tickerArticles} categories={categoriesList} subCategories={subCategoriesList} />
    <Breadcrumbs items={breadcrumbs} />

    <main class="max-w-7xl mx-auto px-4 mt-8 mb-20 transition-all duration-500">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-9 space-y-12">
          <header class="space-y-6">
            <div class="space-y-2">
              <span class="text-[10px] font-black uppercase tracking-[0.4em] text-red-600">Busca editorial</span>
              <h1 class="text-5xl md:text-7xl font-serif font-black italic tracking-tighter text-zinc-900 dark:text-zinc-50">
                {query ? `Resultados para "${query}"` : 'Buscar notícias'}
              </h1>
              <p class="text-zinc-500 dark:text-zinc-400 text-sm md:text-base font-medium leading-relaxed max-w-2xl">
                Pesquise por temas, categorias, autores, tags e conteúdo das matérias publicadas no Portal Novo Alvo.
              </p>
            </div>

            <form action="/buscar" method="get" role="search" class="relative max-w-2xl">
              <Icon name="search" class="absolute left-5 top-1/2 -translate-y-1/2 w-5 h-5 text-zinc-400" />
              <input
                type="search"
                name="q"
                value={query}
                placeholder="Digite sua busca..."
                class="w-full bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl pl-14 pr-32 py-5 text-sm font-bold text-zinc-900 dark:text-white outline-none focus:border-red-600 focus:ring-4 focus:ring-red-600/10 transition-all"
              />
              <button
                type="submit"
                class="absolute right-2 top-1/2 -translate-y-1/2 rounded-xl bg-red-600 px-5 py-3 text-[10px] font-black uppercase tracking-widest text-white hover:bg-red-700 transition-colors"
              >
                Buscar
              </button>
            </form>
          </header>

          {query && (
            <div class="flex items-center justify-between border-y border-zinc-200 dark:border-zinc-800 py-4">
              <p class="text-[10px] font-black uppercase tracking-[0.28em] text-zinc-400">
                {totalMatches === 1
                  ? '1 matéria relacionada'
                  : `${Math.min(totalMatches, 30)} matérias relacionadas${totalMatches > 30 ? ' · exibindo as 30 mais relevantes' : ''}`}
              </p>
              <a href="/buscar" class="text-[10px] font-black uppercase tracking-widest text-red-600 hover:text-red-700">
                Limpar busca
              </a>
            </div>
          )}

          {query ? (
            results.length > 0 ? (
              <div class="space-y-8">
                <div class="flex items-center gap-3 border-b-2 border-red-600 pb-3">
                  <Icon name="trending" class="w-5 h-5 text-red-600" />
                  <h2 class="uppercase text-xs font-black tracking-[0.2em] italic text-zinc-900 dark:text-zinc-50">
                    Pulso da busca
                  </h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
                {results.map((article) => <ArticleCard article={article} variant="pulse" />)}
                </div>
              </div>
            ) : (
              <section class="rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-10 text-center">
                <h2 class="text-3xl md:text-4xl font-serif font-black italic tracking-tighter text-zinc-900 dark:text-zinc-50">
                  Nenhum resultado encontrado
                </h2>
                <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400 font-medium">
                  Tente buscar por uma palavra mais curta, categoria ou tema relacionado.
                </p>
              </section>
            )
          ) : (
            <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {[...categoriesList, ...subCategoriesList].slice(0, 10).map((category) => (
                <a
                  href={`/buscar?q=${encodeURIComponent(category)}`}
                  class="group rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6 hover:border-red-600/40 transition-colors"
                >
                  <span class="text-[9px] font-black uppercase tracking-[0.3em] text-zinc-400">Pesquisar</span>
                  <h2 class="mt-2 text-2xl font-serif font-black italic tracking-tighter text-zinc-900 dark:text-zinc-50 group-hover:text-red-600 transition-colors">
                    {category}
                  </h2>
                </a>
              ))}
            </section>
          )}

          <NewsletterBlock />
        </div>

        <aside class="lg:col-span-3 lg:pl-10 lg:border-l border-zinc-200 dark:border-zinc-800 transition-colors duration-300 relative h-full">
          <div class="space-y-12 h-full flex flex-col">
            <section class="space-y-8 flex-shrink-0">
              <div class="flex items-center gap-3 mb-4 border-b-2 border-red-600 pb-3">
                <Icon name="trending" class="w-5 h-5 text-red-600" />
                <h3 class="uppercase text-xs font-black tracking-[0.2em] italic text-zinc-900 dark:text-zinc-50">
                  MAIS ACESSADAS
                </h3>
              </div>
              <div class="space-y-8">
                {mostRead.map((article, index) => <ArticleCard article={article} variant="side" index={index} />)}
              </div>
            </section>

            <div class="sticky top-28 transition-[top] duration-700 ease-in-out space-y-10 h-fit pb-10 z-10">
              <div class="h-[500px] w-full shrink-0">
                <AdCard label="Publicidade Lateral" class="h-full w-full" />
              </div>
              <NewsletterBlock compact />
            </div>
          </div>
        </aside>
      </div>
    </main>
  </div>
</BaseLayout>
