---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import AdCard from '../components/AdCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Icon from '../components/Icon.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import { getCollection } from 'astro:content';
import {
  categoriesList,
  newsEntryToArticle,
  sortNewsByDate,
  subCategoriesList,
  urgentNews,
} from '../lib/news';

const normalize = (value: string) =>
  value
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim();

const newsEntries = sortNewsByDate(await getCollection('news'));
const tickerArticles = urgentNews(newsEntries).map(newsEntryToArticle);
const articles = newsEntries.map(newsEntryToArticle);
const mostRead = [...articles].sort((a, b) => (b.views || 0) - (a.views || 0)).slice(0, 5);
const searchDocuments = newsEntries.map((entry) => {
  const article = newsEntryToArticle(entry);
  return {
    ...article,
    tags: entry.data.tags,
    subcategory: entry.data.subcategory,
    searchText: normalize([
      entry.data.title,
      entry.data.summary,
      entry.data.seoDescription,
      entry.data.category,
      entry.data.subcategory || '',
      entry.data.author,
      entry.data.tags.join(' '),
      entry.body || '',
    ].join(' ')),
  };
});
const canonical = new URL('/buscar', Astro.site ?? Astro.url.origin).href;
---

<BaseLayout
  title="Buscar notícias | Portal Novo Alvo"
  description="Busque notícias, categorias, temas e coberturas editoriais no Portal Novo Alvo."
  canonical={canonical}
>
  <div class="min-h-screen bg-zinc-50 dark:bg-zinc-950 transition-colors duration-300">
    <Navbar tickerArticles={tickerArticles} categories={categoriesList} subCategories={subCategoriesList} />

    <main class="max-w-7xl mx-auto px-4 mt-8 mb-20 transition-all duration-500">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-9 space-y-12">
          <header class="space-y-6">
            <div class="space-y-2">
              <span class="text-[10px] font-black uppercase tracking-[0.4em] text-red-600">Busca editorial</span>
              <h1 data-search-title class="text-3xl md:text-4xl font-serif font-black italic tracking-tighter text-zinc-900 dark:text-zinc-50">
                Buscar notícias
              </h1>
              <p class="text-zinc-500 dark:text-zinc-400 text-sm md:text-base font-medium leading-relaxed max-w-2xl">
                Pesquise por temas, categorias, autores, tags e conteúdo das matérias publicadas no Portal Novo Alvo.
              </p>
            </div>

            <form action="/buscar" method="get" role="search" class="relative max-w-2xl">
              <Icon name="search" class="absolute left-5 top-1/2 -translate-y-1/2 w-5 h-5 text-zinc-400" />
              <input
                type="search"
                name="q"
                placeholder="Digite sua busca..."
                data-search-input
                class="w-full bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl pl-14 pr-32 py-5 text-sm font-bold text-zinc-900 dark:text-white outline-none focus:border-red-600 focus:ring-4 focus:ring-red-600/10 transition-all"
              />
              <button
                type="submit"
                class="absolute right-2 top-1/2 -translate-y-1/2 rounded-xl bg-red-600 px-5 py-3 text-[10px] font-black uppercase tracking-widest text-white hover:bg-red-700 transition-colors"
              >
                Buscar
              </button>
            </form>
          </header>

          <div data-search-status class="hidden flex items-center justify-between border-y border-zinc-200 dark:border-zinc-800 py-4">
            <p data-search-count class="text-[10px] font-black uppercase tracking-[0.28em] text-zinc-400"></p>
            <a href="/buscar" class="text-[10px] font-black uppercase tracking-widest text-red-600 hover:text-red-700">
              Limpar busca
            </a>
          </div>

          <div data-search-loading class="hidden space-y-8" aria-live="polite">
            <div class="flex items-center gap-3 border-b-2 border-red-600 pb-3">
              <span class="h-2 w-2 rounded-full bg-red-600 animate-pulse"></span>
              <h2 class="uppercase text-xs font-black tracking-[0.2em] italic text-zinc-900 dark:text-zinc-50">
                Buscando matérias
              </h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
              {Array.from({ length: 6 }).map(() => (
                <article class="space-y-6 animate-pulse">
                  <div class="aspect-[16/10] rounded-[2rem] bg-zinc-200 dark:bg-zinc-800"></div>
                  <div class="space-y-3">
                    <div class="h-2 w-32 rounded-full bg-zinc-200 dark:bg-zinc-800"></div>
                    <div class="h-5 w-11/12 rounded-full bg-zinc-200 dark:bg-zinc-800"></div>
                    <div class="h-5 w-8/12 rounded-full bg-zinc-200 dark:bg-zinc-800"></div>
                    <div class="h-2 w-full rounded-full bg-zinc-100 dark:bg-zinc-900"></div>
                    <div class="h-2 w-2/3 rounded-full bg-zinc-100 dark:bg-zinc-900"></div>
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div data-search-results class="hidden space-y-8">
            <div class="flex items-center gap-3 border-b-2 border-red-600 pb-3">
              <Icon name="trending" class="w-5 h-5 text-red-600" />
              <h2 class="uppercase text-xs font-black tracking-[0.2em] italic text-zinc-900 dark:text-zinc-50">
                Pulso da busca
              </h2>
            </div>
            <div data-search-grid class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8"></div>
          </div>

          <section data-search-empty class="hidden rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-10 text-center">
            <h2 class="text-3xl md:text-4xl font-serif font-black italic tracking-tighter text-zinc-900 dark:text-zinc-50">
              Nenhum resultado encontrado
            </h2>
            <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400 font-medium">
              Tente buscar por uma palavra mais curta, categoria ou tema relacionado.
            </p>
          </section>

          <script id="search-data" type="application/json" is:inline set:html={JSON.stringify(searchDocuments)}></script>
          <script is:inline>
            (() => {
              const dataEl = document.getElementById('search-data');
              if (!dataEl) return;
              const articles = JSON.parse(dataEl.textContent || '[]');
              const params = new URLSearchParams(window.location.search);
              const query = (params.get('q') || '').trim();
              const normalize = (value) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
              const terms = normalize(query).split(/\s+/).filter(Boolean);
              const title = document.querySelector('[data-search-title]');
              const input = document.querySelector('[data-search-input]');
              const status = document.querySelector('[data-search-status]');
              const count = document.querySelector('[data-search-count]');
              const results = document.querySelector('[data-search-results]');
              const grid = document.querySelector('[data-search-grid]');
              const empty = document.querySelector('[data-search-empty]');
              const loading = document.querySelector('[data-search-loading]');
              const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (char) => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;',
              })[char]);
              const formatDate = (value) => {
                try {
                  return new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short' }).format(new Date(value));
                } catch {
                  return '';
                }
              };
              const scoreArticle = (article) => terms.reduce((total, term) => {
                let next = total;
                const title = normalize(article.title || '');
                const summary = normalize(article.summary || '');
                const category = normalize([article.category, article.subcategory || ''].join(' '));
                const author = normalize(article.author || '');
                const tags = normalize((article.tags || []).join(' '));
                if (title.includes(term)) next += 12;
                if (summary.includes(term)) next += 7;
                if (category.includes(term)) next += 4;
                if (tags.includes(term)) next += 4;
                if (author.includes(term)) next += 2;
                if ((article.searchText || '').includes(term)) next += 1;
                return next;
              }, 0);
              const renderCard = (article) => `
                <a href="/noticia/${encodeURIComponent(article.slug)}" class="group space-y-6">
                  <div class="aspect-[16/10] rounded-[2rem] overflow-hidden bg-zinc-100 dark:bg-zinc-800 relative shadow-md group-hover:shadow-xl transition-all">
                    ${article.imageUrl ? `
                      <img src="${escapeHtml(article.imageUrl)}" class="w-full h-full object-cover transition-transform duration-[2s] group-hover:scale-105" alt="${escapeHtml(article.title)}" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                    ` : '<div class="w-full h-full bg-zinc-100 dark:bg-zinc-800"></div>'}
                  </div>
                  <div class="space-y-3">
                    <div class="flex items-center gap-3 text-[8px] font-black uppercase tracking-widest text-zinc-400">
                      <span>${escapeHtml(article.category)}</span>
                      <span class="border-l border-zinc-200 dark:border-zinc-800 pl-3">${formatDate(article.publishedAt)}</span>
                    </div>
                    <h3 class="text-2xl font-serif font-black leading-tight tracking-tighter text-zinc-900 dark:text-zinc-50 group-hover:text-red-700 dark:group-hover:text-red-400 transition-colors">
                      ${escapeHtml(article.title)}
                    </h3>
                    <p class="text-zinc-500 dark:text-zinc-400 text-[11px] font-medium leading-relaxed italic line-clamp-3">
                      ${escapeHtml(article.summary)}
                    </p>
                  </div>
                </a>
              `;

              if (input) input.value = query;
              if (!query || !terms.length) return;

              if (title) title.textContent = `Resultados para "${query}"`;
              if (loading) loading.classList.remove('hidden');

              const matches = articles
                .map((article) => ({ article, score: scoreArticle(article) }))
                .filter((item) => item.score > 0)
                .sort((a, b) => b.score - a.score || new Date(b.article.publishedAt).getTime() - new Date(a.article.publishedAt).getTime());
              const visible = matches.slice(0, 30).map((item) => item.article);

              if (status) status.classList.remove('hidden');
              if (count) {
                count.textContent = matches.length === 1
                  ? '1 matéria relacionada'
                  : `${Math.min(matches.length, 30)} matérias relacionadas${matches.length > 30 ? ' · exibindo as 30 mais relevantes' : ''}`;
              }

              if (!visible.length) {
                if (loading) loading.classList.add('hidden');
                if (empty) empty.classList.remove('hidden');
                return;
              }

              if (grid) grid.innerHTML = visible.map(renderCard).join('');
              if (loading) loading.classList.add('hidden');
              if (results) results.classList.remove('hidden');
            })();
          </script>

          <NewsletterBlock />
        </div>

        <aside class="lg:col-span-3 lg:pl-10 lg:border-l border-zinc-200 dark:border-zinc-800 transition-colors duration-300 relative h-full">
          <div class="space-y-12 h-full flex flex-col">
            <section class="space-y-8 flex-shrink-0">
              <div class="flex items-center gap-3 mb-4 border-b-2 border-red-600 pb-3">
                <Icon name="trending" class="w-5 h-5 text-red-600" />
                <h3 class="uppercase text-xs font-black tracking-[0.2em] italic text-zinc-900 dark:text-zinc-50">
                  MAIS ACESSADAS
                </h3>
              </div>
              <div class="space-y-8">
                {mostRead.map((article, index) => <ArticleCard article={article} variant="side" index={index} />)}
              </div>
            </section>

            <div class="sticky top-28 transition-[top] duration-700 ease-in-out space-y-10 h-fit pb-10 z-10">
              <div class="h-[500px] w-full shrink-0">
                <AdCard label="Publicidade Lateral" class="h-full w-full" />
              </div>
              <NewsletterBlock compact />
            </div>
          </div>
        </aside>
      </div>
    </main>
  </div>
</BaseLayout>
