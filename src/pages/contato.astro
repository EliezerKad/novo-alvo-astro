---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import { getCollection } from 'astro:content';
import { categoriesList, newsEntryToArticle, sortNewsByDate, subCategoriesList, urgentNews } from '../lib/news';

const newsEntries = sortNewsByDate(await getCollection('news'));
const tickerArticles = urgentNews(newsEntries).map(newsEntryToArticle);
---

<BaseLayout
  title="Contato | Novo Alvo"
  description="Entre em contato com a redação do Novo Alvo para pautas, sugestões, correções, parcerias comerciais e assuntos institucionais."
  canonical={new URL('/contato', Astro.site ?? Astro.url.origin).href}
>
  <div class="min-h-screen bg-zinc-50 dark:bg-zinc-950">
    <Navbar tickerArticles={tickerArticles} categories={categoriesList} subCategories={subCategoriesList} />
    <main class="max-w-3xl mx-auto px-4 md:px-8 py-12">
      <h1 class="text-4xl md:text-5xl font-black tracking-tighter italic uppercase text-red-600 mb-8">
        Fale Conosco
      </h1>

      <p class="text-zinc-600 dark:text-zinc-400 mb-8 max-w-2xl text-lg">
        Dúvidas, sugestões de pautas, correções ou propostas comerciais? Envie sua mensagem preenchendo o formulário abaixo, ou envie um e-mail diretamente para
        <a href="mailto:contato@portalnovoalvo.com.br" class="text-red-600 font-bold hover:underline"> contato@portalnovoalvo.com.br</a>.
      </p>

      <form class="space-y-6" data-contact-form>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-sm font-bold uppercase tracking-widest text-zinc-500 mb-2">Nome Completo</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              class="w-full bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl p-4 focus:ring-2 focus:ring-red-600/20 focus:border-red-600 outline-none transition-all dark:text-white"
              placeholder="Seu nome"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-bold uppercase tracking-widest text-zinc-500 mb-2">E-mail</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="w-full bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl p-4 focus:ring-2 focus:ring-red-600/20 focus:border-red-600 outline-none transition-all dark:text-white"
              placeholder="seu.email@exemplo.com"
            />
          </div>
        </div>

        <div>
          <label for="subject" class="block text-sm font-bold uppercase tracking-widest text-zinc-500 mb-2">Assunto</label>
          <select
            id="subject"
            name="subject"
            required
            class="w-full bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl p-4 focus:ring-2 focus:ring-red-600/20 focus:border-red-600 outline-none transition-all dark:text-white"
          >
            <option value="" disabled selected>Selecione um assunto</option>
            <option value="Sugestão de Pauta">Sugestão de Pauta</option>
            <option value="Correção de Matéria">Correção de Matéria</option>
            <option value="Comercial / Parcerias">Comercial / Parcerias</option>
            <option value="Outros">Outros</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-bold uppercase tracking-widest text-zinc-500 mb-2">Mensagem</label>
          <textarea
            id="message"
            name="message"
            required
            rows="6"
            class="w-full bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl p-4 focus:ring-2 focus:ring-red-600/20 focus:border-red-600 outline-none transition-all resize-none dark:text-white"
            placeholder="Descreva sua mensagem aqui..."
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full md:w-auto px-8 py-4 bg-red-600 text-white rounded-xl font-bold uppercase tracking-widest text-sm hover:bg-red-700 transition-colors flex items-center justify-center gap-2"
        >
          Enviar Mensagem
          <svg class="w-4 h-4 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </button>

        <p class="hidden text-green-600 font-bold mt-4" data-contact-status>
          Redirecionando para seu cliente de e-mail...
        </p>
      </form>
    </main>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-contact-status]');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') || '');
    const email = String(data.get('email') || '');
    const subject = String(data.get('subject') || '');
    const message = String(data.get('message') || '');
    const body = `Nome: ${name}\nE-mail: ${email}\n\nMensagem:\n${message}`;
    const mailtoLink = `mailto:contato@portalnovoalvo.com.br?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    status?.classList.remove('hidden');
    window.location.href = mailtoLink;
    form.reset();
  });
</script>
