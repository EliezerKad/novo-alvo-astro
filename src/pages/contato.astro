---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import { getCollection } from 'astro:content';
import { categoriesList, newsEntryToArticle, sortNewsByDate, subCategoriesList, urgentNews } from '../lib/news';

const newsEntries = sortNewsByDate(await getCollection('news'));
const tickerArticles = urgentNews(newsEntries).map(newsEntryToArticle);
---

<BaseLayout title="Contato | Novo Alvo" description="Entre em contato com a redacao do Novo Alvo para pautas, sugestoes e assuntos institucionais." canonical={new URL('/contato', Astro.site ?? Astro.url.origin).href}>
  <div class="min-h-screen bg-zinc-50 dark:bg-zinc-950">
    <Navbar tickerArticles={tickerArticles} categories={categoriesList} subCategories={subCategoriesList} />
    <main class="max-w-5xl mx-auto px-4 py-16 grid grid-cols-1 lg:grid-cols-2 gap-10">
      <section class="space-y-5">
        <span class="text-[10px] font-black uppercase tracking-[0.4em] text-red-600">Contato</span>
        <h1 class="text-5xl md:text-7xl font-serif font-black tracking-tighter italic text-zinc-900 dark:text-zinc-50">Fale com a redacao</h1>
        <p class="text-zinc-500 dark:text-zinc-400 leading-8 font-medium">Use este canal para sugestoes de pauta, correcoes, propostas institucionais e contatos comerciais.</p>
        <NewsletterBlock compact />
      </section>
      <form class="bg-white dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800 rounded-[2rem] p-6 shadow-sm space-y-4" action="/" method="get">
        <input class="w-full bg-zinc-50 dark:bg-zinc-800 rounded-xl border-none px-4 py-3 text-xs font-bold uppercase tracking-widest dark:text-white" name="nome" placeholder="Nome" required />
        <input class="w-full bg-zinc-50 dark:bg-zinc-800 rounded-xl border-none px-4 py-3 text-xs font-bold uppercase tracking-widest dark:text-white" name="email" type="email" placeholder="E-mail" required />
        <textarea class="w-full min-h-40 bg-zinc-50 dark:bg-zinc-800 rounded-xl border-none px-4 py-3 text-xs font-bold uppercase tracking-widest dark:text-white" name="mensagem" placeholder="Mensagem" required></textarea>
        <button class="w-full bg-red-600 text-white rounded-xl px-4 py-3 text-[10px] font-black uppercase tracking-widest hover:bg-zinc-900 transition-colors" type="submit">Enviar</button>
      </form>
    </main>
  </div>
</BaseLayout>
