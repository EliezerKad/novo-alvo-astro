---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import { getCollection } from 'astro:content';
import { categoriesList, newsEntryToArticle, sortNewsByDate, subCategoriesList, urgentNews } from '../lib/news';

const newsEntries = sortNewsByDate(await getCollection('news'));
const tickerArticles = urgentNews(newsEntries).map(newsEntryToArticle);
---

<BaseLayout title="Sobre | Novo Alvo" description="Conheca a proposta editorial do Novo Alvo, um portal de noticias com foco em fatos, impacto e contexto." canonical={new URL('/sobre', Astro.site ?? Astro.url.origin).href}>
  <div class="min-h-screen bg-zinc-50 dark:bg-zinc-950">
    <Navbar tickerArticles={tickerArticles} categories={categoriesList} subCategories={subCategoriesList} />
    <main class="max-w-4xl mx-auto px-4 py-16 space-y-10">
      <header class="space-y-4">
        <span class="text-[10px] font-black uppercase tracking-[0.4em] text-red-600">Institucional</span>
        <h1 class="text-5xl md:text-7xl font-serif font-black tracking-tighter italic text-zinc-900 dark:text-zinc-50">Sobre o Novo Alvo</h1>
        <p class="text-xl text-zinc-500 dark:text-zinc-400 leading-8 font-medium italic">Jornalismo digital com foco em fatos relevantes, leitura rapida e contexto editorial.</p>
      </header>
      <section class="prose prose-zinc dark:prose-invert max-w-none">
        <p>O Novo Alvo organiza noticias e analises para leitores que buscam entender o impacto dos acontecimentos no Brasil e no mundo.</p>
        <p>Nossa estrutura Astro prioriza performance, indexacao, acessibilidade e publicacao editorial estatica, com caminho preparado para um CMS futuro.</p>
      </section>
      <NewsletterBlock />
    </main>
  </div>
</BaseLayout>
