---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import AdCard from '../../components/AdCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import NewsletterBlock from '../../components/NewsletterBlock.astro';
import { getCollection } from 'astro:content';
import {
  categoriesList,
  categoryUrl,
  newsEntryToArticle,
  sortNewsByDate,
  subCategoriesList,
  urgentNews,
} from '../../lib/news';
import { getCategoryColor } from '../../lib/utils';

export async function getStaticPaths() {
  const allCategories = [...categoriesList, ...subCategoriesList];
  return allCategories.map((category) => ({
    params: { category: categoryUrl(category).split('/').filter(Boolean).pop() },
    props: { category },
  }));
}

interface Props {
  category: string;
}

const { category } = Astro.props;
const newsEntries = sortNewsByDate(await getCollection('news'));
const articles = newsEntries.map(newsEntryToArticle);
const categoryArticles = articles.filter((article) => article.category === category);
const visibleArticles = categoryArticles.length > 0 ? categoryArticles : [];
const mostRead = [...articles].sort((a, b) => (b.views || 0) - (a.views || 0)).slice(0, 5);
const tickerArticles = urgentNews(newsEntries).map(newsEntryToArticle);
const canonical = new URL(categoryUrl(category), Astro.site ?? Astro.url.origin).href;
const breadcrumbs = [
  { name: 'Inicio', url: new URL('/', Astro.site ?? Astro.url.origin).href },
  { name: category, url: canonical },
];
---

<BaseLayout
  title={`${category} | Novo Alvo`}
  description={`Noticias de ${category} no Novo Alvo, com cobertura editorial, contexto e fatos relevantes.`}
  canonical={canonical}
  breadcrumbs={breadcrumbs}
>
  <div class="min-h-screen bg-zinc-50 dark:bg-zinc-950 transition-colors duration-300">
    <Navbar tickerArticles={tickerArticles} category={category} categories={categoriesList} subCategories={subCategoriesList} />
    <Breadcrumbs items={breadcrumbs} />

    <main class="max-w-7xl mx-auto px-4 mt-8 mb-20 transition-all duration-500">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-9 space-y-12">
          <header class="space-y-2">
            <div class="flex items-center gap-4">
              <div class={`w-2 h-10 ${getCategoryColor(category)} rounded-full`}></div>
              <h1 class="text-5xl font-serif font-black italic tracking-tighter text-zinc-900 dark:text-zinc-50 uppercase">
                {category}
              </h1>
            </div>
            <p class="text-[10px] font-black uppercase tracking-[0.4em] text-zinc-400 ml-6">
              Cobertura Completa e Fatos Relevantes
            </p>
          </header>

          {visibleArticles.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
              {visibleArticles.map((article) => <ArticleCard article={article} variant="pulse" />)}
            </div>
          ) : (
            <div class="py-24 text-center uppercase">
              <h2 class="text-4xl font-black italic text-zinc-300">Em diligencia editorial...</h2>
              <p class="text-zinc-400 text-xs font-black tracking-widest mt-4">Novas pautas desta categoria entram em breve.</p>
            </div>
          )}

          <NewsletterBlock />
        </div>

        <aside class="lg:col-span-3 lg:pl-10 lg:border-l border-zinc-200 dark:border-zinc-800 transition-colors duration-300 relative h-full">
          <div class="space-y-12 h-full flex flex-col">
            <section class="space-y-8 flex-shrink-0">
              <div class="flex items-center gap-3 mb-4 border-b-2 border-red-600 pb-3">
                <Icon name="trending" class="w-5 h-5 text-red-600" />
                <h3 class="uppercase text-xs font-black tracking-[0.2em] italic text-zinc-900 dark:text-zinc-50">
                  MAIS ACESSADAS
                </h3>
              </div>
              <div class="space-y-8">
                {mostRead.map((article, index) => <ArticleCard article={article} variant="side" index={index} />)}
              </div>
            </section>

            <div class="sticky top-28 transition-[top] duration-700 ease-in-out space-y-10 h-fit pb-10 z-10">
              <div class="h-[500px] w-full shrink-0">
                <AdCard label="Publicidade Lateral" class="h-full w-full" />
              </div>
              <NewsletterBlock compact />
            </div>
          </div>
        </aside>
      </div>
    </main>
  </div>
</BaseLayout>
