---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import { getCollection } from 'astro:content';
import { categoriesList, newsEntryToArticle, sortNewsByDate, subCategoriesList, urgentNews } from '../lib/news';

const newsEntries = sortNewsByDate(await getCollection('news'));
const tickerArticles = urgentNews(newsEntries).map(newsEntryToArticle);
---

<BaseLayout title="Politica de Privacidade | Novo Alvo" description="Politica de privacidade do portal Novo Alvo, incluindo informacoes sobre anuncios, cookies e contato editorial." canonical={new URL('/politica-de-privacidade', Astro.site ?? Astro.url.origin).href}>
  <div class="min-h-screen bg-zinc-50 dark:bg-zinc-950">
    <Navbar tickerArticles={tickerArticles} categories={categoriesList} subCategories={subCategoriesList} />
    <main class="max-w-4xl mx-auto px-4 py-16 space-y-8">
      <h1 class="text-5xl md:text-7xl font-serif font-black tracking-tighter italic text-zinc-900 dark:text-zinc-50">Privacidade</h1>
      <div class="prose prose-zinc dark:prose-invert max-w-none">
        <p>O Novo Alvo valoriza a privacidade dos leitores e busca operar com transparencia sobre dados, cookies e publicidade.</p>
        <h2>Publicidade e cookies</h2>
        <p>O portal pode exibir anuncios por meio de parceiros como Google AdSense. Esses parceiros podem usar cookies para mensurar desempenho e personalizar publicidade conforme suas politicas.</p>
        <h2>Contato</h2>
        <p>Solicitacoes sobre privacidade podem ser enviadas pela pagina de contato.</p>
      </div>
    </main>
  </div>
</BaseLayout>
