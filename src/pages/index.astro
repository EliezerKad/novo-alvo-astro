---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import AdCard from '../components/AdCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import Icon from '../components/Icon.astro';
import NewsletterBlock from '../components/NewsletterBlock.astro';
import { getCollection } from 'astro:content';
import {
  categoriesList,
  categoryUrl,
  featuredNews,
  newsEntryToArticle,
  sortNewsByDate,
  subCategoriesList,
  urgentNews,
} from '../lib/news';
import { getCategoryColor } from '../lib/utils';

const newsEntries = sortNewsByDate(await getCollection('news'));
const articles = newsEntries.map(newsEntryToArticle);
const category = Astro.url.searchParams.get('category') || undefined;
const filteredArticles = articles.filter((article) => {
  if (category && category !== 'Início' && article.category !== category) return false;
  return true;
});

const visibleArticles = filteredArticles.length > 0 ? filteredArticles : articles;
const featuredArticles = featuredNews(newsEntries).map(newsEntryToArticle);
const tickerArticles = urgentNews(newsEntries).map(newsEntryToArticle);
const featured = featuredArticles[0] || visibleArticles[0];
const topNews = visibleArticles.filter((article) => article.id !== featured.id).slice(0, 4);
const mostRead = [...articles].sort((a, b) => (b.views || 0) - (a.views || 0)).slice(0, 5);
const categorySections = [...categoriesList, ...subCategoriesList]
  .map((sectionCategory) => ({
    category: sectionCategory,
    articles: articles.filter((article) => article.category === sectionCategory).slice(0, 4),
  }))
  .filter((section) => section.articles.length > 0);
const initialCategorySections = 3;
const hasMoreCategorySections = categorySections.length > initialCategorySections;
const isCategoryView = !!category && category !== 'Início';
---

<BaseLayout
  title="Portal Novo Alvo - Notícias, Fatos e Impacto"
  canonical={new URL('/', Astro.site ?? Astro.url.origin).href}
  description="Portal Novo Alvo reúne notícias, análise e cobertura editorial com foco em fatos relevantes do Brasil e do mundo."
>
  <div class="min-h-screen bg-[radial-gradient(circle_at_50%_0%,rgba(239,68,68,0.06),transparent_26%),linear-gradient(180deg,#fafafa_0%,#f4f4f5_48%,#fafafa_100%)] transition-colors duration-300 dark:bg-[radial-gradient(circle_at_50%_0%,rgba(239,68,68,0.10),transparent_28%),linear-gradient(180deg,#09090b_0%,#18181b_48%,#09090b_100%)]">
    <Navbar tickerArticles={tickerArticles} category={category} categories={categoriesList} subCategories={subCategoriesList} />

    <div class="bg-white dark:bg-zinc-900 border-b border-zinc-200 dark:border-zinc-800 py-4 md:py-6 transition-colors duration-300">
      <div class="max-w-7xl mx-auto px-4 md:px-6 flex justify-center">
        <AdCard size="728x90" class="w-full max-w-[728px] h-[60px] md:h-[90px]" />
      </div>
    </div>

    <main class="max-w-7xl mx-auto px-4 mt-5 md:mt-8 mb-20 transition-all duration-500">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
        <div class="lg:col-span-9 space-y-12 md:space-y-16">
          {
            isCategoryView ? (
              <div class="space-y-12">
                <header class="space-y-2">
                  <div class="flex items-center gap-4">
                    <div class={`w-2 h-10 ${getCategoryColor(category || '')} rounded-full`}></div>
                    <h2 class="text-5xl font-serif font-black italic tracking-tighter text-zinc-900 dark:text-zinc-50 uppercase">
                      {category}
                    </h2>
                  </div>
                  <p class="text-[10px] font-black uppercase tracking-[0.4em] text-zinc-400 ml-6">
                    Cobertura Completa e Fatos Relevantes
                  </p>
                </header>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                  {visibleArticles.map((article) => <ArticleCard article={article} variant="pulse" />)}
                </div>
              </div>
            ) : (
              <>
                <FeaturedCarousel articles={featuredArticles.length > 0 ? featuredArticles : [featured]} />

                <section class="hidden space-y-7 md:space-y-8" data-cms-latest-section>
                  <div class="flex items-center gap-3 border-b-2 border-red-600 pb-3">
                    <Icon name="trending" class="w-5 h-5 text-red-600" />
                    <h3 class="uppercase text-xs font-black tracking-[0.2em] italic text-zinc-900 dark:text-zinc-50">
                      AGORA NO PORTAL
                    </h3>
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10" data-cms-latest-grid></div>
                </section>

                <section class="space-y-7 md:space-y-8">
                  <div class="flex items-center gap-3 border-b-2 border-red-600 pb-3">
                    <Icon name="trending" class="w-5 h-5 text-red-600" />
                    <h3 class="uppercase text-xs font-black tracking-[0.2em] italic text-zinc-900 dark:text-zinc-50">
                      PULSO DO BRASIL
                    </h3>
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10">
                    {topNews.map((article) => <ArticleCard article={article} variant="pulse" />)}
                  </div>
                </section>

                <div class="space-y-14 md:space-y-20" data-category-sections>
                  {categorySections.map((section, sectionIndex) => (
                    <section
                      id={`category-section-${sectionIndex}`}
                      class={`space-y-8 ${sectionIndex >= initialCategorySections ? 'hidden' : ''}`}
                      data-category-section
                      data-category-hidden={sectionIndex >= initialCategorySections ? 'true' : 'false'}
                    >
                      <div class="flex items-center justify-between border-b border-zinc-200 dark:border-zinc-800 pb-4">
                        <div class="flex items-center gap-4">
                          <div class={`w-2 h-8 ${getCategoryColor(section.category)} rounded-full`}></div>
                          <h3 class="uppercase text-2xl md:text-3xl font-serif font-black italic tracking-tighter leading-none text-zinc-900 dark:text-zinc-50">
                            {section.category}
                          </h3>
                        </div>
                        <a href={categoryUrl(section.category)} class="hidden md:inline-flex items-center gap-1 text-[9px] font-black uppercase tracking-widest text-red-600 hover:text-red-700">
                          Ver tudo
                          <Icon name="chevronRight" class="w-3 h-3" />
                        </a>
                      </div>

                      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8">
                        <div class="md:col-span-7">
                          <ArticleCard article={section.articles[0]} variant="pulse" />
                        </div>
                        <div class="md:col-span-5 space-y-8">
                          {section.articles.slice(1).map((article) => <ArticleCard article={article} variant="list" />)}
                        </div>
                      </div>

                      {(section.category === 'Economia' || section.category === 'Saúde') && (
                        <div class="py-12 border-y border-zinc-100 dark:border-zinc-800 flex flex-col items-center gap-4 bg-zinc-50/50 dark:bg-zinc-900/30 rounded-[3rem]">
                          <span class="text-[7px] font-black text-zinc-300 dark:text-zinc-700 uppercase tracking-[0.4em]">
                            PUBLICIDADE EDITORIAL NOVO ALVO
                          </span>
                          <AdCard size="728x90" class="w-full max-w-[728px] h-[90px]" />
                        </div>
                      )}
                    </section>
                  ))}

                  {hasMoreCategorySections && (
                    <div class="pt-2">
                      <button
                        type="button"
                        class="w-full rounded-2xl bg-red-600 px-6 py-4 text-[10px] font-black uppercase tracking-[0.2em] text-white shadow-lg shadow-red-600/20 transition-all hover:bg-red-700 hover:shadow-xl hover:shadow-red-600/25 focus:outline-none focus:ring-2 focus:ring-red-600 focus:ring-offset-2 dark:focus:ring-offset-zinc-950"
                        data-show-more-categories
                      >
                        Mostrar mais
                      </button>
                    </div>
                  )}
                </div>

                <script is:inline>
                  (() => {
                    const button = document.querySelector('[data-show-more-categories]');
                    if (button) {
                      button.addEventListener('click', () => {
                        document.querySelectorAll('[data-category-hidden="true"]').forEach((section) => {
                          section.classList.remove('hidden');
                          section.dataset.categoryHidden = 'false';
                        });
                        button.closest('div')?.remove();
                      });
                    }

                    const section = document.querySelector('[data-cms-latest-section]');
                    const grid = document.querySelector('[data-cms-latest-grid]');
                    if (!section || !grid) return;

                    const escapeHtml = (value) =>
                      String(value || '')
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;')
                        .replace(/'/g, '&#039;');

                    const formatDate = (value) => {
                      const date = new Date(value || Date.now());
                      const diff = Date.now() - date.getTime();
                      const minutes = Math.max(1, Math.floor(diff / 60000));
                      if (minutes < 60) return `há ${minutes} min`;
                      const hours = Math.floor(minutes / 60);
                      if (hours < 24) return `há ${hours}h`;
                      return new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short' }).format(date);
                    };

                    fetch('/api/public/articles?limit=4')
                      .then((response) => (response.ok ? response.json() : { articles: [] }))
                      .then((data) => {
                        const articles = Array.isArray(data.articles) ? data.articles : [];
                        if (!articles.length) return;
                        grid.innerHTML = articles
                          .map((article) => {
                            const image = article.cover_url || '/og-default.svg';
                            const url = `/noticia/${encodeURIComponent(article.slug)}/`;
                            return `
                              <article class="group overflow-hidden rounded-[2rem] bg-white shadow-[0_24px_80px_rgba(15,23,42,0.06)] ring-1 ring-zinc-100 transition-all duration-500 hover:-translate-y-1 hover:shadow-[0_28px_90px_rgba(220,38,38,0.12)] dark:bg-zinc-950 dark:ring-zinc-800">
                                <a href="${url}" class="block">
                                  <div class="aspect-[16/10] overflow-hidden bg-zinc-100 dark:bg-zinc-900">
                                    <img src="${escapeHtml(image)}" alt="${escapeHtml(article.cover_alt || article.title)}" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
                                  </div>
                                  <div class="space-y-3 p-5">
                                    <div class="flex items-center gap-3 text-[9px] font-black uppercase tracking-widest text-zinc-400">
                                      <span class="text-red-600">${escapeHtml(article.category || 'Editorial')}</span>
                                      <span>${formatDate(article.published_at || article.scheduled_at || article.updated_at)}</span>
                                    </div>
                                    <h4 class="font-serif text-2xl font-black italic leading-none tracking-tighter text-zinc-900 dark:text-zinc-50">${escapeHtml(article.title)}</h4>
                                    <p class="line-clamp-2 text-sm font-medium leading-6 text-zinc-500 dark:text-zinc-400">${escapeHtml(article.summary || '')}</p>
                                  </div>
                                </a>
                              </article>
                            `;
                          })
                          .join('');
                        section.classList.remove('hidden');
                      })
                      .catch(() => {});
                  })();
                </script>

                <div class="py-12 border-y border-zinc-100 dark:border-zinc-800 flex flex-col items-center gap-4 bg-white dark:bg-zinc-950">
                  <span class="text-[7px] font-black text-zinc-300 dark:text-zinc-700 uppercase tracking-[0.4em]">
                    PUBLICIDADE
                  </span>
                  <AdCard size="728x90" class="w-full max-w-[728px] h-[90px]" />
                </div>
              </>
            )
          }
        </div>

        <aside class="lg:col-span-3 lg:pl-10 lg:border-l border-zinc-200 dark:border-zinc-800 transition-colors duration-300 relative h-full">
          <div class="space-y-12 h-full flex flex-col">
            <section class="space-y-8 flex-shrink-0">
              <div class="flex items-center gap-3 mb-4 border-b-2 border-red-600 pb-3">
                <Icon name="trending" class="w-5 h-5 text-red-600" />
                <h3 class="uppercase text-xs font-black tracking-[0.2em] italic text-zinc-900 dark:text-zinc-50">
                  MAIS ACESSADAS
                </h3>
              </div>
              <div class="space-y-8">
                {mostRead.map((article, index) => <ArticleCard article={article} variant="side" index={index} />)}
              </div>
            </section>

            <div class="sticky top-28 transition-[top] duration-700 ease-in-out space-y-10 h-fit pb-10 z-10">
              <div class="h-[500px] w-full shrink-0">
                <AdCard label="Publicidade Lateral" class="h-full w-full" />
              </div>

              <NewsletterBlock compact />
            </div>
          </div>
        </aside>
      </div>
    </main>
  </div>
</BaseLayout>
