---
import BaseLayout from '../layouts/BaseLayout.astro';

const soundcloudUrl = 'https://soundcloud.com/xapreto/oh-lala-space-jam-by-x-a-preto';
const instagramUrl = 'https://instagram.com/eliezerman';
const contactUrl = 'mailto:elidepaula@msn.com';
---

<BaseLayout
  title="x.a preto | Portal Novo Alvo"
  canonical={new URL('/', Astro.site ?? Astro.url.origin).href}
  description="Official landing page for x.a preto, an independent producer sharing new music, edits and collaborations with DJs and selectors."
>
  <main class="xap-site">
    <section class="xap-hero">
      <div class="xap-badge">Portal Novo Alvo</div>
      <h1>x.a preto</h1>
      <p class="xap-lead">
        Independent producer shaping warm club music, edits and left-field grooves from Brazil to selectors around the world.
      </p>
      <div class="xap-actions">
        <a class="xap-primary" href={soundcloudUrl} target="_blank" rel="noreferrer">Listen to “oh lala/space jam” ↗</a>
        <a class="xap-secondary" href={instagramUrl} target="_blank" rel="noreferrer">Instagram @eliezerman</a>
      </div>
    </section>

    <section class="xap-cards" aria-label="Highlights">
      <article>
        <span>01</span>
        <h2>For DJs and selectors</h2>
        <p>New music, WAVs and unreleased ideas are available for sets, radio folders and personal listening.</p>
      </article>
      <article>
        <span>02</span>
        <h2>Worldwide ear</h2>
        <p>Some earlier x.a preto tracks have reached Soulection-related sets, radio selections and independent selectors.</p>
      </article>
      <article>
        <span>03</span>
        <h2>Open to build</h2>
        <p>Remixes, edits, guest mixes and collab ideas are welcome when the sound connects.</p>
      </article>
    </section>

    <section class="xap-track">
      <div>
        <p>Current focus</p>
        <h2>oh lala/space jam</h2>
        <span>A direct link for anyone checking the domain after receiving a message from x.a preto.</span>
      </div>
      <a class="xap-primary" href={soundcloudUrl} target="_blank" rel="noreferrer">Open SoundCloud ↗</a>
    </section>

    <footer class="xap-footer">
      <span>Contact / replies</span>
      <a href={contactUrl}>elidepaula@msn.com</a>
    </footer>
  </main>

  <style>
    :global(body) {
      margin: 0;
      background:
        radial-gradient(circle at 20% 10%, rgba(255, 122, 54, 0.32), transparent 34rem),
        radial-gradient(circle at 80% 20%, rgba(105, 79, 255, 0.28), transparent 28rem),
        linear-gradient(145deg, #090706 0%, #17100c 48%, #050505 100%);
      color: #f7efe5;
    }

    .xap-site {
      width: min(1120px, calc(100% - 40px));
      min-height: 100vh;
      margin: 0 auto;
      padding: 48px 0 30px;
      display: grid;
      gap: 26px;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .xap-hero,
    .xap-track,
    .xap-cards article,
    .xap-footer {
      border: 1px solid rgba(247, 239, 229, 0.14);
      background: rgba(15, 12, 10, 0.72);
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.28);
      backdrop-filter: blur(18px);
    }

    .xap-hero {
      min-height: 560px;
      display: flex;
      flex-direction: column;
      justify-content: end;
      border-radius: 42px;
      padding: clamp(28px, 7vw, 72px);
      overflow: hidden;
      position: relative;
    }

    .xap-hero::before {
      content: '';
      position: absolute;
      inset: 26px;
      border-radius: 32px;
      border: 1px solid rgba(247, 239, 229, 0.08);
      pointer-events: none;
    }

    .xap-badge {
      width: fit-content;
      margin-bottom: 22px;
      border-radius: 999px;
      padding: 10px 14px;
      color: #ffd1aa;
      background: rgba(255, 122, 54, 0.16);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .xap-site h1,
    .xap-site h2,
    .xap-site p { margin: 0; }

    .xap-site h1 {
      max-width: 900px;
      font-size: clamp(64px, 15vw, 170px);
      line-height: 0.82;
      letter-spacing: -0.09em;
      text-transform: lowercase;
    }

    .xap-lead {
      max-width: 720px;
      margin-top: 28px !important;
      color: rgba(247, 239, 229, 0.78);
      font-size: clamp(19px, 3vw, 30px);
      line-height: 1.22;
    }

    .xap-actions {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      margin-top: 34px;
    }

    .xap-primary,
    .xap-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      border-radius: 999px;
      padding: 0 20px;
      font-weight: 800;
      text-decoration: none;
    }

    .xap-primary {
      color: #120a05;
      background: #ffb36b;
    }

    .xap-secondary {
      color: #f7efe5;
      background: rgba(247, 239, 229, 0.1);
    }

    .xap-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .xap-cards article {
      min-height: 220px;
      border-radius: 28px;
      padding: 24px;
    }

    .xap-cards span,
    .xap-track p { color: #ffb36b; }

    .xap-cards span,
    .xap-track p {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .xap-cards h2,
    .xap-track h2 {
      margin-top: 18px;
      font-size: 24px;
      letter-spacing: -0.04em;
    }

    .xap-cards p,
    .xap-track span {
      display: block;
      margin-top: 12px;
      color: rgba(247, 239, 229, 0.68);
      line-height: 1.55;
    }

    .xap-track {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      border-radius: 32px;
      padding: 28px;
    }

    .xap-footer {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      border-radius: 24px;
      padding: 20px 24px;
      color: rgba(247, 239, 229, 0.7);
    }

    .xap-footer a {
      color: #ffd1aa;
      font-weight: 800;
      text-decoration: none;
    }

    @media (max-width: 760px) {
      .xap-site { width: min(100% - 24px, 1120px); padding-top: 24px; }
      .xap-hero { min-height: 520px; border-radius: 30px; }
      .xap-cards { grid-template-columns: 1fr; }
      .xap-track { align-items: stretch; flex-direction: column; }
    }
  </style>
</BaseLayout>
