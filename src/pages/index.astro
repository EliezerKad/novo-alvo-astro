---
import BaseLayout from '../layouts/BaseLayout.astro';

const soundcloudUrl = 'https://soundcloud.com/xapreto/oh-lala-space-jam-by-x-a-preto';
const instagramUrl = 'https://instagram.com/eliezerman';
const contactUrl = 'mailto:contato@portalnovoalvo.com.br';
const soundcloudEmbed = 'https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/soundcloud%253Atracks%253A2397068337&color=%23c8d7ff&inverse=false&auto_play=true&show_user=true';
---

<BaseLayout
  title="Novo Alvo Productions | x.a preto"
  canonical={new URL('/', Astro.site ?? Astro.url.origin).href}
  description="Novo Alvo Productions is an independent Brazilian music label and production house for edits, club grooves, R&B, soul, audiovisual music and x.a preto releases."
>
  <main class="pna-site" data-lang="en">
    <nav class="pna-nav" aria-label="Novo Alvo Productions navigation">
      <a class="pna-logo" href="/" aria-label="Novo Alvo Productions home">
        <img src="/novo-alvo-symbol-clean.png" alt="" width="42" height="42" />
        <b data-brand-name>Novo Alvo Productions</b>
      </a>
      <div class="pna-nav-links">
        <a href="#release" data-i18n="navRelease">Release</a>
        <a href="#artist" data-i18n="navArtist">Artist</a>
        <a href="#credits" data-i18n="navCredits">Credits</a>
        <a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a>
        <button class="pna-lang" type="button" aria-label="Switch language" data-lang-toggle>
          <strong data-lang-current>EN</strong> / PT
        </button>
      </div>
    </nav>

    <section class="pna-hero" id="artist" aria-labelledby="hero-title">
      <div class="pna-hero-tag" aria-hidden="true">NA001 / EDITS / RADIO COPY / CLUB MEMORY</div>
      <div class="pna-hero-copy">
        <p class="pna-kicker" data-i18n="heroKicker">Independent Brazilian label</p>
        <h1 id="hero-title"><span>NOVO</span><span>ALVO</span></h1>
        <div class="pna-title-tag" data-brand-tag>PRODUCTIONS</div>
        <p class="pna-lead" data-i18n="heroLead">
          An independent music and production house for edits, R&B cuts, club memories and soundtrack ideas — shaped by x.a preto and open to aligned collaborations.
        </p>
        <div class="pna-actions">
          <a class="pna-primary" href={soundcloudUrl} target="_blank" rel="noreferrer" data-i18n="heroListen">Listen to “oh lala/space jam” ↗</a>
          <a class="pna-secondary" href={contactUrl} data-i18n="heroContact">Contact / promo</a>
        </div>
      </div>

      <aside class="pna-artist-card" aria-label="x.a preto artist card">
        <div class="pna-card-top">
          <span>NA001</span>
          <small data-i18n="catalogLabel">artist file</small>
        </div>
        <figure class="pna-portrait">
          <img src="/xapreto-studio-portrait.png" alt="x.a preto in the studio" />
        </figure>
        <div class="pna-artist-text">
          <h2>x.a preto</h2>
          <p data-i18n="artistShort">Producer, vocalist and edit maker moving between R&B, rap, soul, club grooves and music for picture.</p>
          <a href={instagramUrl} target="_blank" rel="noreferrer">@eliezerman ↗</a>
        </div>
      </aside>
    </section>

    <section class="pna-release" id="release" aria-labelledby="release-title" data-tilt-release>
      <div class="pna-release-image">
        <div class="pna-cover-card">
          <img src="/oh-lala-space-jam-cover.png" alt="oh lala/space jam cover art" />
        </div>
        <div class="pna-soundcloud">
          <iframe allow="autoplay; encrypted-media" src={soundcloudEmbed} title="SoundCloud player for oh lala/space jam"></iframe>
          <div class="pna-soundcloud-credit">
            <a href="https://soundcloud.com/xapreto" target="_blank" rel="noreferrer">x.a preto</a> ·
            <a href={soundcloudUrl} target="_blank" rel="noreferrer">oh lala/space jam (by x.a preto)</a>
          </div>
        </div>
      </div>
      <div class="pna-release-copy">
        <p class="pna-kicker" data-i18n="releaseKicker">Current plate</p>
        <h2 id="release-title">oh lala/<br />space jam</h2>
        <p data-i18n="releaseText">
          A rough little flip of two Justine Skye moments originally produced by Kaytranada, pushed into a club edit with a nod to Quad City DJ’s “Space Jam” from the film that never left our heads.
        </p>
        <a class="pna-primary wide" href={soundcloudUrl} target="_blank" rel="noreferrer" data-i18n="releaseCta">Open on SoundCloud ↗</a>
      </div>
    </section>

    <section class="pna-credits" id="credits" aria-labelledby="credits-title">
      <div class="pna-credits-copy">
        <p class="pna-kicker" data-i18n="creditsKicker">Credits in the room</p>
        <h2 id="credits-title" data-i18n="creditsTitle">Sound already crossed screens.</h2>
        <p data-i18n="creditsText">Tracks, edits and voice work connected to productions and studios linked to:</p>
      </div>
      <ul class="pna-logo-strip" aria-label="Client and production credits">
        <li class="mark-hbo">HBO Max</li>
        <li class="mark-netflix">NETFLIX</li>
        <li class="mark-cartoonito">cartoonito</li>
        <li class="mark-record">RECORD</li>
        <li class="mark-dubbing">DUBBING<br />COMPANY</li>
      </ul>
    </section>

    <section class="pna-notes" id="notes" aria-labelledby="notes-title">
      <div class="pna-notes-head">
        <p class="pna-kicker" data-i18n="notesKicker">Label note</p>
        <h2 id="notes-title" data-i18n="notesTitle">Built for records, edits and moving images.</h2>
      </div>
      <div class="pna-manifesto">
        <p class="pna-manifesto-lead" data-i18n="manifestoLead">Novo Alvo is a creative base.</p>
        <p data-i18n="manifestoText">A place to organize x.a preto releases, edits, voice work and soundtrack ideas with the same ear: Black music, club pressure, sample memory and audiovisual timing. The label is small on purpose — direct contact, careful files, real context.</p>
      </div>
    </section>


    <footer class="pna-footer">
      <div>
        <strong data-brand-name>Novo Alvo Productions</strong>
        <span data-i18n="footerLine">Files, soundtrack ideas, voice work and collaborations.</span>
      </div>
      <a class="pna-footer-cta" href={contactUrl} data-i18n="footerCta">Contact Novo Alvo ↗</a>
      <div class="pna-footer-links">
        <a href={contactUrl}>contato@portalnovoalvo.com.br</a>
        <a href={instagramUrl} target="_blank" rel="noreferrer">instagram.com/eliezerman</a>
      </div>
    </footer>
  </main>

  <script is:inline>
    (() => {
      const copy = {
        pt: {
          navRelease: 'Faixa', navArtist: 'Artista', navCredits: 'Créditos',
          heroKicker: 'Selo brasileiro independente',
          heroLead: 'Uma casa independente para edits, R&B, memórias de pista e ideias de trilha — conduzida por x.a preto e aberta a colaborações que façam sentido.',
          heroListen: 'Ouça “oh lala/space jam” ↗', heroContact: 'Contato / promo', catalogLabel: 'arquivo de artista',
          artistShort: 'Produtor, voz e criador de edits entre R&B, rap, soul, grooves de pista e música para imagem.',
          releaseKicker: 'Faixa atual',
          releaseText: 'Uma releitura crua de dois momentos da Justine Skye produzidos originalmente por Kaytranada, levada para um edit de pista com referência a “Space Jam”, do Quad City DJ’s, tema clássico do filme que nunca saiu da cabeça.',
          releaseCta: 'Abrir no SoundCloud ↗',
          creditsKicker: 'Créditos no som', creditsTitle: 'O som já atravessou telas.', creditsText: 'Faixas, edits e trabalhos de voz conectados a produções e estúdios ligados a:',
          notesKicker: 'Nota do selo', notesTitle: 'Feito para faixas, edits e imagens em movimento.',
          manifestoLead: 'Novo Alvo é uma base criativa.',
          manifestoText: 'Um lugar para organizar lançamentos, edits, voz e ideias de trilha de x.a preto com a mesma escuta: black music, pressão de pista, memória de sample e tempo de audiovisual. O selo é pequeno de propósito — contato direto, arquivos bem cuidados e contexto real.',
          footerLine: 'Arquivos, ideias de trilha, voz e colaborações.',
          footerCta: 'Falar com a Novo Alvo ↗'
        },
        en: {
          navRelease: 'Release', navArtist: 'Artist', navCredits: 'Credits',
          heroKicker: 'Independent Brazilian label',
          heroLead: 'An independent music and production house for edits, R&B cuts, club memories and soundtrack ideas — shaped by x.a preto and open to aligned collaborations.',
          heroListen: 'Listen to “oh lala/space jam” ↗', heroContact: 'Contact / promo', catalogLabel: 'artist file',
          artistShort: 'Producer, vocalist and edit maker moving between R&B, rap, soul, club grooves and music for picture.',
          releaseKicker: 'Current plate',
          releaseText: 'A rough little flip of two Justine Skye moments originally produced by Kaytranada, pushed into a club edit with a nod to Quad City DJ’s “Space Jam” from the film that never left our heads.',
          releaseCta: 'Open on SoundCloud ↗',
          creditsKicker: 'Credits in the room', creditsTitle: 'Sound already crossed screens.', creditsText: 'Tracks, edits and voice work connected to productions and studios linked to:',
          notesKicker: 'Label note', notesTitle: 'Built for records, edits and moving images.',
          manifestoLead: 'Novo Alvo is a creative base.',
          manifestoText: 'A place to organize x.a preto releases, edits, voice work and soundtrack ideas with the same ear: Black music, club pressure, sample memory and audiovisual timing. The label is small on purpose — direct contact, careful files, real context.',
          footerLine: 'Files, soundtrack ideas, voice work and collaborations.',
          footerCta: 'Contact Novo Alvo ↗'
        }
      };

      const root = document.querySelector('.pna-site');
      const button = document.querySelector('[data-lang-toggle]');
      const setLang = (lang) => {
        root?.setAttribute('data-lang', lang);
        document.documentElement.lang = lang === 'pt' ? 'pt-BR' : 'en';
        document.querySelectorAll('[data-brand-name]').forEach((node) => {
          node.textContent = lang === 'pt' ? 'Novo Alvo Produções' : 'Novo Alvo Productions';
        });
        document.querySelectorAll('[data-brand-tag]').forEach((node) => {
          node.textContent = lang === 'pt' ? 'PRODUÇÕES' : 'PRODUCTIONS';
        });
        document.querySelectorAll('[data-i18n]').forEach((node) => {
          const key = node.getAttribute('data-i18n');
          if (key && copy[lang]?.[key]) node.textContent = copy[lang][key];
        });
        const other = lang === 'en' ? 'PT' : 'EN';
        if (button) button.innerHTML = `<strong data-lang-current>${lang.toUpperCase()}</strong> / ${other}`;
        try { localStorage.setItem('pna-lang', lang); } catch {}
      };

      const detectLocale = async () => {
        try {
          const saved = localStorage.getItem('pna-lang-manual');
          if (saved === 'pt' || saved === 'en') return saved;
        } catch {}
        try {
          const res = await fetch('/cdn-cgi/trace', { cache: 'no-store' });
          if (res.ok) {
            const text = await res.text();
            if (/(?:^|\n)loc=BR(?:\n|$)/.test(text)) return 'pt';
            if (/(?:^|\n)loc=[A-Z]{2}(?:\n|$)/.test(text)) return 'en';
          }
        } catch {}
        const language = (navigator.language || '').toLowerCase();
        const languages = (navigator.languages || []).join(',').toLowerCase();
        const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
        if (language === 'pt-br' || languages.includes('pt-br') || tz === 'America/Sao_Paulo') return 'pt';
        return 'en';
      };

      detectLocale().then((lang) => setLang(lang === 'pt' ? 'pt' : 'en'));
      button?.addEventListener('click', () => {
        const lang = root?.getAttribute('data-lang') === 'pt' ? 'en' : 'pt';
        try { localStorage.setItem('pna-lang-manual', lang); } catch {}
        setLang(lang);
      });

      document.querySelectorAll('[data-tilt-release]').forEach((card) => {
        card.addEventListener('pointermove', (event) => {
          const rect = card.getBoundingClientRect();
          const x = ((event.clientX - rect.left) / rect.width) * 100;
          const y = ((event.clientY - rect.top) / rect.height) * 100;
          card.style.setProperty('--mx', `${x}%`);
          card.style.setProperty('--my', `${y}%`);
          card.style.setProperty('--rx', `${(y - 50) * -0.035}deg`);
          card.style.setProperty('--ry', `${(x - 50) * 0.035}deg`);
        });
        card.addEventListener('pointerleave', () => {
          card.style.setProperty('--mx', '50%');
          card.style.setProperty('--my', '50%');
          card.style.setProperty('--rx', '0deg');
          card.style.setProperty('--ry', '0deg');
        });
      });
    })();
  </script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@500;700&family=Space+Mono:wght@400;700&display=swap');

    :global(:root) {
      --na-bg: #070707;
      --na-ink: #f4efe1;
      --na-muted: rgba(244, 239, 225, 0.66);
      --na-blue: #9db7ec;
      --na-blue-deep: #263c68;
      --na-lime: #d8ff00;
      --na-brown: #3b2b24;
      --na-paper: #d4c9ad;
      --na-purple: #33204f;
      --na-line: rgba(244, 239, 225, 0.16);
      --na-display: 'Archivo Black', Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
      --na-body: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
      --na-mono: 'Space Mono', ui-monospace, SFMono-Regular, Consolas, monospace;
    }

    :global(body) {
      margin: 0;
      color: var(--na-ink);
      background:
        radial-gradient(circle at 15% 12%, rgba(157, 183, 236, 0.24), transparent 28rem),
        radial-gradient(circle at 78% 16%, rgba(216, 255, 0, 0.16), transparent 21rem),
        radial-gradient(circle at 84% 88%, rgba(51, 32, 79, 0.5), transparent 30rem),
        linear-gradient(135deg, #060606 0%, #11100e 46%, #09080d 100%);
      font-family: var(--na-body);
    }

    :global(body::before) {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 999;
      opacity: 0.12;
      mix-blend-mode: overlay;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.58'/%3E%3C/svg%3E");
    }

    .pna-site {
      width: min(1320px, calc(100% - 32px));
      margin: 0 auto;
      padding: 20px 0 34px;
      display: grid;
      gap: 14px;
    }

    .pna-site a { color: inherit; }
    .pna-site h1, .pna-site h2, .pna-site h3, .pna-site p, .pna-site figure { margin: 0; }

    .pna-nav {
      min-height: 70px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      border: 1px solid var(--na-line);
      border-radius: 2px;
      padding: 10px 14px 10px 10px;
      position: sticky;
      top: 12px;
      z-index: 30;
      background: rgba(7, 7, 7, 0.76);
      backdrop-filter: blur(18px);
      box-shadow: 0 18px 58px rgba(0, 0, 0, 0.42);
    }

    .pna-logo, .pna-nav-links, .pna-actions, .pna-card-top, .pna-footer, .pna-footer-links { display: flex; align-items: center; }

    .pna-logo {
      gap: 10px;
      text-decoration: none;
      font-family: var(--na-mono);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: -0.02em;
      text-transform: uppercase;
    }

    .pna-logo img {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      box-shadow: 0 0 24px rgba(216, 255, 0, 0.35);
    }

    .pna-nav-links { gap: 14px; flex-wrap: wrap; justify-content: flex-end; }

    .pna-nav a, .pna-lang {
      color: rgba(244, 239, 225, 0.76);
      background: transparent;
      border: 0;
      font: 700 11px/1 var(--na-mono);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }

    .pna-nav a:hover { color: var(--na-lime); }

    .pna-lang {
      border: 1px solid rgba(244, 239, 225, 0.22);
      padding: 11px 12px;
      cursor: pointer;
    }

    .pna-lang strong { color: var(--na-lime); }

    .pna-hero {
      min-height: 720px;
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(330px, 0.62fr);
      gap: 12px;
      position: relative;
      overflow: hidden;
      border: 1px solid var(--na-line);
      background:
        linear-gradient(90deg, rgba(157, 183, 236, 0.1), transparent 42%),
        linear-gradient(155deg, rgba(22, 19, 15, 0.92), rgba(5, 5, 5, 0.96));
    }

    .pna-hero::before {
      content: 'NOVO ALVO PRODUCTIONS / NA001 / SAMPLE CULTURE / R&B / CLUB MEMORY / ';
      position: absolute;
      left: -1vw;
      right: -1vw;
      bottom: -0.21em;
      z-index: 0;
      color: rgba(244, 239, 225, 0.045);
      font-family: var(--na-display);
      font-size: clamp(84px, 16vw, 250px);
      line-height: 0.8;
      letter-spacing: -0.08em;
      white-space: nowrap;
      pointer-events: none;
    }

    .pna-hero-tag {
      position: absolute;
      top: 24px;
      left: 24px;
      z-index: 2;
      color: var(--na-lime);
      font: 700 11px/1 var(--na-mono);
      letter-spacing: 0.06em;
      writing-mode: vertical-rl;
      text-orientation: mixed;
    }

    .pna-hero-copy {
      position: relative;
      z-index: 1;
      min-height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(48px, 8vw, 110px) clamp(26px, 6vw, 94px);
    }

    .pna-kicker {
      width: fit-content;
      margin-bottom: 18px !important;
      color: var(--na-lime);
      font: 700 11px/1 var(--na-mono);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .pna-site h1 {
      font-family: var(--na-display);
      font-size: clamp(70px, 13vw, 190px);
      line-height: 0.72;
      letter-spacing: -0.1em;
      text-transform: uppercase;
      max-width: 900px;
    }

    .pna-site h1 span { display: block; }

    .pna-title-tag {
      width: fit-content;
      margin-top: 14px;
      color: #090909;
      background: var(--na-blue);
      padding: 8px 12px 7px;
      font: 700 clamp(14px, 1.5vw, 20px)/1 var(--na-mono);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      transform: rotate(-1.2deg);
    }

    .pna-lead {
      max-width: 620px;
      margin-top: 32px !important;
      color: rgba(244, 239, 225, 0.76);
      font-size: clamp(20px, 2.1vw, 30px);
      line-height: 1.12;
      letter-spacing: -0.04em;
    }

    .pna-actions { gap: 10px; flex-wrap: wrap; margin-top: 34px; }

    .pna-primary, .pna-secondary {
      min-height: 50px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 17px;
      text-decoration: none;
      font: 700 12px/1 var(--na-mono);
      text-transform: uppercase;
      letter-spacing: -0.01em;
      border: 1px solid var(--na-line);
      transition: transform 0.18s ease, background 0.18s ease, color 0.18s ease;
      opacity: 1;
      mix-blend-mode: normal;
    }

    .pna-primary,
    .pna-primary:visited,
    .pna-primary:hover,
    .pna-primary:focus-visible {
      color: #050505 !important;
      -webkit-text-fill-color: #050505 !important;
      background: var(--na-lime);
      border-color: var(--na-lime);
      text-shadow: none;
    }
    .pna-secondary { color: var(--na-ink); background: rgba(244, 239, 225, 0.06); }
    .pna-primary:hover, .pna-secondary:hover { transform: translateY(-2px) skewX(-2deg); }
    .pna-primary.wide { width: min(100%, 390px); }

    .pna-artist-card {
      position: relative;
      z-index: 1;
      min-height: 100%;
      display: grid;
      grid-template-rows: auto 1fr auto;
      border-left: 1px solid var(--na-line);
      background:
        radial-gradient(circle at 50% 18%, rgba(216, 255, 0, 0.18), transparent 14rem),
        linear-gradient(180deg, rgba(157, 183, 236, 0.09), rgba(0, 0, 0, 0.24));
      padding: 22px;
    }

    .pna-card-top { justify-content: space-between; font: 700 11px/1 var(--na-mono); color: rgba(244, 239, 225, 0.72); text-transform: uppercase; }
    .pna-card-top span { color: var(--na-lime); }

    .pna-portrait {
      align-self: center;
      width: min(78vw, 410px);
      aspect-ratio: 4 / 5;
      margin: 28px auto;
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(157, 183, 236, 0.44);
      background: #0e0e0e;
      box-shadow: 0 35px 100px rgba(0,0,0,0.6), 0 0 56px rgba(157, 183, 236, 0.18);
      transform: rotate(1.4deg);
    }

    .pna-portrait::before {
      content: '';
      position: absolute;
      inset: -24%;
      background: url('/xapreto-studio-portrait.png') center/cover;
      filter: blur(24px) saturate(1.15);
      opacity: 0.35;
      transform: scale(1.12);
    }

    .pna-portrait img {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      filter: contrast(1.08) saturate(0.92) sepia(0.12);
    }

    .pna-portrait::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      background: linear-gradient(180deg, rgba(157,183,236,0.12), transparent 44%, rgba(0,0,0,0.28));
      mix-blend-mode: screen;
    }

    .pna-artist-text h2 {
      font-family: var(--na-display);
      font-size: clamp(44px, 6vw, 82px);
      line-height: 0.86;
      letter-spacing: -0.075em;
      text-transform: lowercase;
    }

    .pna-artist-text p { margin-top: 10px; color: var(--na-muted); font-size: 16px; line-height: 1.38; }
    .pna-artist-text a { display: inline-block; margin-top: 16px; color: var(--na-lime); font: 700 12px/1 var(--na-mono); text-decoration: none; }

    .pna-release {
      min-height: 560px;
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) minmax(360px, 1.05fr);
      border: 1px solid var(--na-line);
      background: #080808;
      overflow: hidden;
      --mx: 50%;
      --my: 50%;
      --rx: 0deg;
      --ry: 0deg;
    }

