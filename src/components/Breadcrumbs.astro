---
interface Crumb {
  name: string;
  url: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="max-w-6xl mx-auto px-4 pt-8">
  <ol class="flex flex-wrap items-center gap-2 text-[10px] font-black uppercase tracking-widest text-zinc-400">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && <span class="text-zinc-300 dark:text-zinc-700">/</span>}
        {index === items.length - 1 ? (
          <span class="text-red-600">{item.name}</span>
        ) : (
          <a href={item.url} class="hover:text-red-600 transition-colors">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
