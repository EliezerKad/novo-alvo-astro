---
import Icon from './Icon.astro';
import type { Article } from '../types';
import { formatRelativeDate, getCategoryColor } from '../lib/utils';

interface Props {
  article: Article;
  variant?: 'feature' | 'pulse' | 'list' | 'side';
  index?: number;
}

const { article, variant = 'pulse', index = 0 } = Astro.props;
const href = article.slug === '#' ? '#' : `/noticia/${article.slug}`;
---

{
  variant === 'feature' && (
    <a href={href} class="block group">
      <div class="relative aspect-auto md:aspect-[16/9] overflow-hidden rounded-[2.5rem] mb-8 shadow-[0_32px_64px_-12px_rgba(0,0,0,0.15)] bg-zinc-200 dark:bg-zinc-800 min-h-[460px] md:min-h-0">
        <img
          src={article.imageUrl || 'https://picsum.photos/seed/novoalvopre/1600/900'}
          alt={article.title}
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-[3s] group-hover:scale-105"
          referrerpolicy="no-referrer"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/40 to-transparent flex flex-col justify-end p-8 md:p-16">
          <div class="flex flex-wrap gap-3 mb-6">
            <span class="bg-zinc-950/50 backdrop-blur-xl text-white px-4 py-1.5 text-[10px] font-black uppercase tracking-widest rounded-lg border border-white/10 flex items-center gap-2">
              <Icon name="zap" class="w-3 h-3 text-yellow-400 fill-yellow-400" />
              DESTAQUES
            </span>
            <span class={`${getCategoryColor(article.category)} text-white px-4 py-1.5 text-[10px] font-black uppercase tracking-widest rounded-lg shadow-lg`}>
              {article.category}
            </span>
          </div>
          <h2 class="text-2xl md:text-4xl lg:text-5xl font-serif font-black text-white leading-[1.1] tracking-tighter mb-3 group-hover:text-red-400 transition-colors drop-shadow-2xl line-clamp-3">
            {article.title}
          </h2>
          <p class="text-sm md:text-base text-zinc-300 leading-relaxed max-w-2xl font-medium italic line-clamp-2 drop-shadow-md">
            {article.summary}
          </p>
        </div>
      </div>
      <div class="flex items-center justify-between pt-2 pb-6 px-4">
        <div class="flex items-center gap-4 text-zinc-400 text-[10px] font-black uppercase tracking-widest">
          <div class="flex items-center gap-1.5">
            <Icon name="clock" class="w-3.5 h-3.5" />
            {formatRelativeDate(article.publishedAt)}
          </div>
          <div class="flex items-center gap-1.5 border-l border-zinc-200 dark:border-zinc-800 pl-4">
            <Icon name="eye" class="w-3.5 h-3.5" />
            {article.views || 0} acessos
          </div>
        </div>
      </div>
    </a>
  )
}

{
  variant === 'pulse' && (
    <a href={href} class="group space-y-6">
      <div class="aspect-[16/10] rounded-[2rem] overflow-hidden bg-zinc-100 dark:bg-zinc-800 relative shadow-md group-hover:shadow-xl transition-all">
        {article.imageUrl ? (
          <img
            src={article.imageUrl}
            class="w-full h-full object-cover transition-transform duration-[2s] group-hover:scale-105"
            alt={article.title}
            referrerpolicy="no-referrer"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-zinc-300 dark:text-zinc-700">
            <Icon name="image" class="w-10 h-10 opacity-20" />
          </div>
        )}
      </div>
      <div class="space-y-3">
        <div class="flex items-center gap-3 text-[8px] font-black uppercase tracking-widest text-zinc-400">
          <div class="flex items-center gap-1">
            <Icon name="clock" class="w-3 h-3" />
            {formatRelativeDate(article.publishedAt)}
          </div>
          <div class="flex items-center gap-1 border-l border-zinc-200 dark:border-zinc-800 pl-3">
            <Icon name="eye" class="w-3 h-3" />
            {article.views || 0} acessos
          </div>
        </div>
        <h3 class="text-2xl font-serif font-black leading-tight tracking-tighter text-zinc-900 dark:text-zinc-50 group-hover:text-red-700 dark:group-hover:text-red-400 transition-colors">
          {article.title}
        </h3>
        <p class="text-zinc-500 dark:text-zinc-400 text-[11px] font-medium leading-relaxed italic line-clamp-3">
          {article.summary}
        </p>
      </div>
    </a>
  )
}

{
  variant === 'list' && (
    <a href={href} class="group/side flex items-start gap-4 pb-8 border-b border-zinc-100 dark:border-zinc-800 last:border-0 last:pb-0">
      <div class="w-20 h-16 rounded-xl overflow-hidden bg-zinc-100 dark:bg-zinc-800 flex-shrink-0">
        {article.imageUrl ? (
          <img src={article.imageUrl} class="w-full h-full object-cover" alt={article.title} referrerpolicy="no-referrer" />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-zinc-300 dark:text-zinc-700">
            <Icon name="image" class="w-5 h-5 opacity-20" />
          </div>
        )}
      </div>
      <div class="flex-1 space-y-2">
        <div class="flex items-center gap-1 text-[9px] font-bold text-zinc-500 dark:text-zinc-400">
          <Icon name="eye" class="w-3 h-3" />
          {article.views || 0}
        </div>
        <h5 class="text-xs md:text-base font-serif font-black leading-tight tracking-tight text-zinc-900 dark:text-zinc-50 group-hover/side:text-red-700 dark:group-hover/side:text-red-400 transition-colors">
          {article.title}
        </h5>
        <p class="text-zinc-400 dark:text-zinc-500 text-[9px] font-medium line-clamp-2 leading-relaxed italic">
          {article.summary}
        </p>
      </div>
    </a>
  )
}

{
  variant === 'side' && (
    <a href={href} class="flex gap-6 group">
      <span class="text-4xl font-serif font-black text-zinc-200 dark:text-zinc-800 group-hover:text-red-200 dark:group-hover:text-red-900 transition-colors leading-none">
        0{index + 1}
      </span>
      <div class="space-y-1 min-w-0">
        <span class={`text-[7px] font-black text-white px-1.5 py-0.5 rounded-sm uppercase tracking-widest block w-fit mb-1 ${getCategoryColor(article.category)}`}>
          {article.category}
        </span>
        <h4 class="font-serif font-black text-sm leading-tight tracking-tighter group-hover:text-red-700 transition-colors dark:text-zinc-200 dark:group-hover:text-red-400 line-clamp-2">
          {article.title}
        </h4>
        <div class="flex items-center gap-1.5 text-[8px] font-black text-zinc-300 dark:text-zinc-500 uppercase tracking-widest">
          <Icon name="eye" class="w-2.5 h-2.5" />
          {article.views || 0} acessos
        </div>
      </div>
    </a>
  )
}
