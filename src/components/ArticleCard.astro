---
import Icon from './Icon.astro';
import type { Article } from '../types';
import { formatRelativeDate, getCategoryColor } from '../lib/utils';

interface Props {
  article: Article;
  variant?: 'feature' | 'pulse' | 'list' | 'side';
  index?: number;
}

const { article, variant = 'pulse', index = 0 } = Astro.props;
const href = article.slug === '#' ? '#' : `/noticia/${article.slug}`;
---

{
  variant === 'feature' && (
    <a href={href} class="block group">
      <div class="relative mb-0 aspect-auto min-h-[430px] overflow-hidden rounded-[1.55rem] bg-zinc-200 shadow-[0_24px_70px_rgba(16,16,16,0.13)] dark:bg-zinc-800 sm:min-h-[500px] md:min-h-[620px] md:rounded-[2.125rem]">
        <img
          src={article.imageUrl || 'https://picsum.photos/seed/novoalvopre/1600/900'}
          alt={article.title}
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-[3s] ease-out group-hover:scale-105"
          referrerpolicy="no-referrer"
          onerror="this.onerror=null;this.src='/og-default.svg';"
        />
        <div class="absolute inset-0 flex flex-col justify-end bg-[linear-gradient(180deg,rgba(9,9,11,0.02)_0%,rgba(9,9,11,0.16)_28%,rgba(9,9,11,0.90)_100%),linear-gradient(90deg,rgba(9,9,11,0.58),rgba(9,9,11,0.18)_72%,transparent)] p-5 md:p-10 lg:p-12">
          <div class="mb-4 flex flex-wrap gap-2 md:mb-6 md:gap-3">
            <span class="flex items-center gap-2 rounded-lg border border-white/10 bg-zinc-950/50 px-3 py-1.5 text-[8px] font-black uppercase tracking-widest text-white backdrop-blur-xl md:px-4 md:text-[10px]">
              <Icon name="zap" class="w-3 h-3 text-yellow-400 fill-yellow-400" />
              DESTAQUES
            </span>
            <span class={`${getCategoryColor(article.category)} rounded-full px-3 py-1.5 text-[8px] font-black uppercase tracking-widest text-white shadow-lg md:px-4 md:text-[10px]`}>
              {article.category}
            </span>
          </div>
          <h2 class="mb-3 max-w-[860px] break-words text-[clamp(1.95rem,9.8vw,3.15rem)] font-sans font-black leading-[0.98] tracking-[-0.065em] text-white drop-shadow-2xl transition-colors group-hover:text-[#f4c8cf] sm:text-[clamp(2.55rem,7.4vw,4rem)] md:mb-4 md:leading-[0.94] md:tracking-[-0.075em]">
            {article.title}
          </h2>
          <p class="line-clamp-2 max-w-2xl text-sm font-medium leading-6 text-zinc-200 drop-shadow-md sm:text-base md:text-lg md:leading-7">
            {article.summary}
          </p>
        </div>
      </div>
      <div class="flex items-center justify-between px-2 pb-1 pt-4 md:px-4 md:pt-5">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[9px] font-black uppercase tracking-widest text-zinc-400 md:text-[10px]">
          <div class="flex items-center gap-1.5">
            <Icon name="clock" class="w-3.5 h-3.5" />
            {formatRelativeDate(article.publishedAt)}
          </div>
          <div class="flex items-center gap-1.5 border-l border-zinc-200 dark:border-zinc-800 pl-4">
            <Icon name="eye" class="w-3.5 h-3.5" />
            {article.views || 0} acessos
          </div>
        </div>
      </div>
    </a>
  )
}

{
  variant === 'pulse' && (
    <a href={href} class="group block rounded-[1.55rem] border border-transparent p-1.5 transition-all duration-500 hover:-translate-y-1 hover:border-black/10 hover:bg-white/74 hover:shadow-[0_18px_50px_rgba(16,16,16,0.07)] dark:hover:border-zinc-800 dark:hover:bg-zinc-900/70 md:rounded-[2rem] md:p-2">
      <div class="relative aspect-[16/10] overflow-hidden rounded-[1.25rem] bg-[#ebe8df] shadow-[0_12px_30px_rgba(16,16,16,0.06)] transition-all duration-500 group-hover:shadow-[0_22px_52px_rgba(16,16,16,0.12)] dark:bg-zinc-800 md:rounded-[1.8rem]">
        {article.imageUrl ? (
          <img
            src={article.imageUrl}
            class="w-full h-full object-cover transition-transform duration-[2s] ease-out group-hover:scale-105"
            alt={article.title}
            referrerpolicy="no-referrer"
            onerror="this.onerror=null;this.src='/og-default.svg';"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-zinc-300 dark:text-zinc-700">
            <Icon name="image" class="w-10 h-10 opacity-20" />
          </div>
        )}
      </div>
      <div class="space-y-2.5 px-1 py-4 md:space-y-3 md:px-2 md:py-5">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[8px] font-black uppercase tracking-widest text-zinc-400">
          <div class="flex items-center gap-1">
            <Icon name="clock" class="w-3 h-3" />
            {formatRelativeDate(article.publishedAt)}
          </div>
          <div class="flex items-center gap-1 border-l border-zinc-200 dark:border-zinc-800 pl-3">
            <Icon name="eye" class="w-3 h-3" />
            {article.views || 0} acessos
          </div>
        </div>
        <h3 class="text-[1.32rem] font-sans font-black leading-[1.04] tracking-[-0.055em] text-zinc-900 transition-colors group-hover:text-[#8A1F2D] dark:text-zinc-50 dark:group-hover:text-red-400 md:text-2xl md:leading-[1.08]">
          {article.title}
        </h3>
        <p class="line-clamp-2 text-xs font-medium leading-5 text-zinc-500 dark:text-zinc-400 md:line-clamp-3 md:text-[12px] md:leading-6">
          {article.summary}
        </p>
      </div>
    </a>
  )
}

{
  variant === 'list' && (
    <a href={href} class="group/side -mx-3 flex items-start gap-4 rounded-2xl border-b border-black/10 p-3 pb-7 transition-all duration-300 hover:bg-white/70 hover:shadow-lg dark:border-zinc-800 dark:hover:bg-zinc-900/70 last:border-0 last:pb-3">
      <div class="w-24 h-20 md:w-20 md:h-16 rounded-2xl overflow-hidden bg-[#ebe8df] dark:bg-zinc-800 flex-shrink-0 shadow-sm">
        {article.imageUrl ? (
          <img src={article.imageUrl} class="w-full h-full object-cover transition-transform duration-700 group-hover/side:scale-105" alt={article.title} referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='/og-default.svg';" />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-zinc-300 dark:text-zinc-700">
            <Icon name="image" class="w-5 h-5 opacity-20" />
          </div>
        )}
      </div>
      <div class="flex-1 space-y-2">
        <div class="flex items-center gap-1 text-[9px] font-bold text-zinc-500 dark:text-zinc-400">
          <Icon name="eye" class="w-3 h-3" />
          {article.views || 0}
        </div>
        <h5 class="text-sm md:text-base font-sans font-black leading-[1.12] tracking-[-0.035em] text-zinc-900 dark:text-zinc-50 group-hover/side:text-[#8A1F2D] dark:group-hover/side:text-red-400 transition-colors">
          {article.title}
        </h5>
        <p class="text-zinc-400 dark:text-zinc-500 text-[9px] font-medium line-clamp-2 leading-relaxed">
          {article.summary}
        </p>
      </div>
    </a>
  )
}

{
  variant === 'side' && (
    <a href={href} class="-mx-2 flex gap-4 md:gap-5 group rounded-2xl p-2 transition-all duration-300 hover:-translate-y-0.5 hover:bg-white/70 hover:shadow-lg dark:hover:bg-zinc-900/70">
      <div class="relative w-20 h-16 rounded-2xl overflow-hidden bg-[#ebe8df] dark:bg-zinc-800 flex-shrink-0 shadow-sm">
        {article.imageUrl ? (
          <img
            src={article.imageUrl}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            alt={article.title}
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            onerror="this.onerror=null;this.src='/og-default.svg';"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-zinc-300 dark:text-zinc-700">
            <Icon name="image" class="w-5 h-5 opacity-20" />
          </div>
        )}
        <span class="absolute top-1.5 left-1.5 rounded-full bg-zinc-950/70 px-1.5 py-0.5 text-[7px] font-black text-white backdrop-blur">
          {index + 1}
        </span>
      </div>
      <div class="space-y-1 min-w-0">
        <span class={`text-[7px] font-black text-white px-1.5 py-0.5 rounded-sm uppercase tracking-widest block w-fit mb-1 ${getCategoryColor(article.category)}`}>
          {article.category}
        </span>
        <h4 class="font-sans font-black text-sm leading-[1.12] tracking-[-0.045em] group-hover:text-[#8A1F2D] transition-colors dark:text-zinc-200 dark:group-hover:text-red-400 line-clamp-2">
          {article.title}
        </h4>
        <div class="flex items-center gap-1.5 text-[8px] font-black text-zinc-300 dark:text-zinc-500 uppercase tracking-widest">
          <Icon name="eye" class="w-2.5 h-2.5" />
          {article.views || 0} acessos
        </div>
      </div>
    </a>
  )
}
