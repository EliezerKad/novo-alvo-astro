---
import LogoSymbol from './LogoSymbol.astro';
import NavbarControls from './NavbarControls';
import NavbarMobileSearch from './NavbarMobileSearch';
import NavbarSearch from './NavbarSearch.astro';
import ThemeToggle from './ThemeToggle.astro';
import TopTicker from './TopTicker.astro';
import { categoryUrl } from '../lib/news';
import type { Article } from '../types';

interface Props {
  tickerArticles?: Article[];
  category?: string;
  categories: string[];
  subCategories: string[];
}

const { tickerArticles = [], category, categories, subCategories } = Astro.props;
---

<div class="sticky top-0 z-50">
  <NavbarMobileSearch client:load />
  <TopTicker articles={tickerArticles} />

  <header class="bg-white dark:bg-zinc-900 border-b border-zinc-200 dark:border-zinc-800 shadow-sm transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 md:px-6 py-2 md:py-3">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <a href="/" class="group flex flex-col items-center md:items-start text-zinc-900 dark:text-zinc-50">
          <div class="flex items-center gap-2">
            <LogoSymbol class="w-8 h-8 md:w-9 md:h-9 text-red-600 group-hover:text-red-700 transition-colors" />
            <h1 class="text-3xl md:text-3xl font-serif font-black tracking-tighter leading-none group-hover:text-red-700 transition-all duration-500 relative">
              NOVO ALVO
            </h1>
          </div>
          <p class="uppercase text-[6px] tracking-[0.4em] font-black text-zinc-400 italic mt-0.5 md:ml-[3.25rem]">
            Fatos e Impacto 24h
          </p>
        </a>

        <div class="md:hidden flex items-center gap-2">
          <NavbarControls category={category} client:load />
          <ThemeToggle />
        </div>

        <div class="hidden md:flex items-center gap-4 w-full md:w-auto flex-1 min-w-0">
          <div class="flex flex-col flex-1 min-w-0">
            <nav class="flex items-center justify-start lg:justify-center gap-4 md:gap-6 overflow-x-auto no-scrollbar py-1">
              <a
                href="/"
                class={`uppercase text-[11px] font-black tracking-widest transition-colors flex-shrink-0 ${!category || category === 'Início' ? 'text-red-600' : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-200'}`}
              >
                Início
              </a>
              {categories.map((cat) => (
                <a
                  href={categoryUrl(cat)}
                  class={`uppercase text-[11px] font-black tracking-widest transition-colors flex-shrink-0 ${category === cat ? 'text-red-600' : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-200'}`}
                >
                  {cat}
                </a>
              ))}
            </nav>
            <nav class="flex items-center justify-start lg:justify-center gap-4 md:gap-6 overflow-x-auto no-scrollbar py-1 border-t border-zinc-50 dark:border-zinc-800 mt-1">
              {subCategories.map((cat) => (
                <a
                  href={categoryUrl(cat)}
                  class={`uppercase text-[9px] font-black tracking-widest transition-colors flex-shrink-0 ${category === cat ? 'text-red-600' : 'text-zinc-400 dark:text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200'}`}
                >
                  {cat}
                </a>
              ))}
            </nav>
          </div>

          <div class="flex items-center gap-2 md:gap-3 flex-shrink-0 ml-2 pl-4 border-l border-zinc-100 dark:border-zinc-800">
            <NavbarSearch />
            <NavbarControls category={category} client:load />
            <ThemeToggle />
          </div>
        </div>
      </div>
    </div>
  </header>
</div>
