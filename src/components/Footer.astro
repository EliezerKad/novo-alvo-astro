---
import LogoSymbol from './LogoSymbol.astro';

const year = new Date().getFullYear();
---

<footer class="mt-8 bg-[#080809] px-4 py-5 text-white md:mt-10 md:py-6">
  <div class="mx-auto flex max-w-[1240px] flex-col gap-5 md:flex-row md:items-end md:justify-between">
    <div class="max-w-2xl space-y-3">
      <a href="/" class="group flex w-fit items-center gap-2">
        <LogoSymbol class="h-6 w-6 text-[#d7ff00] transition-colors group-hover:text-white md:h-7 md:w-7" />
        <h2 class="text-xl font-black uppercase leading-none tracking-[-0.04em] text-white transition-colors group-hover:text-[#d7ff00] md:text-2xl">
          Novo Alvo Produções
        </h2>
      </a>
      <p class="max-w-xl text-sm font-semibold leading-6 text-white/58">
        Música, edits, trilhas, voz e colaborações com curadoria direta de x.a preto.
      </p>
    </div>

    <nav class="flex flex-wrap gap-3 text-[11px] font-black uppercase tracking-[0.16em] text-white/55">
      <a href="mailto:contato@portalnovoalvo.com.br" class="transition-colors hover:text-[#d7ff00]">Email</a>
      <a href="https://instagram.com/eliezerman" target="_blank" rel="noreferrer" class="transition-colors hover:text-[#d7ff00]">Instagram</a>
      <a href="https://soundcloud.com/xapreto/oh-lala-space-jam-by-x-a-preto" target="_blank" rel="noreferrer" class="transition-colors hover:text-[#d7ff00]">SoundCloud</a>
    </nav>
  </div>

  <div class="mx-auto mt-5 flex max-w-[1240px] border-t border-white/10 pt-4 text-[10px] font-bold uppercase tracking-[0.18em] text-white/35">
    <p>© {year} Novo Alvo Produções</p>
  </div>
</footer>
