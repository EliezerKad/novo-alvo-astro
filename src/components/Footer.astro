---
import LogoSymbol from './LogoSymbol.astro';
import { categoryUrl } from '../lib/news';

const categories = [
  'Brasil',
  'Esportes',
  'Musica',
  'Moda',
  'Famosos',
  'Games',
  'Tecnologia',
  'Educacao',
  'Politica',
  'Economia',
  'Geral',
];
const year = new Date().getFullYear();
---

<footer class="bg-zinc-950 text-white pt-8 pb-6 border-t border-zinc-900 mt-12">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
      <div class="col-span-1 md:col-span-2 space-y-3">
        <a href="/" class="flex items-center gap-2 group w-fit">
          <LogoSymbol class="w-6 h-6 md:w-7 md:h-7 text-red-600 group-hover:text-red-700 transition-colors" />
          <h2 class="text-2xl font-serif font-black tracking-tighter leading-none group-hover:text-red-700 transition-all duration-500 relative text-zinc-900 dark:text-zinc-50">
            NOVO ALVO
          </h2>
        </a>
        <p class="text-zinc-500 text-[11px] max-w-sm leading-relaxed font-medium uppercase tracking-wider">
          Sua fonte primaria para noticias de impacto. Cobertura profunda e analitica dos fatos que moldam o mundo, 24 horas por dia.
        </p>
      </div>

      <div class="space-y-3">
        <h4 class="text-[9px] font-black uppercase tracking-[0.3em] text-red-600 mb-1">
          Categorias
        </h4>
        <nav class="grid grid-cols-2 gap-x-4 gap-y-1.5">
          {categories.slice(0, 8).map((category) => (
            <a
              href={categoryUrl(category)}
              class="text-[10px] font-bold text-zinc-500 hover:text-white transition-colors uppercase tracking-widest"
            >
              {category}
            </a>
          ))}
        </nav>
      </div>

      <div class="space-y-3">
        <h4 class="text-[9px] font-black uppercase tracking-[0.3em] text-red-600 mb-1">
          Institucional
        </h4>
        <nav class="flex flex-col gap-1.5 text-[10px] font-bold text-zinc-500 uppercase tracking-widest">
          <a href="/sobre" class="hover:text-white transition-colors">
            Sobre Nos
          </a>
          <a href="/privacidade" class="hover:text-white transition-colors">
            Privacidade
          </a>
          <a href="/contato" class="hover:text-white transition-colors">
            Contato
          </a>
        </nav>
      </div>
    </div>

    <div class="pt-4 border-t border-zinc-900 flex flex-col md:flex-row justify-between items-center gap-3">
      <p class="text-zinc-600 text-[8px] font-bold uppercase tracking-[0.2em]">
        © {year} Redacao Novo Alvo • Fatos e Impacto
      </p>
      <div class="flex gap-6 text-zinc-600 text-[8px] font-bold uppercase tracking-[0.2em]">
        <a href="/admin" class="hover:text-zinc-400 transition-colors">
          Redacao
        </a>
        <a href="/sobre" class="hover:text-zinc-400 transition-colors">
          Sobre Nos
        </a>
        <a href="/privacidade" class="hover:text-zinc-400 transition-colors">
          Privacidade
        </a>
      </div>
    </div>
  </div>
</footer>
