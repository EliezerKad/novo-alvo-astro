---
import LogoSymbol from './LogoSymbol.astro';
import VisitorCounter from './VisitorCounter.astro';
import { categoryUrl, displayCategory } from '../lib/news';

const categories = [
  'Brasil',
  'Esportes',
  'Musica',
  'Moda',
  'Famosos',
  'Games',
  'Tecnologia',
  'Educacao',
  'Politica',
  'Economia',
  'Geral',
];
const year = new Date().getFullYear();
---

<footer class="mt-8 bg-[#080809] px-4 py-3 text-white md:mt-10">
  <div class="mx-auto max-w-[1240px]">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-[1.15fr_.85fr] md:gap-6">
      <div class="space-y-2">
        <a href="/" class="group flex w-fit items-center gap-2">
          <LogoSymbol class="h-6 w-6 text-[#8A1F2D] transition-colors group-hover:text-[#e0b8bf] md:h-7 md:w-7" />
          <h2 class="relative text-xl font-serif font-black leading-none tracking-tighter text-white transition-all duration-500 group-hover:text-[#e0b8bf] md:text-2xl">
            NOVO ALVO
          </h2>
        </a>
        <VisitorCounter />
        <p class="max-w-2xl text-sm font-medium leading-5 text-white/60">
          Sua fonte primária para notícias de impacto. Cobertura profunda e analítica dos fatos que moldam o mundo, 24 horas por dia.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-5">
        <div>
          <h4 class="mb-2 text-[9px] font-black uppercase tracking-[0.12em] text-white">
            Categorias
          </h4>
          <nav class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-[11px] font-bold text-white/58">
            {categories.slice(0, 8).map((category) => (
              <a href={categoryUrl(category)} class="transition-colors hover:text-white">
                {displayCategory(category)}
              </a>
            ))}
          </nav>
        </div>

        <div>
          <h4 class="mb-2 text-[9px] font-black uppercase tracking-[0.12em] text-white">
            Institucional
          </h4>
          <nav class="grid gap-1.5 text-[11px] font-bold text-white/58">
            <a href="/sobre" class="transition-colors hover:text-white">Sobre Nós</a>
            <a href="/privacidade" class="transition-colors hover:text-white">Privacidade</a>
            <a href="/contato" class="transition-colors hover:text-white">Contato</a>
            <a href="/redacao" class="transition-colors hover:text-white">Redação</a>
          </nav>
        </div>
      </div>
    </div>

    <div class="mt-3 flex flex-col justify-between gap-2 border-t border-white/10 pt-3 text-[10px] font-bold text-white/42 md:flex-row md:items-end">
      <p>© {year} Redação Novo Alvo • Fatos e Impacto</p>
      <div class="flex items-baseline text-white" aria-label="NEXA">
        <span class="font-['Syncopate'] text-[10px] font-bold uppercase tracking-[0.18em] [transform:skew(-12deg)_scaleX(1.08)] md:text-xs">
          NEXA
        </span>
      </div>
    </div>
  </div>
</footer>
