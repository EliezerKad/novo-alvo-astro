---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span
  data-visitor-counter
  class={`hidden items-center gap-1 text-[7px] font-black uppercase tracking-[0.24em] text-zinc-400 dark:text-zinc-500 ${className}`}
  aria-live="polite"
>
  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.8)]"></span>
  <span data-visitor-counter-text>Ao vivo</span>
</span>

<script is:inline>
  (() => {
    if (window.__novoAlvoVisitorCounter) return;
    window.__novoAlvoVisitorCounter = true;

    const endpoint = '/api/visits';
    const sessionKey = 'novo-alvo-visitor-id';
    const leaderKey = 'novo-alvo-visitor-counter-leader';
    const cacheKey = 'novo-alvo-visitor-counter-cache';
    const tabId = `${Date.now()}-${Math.random()}`;
    const pingInterval = 300000;
    const leaderTtl = 330000;
    const formatNumber = (value) => {
      const number = Number(value || 0);
      if (number >= 1000000) return `${(number / 1000000).toFixed(1).replace('.0', '')}M`;
      if (number >= 1000) return `${(number / 1000).toFixed(1).replace('.0', '')}K`;
      return String(number);
    };
    const getVisitorId = () => {
      try {
        const existing = localStorage.getItem(sessionKey);
        if (existing) return existing;
        const next = crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random()}`;
        localStorage.setItem(sessionKey, next);
        return next;
      } catch {
        return `${Date.now()}-${Math.random()}`;
      }
    };
    const render = (payload) => {
      if (!payload || payload.enabled === false) return;
      document.querySelectorAll('[data-visitor-counter]').forEach((element) => {
        const text = element.querySelector('[data-visitor-counter-text]');
        if (!text) return;
        const online = Number(payload.online || 0);
        text.textContent = `${formatNumber(online)} online`;
        element.classList.remove('hidden');
        element.classList.add('inline-flex');
      });
    };
    const readCachedPayload = () => {
      try {
        const cached = JSON.parse(localStorage.getItem(cacheKey) || 'null');
        if (cached && Date.now() - Number(cached.cachedAt || 0) < leaderTtl) render(cached.payload);
      } catch {}
    };
    const cachePayload = (payload) => {
      try {
        localStorage.setItem(cacheKey, JSON.stringify({ cachedAt: Date.now(), payload }));
      } catch {}
    };
    const isVisible = () => document.visibilityState === 'visible';
    const isLeader = () => {
      if (!isVisible()) return false;
      try {
        const current = JSON.parse(localStorage.getItem(leaderKey) || 'null');
        const expired = !current || Number(current.expiresAt || 0) < Date.now();
        if (expired || current.tabId === tabId) {
          localStorage.setItem(leaderKey, JSON.stringify({ tabId, expiresAt: Date.now() + leaderTtl }));
          return true;
        }
      } catch {}
      return false;
    };
    const ping = async () => {
      if (!isLeader()) {
        readCachedPayload();
        return;
      }
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            visitorId: getVisitorId(),
            path: window.location.pathname,
          }),
        });
        if (!response.ok) return;
        const payload = await response.json();
        cachePayload(payload);
        render(payload);
      } catch {}
    };

    readCachedPayload();
    window.setTimeout(ping, 1500);
    window.setInterval(ping, pingInterval);
    document.addEventListener('visibilitychange', ping);
    window.addEventListener('storage', (event) => {
      if (event.key !== cacheKey || !event.newValue) return;
      readCachedPayload();
    });
  })();
</script>
