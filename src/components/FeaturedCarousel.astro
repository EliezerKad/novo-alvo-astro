---
import ArticleCard from './ArticleCard.astro';
import type { Article } from '../types';

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
---

{
  articles.length > 0 && (
    <section class="relative group" data-featured-carousel>
      <div class="pointer-events-none absolute -inset-6 rounded-[3rem] bg-[radial-gradient(circle_at_35%_18%,rgba(138,31,45,0.13),transparent_38%),radial-gradient(circle_at_80%_82%,rgba(16,16,16,0.06),transparent_35%)] blur-2xl"></div>
      <div
        class="relative overflow-hidden rounded-[2rem] shadow-[0_30px_90px_rgba(16,16,16,0.12)] md:rounded-[2.125rem]"
        data-featured-track
      >
        <div class="flex transition-transform duration-700 ease-out will-change-transform" data-featured-list>
          {articles.map((article, index) => (
            <div id={`destaque-${index + 1}`} class="min-w-full" data-featured-slide>
              <ArticleCard article={article} variant="feature" />
            </div>
          ))}
        </div>
      </div>
      {articles.length > 1 && (
        <>
          <button
            type="button"
            class="absolute left-5 top-1/2 z-20 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/25 bg-zinc-950/35 text-white shadow-xl backdrop-blur-md transition-all hover:border-[#8A1F2D] hover:bg-[#8A1F2D] focus:outline-none focus:ring-2 focus:ring-[#8A1F2D] md:flex"
            aria-label="Retroceder destaque"
            data-featured-prev
          >
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </button>

          <button
            type="button"
            class="absolute right-5 top-1/2 z-20 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/25 bg-zinc-950/35 text-white shadow-xl backdrop-blur-md transition-all hover:border-[#8A1F2D] hover:bg-[#8A1F2D] focus:outline-none focus:ring-2 focus:ring-[#8A1F2D] md:flex"
            aria-label="Avançar destaque"
            data-featured-next
          >
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </button>

          <div class="absolute bottom-12 left-1/2 -translate-x-1/2 flex gap-3 z-20">
            {articles.map((_, index) => (
              <button
                type="button"
                class="h-1.5 w-8 rounded-full bg-white/50 shadow-[0_0_15px_rgba(138,31,45,0.25)] transition-all duration-300 hover:bg-[#8A1F2D] data-[active=true]:bg-[#8A1F2D]"
                aria-label={`Ver destaque ${index + 1}`}
                data-featured-dot
                data-index={index}
              ></button>
            ))}
          </div>
        </>
      )}
    </section>
  )
}

<script>
  const carousels = document.querySelectorAll<HTMLElement>('[data-featured-carousel]');

  carousels.forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-featured-track]');
    const list = carousel.querySelector<HTMLElement>('[data-featured-list]');
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-featured-slide]'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-featured-dot]'));
    const prev = carousel.querySelector<HTMLButtonElement>('[data-featured-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-featured-next]');

    if (!track || !list || slides.length < 2) return;

    let currentIndex = 0;
    let intervalId: number | undefined;

    const setActiveDot = (index: number) => {
      dots.forEach((dot, dotIndex) => {
        dot.dataset.active = dotIndex === index ? 'true' : 'false';
      });
    };

    const scrollToSlide = (index: number) => {
      const nextIndex = (index + slides.length) % slides.length;
      currentIndex = nextIndex;
      list.style.transform = `translateX(-${nextIndex * 100}%)`;
      setActiveDot(nextIndex);
    };

    const start = () => {
      window.clearInterval(intervalId);
      intervalId = window.setInterval(() => scrollToSlide(currentIndex + 1), 8000);
    };

    const stop = () => {
      window.clearInterval(intervalId);
    };

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        scrollToSlide(Number(dot.dataset.index || 0));
        start();
      });
    });

    prev?.addEventListener('click', () => {
      scrollToSlide(currentIndex - 1);
      start();
    });

    next?.addEventListener('click', () => {
      scrollToSlide(currentIndex + 1);
      start();
    });

    carousel.addEventListener('focusin', stop);
    carousel.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stop();
      } else {
        start();
      }
    });

    setActiveDot(0);
    start();
  });
</script>
