---
import type { Article } from '../types';

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
---

{
  articles.length > 0 && (
    <div class="bg-red-600 text-white py-2 overflow-hidden whitespace-nowrap border-y border-red-700 shadow-lg relative">
      <div class="flex hover:[animation-play-state:paused] w-max" style="animation: ticker 54s linear infinite">
        {[...articles, ...articles].map((article) => (
          <a href={`/noticia/${article.slug}/`} class="inline-flex items-center mx-12">
            <span class="bg-white text-red-600 font-black px-2 py-0.5 text-[10px] mr-4 clip-newspaper">URGENTE</span>
            <span class="text-sm font-black tracking-tight uppercase hover:underline">
              {article.breakingSummary || article.title.substring(0, 70)}
            </span>
            <div class="w-2 h-2 bg-white/30 rounded-full ml-12"></div>
          </a>
        ))}
      </div>
    </div>
  )
}
