---
import type { Article } from '../types';

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
---

{
  articles.length > 0 && (
    <div class="live-newsroom-ticker relative overflow-hidden whitespace-nowrap border-y border-red-500/70 bg-red-600 py-1.5 text-white shadow-[0_12px_34px_rgba(220,38,38,0.22)] md:py-2">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_12%_50%,rgba(255,255,255,0.22),transparent_24%),linear-gradient(90deg,rgba(255,255,255,0.08),transparent_18%,transparent_82%,rgba(255,255,255,0.08))]"></div>
      <div class="relative flex w-max hover:[animation-play-state:paused]" style="animation: ticker 38s linear infinite">
        {[...articles, ...articles].map((article) => (
          <a href={`/noticia/${article.slug}/`} class="inline-flex items-center gap-3 mx-5 md:mx-10">
            <span class="relative inline-flex items-center gap-1.5 rounded-full bg-white px-2.5 py-1 text-[8px] font-black uppercase tracking-widest text-red-600 shadow-[0_0_18px_rgba(255,255,255,0.28)] md:text-[9px]">
              <span class="h-1.5 w-1.5 rounded-full bg-red-600 animate-live-pulse"></span>
              URGENTE
            </span>
            {article.imageUrl && (
              <img
                src={article.imageUrl}
                alt=""
                class="h-7 w-7 rounded-lg object-cover shadow-md ring-1 ring-white/20 md:h-8 md:w-8"
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
            )}
            <span class="max-w-[74vw] overflow-hidden text-ellipsis text-[11px] font-black uppercase tracking-tight hover:underline md:max-w-none md:text-sm">
              {article.breakingSummary || article.title.substring(0, 70)}
            </span>
            <div class="h-1.5 w-1.5 rounded-full bg-white/35 md:ml-4"></div>
          </a>
        ))}
      </div>
    </div>
  )
}
