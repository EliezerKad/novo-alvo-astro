---
const { class: className = 'w-8 h-8' } = Astro.props;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class={className} role="img" aria-label="Novo Alvo Produções">
  <defs>
    <radialGradient id="na-disc" cx="50%" cy="46%" r="62%">
      <stop offset="0%" stop-color="#2b2b2b" />
      <stop offset="58%" stop-color="#101010" />
      <stop offset="100%" stop-color="#030303" />
    </radialGradient>
    <radialGradient id="na-inner" cx="50%" cy="50%" r="55%">
      <stop offset="0%" stop-color="#303030" />
      <stop offset="100%" stop-color="#202020" />
    </radialGradient>
    <filter id="na-neon" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="6" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>
  <circle cx="256" cy="256" r="238" fill="url(#na-disc)" />
  <circle cx="256" cy="256" r="184" fill="none" stroke="#e6ff00" stroke-width="18" filter="url(#na-neon)" />
  <circle cx="256" cy="256" r="103" fill="url(#na-inner)" />
  <circle cx="188" cy="176" r="33" fill="#f4f0e7" opacity="0.98" />
  <circle cx="306" cy="224" r="18" fill="#e6ff00" />
  <circle cx="256" cy="256" r="232" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="2" />
</svg>
