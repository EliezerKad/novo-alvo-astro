---
import type { Article } from '../types';
import { getCategoryColor } from '../lib/utils';
import Icon from './Icon.astro';
import AdsenseBlock from './AdsenseBlock.astro';

interface Props {
  current: Article;
  articles: Article[];
}

const { current, articles } = Astro.props;
const carouselArticles = articles.length > 1 ? [...articles, ...articles] : articles;
---

{
  articles.length > 0 && (
    <div class="mt-24 pt-12 border-t border-zinc-100 dark:border-zinc-800 transition-colors">
      <div class="flex items-center justify-between gap-4 mb-8">
        <div class="flex items-center gap-4 min-w-0">
          <div class="w-10 h-10 bg-red-600 rounded-xl flex items-center justify-center text-white shadow-lg flex-shrink-0">
            <Icon name="trending" class="w-5 h-5" />
          </div>
          <div class="min-w-0">
            <h3 class="text-2xl font-serif font-black tracking-tighter italic dark:text-zinc-50">Giro de Notícias</h3>
            <p class="text-zinc-400 text-[9px] font-black uppercase tracking-[0.3em] dark:text-zinc-500">Mais em {current.category}</p>
          </div>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          <button
            type="button"
            class="w-10 h-10 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-500 hover:text-red-600 hover:border-red-600/40 transition-colors flex items-center justify-center disabled:pointer-events-none"
            aria-label="Matéria relacionada anterior"
            data-related-prev
          >
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </button>
          <button
            type="button"
            class="w-10 h-10 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-500 hover:text-red-600 hover:border-red-600/40 transition-colors flex items-center justify-center disabled:pointer-events-none"
            aria-label="Próxima matéria relacionada"
            data-related-next
          >
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </button>
        </div>
      </div>

      <div class="mb-8 py-8 border-y border-zinc-100 dark:border-zinc-800">
        <AdsenseBlock label="Publicidade entre relacionadas" minHeight="90px" class="w-full max-w-[728px] h-[90px] mx-auto" />
      </div>

      <div class="relative" data-related-carousel>
        <div
          class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-8 pr-4 no-scrollbar"
          data-related-track
        >
          {carouselArticles.map((rel) => (
            <a href={`/noticia/${rel.slug}`} class="w-[78vw] sm:w-[340px] md:w-[300px] flex-shrink-0 snap-start group/card space-y-4">
              <div class="aspect-[16/10] bg-zinc-100 dark:bg-zinc-800 rounded-3xl overflow-hidden relative border border-zinc-100 dark:border-zinc-800">
                {rel.imageUrl ? (
                  <img
                    src={rel.imageUrl}
                    referrerpolicy="no-referrer"
                    class="w-full h-full object-cover grayscale group-hover/card:grayscale-0 group-hover/card:scale-110 transition-all duration-1000"
                    alt={rel.title}
                    loading="lazy"
                    decoding="async"
                    sizes="(max-width: 640px) 78vw, 300px"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-zinc-300 dark:text-zinc-700">
                    <Icon name="zap" class="w-8 h-8" />
                  </div>
                )}
                <div class="absolute top-3 left-3">
                  <span class={`text-white px-2 py-0.5 text-[7px] font-black uppercase tracking-widest rounded-md ${getCategoryColor(rel.category)}`}>
                    {rel.category}
                  </span>
                </div>
              </div>
              <h4 class="text-base font-serif font-black leading-tight tracking-tighter group-hover/card:text-red-700 dark:text-zinc-50 dark:group-hover/card:text-red-400 transition-colors line-clamp-2">
                {rel.title}
              </h4>
            </a>
          ))}
        </div>
      </div>

      <script is:inline>
        const setupRelatedCarousels = () => document.querySelectorAll('[data-related-carousel]').forEach((carousel) => {
          if (carousel.dataset.relatedReady === 'true') return;
          const track = carousel.querySelector('[data-related-track]');
          const root = carousel.closest('.mt-24');
          const prev = root?.querySelector('[data-related-prev]');
          const next = root?.querySelector('[data-related-next]');
          if (!track || !prev || !next) return;
          carousel.dataset.relatedReady = 'true';

          const getStep = () => {
            const card = track.querySelector('a');
            if (!card) return track.clientWidth * 0.85;
            const styles = window.getComputedStyle(track);
            const gap = Number.parseFloat(styles.columnGap || styles.gap || '0') || 0;
            return card.offsetWidth + gap;
          };

          const updateButtons = () => {
            const maxScroll = track.scrollWidth - track.clientWidth - 2;
            prev.disabled = track.scrollLeft <= 2;
            next.disabled = track.scrollLeft >= maxScroll;
            prev.classList.toggle('opacity-40', prev.disabled);
            next.classList.toggle('opacity-40', next.disabled);
          };

          prev.addEventListener('click', () => {
            track.scrollBy({ left: -getStep(), behavior: 'smooth' });
          });
          next.addEventListener('click', () => {
            track.scrollBy({ left: getStep(), behavior: 'smooth' });
          });
          track.addEventListener('scroll', () => window.requestAnimationFrame(updateButtons), { passive: true });
          window.addEventListener('resize', updateButtons);

          const autoDelay = 6000;
          let autoTimer;
          let resumeTimer;

          const stopAuto = () => {
            if (autoTimer) window.clearInterval(autoTimer);
            autoTimer = undefined;
          };

          const startAuto = () => {
            stopAuto();
            if (track.scrollWidth <= track.clientWidth + 4) return;

            autoTimer = window.setInterval(() => {
              const step = getStep();
              const maxScroll = track.scrollWidth - track.clientWidth - step;
              const shouldRestart = track.scrollLeft >= maxScroll;
              track.scrollTo({
                left: shouldRestart ? 0 : track.scrollLeft + step,
                behavior: shouldRestart ? 'auto' : 'smooth',
              });
            }, autoDelay);
          };

          const pauseThenResume = () => {
            stopAuto();
            if (resumeTimer) window.clearTimeout(resumeTimer);
            resumeTimer = window.setTimeout(startAuto, autoDelay);
          };

          [prev, next].forEach((button) => button.addEventListener('click', pauseThenResume));
          track.addEventListener('pointerdown', pauseThenResume, { passive: true });
          track.addEventListener('focusin', stopAuto);
          track.addEventListener('focusout', startAuto);

          window.requestAnimationFrame(() => {
            updateButtons();
            startAuto();
          });
        });

        setupRelatedCarousels();
        document.addEventListener('astro:page-load', setupRelatedCarousels);
      </script>
    </div>
  )
}
