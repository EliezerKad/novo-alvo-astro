---
import '../styles.css';

interface Props {
  title: string;
  description?: string;
  active?: 'dashboard' | 'news' | 'new' | 'home' | 'seo' | 'settings';
}

const {
  title,
  description = 'Painel editorial do Portal Novo Alvo.',
  active = 'dashboard',
} = Astro.props;

const navItems = [
  { href: '/admin/', label: 'Visao geral', id: 'dashboard' },
  { href: '/admin/noticias/', label: 'Noticias', id: 'news' },
  { href: '/admin/nova/', label: 'Nova materia', id: 'new' },
  { href: '/admin/home/', label: 'Home editorial', id: 'home' },
  { href: '/admin/seo/', label: 'SEO e distribuicao', id: 'seo' },
  { href: '/admin/configuracoes/', label: 'Configuracoes', id: 'settings' },
] as const;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=Playfair+Display:ital,wght@0,900;1,900&display=swap" />
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (theme === 'dark' || (!theme && prefersDark)) document.documentElement.classList.add('dark');
          if (localStorage.getItem('admin-sidebar') === 'collapsed') document.documentElement.classList.add('admin-sidebar-collapsed');
        } catch {}
      })();
    </script>
    <style is:inline>
      @media (min-width: 1024px) {
        .admin-shell {
          grid-template-columns: 280px minmax(0, 1fr);
          transition: grid-template-columns 220ms ease;
        }

        .admin-sidebar {
          transition: opacity 180ms ease, transform 220ms ease, visibility 220ms ease;
        }

        .admin-main {
          min-width: 0;
        }

        .admin-sidebar-collapsed .admin-shell {
          grid-template-columns: 0 minmax(0, 1fr);
        }

        .admin-sidebar-collapsed .admin-sidebar {
          visibility: hidden;
          opacity: 0;
          transform: translateX(-24px);
          pointer-events: none;
        }
      }
    </style>
  </head>
  <body class="min-h-screen bg-zinc-100 text-zinc-950 antialiased dark:bg-zinc-950 dark:text-zinc-50">
    <div class="admin-shell min-h-screen lg:grid">
      <aside class="admin-sidebar border-b border-zinc-200 bg-white px-4 py-4 dark:border-zinc-800 dark:bg-zinc-950 lg:sticky lg:top-0 lg:h-screen lg:overflow-hidden lg:border-b-0 lg:border-r lg:px-5 lg:py-6">
        <div class="flex items-center justify-between gap-4 lg:block">
          <a href="/admin/" class="flex items-center gap-3">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-red-600 text-white shadow-lg shadow-red-600/20">
              <img src="/favicon.svg" alt="" class="h-6 w-6" />
            </span>
            <span>
              <span class="block text-sm font-black uppercase tracking-[0.18em]">Novo Alvo</span>
              <span class="block text-[9px] font-black uppercase tracking-[0.24em] text-zinc-400">Redacao</span>
            </span>
          </a>
          <a href="/" class="rounded-full border border-zinc-200 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-zinc-500 transition hover:border-red-600 hover:text-red-600 dark:border-zinc-800 lg:mt-8 lg:inline-flex">
            Ver portal
          </a>
        </div>

        <nav class="mt-5 flex gap-2 overflow-x-auto pb-1 lg:mt-8 lg:block lg:space-y-2 lg:overflow-visible lg:pb-0">
          {navItems.map((item) => (
            <a
              href={item.href}
              class={`whitespace-nowrap rounded-2xl px-4 py-3 text-[10px] font-black uppercase tracking-widest transition lg:flex lg:w-full ${
                active === item.id
                  ? 'bg-red-600 text-white shadow-lg shadow-red-600/15'
                  : 'bg-zinc-50 text-zinc-500 hover:bg-zinc-100 hover:text-zinc-950 dark:bg-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-50'
              }`}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="mt-8 hidden rounded-3xl border border-zinc-200 bg-zinc-50 p-5 dark:border-zinc-800 dark:bg-zinc-900 lg:block">
          <p class="text-[9px] font-black uppercase tracking-[0.24em] text-zinc-400">Modo atual</p>
          <p class="mt-2 text-sm font-bold text-zinc-700 dark:text-zinc-300">Estrutura inicial sem autenticacao. Ideal para desenhar fluxo editorial antes do CMS.</p>
        </div>
      </aside>

      <main class="admin-main px-4 py-6 md:px-8 lg:px-10 lg:py-8">
        <button
          type="button"
          class="mb-5 hidden items-center gap-2 rounded-full border border-zinc-200 bg-white px-4 py-3 text-[9px] font-black uppercase tracking-widest text-zinc-500 shadow-sm transition hover:border-red-600 hover:text-red-600 dark:border-zinc-800 dark:bg-zinc-900 lg:inline-flex"
          aria-label="Alternar menu lateral"
          data-admin-sidebar-toggle
        >
          <span data-admin-sidebar-toggle-icon>←</span>
          <span data-admin-sidebar-toggle-text>Esconder menu</span>
        </button>
        <slot />
      </main>
    </div>
    <script is:inline>
      (() => {
        const button = document.querySelector('[data-admin-sidebar-toggle]');
        if (!button) return;
        const text = button.querySelector('[data-admin-sidebar-toggle-text]');
        const icon = button.querySelector('[data-admin-sidebar-toggle-icon]');

        const render = () => {
          const collapsed = document.documentElement.classList.contains('admin-sidebar-collapsed');
          if (text) text.textContent = collapsed ? 'Mostrar menu' : 'Esconder menu';
          if (icon) icon.textContent = collapsed ? '→' : '←';
          button.setAttribute('aria-expanded', String(!collapsed));
        };

        button.addEventListener('click', () => {
          const collapsed = document.documentElement.classList.toggle('admin-sidebar-collapsed');
          try {
            localStorage.setItem('admin-sidebar', collapsed ? 'collapsed' : 'expanded');
          } catch {}
          render();
        });

        render();
      })();
    </script>
  </body>
</html>
