---
import '../styles.css';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  imageAlt?: string;
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title,
  description = 'Novo Alvo reúne notícias, análise e cobertura editorial com foco em fatos relevantes.',
  canonical = Astro.url.href,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  section,
  imageAlt = title,
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes,
  breadcrumbs = [],
} = Astro.props;
const siteName = 'Portal Novo Alvo';
const fallbackImage = new URL('/og-default.svg', Astro.site ?? Astro.url.origin).href;
const socialImage = image || fallbackImage;
const fontStylesheet = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@300;700&family=Playfair+Display:ital,wght@0,900;1,900&family=Syncopate:wght@700&display=swap';
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  name: siteName,
  url: new URL('/', Astro.site ?? Astro.url.origin).href,
  logo: new URL('/og-default.svg', Astro.site ?? Astro.url.origin).href,
  sameAs: [],
};
const breadcrumbSchema = breadcrumbs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: item.url,
      })),
    }
  : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="google-adsense-account" content="ca-pub-4967503094814982" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#8A1F2D" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Portal Novo Alvo RSS" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fontStylesheet} />
    <link rel="stylesheet" href={fontStylesheet} />
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage}
        imagesrcset={preloadImageSrcset}
        imagesizes={preloadImageSizes}
        fetchpriority="high"
      />
    )}
    <title>{title}</title>
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="pt_BR" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}
    {section && <meta property="article:section" content={section} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4967503094814982" crossorigin="anonymous"></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)}></script>
    {breadcrumbSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)}></script>}
    <script is:inline>
      try {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', stored === 'dark' || (!stored && prefersDark));
      } catch {}
    </script>
  </head>
  <body>
    <slot />
    <Footer />
    <div
      class="fixed inset-x-3 bottom-3 z-[80] hidden rounded-[1.35rem] border border-black/10 bg-white/95 p-4 text-[#101010] shadow-[0_24px_80px_rgba(16,16,16,0.18)] backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/95 dark:text-zinc-50 md:inset-x-auto md:right-5 md:bottom-5 md:max-w-[430px] md:rounded-[1.7rem] md:p-5"
      data-cookie-notice
      role="dialog"
      aria-live="polite"
      aria-label="Aviso de cookies"
    >
      <div class="flex items-start gap-3">
        <div class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-[#8A1F2D] shadow-[0_0_0_5px_rgba(138,31,45,0.12)]"></div>
        <div class="min-w-0">
          <h2 class="text-xs font-black uppercase tracking-[0.18em] text-[#8A1F2D]">Aviso de cookies</h2>
          <p class="mt-2 text-sm font-semibold leading-6 text-zinc-600 dark:text-zinc-300">
            Usamos cookies essenciais, preferências de navegação e tecnologias de publicidade para manter o portal funcionando, medir audiência e melhorar sua experiência.
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            <button
              type="button"
              class="rounded-full bg-[#8A1F2D] px-4 py-2 text-[10px] font-black uppercase tracking-widest text-white shadow-[0_12px_26px_rgba(138,31,45,0.22)] transition hover:-translate-y-0.5 hover:bg-[#6f1723]"
              data-cookie-accept
            >
              Aceitar
            </button>
            <a
              href="/politica-de-privacidade/"
              class="rounded-full border border-black/10 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-zinc-500 transition hover:-translate-y-0.5 hover:border-[#8A1F2D]/30 hover:text-[#8A1F2D] dark:border-white/10 dark:text-zinc-400"
            >
              Saiba mais
            </a>
          </div>
        </div>
      </div>
    </div>
    <script is:inline>
      (() => {
        const key = 'novo_alvo_cookie_notice_v1';
        const notice = document.querySelector('[data-cookie-notice]');
        const accept = document.querySelector('[data-cookie-accept]');
        if (!notice || !accept) return;

        try {
          if (localStorage.getItem(key) === 'accepted') return;
        } catch {}

        notice.classList.remove('hidden');
        accept.addEventListener('click', () => {
          try {
            localStorage.setItem(key, 'accepted');
          } catch {}
          notice.classList.add('hidden');
        });
      })();
    </script>
    <script is:inline>
      (() => {
        if (!window.__novoAlvoHydrateViews) {
          window.__novoAlvoHydrateViews = async (root = document) => {
            const nodes = Array.from(root.querySelectorAll('[data-live-view-count]'));
            const slugs = [...new Set(nodes.map((node) => node.dataset.liveViewCount).filter(Boolean))];
            if (!slugs.length) return;

            try {
              const response = await fetch(`/api/public/views?slugs=${encodeURIComponent(slugs.join(','))}`);
              if (!response.ok) return;
              const data = await response.json();
              const views = data && typeof data.views === 'object' ? data.views : {};
              nodes.forEach((node) => {
                const slug = node.dataset.liveViewCount || '';
                const value = Number(views[slug] || 0);
                node.textContent = node.dataset.viewFormat === 'number' ? String(value) : `${value} acessos`;
              });
            } catch {}
          };
        }

        void window.__novoAlvoHydrateViews();
      })();
    </script>
  </body>
</html>
