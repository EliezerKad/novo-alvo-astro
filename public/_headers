/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/admin
  X-Robots-Tag: noindex, nofollow, noarchive

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive

/redacao
  X-Robots-Tag: noindex, nofollow, noarchive

/redacao/*
  X-Robots-Tag: noindex, nofollow, noarchive

/api/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive

/_astro/*
  Cache-Control: public, max-age=31536000, immutable, no-transform
  X-Content-Type-Options: nosniff
