{
  "name": "novo-alvo-astro",
  "compatibility_date": "2025-01-01",
  "pages_build_output_dir": "dist",
  "kv_namespaces": [
    {
      "binding": "VISITOR_COUNTER",
      "id": "d73052d6da584a3186bf3bd72f917a55"
    }
  ],
  "ai": {
    "binding": "AI"
  }
  /*
  Depois de criar o D1/R2 no Cloudflare, ative os bindings abaixo:

  ,"d1_databases": [
    {
      "binding": "EDITORIAL_DB",
      "database_name": "novo-alvo-editorial",
      "database_id": "COLE_O_DATABASE_ID_AQUI"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "novo-alvo-media"
    }
  ]
  */
}
