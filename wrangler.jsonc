  "pages_build_output_dir": "dist",
  "kv_namespaces": [
    {
      "binding": "VISITOR_COUNTER",
      "id": "d73052d6da584a3186bf3bd72f917a55"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "EDITORIAL_DB",
      "database_name": "novo-alvo-editorial",
