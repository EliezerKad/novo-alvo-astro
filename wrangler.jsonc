{
  "name": "novo-alvo-astro",
  "compatibility_date": "2025-01-01",
  "pages_build_output_dir": "dist",
  "kv_namespaces": [
    {
      "binding": "VISITOR_COUNTER",
      "id": "d73052d6da584a3186bf3bd72f917a55"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "EDITORIAL_DB",
      "database_name": "novo-alvo-editorial",
      "database_id": "a15d72bf-96ac-432d-8379-e179ea387bb7"
    }
  ]
  /*
  Depois de criar o R2 no Cloudflare, ative o binding abaixo:

  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "novo-alvo-media"
    }
  ]
  */
}
